// The restart bar, shared by the Plugins tab and the Card order dialog.

import { Theme, Button } from "@ui-kit/ui-kit.slint";

// In the warning colour so it is noticed, and the one place a pending restart shows. The owner says what is waiting (`note`) and what Revert
// puts back (`revert-tip`).
// `amount` (0 to 1) is how far it has opened, from the window's own Unfold: the page above it gives up the same room as it grows, so
// the bar opens and shuts with everything round it moving, and the words fade up as it opens. The bar keeps its size and the window
// moves it (it slides down past the bottom edge as it shuts, not shrinks into a line above it).
export component RestartBar inherits Rectangle {
    in property <string> note;
    // What Revert does, the tooltip's body under its name
    in property <string> revert-tip: @tr("Put the plugins back the way they are in the running app, so nothing needs a restart.");
    // The restart button's words, for an owner that asks once more before it goes ahead
    in property <string> restart-text: @tr("Restart now");
    in property <float> amount: 1;
    // Whether a restart is still waiting: a bar on its way out looks the same but its buttons do nothing
    in property <bool> open: true;
    callback restart;
    callback revert;
    height: Theme.u(27);
    border-radius: Theme.r-card;
    background: Theme.warn;
    clip: true;
    HorizontalLayout {
        y: 0px;
        height: Theme.u(27);
        opacity: clamp(root.amount * 1.4 - 0.2, 0, 1);
        padding-left: Theme.u(8);
        padding-right: Theme.u(5);
        padding-top: Theme.u(5);
        padding-bottom: Theme.u(5);
        spacing: Theme.u(6);
        Text { horizontal-stretch: 1; text: note; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); font-family: Theme.font; font-size: Theme.body; font-weight: Theme.w-value; color: Theme.stage; vertical-alignment: center; }
        Button {
            text: @tr("Revert");
            role: "outline";
            clicked => { if (root.open) { root.revert(); } }
            tip: @tr("Revert");
            tip-detail: root.revert-tip;
        }
        Button {
            text: root.restart-text;
            clicked => { if (root.open) { root.restart(); } }
            tip: @tr("Restart now");
            tip-detail: @tr("Restart Telescope to apply your changes.");
        }
    }
}
