// One cell of the specimen sheet (src/specimen.rs): one kit control in one state, on a card's surface. Read crates/ui-kit/STYLE.md.
// The sheet draws this window once per control, state and look, and puts the pictures in a grid.

import { Theme, KeyFocus, Icons, Button, IconButton, LinkText, Switch, SwitchTile, Segmented, ChoiceField, Slider, TextField, NumberField, Jog, Stepper, SettingRow, Tag, TipBody, Card, FormRow, SectionHeading, ScrollBar } from "@ui-kit/ui-kit.slint";
export { Theme, KeyFocus }
// Tooltips (the second sheet): the tip, the window it is drawn in and the globals it reads
import { Tip, Tips, TipLayer, WindowBox } from "@ui-kit/ui-kit.slint";
export { Tips, WindowBox }

export component Cell inherits Window {
    // The control, as src/specimen.rs names it
    in property <string> kind;
    // The state: disabled, nothing filled in yet, a long text (what a German translation would give), lit
    in property <bool> off;
    in property <bool> empty;
    in property <bool> long;
    in property <bool> lit;
    background: Theme.card;
    property <color> hue: Theme.plugin-hue("camera");
    VerticalLayout {
        padding: 12px;
        alignment: center;
        spacing: 6px;
        if kind == "button": Button { text: long ? "Automatische Belichtungsmessung aktivieren" : "Reset"; enabled: !off; }
        if kind == "button-primary": Button { text: long ? "Übertragung jetzt starten und fortsetzen" : "Start streaming"; role: "primary"; enabled: !off; }
        if kind == "button-danger": Button { text: long ? "Alle gespeicherten Einstellungen löschen" : "Forget phone"; role: "danger"; enabled: !off; }
        if kind == "button-quiet": Button { text: long ? "Erweiterte Einstellungen anzeigen" : "Details"; role: "quiet"; enabled: !off; }
        if kind == "icon-button": HorizontalLayout { alignment: start; IconButton { icon: Icons.bell; label: "Notify"; enabled: !off; } }
        if kind == "link": HorizontalLayout { alignment: start; LinkText { text: long ? "Datenschutzerklärung und Nutzungsbedingungen anzeigen" : "Learn more"; url: "https://example.org"; font-size: Theme.body; } }
        if kind == "switch": HorizontalLayout { alignment: start; Switch { label: "Notify"; checked: lit; hue: hue; enabled: !off; } }
        if kind == "toggle": SwitchTile { text: long ? "Automatische Benachrichtigung bei Verbindungsabbruch" : "Notify"; icon: Icons.bell; checked: lit; hue: hue; enabled: !off; }
        if kind == "slider": Slider {
            label: "Zoom";
            minimum: 0;
            maximum: 100;
            value: 40;
            hue: hue;
            readout: long ? "+1,0 Blendenstufen (automatisch)" : "40%";
            enabled: !off;
        }
        if kind == "slider-key": VerticalLayout {
            spacing: 2px;
            for name[i] in ["Tolerance", "Edges", "Spill"]: Slider {
                label: name;
                minimum: 0;
                maximum: 100;
                value: 40;
                hue: Theme.plugin-hue("vision");
                fill: i == 0 ? "tolerance" : i == 1 ? "edges" : "spill";
                grad-a: i == 2 ? #d9a98a.mix(#3cb432, 0.55) : #3cb432;
                grad-b: i == 0 ? Theme.ink2.mix(#3cb432, 0.85) : #d9a98a;
                readout: "40%";
                enabled: !off;
            }
        }
        if kind == "segmented": Segmented {
            label: "Mode";
            items: long ? ["Automatisch", "Manuell", "Antippen zum Fokussieren"] : ["Auto", "Tap", "Manual"];
            disabled: [off, off, off];
            current: 0;
            hue: hue;
        }
        if kind == "picker": ChoiceField {
            caption: long ? "Belichtungskorrektur" : "Lens";
            items: long ? ["Weitwinkel (ultraweit)", "Normal (Hauptkamera)", "Teleobjektiv"] : ["Wide", "Normal", "Long"];
            current: empty ? -1 : 1;
            placeholder: long ? "Bitte ein Objektiv wählen" : "Choose";
            enabled: !off;
        }
        if kind == "field": TextField { text: empty ? "" : long ? "Wohnzimmer-Kamera von Christoph (Pixel 8 Pro)" : "Pixel 8"; placeholder: long ? "Namen für dieses Telefon eingeben" : "Name"; label: "Name"; enabled: !off; }
        if kind == "number": NumberField { value: empty ? "" : long ? "1234567890123456789012345678901234567890" : "42"; placeholder: "0"; label: "Number"; enabled: !off; }
        if kind == "jog": Jog { near-text: long ? "Näher heran" : "Near"; far-text: long ? "Weiter weg" : "Far"; label: "Focus"; hue: hue; enabled: !off; }
        if kind == "stepper": Stepper { caption: long ? "Brennweite" : "Zoom"; items: long ? ["Ultraweitwinkel 0,5x", "Hauptkamera 1x", "Teleobjektiv 5x"] : ["0.5x", "1x", "5x"]; current: 1; enabled: !off; }
        if kind == "strip": SettingRow {
            title: long ? "Bei Verbindungsabbruch automatisch neu verbinden" : "Reconnect";
            sub: long ? "Versucht es alle paar Sekunden" : "";
            enabled: !off;
            Switch { label: "Reconnect"; checked: lit; hue: hue; enabled: !off; }
        }
        if kind == "badge": HorizontalLayout { alignment: start; Tag { text: long ? "Experimentell und noch nicht stabil" : "Experimental"; } }
        if kind == "tip": HorizontalLayout { alignment: start; TipBody { says: long ? "Belichtung automatisch" : "Exposure"; detail: long ? "Stellt die Belichtung nach, solange das Telefon streamt, und merkt sich den Wert." : "Adjusts the picture's brightness for you."; keys: long ? [] : ["Ctrl", "E"]; } }
        if kind == "row": FormRow { label: long ? "Belichtungskorrektur" : "Exposure"; enabled: !off; Segmented { label: "Exposure"; items: ["Auto", "Manual"]; hue: hue; } }
        if kind == "section": SectionHeading { text: long ? "Weißabgleich und Farbtemperatur" : "White balance"; icon: Icons.thermometer; }
        if kind == "scrollbar": HorizontalLayout { alignment: start; ScrollBar { width: 11px; height: 80px; content: 400px; viewport: 100px; offset: 0px; } }
        if kind == "card": Card {
            title: long ? "Belichtung und Weißabgleich" : "Camera";
            icon: Icons.camera;
            hue: hue;
            enabled: !off;
            FormRow { label: "Mode"; Segmented { label: "Mode"; items: ["Auto", "Manual"]; hue: hue; } }
        }
        // The controls the card redesigns need (STYLE.md: Toggle tile, Picture segmented, Pad, Threshold bar, Dial, Icon rail)
        if kind == "toggle-tile": HorizontalLayout {
            spacing: Theme.gap;
            ToggleTile { text: long ? "Automatische Benachrichtigung bei Verbindungsabbruch" : "Stabilization"; icon: Icons.stabilize; checked: lit; hue: hue; enabled: !off; }
            ToggleTile { text: "Torch"; icon: Icons.torch; hue: hue; enabled: !off; }
        }
        if kind == "toggle-icons": HorizontalLayout {
            spacing: Theme.gap;
            ToggleTile { name: "Previous"; icon: Icons.chevron; checked: lit; hue: hue; enabled: !off; }
            ToggleTile { name: "Play"; icon: Icons.v-play; checked: lit; hue: hue; enabled: !off; }
            ToggleTile { name: "Next"; icon: Icons.chevron; hue: hue; enabled: !off; }
        }
        if kind == "picture-swatches": swatches := PictureSegmented {
            label: "Writing";
            items: long ? ["Pergamentpapier mit Linien", "Weisses Papier", "Graues Papier"] : ["Cream", "White", "Grey"];
            disabled: [off, off, off];
            current: 0;
            hue: hue;
            for i in 3: Rectangle {
                x: i * swatches.pitch + (swatches.cell-width - self.width) / 2;
                y: (swatches.art-height - self.height) / 2;
                width: Theme.u(24);
                height: Theme.u(13);
                border-radius: Theme.u(2);
                background: off ? Theme.dis : i == 0 ? #d6d3ca : i == 1 ? #ffffff : #c4c4c4;
                Path {
                    x: Theme.u(3);
                    y: Theme.u(3);
                    width: parent.width - Theme.u(6);
                    height: parent.height - Theme.u(6);
                    viewbox-width: 36;
                    viewbox-height: 14;
                    commands: "M 0 7 C 4 0 8 14 12 7 S 20 0 24 7 S 32 14 36 7";
                    stroke: off ? Theme.trough : i == 1 ? #111111 : #4a5568;
                    stroke-width: 1.5px;
                    fill: transparent;
                }
            }
        }
        if kind == "picture-shapes": shapes := PictureSegmented {
            label: "Shape";
            items: long ? ["Automatisch", "A4 hoch", "Letter", "Quadrat", "Bildfüllend"] : ["Auto", "A4", "Letter", "Square", "Fill"];
            disabled: [off, off, off, off, off];
            current: 1;
            hue: hue;
            show-names: true;
            tile-height: Theme.u(24);
            for i in 5: Path {
                property <length> w: i == 0 ? Theme.u(10) : i == 1 ? Theme.u(7) : i == 2 ? Theme.u(8) : i == 3 ? Theme.u(10) : Theme.u(13);
                property <length> h: i == 0 ? Theme.u(10) : i == 1 ? Theme.u(10) : i == 2 ? Theme.u(10) : i == 3 ? Theme.u(10) : Theme.u(8);
                x: i * shapes.pitch + (shapes.cell-width - w) / 2;
                y: (shapes.art-height - h) / 2;
                width: w;
                height: h;
                viewbox-width: w / 1px;
                viewbox-height: h / 1px;
                commands: i == 0 ? "M 1 " + (h / 1px - 1) + " L " + (w / 2 / 1px) + " 1 L " + (w / 1px - 1) + " " + (h / 1px - 1) + " Z"
                    : "M 1 1 L " + (w / 1px - 1) + " 1 L " + (w / 1px - 1) + " " + (h / 1px - 1) + " L 1 " + (h / 1px - 1) + " Z";
                stroke: off ? Theme.dis : shapes.shown == i ? Theme.ink : Theme.ink2;
                stroke-width: 1.5px;
                fill: transparent;
            }
        }
        if kind == "slider-wb": VerticalLayout {
            spacing: 2px;
            for name[i] in ["Temperature", "Tint"]: Slider {
                label: name;
                minimum: i == 0 ? 2000 : -50;
                maximum: i == 0 ? 10000 : 50;
                value: i == 0 ? 5500 : 10;
                has-default: true;
                default-value: i == 0 ? 5500 : 0;
                hue: hue;
                fill: i == 0 ? "temperature" : "tint";
                readout: long ? "Farbtemperatur 5500 Kelvin" : i == 0 ? "5500 K" : "+10";
                enabled: !off;
            }
        }
        if kind == "pad-sheet": sheet-pad := Pad {
            label: "Sheet size";
            x-minimum: 20;
            x-maximum: 200;
            y-minimum: 20;
            y-maximum: 200;
            value-x: 120;
            value-y: 90;
            centre-x: 100;
            centre-y: 100;
            has-default: true;
            default-x: 100;
            default-y: 100;
            hue: hue;
            enabled: !off;
            readout-top-left: true;
            readout: long ? "Breite 120 % Höhe 90 % des Papiers" : "W 120%  H 90%";
            Path {
                x: Theme.u(6);
                y: Theme.u(6);
                width: max(1px, sheet-pad.handle-x - Theme.u(6));
                height: max(1px, sheet-pad.handle-y - Theme.u(6));
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: "M 1 1 L " + (self.width / 1px - 1) + " 1 L " + (self.width / 1px - 1) + " " + (self.height / 1px - 1) + " L 1 " + (self.height / 1px - 1) + " Z";
                stroke: off ? Theme.dis : hue;
                stroke-width: 2px;
                fill: off ? transparent : Theme.tint(hue);
            }
            IconButton { x: parent.width - self.width - Theme.u(3); y: Theme.u(3); icon: Icons.reset; label: "Reset"; enabled: !off; }
        }
        if kind == "dial": HorizontalLayout {
            spacing: Theme.gap;
            Dial {
                label: long ? "Lichtempfindlichkeit" : "ISO";
                stops: empty ? [] : long ? ["100000", "2000000", "4000000", "8000000"] : ["100", "200", "400", "800", "1600", "3200"];
                current: 2;
                hue: hue;
                enabled: !off;
            }
            Dial {
                label: long ? "Belichtungszeit" : "Shutter";
                stops: empty ? [] : long ? ["1/100000", "1/200000", "1/400000", "1/800000"] : ["1/15", "1/30", "1/60", "1/125", "1/250", "1/500"];
                current: 2;
                hue: hue;
                enabled: !off;
            }
        }
        if kind == "threshold": VerticalLayout {
            spacing: Theme.u(3);
            Slider {
                label: "Battery";
                fill: "threshold";
                minimum: 0;
                maximum: 100;
                value: 20;
                level: 74;
                has-level: !empty;
                level-text: empty ? "-" : long ? "74 % und lädt gerade" : "74%";
                level-icon: Icons.bolt;
                has-level-icon: !empty;
                readout: "20%";
                hue: Theme.plugin-hue("streaming");
                enabled: !off;
            }
            Slider {
                label: "Temperature";
                fill: "threshold";
                minimum: 20;
                maximum: 60;
                value: 45;
                level: 38;
                has-level: !empty;
                level-text: empty ? "-" : "38°C";
                readout: "45°C";
                hue: Theme.plugin-hue("streaming");
                enabled: !off;
            }
        }
        if kind == "rail": VerticalLayout {
            spacing: Theme.u(3);
            RailRow {
                icon: Icons.sun;
                label: "Brightness";
                hue: hue;
                enabled: !off;
                Slider { label: "Brightness"; minimum: -4; maximum: 4; step: 0.1; value: 0; hue: hue; readout: long ? "+0,0 Blendenstufen (Auto)" : "+0.0 EV"; enabled: !off; }
            }
            RailRow {
                icon: Icons.thermometer;
                label: "White balance";
                hue: hue;
                enabled: !off;
                Segmented { label: "White balance"; items: ["Auto", "Manual"]; disabled: [off, off]; hue: hue; }
            }
            RailRow {
                has-icon: false;
                enabled: !off;
                Slider { label: "Warmth"; minimum: 0; maximum: 100; value: 60; hue: hue; readout: "60%"; enabled: !off; }
            }
        }
    }
}

// A row or column heading of the sheet
export component Heading inherits Window {
    in property <string> text;
    in property <bool> column;
    background: Theme.ground;
    Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.text;
        font-family: Theme.font;
        font-size: Theme.small;
        font-weight: Theme.w-value;
        color: Theme.ink2;
        vertical-alignment: center;
        horizontal-alignment: column ? center : left;
        overflow: elide;
    }
}

import { ToggleTile, PictureSegmented, Pad, Dial, RailRow } from "@ui-kit/ui-kit.slint";

// A control with its tooltip held up, anchored where the case says
component TipSample inherits Rectangle {
    in property <string> says;
    in property <string> detail;
    in property <[string]> keys;
    in property <color> hue: transparent;
    width: Theme.row;
    height: Theme.row;
    IconButton { icon: Icons.bell; label: "Notify"; }
    Tip { says: root.says; detail: root.detail; keys: root.keys; hue: root.hue; hover: true; }
}

// One cell of the tooltip sheet (src/specimen.rs): a tooltip up over a control, in a small window with the tip's own layer
export component TipCell inherits Window {
    in property <string> case;
    background: Theme.card;
    property <color> hue: Theme.plugin-hue("camera");
    if case == "name": TipSample { x: 24px; y: 14px; says: "Mute"; }
    if case == "detail": TipSample { x: 24px; y: 14px; says: "Exposure"; detail: "Adjusts the picture's brightness for you."; }
    if case == "keys": TipSample { x: 24px; y: 14px; says: "Take a photo"; keys: ["Ctrl", "Shift", "P"]; }
    if case == "long": TipSample { x: 24px; y: 14px; says: "Automatic exposure"; detail: "Looks at about a second of the picture and sets brightness for you. Everything it sets stays on the sliders to change."; keys: ["F5"]; }
    if case == "tint": TipSample { x: 24px; y: 14px; says: "Camera"; detail: "Which lens the phone uses."; hue: hue; }
    if case == "tint-keys": TipSample { x: 24px; y: 14px; says: "Take a photo"; keys: ["Ctrl", "P"]; hue: hue; }
    if case == "flip": TipSample { x: 24px; y: root.height - 14px - Theme.row; says: "Exposure"; detail: "Adjusts the picture's brightness for you."; }
    if case == "edge": TipSample { x: root.width - 24px - Theme.row; y: 14px; says: "Take a photo"; detail: "Saves the picture to your photos folder."; keys: ["Ctrl", "P"]; }
    TipLayer { }
}
