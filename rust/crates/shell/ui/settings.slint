// The settings window (widgets/settings_window.py) and its Plugins tab (widgets/plugins_panel.py). The window itself
// is written at startup by doc.rs, with every plugin's settings sections placed on their tabs.

import { Theme, Icons, Icon, Ghost, FocusRing, Button, IconButton, LinkText, Switch, Segmented, Worm, SearchWords, SettingRow, TextField, Tip, TipBody, ColumnScrollbar, ProgressBar, Motion, DialogFrame, DialogButtons, Status, Card, RailRow, SwitchRow, Unfolding, UnfoldGroup } from "@ui-kit/ui-kit.slint";

export struct NavTab {
    id: string,
    name: string,
    icon: image,
}

export struct Result {
    name: string,
    path: string,
}

export struct BadgeData {
    text: string,
    kind: string,
}

export struct TileView {
    name: string,
    title: string,
    about: string,
    icon: image,
    hue: color,
    on: bool,
    locked: bool,
    // The switch can be used (not a locked one, nor one whose download isn't there)
    enabled: bool,
    tooltip: string,
    note: string,
    note-kind: string,
    // The link that goes with the note (a newer release) and the one next to the author
    note-link: string,
    note-url: string,
    byline: string,
    byline-link: string,
    byline-url: string,
    // An added plugin has a remove button, named for it
    removable: bool,
    remove-label: string,
    badges: [BadgeData],
}

export struct UpdateRowView {
    id: string,
    title: string,
    about: string,
    note: string,
    danger: bool,
    on: bool,
    enabled: bool,
}

export struct GroupView {
    id: string,
    title: string,
    count: string,
    icon: image,
    hue: color,
    tiles: [TileView],
    // Every tile in a group is as tall as its tallest
    tile-height: length,
    // The vision download's own button and what it says, on the group that uses it
    remove-pack: bool,
    status: string,
}

// One tab in the column down the left (settings_nav).
component NavItem inherits Rectangle {
    in property <NavTab> tab;
    in property <bool> selected;
    callback clicked;
    height: Theme.u(19);
    accessible-role: list-item;
    accessible-label: tab.name;
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-action-default => { clicked(); }
    touch := TouchArea { clicked => { root.clicked(); } }
    Ghost {
        y: Theme.u(0.5);
        height: parent.height - Theme.u(1);
        // The picked tab's own look is the worm's, which the column draws under the rows
        plain: selected;
        over: touch.has-hover;
        held: touch.pressed;
        Icon { x: Theme.u(6.5); y: (parent.height - self.height) / 2; source: tab.icon; tint: selected ? Theme.accent : Theme.ink2; width: Theme.icon; height: Theme.icon; accessible-role: none; }
        Text {
            x: Theme.u(17.5);
            width: parent.width - Theme.u(22.5);
            text: tab.name;
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: selected ? Theme.w-value : Theme.w-label;
            color: selected ? Theme.ink : Theme.ink2;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The tab column: one focus stop, arrows move between tabs like QListWidget. A short window scrolls it: by the wheel, and
// by itself to keep the picked tab in sight. Its Flickable never moves itself (the rows shift by `offset`), as in ScrollPage.
export component SettingsNav inherits Rectangle {
    in property <[NavTab]> tabs;
    in-out property <int> current;
    callback picked(int);
    in-out property <length> offset;
    out property <length> item: Theme.u(19);
    out property <length> content: Theme.u(4) + tabs.length * item;
    property <length> range: max(0px, content - root.height);
    // Keeps the picked tab inside, whichever way it was picked
    function show-current() {
        let top = Theme.u(2) + current * item;
        if (top < min(offset, range) + Theme.u(2)) { offset = max(0px, top - Theme.u(2)); }
        else if (top + item + Theme.u(2) > min(offset, range) + root.height) { offset = min(range, top + item + Theme.u(2) - root.height); }
    }
    changed current => { show-current(); }
    changed height => { show-current(); }
    accessible-role: list;
    accessible-label: @tr("Settings tabs");
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.DownArrow && current < tabs.length - 1) { current += 1; picked(current); return accept; }
            if (e.text == Key.UpArrow && current > 0) { current -= 1; picked(current); return accept; }
            if (e.text == Key.Home) { current = 0; picked(current); return accept; }
            if (e.text == Key.End) { current = tabs.length - 1; picked(current); return accept; }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: Theme.r-ctl; width: parent.width + Theme.u(2); height: min(parent.height + Theme.u(2), tabs.length * item + Theme.u(6)); }
    Flickable {
        width: parent.width;
        height: parent.height;
        interactive: false;
        viewport-width: self.width;
        viewport-height: self.height;
        TouchArea {
            scroll-event(e) => {
                if (root.range <= 0px) { return reject; }
                offset = clamp(min(offset, range) - e.delta-y, 0px, range);
                accept
            }
        }
        // The picked tab's outline, in the rows' own scroll so scrolling doesn't make it lag
        Rectangle {
            y: -min(root.offset, root.range);
            width: parent.width;
            height: root.content;
            Worm {
                to-x: 0px;
                to-y: Theme.u(2) + current * item + Theme.u(0.5);
                to-w: parent.width;
                to-h: item - Theme.u(1);
                radius: Theme.r-ctl;
                hue: Theme.accent;
                shown: current >= 0 && current < tabs.length;
            }
        }
        VerticalLayout {
            y: -min(root.offset, root.range);
            width: parent.width;
            height: self.preferred-height;
            padding-top: Theme.u(2);
            alignment: start;
            for tab[i] in tabs: NavItem {
                tab: tab;
                selected: i == current;
                clicked => {
                    current = i;
                    focus.focus();
                    picked(i);
                }
            }
        }
    }
}

// A tab's page: its sections stacked, scrolling on its own, with Qt's 11px scrollbar beside the cards. A Flickable's clip
// lets Tab reach a control that has scrolled out of sight (a plain clip makes Slint skip it, and the cycle would be
// whatever is in view). It never moves itself: the page scrolls by `offset`, and a control that takes the focus asks
// for that through Reveal.
// How wide a Settings page's content may grow, the same on every page: past this a name and its control are too far apart to read as
// one row. Pages keep to the left, under the page title, however wide the window is.
export global SettingsLayout {
    out property <length> content-max: Theme.u(260);
}

export component ScrollPage inherits Flickable {
    in-out property <length> offset;
    out property <length> content: lay.preferred-height;
    property <length> range: max(0px, content - root.height);
    // Set from changes, not bound: the bar narrows the page, which changes how tall its content is
    in-out property <bool> bar;
    property <bool> checked;
    // The bar's room is always kept, so the page doesn't move or narrow when the bar appears
    out property <length> inner-width: min(root.width - 8px - 11px, SettingsLayout.content-max);
    changed content => { bar = content > root.height; }
    changed height => { bar = content > root.height; }
    interactive: false;
    viewport-width: self.width;
    viewport-height: self.height;
    // How the settings search tells the pages apart
    in property <int> index;
    SearchWords { words: "page \{index}"; }
    Timer {
        interval: 1ms;
        running: !checked;
        triggered => {
            bar = content > root.height;
            checked = true;
        }
    }
    TouchArea {
        scroll-event(e) => {
            offset = clamp(min(offset, range) - e.delta-y, 0px, range);
            accept
        }
    }
    lay := VerticalLayout {
        x: 0;
        y: -min(offset, range);
        width: inner-width;
        height: self.preferred-height;
        spacing: Theme.u(7);
        @children
    }
    ColumnScrollbar {
        // Takes presses over its whole gutter, the room beside the content included
        before: 8px;
        x: parent.width - 8px - 11px;
        height: parent.height;
        visible: bar;
        content: root.content;
        viewport: root.height;
        offset <=> root.offset;
    }
}

// What the search found: each result as its name with where it lives under it.
export component ResultsList inherits VerticalLayout {
    in property <[Result]> results;
    in-out property <int> current;
    in property <string> note;
    in property <string> empty;
    callback opened(int);
    spacing: Theme.gap;
    alignment: start;
    if note != "": Status { text: note; detail: note; }
    if results.length > 0: Rectangle {
        height: results.length * Theme.u(26);
        accessible-role: list;
        accessible-label: @tr("Search results");
        VerticalLayout {
            for r[i] in results: Rectangle {
                height: Theme.u(26);
                border-radius: Theme.r-ctl;
                border-width: i == current ? Theme.stroke : row-touch.has-hover ? Theme.outline-w-over : 0px;
                border-color: i == current ? Theme.accent : Theme.outline-hover;
                background: i == current ? Theme.tint(Theme.accent) : row-touch.has-hover ? Theme.hover : transparent;
                animate background { duration: Motion.tone-for(row-touch.pressed); easing: Motion.tone; }
                accessible-role: list-item;
                accessible-label: r.name;
                accessible-description: r.path;
                accessible-item-selected: i == current;
                accessible-action-default => { root.opened(i); }
                row-touch := TouchArea { clicked => { current = i; root.opened(i); } }
                VerticalLayout {
                    padding-left: Theme.u(7);
                    padding-right: Theme.u(5);
                    alignment: center;
                    spacing: Theme.u(1);
                    Text { text: r.name; overflow: elide; font-family: Theme.font; font-size: Theme.body; color: Theme.ink; font-weight: i == current ? Theme.w-value : Theme.w-label; }
                    Text { text: r.path; overflow: elide; font-family: Theme.font; font-size: Theme.small; color: Theme.ink2; }
                }
            }
        }
    }
    if empty != "": Status { text: empty; detail: empty; }
}

// A plugin as a named row: its icon in its card's colour (grey while it is off), its name, what it says about itself in a quiet word or
// two and the switch. What it does is the row's tooltip.
component PluginRow inherits Rectangle {
    in property <TileView> tile;
    callback switched(bool);
    callback removed;
    callback open-url(string);
    height: max(lay.preferred-height, Theme.row);
    accessible-role: groupbox;
    accessible-label: tile.title;
    accessible-description: tile.about;
    accessible-id: "setting";
    // Two texts on separate lines, without an empty line when one is missing
    pure function lines(a: string, b: string) -> string { a == "" ? b : b == "" ? a : a + "\n" + b }
    // What it does is the detail; who made it, what it needs and how it's doing go in the footer
    Tip { says: tile.title; detail: tile.about; hint: lines(lines(lines(tile.byline, tile.badges.length > 0 ? tile.badges[0].text : ""), tile.note), tile.tooltip); inert: true; }
    lay := RailRow {
        width: parent.width;
        icon: tile.icon;
        label: tile.title;
        named: true;
        // The row carries the marker itself (its description, the whole row)
        searchable: false;
        hue: tile.on ? tile.hue : Theme.dis;
        // The row is named by its text already, the tooltip is the row's
        tip: "";
        HorizontalLayout {
            spacing: Theme.gap;
            alignment: end;
            if tile.byline-link != "": VerticalLayout {
                alignment: center;
                LinkText { text: tile.byline-link; url: tile.byline-url; horizontal-stretch: 0; opened(u) => { root.open-url(u); } }
            }
            if tile.note-link != "": VerticalLayout {
                alignment: center;
                LinkText { text: tile.note-link; url: tile.note-url; horizontal-stretch: 0; opened(u) => { root.open-url(u); } }
            }
            if tile.removable: IconButton {
                icon: Icons.trash;
                label: tile.remove-label;
                tip: @tr("Remove");
                tip-detail: @tr("Delete this plugin's folder from the plugins folder.");
                clicked => { root.removed(); }
            }
            VerticalLayout {
                alignment: center;
                Switch {
                    hue: tile.hue;
                    checked: tile.on;
                    label: tile.title;
                    enabled: tile.enabled && !tile.locked;
                    toggled(on) => { root.switched(on); }
                }
            }
        }
    }
}

export component PluginsPanel inherits VerticalLayout {
    in property <[GroupView]> groups;
    in property <bool> all-on-enabled;
    in property <string> empty-note;
    in property <bool> narrowed;
    in-out property <string> query;
    in-out property <int> filter;
    // Something has been added, so there are no instructions to show, and the update switches that go with it
    in property <bool> has-added;
    in property <[UpdateRowView]> update-rows;
    callback switched(string, bool);
    callback removed(string);
    callback remove-pack;
    callback update-switched(string, bool);
    callback open-url(string);
    callback all-on;
    callback show-all;
    callback filter-changed;
    callback install;
    callback open-folder;
    callback open-docs;
    spacing: Theme.u(7);
    alignment: start;
    // Find a plugin, show the ones that are on or off, and put them all back as they came
    HorizontalLayout {
        spacing: Theme.gap;
        height: Theme.row;
        TextField {
            horizontal-stretch: 1;
            text <=> root.query;
            placeholder: @tr("Search plugins");
            label: @tr("Search plugins");
            has-icon: true;
            icon: Icons.search;
            clearable: true;
            edited => { root.filter-changed(); }
        }
        // The kit's Segmented: the picked one wears the worm, like every one-of choice
        Segmented {
            width: Theme.u(90);
            hue: Theme.accent;
            horizontal-stretch: 0;
            items: [@tr("plugins" => "All"), @tr("plugins" => "On"), @tr("plugins" => "Off")];
            disabled: [false, false, false];
            has-icons: [false, false, false];
            icons: [Icons.search, Icons.search, Icons.search];
            label: @tr("Show");
            current: filter;
            picked(i) => { filter = i; root.filter-changed(); }
        }
        IconButton {
            icon: Icons.reset;
            label: @tr("Reset to defaults");
            enabled: all-on-enabled;
            tip: @tr("Reset to defaults");
            tip-detail: @tr("Switch the optional built-in plugins off and the rest on.");
            clicked => { root.all-on(); }
        }
    }
    for g in groups: Card {
        title: g.title;
        tip: g.count;
        icon: g.icon;
        hue: g.hue;
        has-action: g.remove-pack;
        action-icon: Icons.trash;
        action-text: @tr("Remove download");
        action-tip-detail: @tr("Delete the download these plugins use. Switching on any of these plugins downloads the files again.");
        action => { root.remove-pack(); }
        if g.status != "": Status { text: g.status; detail: g.status; }
        for t in g.tiles: PluginRow {
            tile: t;
            switched(on) => { root.switched(t.name, on); }
            removed => { root.removed(t.name); }
            open-url(u) => { root.open-url(u); }
        }
    }
    if groups.length == 0: VerticalLayout {
        padding-top: Theme.u(8);
        padding-bottom: Theme.u(8);
        spacing: Theme.gap;
        Status { text: empty-note; detail: empty-note; horizontal: "center"; }
        HorizontalLayout {
            alignment: center;
            Button { text: @tr("Show all plugins"); clicked => { root.show-all(); } }
        }
    }
    if !narrowed: Card {
        title: @tr("Added plugins");
        icon: Icons.download;
        hue: Theme.accent;
        has-action: true;
        action-icon: Icons.plus;
        action-text: @tr("Install");
        action-label: @tr("Install");
        action-tip-detail: @tr("Pick a plugin's .zip file. You can also drop the file onto this window.");
        action => { root.install(); }
        UnfoldGroup {
            Unfolding {
                open: !has-added;
                lead: 0px;
                Status { text: @tr("No plugins added yet"); }
            }
        }
        for r in update-rows: RailRow {
            icon: Icons.update;
            label: r.title;
            tip: r.about;
            named: true;
            hue: r.danger ? Theme.err : Theme.accent;
            HorizontalLayout {
                spacing: Theme.gap;
                alignment: end;
                if r.note != "": Status { horizontal-stretch: 0; text: r.note; detail: r.note; kind: r.danger ? "err" : ""; font-size: Theme.small; font-weight: Theme.w-label; }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        checked: r.on;
                        label: r.title;
                        enabled: r.enabled;
                        danger: r.danger;
                        toggled(on) => { root.update-switched(r.id, on); }
                    }
                }
            }
        }
        RailRow {
            has-icon: false;
            HorizontalLayout {
                spacing: Theme.gap;
                alignment: end;
                Button { text: @tr("How plugins work"); clicked => { root.open-docs(); } }
                Button { text: @tr("Open plugins folder"); clicked => { root.open-folder(); } }
            }
        }
    }
}

// The restart bar kept under the Plugins tab's page: in the warning colour so it is noticed, and the one place a pending restart shows.
// `amount` (0 to 1) is how far it has opened, from the window's own Unfold: the page above it gives up the same room as it grows, so
// the bar opens and shuts with everything round it moving, and the words fade up as it opens.
export component PluginsFooter inherits Rectangle {
    in property <string> note;
    in property <float> amount: 1;
    callback restart;
    height: Theme.u(27) * amount;
    border-radius: Theme.r-card;
    background: Theme.warn;
    clip: true;
    HorizontalLayout {
        y: 0px;
        height: Theme.u(27);
        opacity: clamp(root.amount * 1.4 - 0.2, 0, 1);
        padding-left: Theme.u(8);
        padding-right: Theme.u(5);
        padding-top: Theme.u(5);
        padding-bottom: Theme.u(5);
        spacing: Theme.u(6);
        Text { horizontal-stretch: 1; text: note; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); font-family: Theme.font; font-size: Theme.body; font-weight: Theme.w-value; color: Theme.stage; vertical-alignment: center; }
        Button {
            text: @tr("Restart now");
            enabled: root.amount >= 1;
            clicked => { root.restart(); }
            tip: @tr("Restart now");
            tip-detail: @tr("Restart Telescope to apply your changes.");
        }
    }
}

// The banner over the restart bar while a pack downloads (the vision pack, and any later one): its name, a bar and the percentage on the
// right. `percent` is -1 while the size isn't known (the bar stays empty and no number shows). With an `error` it says what went wrong
// instead, in the error colour. `amount` is how far it has opened, from the window's own Unfold, the same way the restart bar's is.
export component DownloadBanner inherits Rectangle {
    in property <string> title;
    in property <int> percent: -1;
    in property <string> error;
    in property <string> detail;
    in property <float> amount: 1;
    height: Theme.u(27) * amount;
    border-radius: Theme.r-card;
    background: root.error != "" ? Theme.err : Theme.warn;
    clip: true;
    accessible-role: AccessibleRole.text;
    accessible-label: root.error != "" ? root.error : root.title;
    Tip { says: root.error != "" ? root.error : root.title; detail: root.detail; inert: true; }
    VerticalLayout {
        y: 0px;
        height: Theme.u(27);
        opacity: clamp(root.amount * 1.4 - 0.2, 0, 1);
        padding-left: Theme.u(8);
        padding-right: Theme.u(8);
        padding-top: Theme.u(5);
        padding-bottom: Theme.u(5);
        spacing: Theme.u(3);
        alignment: center;
        Text {
            text: root.error != "" ? root.error : root.title;
            wrap: word-wrap;
            line-height-factor: Theme.line-factor(self.font-size);
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: Theme.w-value;
            color: Theme.stage;
        }
        if root.error == "": HorizontalLayout {
            spacing: Theme.u(6);
            alignment: stretch;
            Rectangle {
                horizontal-stretch: 1;
                ProgressBar {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    value: max(root.percent, 0) / 100;
                    track: Theme.stage.with-alpha(0.25);
                    fill: Theme.stage;
                }
            }
            Text {
                visible: root.percent >= 0;
                width: Theme.u(18);
                text: root.percent + "%";
                horizontal-alignment: right;
                vertical-alignment: center;
                font-family: Theme.font;
                font-size: Theme.small;
                font-weight: Theme.w-value;
                color: Theme.stage;
            }
        }
    }
}

// The few questions the Plugins tab asks, over the settings window: the kit's dialog on a dimmed window. It pops and fades in and goes
// the same way, and the answer is said once the fade is over. With info it only tells, one button.
export component Ask inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> yes;
    in property <bool> danger;
    in property <bool> info;
    callback answered(bool);
    // What the dialog is left with: Escape and a press beside it are a no
    property <bool> answer;
    // The window dims and clears with the dialog
    background: Theme.scrim.with-alpha(Theme.scrim-a * dlg.presence);
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.answer = false; dlg.leave(); return accept; }
            reject
        }
        dlg := DialogFrame {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: Theme.u(210);
            height: self.preferred-height;
            title: root.title;
            dismissable: true;
            left => { root.answered(root.answer); }
            Text {
                text: root.text;
                wrap: word-wrap;
                line-height-factor: Theme.line-factor(self.font-size);
                font-family: Theme.font;
                font-size: Theme.body;
                color: Theme.ink2;
            }
            DialogButtons {
                if !info: Button { text: @tr("Cancel"); dialog: true; clicked => { root.answer = false; dlg.leave(); } }
                Button { text: info ? @tr("OK") : yes; dialog: true; role: danger && !info ? "" : "primary"; clicked => { root.answer = true; dlg.leave(); } }
            }
        }
    }
}
