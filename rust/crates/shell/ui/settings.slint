// The settings window (widgets/settings_window.py) and its Plugins tab (widgets/plugins_panel.py). The window itself
// is written at startup by doc.rs, with every plugin's settings sections placed on their tabs.

import { Theme, Icons, Icon, FocusRing, Button, IconButton, LinkText, Switch, Segmented, Worm, SearchWords, SettingRow, TextField, Tip, TipBody, ColumnScrollbar } from "@ui-kit/ui-kit.slint";

export struct NavTab {
    id: string,
    name: string,
    icon: image,
}

export struct Result {
    name: string,
    path: string,
}

export struct BadgeData {
    text: string,
    kind: string,
}

export struct TileView {
    name: string,
    title: string,
    about: string,
    icon: image,
    hue: color,
    on: bool,
    locked: bool,
    // The switch can be used (not a locked one, nor one whose download isn't there)
    enabled: bool,
    tooltip: string,
    note: string,
    note-kind: string,
    // The link that goes with the note (a newer release) and the one next to the author
    note-link: string,
    note-url: string,
    byline: string,
    byline-link: string,
    byline-url: string,
    // An added plugin has a remove button, named for it
    removable: bool,
    remove-label: string,
    badges: [BadgeData],
}

export struct UpdateRowView {
    id: string,
    title: string,
    about: string,
    note: string,
    danger: bool,
    on: bool,
    enabled: bool,
}

export struct GroupView {
    id: string,
    title: string,
    count: string,
    icon: image,
    hue: color,
    tiles: [TileView],
    // Every tile in a group is as tall as its tallest
    tile-height: length,
    // The vision download's own button and what it says, on the group that uses it
    remove-pack: bool,
    status: string,
}

// One tab in the column down the left (settings_nav).
component NavItem inherits Rectangle {
    in property <NavTab> tab;
    in property <bool> selected;
    callback clicked;
    height: 38px;
    accessible-role: list-item;
    accessible-label: tab.name;
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-action-default => { clicked(); }
    touch := TouchArea { clicked => { root.clicked(); } }
    Rectangle {
        y: 1px;
        height: parent.height - 2px;
        border-radius: 7px;
        // The picked tab's own look is the worm's, which the column draws under the rows
        background: !selected && touch.has-hover ? Theme.surface-hover : transparent;
        Icon { x: 13px; source: tab.icon; tint: selected ? Theme.text : Theme.text-dim; width: 16px; height: 16px; accessible-role: none; }
        Text {
            x: 35px;
            width: parent.width - 45px;
            text: tab.name;
            font-family: Theme.font;
            font-size: Theme.body;
            color: selected ? Theme.text : Theme.text-dim;
            font-weight: selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The tab column: one focus stop, arrows move between tabs like QListWidget. A short window scrolls it: by the wheel, and
// by itself to keep the picked tab in sight. Its Flickable never moves itself (the rows shift by `offset`), as in ScrollPage.
export component SettingsNav inherits Rectangle {
    in property <[NavTab]> tabs;
    in-out property <int> current;
    callback picked(int);
    in-out property <length> offset;
    out property <length> content: 8px + tabs.length * 38px;
    property <length> range: max(0px, content - root.height);
    // Keeps the picked tab inside, whichever way it was picked
    function show-current() {
        let top = 4px + current * 38px;
        if (top < min(offset, range) + 4px) { offset = max(0px, top - 4px); }
        else if (top + 38px + 4px > min(offset, range) + root.height) { offset = min(range, top + 38px + 4px - root.height); }
    }
    changed current => { show-current(); }
    changed height => { show-current(); }
    accessible-role: list;
    accessible-label: @tr("Settings tabs");
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.DownArrow && current < tabs.length - 1) { current += 1; picked(current); return accept; }
            if (e.text == Key.UpArrow && current > 0) { current -= 1; picked(current); return accept; }
            if (e.text == Key.Home) { current = 0; picked(current); return accept; }
            if (e.text == Key.End) { current = tabs.length - 1; picked(current); return accept; }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: 7px; width: parent.width + 4px; height: min(parent.height + 4px, tabs.length * 38px + 12px); }
    Flickable {
        width: parent.width;
        height: parent.height;
        interactive: false;
        viewport-width: self.width;
        viewport-height: self.height;
        TouchArea {
            scroll-event(e) => {
                if (root.range <= 0px) { return reject; }
                offset = clamp(min(offset, range) - e.delta-y, 0px, range);
                accept
            }
        }
        // The picked tab's outline, in the rows' own scroll so scrolling doesn't make it lag
        Rectangle {
            y: -min(root.offset, root.range);
            width: parent.width;
            height: root.content;
            Worm {
                to-x: 0px;
                to-y: 4px + current * 38px + 1px;
                to-w: parent.width;
                to-h: 36px;
                radius: 7px;
                hue: Theme.accent;
                shown: current >= 0 && current < tabs.length;
            }
        }
        VerticalLayout {
            y: -min(root.offset, root.range);
            width: parent.width;
            height: self.preferred-height;
            padding-top: 4px;
            alignment: start;
            for tab[i] in tabs: NavItem {
                tab: tab;
                selected: i == current;
                clicked => {
                    current = i;
                    focus.focus();
                    picked(i);
                }
            }
        }
    }
}

// A tab's page: its sections stacked, scrolling on its own, with Qt's 11px scrollbar beside the cards. A Flickable's clip
// lets Tab reach a control that has scrolled out of sight (a plain clip makes Slint skip it, and the cycle would be
// whatever is in view). It never moves itself: the page scrolls by `offset`, and a control that takes the focus asks
// for that through Reveal.
export component ScrollPage inherits Flickable {
    in-out property <length> offset;
    out property <length> content: lay.preferred-height;
    property <length> range: max(0px, content - root.height);
    // Set from changes, not bound: the bar narrows the page, which changes how tall its content is
    in-out property <bool> bar;
    property <bool> checked;
    out property <length> inner-width: root.width - 8px - (bar ? 11px : 0px);
    changed content => { bar = content > root.height; }
    changed height => { bar = content > root.height; }
    interactive: false;
    viewport-width: self.width;
    viewport-height: self.height;
    // How the settings search tells the pages apart
    in property <int> index;
    SearchWords { words: "page \{index}"; }
    Timer {
        interval: 1ms;
        running: !checked;
        triggered => {
            bar = content > root.height;
            checked = true;
        }
    }
    TouchArea {
        scroll-event(e) => {
            offset = clamp(min(offset, range) - e.delta-y, 0px, range);
            accept
        }
    }
    lay := VerticalLayout {
        x: 0;
        y: -min(offset, range);
        width: inner-width;
        height: self.preferred-height;
        spacing: 14px;
        @children
    }
    ColumnScrollbar {
        x: parent.width - 11px;
        height: parent.height;
        visible: bar;
        content: root.content;
        viewport: root.height;
        offset <=> root.offset;
    }
}

// What the search found: each result as its name with where it lives under it.
export component ResultsList inherits VerticalLayout {
    in property <[Result]> results;
    in-out property <int> current;
    in property <string> note;
    in property <string> empty;
    callback opened(int);
    spacing: 8px;
    alignment: start;
    if note != "": Text { text: note; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); font-family: Theme.font; font-size: Theme.body; color: Theme.text-dim; }
    if results.length > 0: Rectangle {
        height: results.length * 52px;
        accessible-role: list;
        accessible-label: @tr("Search results");
        VerticalLayout {
            for r[i] in results: Rectangle {
                height: 52px;
                border-radius: 8px;
                background: i == current ? Theme.fill : row-touch.has-hover ? Theme.surface-hover : transparent;
                accessible-role: list-item;
                accessible-label: r.name;
                accessible-description: r.path;
                accessible-item-selected: i == current;
                accessible-action-default => { root.opened(i); }
                row-touch := TouchArea { clicked => { current = i; root.opened(i); } }
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    alignment: center;
                    spacing: 2px;
                    Text { text: r.name; overflow: elide; font-family: Theme.font; font-size: Theme.body; color: i == current ? white : Theme.text; }
                    Text { text: r.path; overflow: elide; font-family: Theme.font; font-size: Theme.body; color: i == current ? #e6e1ff : Theme.text-dim; }
                }
            }
        }
    }
    if empty != "": Text { text: empty; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); font-family: Theme.font; font-size: Theme.body; color: Theme.text-dim; }
}

// QLabel#plugin_badge.
component Badge inherits Rectangle {
    in property <BadgeData> data;
    height: 18px;
    width: label.preferred-width + 16px;
    border-radius: 8px;
    border-width: 1px;
    background: data.kind == "restart" ? #251f17 : Theme.surface-raise;
    border-color: data.kind == "restart" ? #5a4a2e : Theme.border;
    label := Text {
        text: data.text;
        font-family: Theme.font;
        font-size: 11px;
        color: data.kind == "restart" ? Theme.warn : data.kind == "lock" ? Theme.accent-soft : Theme.text-dim;
        vertical-alignment: center;
    }
}

// An icon on a tinted square (_chip); grey for a plugin that's off.
component Chip inherits Rectangle {
    in property <image> icon;
    in property <color> hue;
    in property <bool> lit: true;
    width: 28px;
    height: 28px;
    border-radius: self.width / 3;
    background: (lit ? hue : Theme.text-faint).with-alpha(lit ? 0.14 : 0.10);
    Icon { source: icon; tint: lit ? hue : Theme.text-faint; width: 16px; height: 16px; accessible-role: none; }
}

// A plugin as a tile: icon, name and switch on top, what it does under them, then any note and its badges.
component PluginTile inherits Rectangle {
    in property <TileView> tile;
    callback switched(bool);
    callback removed;
    callback open-url(string);
    border-radius: 12px;
    border-width: 1px;
    background: Theme.surface;
    border-color: touch.has-hover ? Theme.border-strong : Theme.border;
    accessible-role: groupbox;
    accessible-label: tile.title;
    accessible-description: tile.about;
    accessible-id: "setting";
    touch := TouchArea { }
    Tip { says: tile.locked ? tile.tooltip : ""; hover: touch.has-hover; }
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 12px;
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: 10px;
            height: 32px;
            Chip { y: 0; icon: tile.icon; hue: tile.hue; lit: tile.on; }
            Text {
                horizontal-stretch: 1;
                text: tile.title;
                wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size);
                font-family: Theme.font;
                font-size: Theme.body;
                font-weight: 600;
                color: tile.on ? Theme.text : Theme.text-dim;
                vertical-alignment: center;
                // The tile and its switch are named by it already
                accessible-role: none;
            }
            if tile.removable: IconButton {
                y: 1px;
                icon: Icons.trash;
                label: tile.remove-label;
                tip: @tr("Remove");
                clicked => { root.removed(); }
            }
            Rectangle {
                width: 36px;
                Switch {
                    y: 6px;
                    checked: tile.on;
                    label: tile.title;
                    enabled: tile.enabled && !tile.locked;
                    tip: tile.locked ? "" : tile.tooltip;
                    toggled(on) => { root.switched(on); }
                }
            }
        }
        about := Text {
            height: 32px;
            text: tile.about;
            wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size);
            overflow: elide;
            font-family: Theme.font;
            font-size: 12px;
            color: Theme.text-faint;
            vertical-alignment: top;
        }
        if tile.byline != "" || tile.byline-link != "": HorizontalLayout {
            spacing: 4px;
            alignment: start;
            height: 18px;
            if tile.byline != "": Text { text: tile.byline; font-family: Theme.font; font-size: 12px; color: Theme.text-faint; vertical-alignment: center; }
            if tile.byline-link != "": LinkText { text: tile.byline-link; url: tile.byline-url; opened(u) => { root.open-url(u); } }
        }
        if tile.note != "": Text {
            text: tile.note;
            wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size);
            font-family: Theme.font;
            font-size: 12px;
            color: tile.note-kind == "status_err" ? Theme.err : tile.note-kind == "status_warn" ? Theme.warn : Theme.text-faint;
        }
        if tile.note-link != "": LinkText { text: tile.note-link; url: tile.note-url; opened(u) => { root.open-url(u); } }
        if tile.badges.length > 0: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for b in tile.badges: Badge { data: b; }
        }
    }
}

// card_action: a quiet button with a small icon.
export component CardAction inherits Button {
    role: "quiet";
    height: 30px;
    padding-x: 10px;
    gap: 6px;
    has-icon: true;
    icon-tint: Theme.text-dim;
    quiet-when-disabled: true;
}

export component PluginsPanel inherits VerticalLayout {
    in property <[GroupView]> groups;
    in property <bool> all-on-enabled;
    in property <string> empty-note;
    in property <bool> narrowed;
    in-out property <string> query;
    in-out property <int> filter;
    in property <int> columns: 2;
    // Something has been added, so there are no instructions to show, and the update switches that go with it
    in property <bool> has-added;
    in property <[UpdateRowView]> update-rows;
    // What each of All, On and Off is called to a screen reader ("Show: On")
    in property <[string]> filter-names;
    callback switched(string, bool);
    callback removed(string);
    callback remove-pack;
    callback update-switched(string, bool);
    callback open-url(string);
    callback all-on;
    callback show-all;
    callback filter-changed;
    callback install;
    callback open-folder;
    callback open-docs;
    spacing: 14px;
    alignment: start;
    HorizontalLayout {
        spacing: 12px;
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: start;
            CardAction {
                text: @tr("Reset to defaults");
                icon: Icons.reset;
                enabled: all-on-enabled;
                clicked => { root.all-on(); }
                tip: @tr("Switch the built-in plugins back to the standard selection: the optional ones off, the rest on");
            }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        height: 32px;
        TextField {
            horizontal-stretch: 1;
            text <=> root.query;
            placeholder: @tr("Search plugins");
            label: @tr("Search plugins");
            has-icon: true;
            icon: Icons.search;
            clearable: true;
            edited => { root.filter-changed(); }
        }
        // The kit's Segmented: the picked one wears the worm, like every one-of choice
        Segmented {
            width: 178px;
            horizontal-stretch: 0;
            items: [@tr("plugins" => "All"), @tr("plugins" => "On"), @tr("plugins" => "Off")];
            disabled: [false, false, false];
            has-icons: [false, false, false];
            icons: [Icons.search, Icons.search, Icons.search];
            label: @tr("Show");
            current: filter;
            picked(i) => { filter = i; root.filter-changed(); }
        }
    }
    VerticalLayout {
        spacing: 22px;
        for g in groups: VerticalLayout {
            spacing: 10px;
            accessible-role: groupbox;
            accessible-label: g.title;
            accessible-id: "card";
            HorizontalLayout {
                spacing: 10px;
                height: 26px;
                alignment: start;
                Chip { width: 26px; height: 26px; icon: g.icon; hue: g.hue; }
                Text { text: g.title; font-family: Theme.font; font-size: Theme.card-title; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                Text { text: g.count; font-family: Theme.font; font-size: Theme.small; color: Theme.text-faint; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if g.remove-pack: CardAction {
                    y: -2px;
                    text: @tr("Remove download");
                    icon: Icons.trash;
                    clicked => { root.remove-pack(); }
                    tip: @tr("Delete the download the plugins here use. Switching one on gets it again.");
                }
            }
            if g.status != "": Text {
                text: g.status;
                wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size);
                font-family: Theme.font;
                font-size: Theme.body;
                color: Theme.text-dim;
            }
            Rectangle {
                property <length> w: (self.width - (columns - 1) * 10px) / columns;
                height: ceil(g.tiles.length / columns) * (g.tile-height + 10px) - 10px;
                for t[i] in g.tiles: PluginTile {
                    x: mod(i, columns) * (parent.w + 10px);
                    y: floor(i / columns) * (g.tile-height + 10px);
                    width: parent.w;
                    height: g.tile-height;
                    tile: t;
                    switched(on) => { root.switched(t.name, on); }
                    removed => { root.removed(t.name); }
                    open-url(u) => { root.open-url(u); }
                }
            }
        }
    }
    if groups.length == 0: VerticalLayout {
        padding-top: 24px;
        padding-bottom: 24px;
        spacing: 10px;
        Text { text: empty-note; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); horizontal-alignment: center; font-family: Theme.font; font-size: Theme.body; color: Theme.text-dim; }
        HorizontalLayout {
            alignment: center;
            CardAction { text: @tr("Show all plugins"); icon: Icons.reset; clicked => { root.show-all(); } }
        }
    }
    if !narrowed: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            height: 30px;
            Chip { y: 2px; width: 26px; height: 26px; icon: Icons.download; hue: Theme.accent; }
            Text { text: @tr("Added plugins"); accessible-id: "card"; font-family: Theme.font; font-size: Theme.card-title; font-weight: 600; color: Theme.text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            CardAction {
                text: @tr("Install");
                icon: Icons.plus;
                clicked => { root.install(); }
                tip: @tr("Pick a plugin's .zip file. You can also drop one onto this window.");
            }
        }
        if !has-added: Text {
            text: @tr("No plugins added yet");
            wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size);
            font-family: Theme.font;
            font-size: Theme.body;
            color: Theme.text-dim;
        }
        for r in update-rows: SettingRow {
            title: r.title;
            sub: r.about;
            note: r.note;
            note-color: r.danger ? Theme.err : Theme.text-dim;
            Switch {
                checked: r.on;
                label: r.title;
                enabled: r.enabled;
                danger: r.danger;
                toggled(on) => { root.update-switched(r.id, on); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button { text: @tr("How plugins work"); height: 32px; clicked => { root.open-docs(); } }
            Button { text: @tr("Open plugins folder"); height: 32px; clicked => { root.open-folder(); } }
        }
    }
}

// The restart bar kept under the Plugins tab's page.
export component PluginsFooter inherits Rectangle {
    in property <string> note;
    callback restart;
    height: 54px;
    border-radius: 12px;
    border-width: 1px;
    background: Theme.surface-raise;
    border-color: Theme.border-strong;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        Text { horizontal-stretch: 1; text: note; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); font-family: Theme.font; font-size: Theme.body; font-weight: 600; color: Theme.text; vertical-alignment: center; }
        Button {
            text: @tr("Restart now");
            role: "primary";
            height: 32px;
            clicked => { root.restart(); }
            tip: @tr("Start Telescope again to apply your changes");
        }
    }
}

// QMessageBox for the few questions the Plugins tab asks, drawn over the settings window. With info it only tells,
// as QMessageBox.information and warning do: one button.
export component Ask inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> yes;
    in property <bool> danger;
    in property <bool> info;
    callback answered(bool);
    background: #00000080;
    TouchArea { }
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.answered(false); return accept; }
            reject
        }
        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 420px;
            height: lay.preferred-height;
            background: Theme.bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-strong;
            accessible-role: groupbox;
            accessible-label: title;
            lay := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: title; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); font-family: Theme.font; font-size: Theme.card-title; font-weight: 600; color: Theme.text; }
                Text { text: root.text; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); font-family: Theme.font; font-size: Theme.body; color: Theme.text-dim; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if !info: Button { text: @tr("Cancel"); clicked => { root.answered(false); } }
                    Button { text: info ? @tr("OK") : yes; role: danger && !info ? "" : "primary"; clicked => { root.answered(true); } }
                }
            }
        }
    }
}
