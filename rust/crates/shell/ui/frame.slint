// The window around the cards (app.py _build_header, _build_footer, widgets/banner.py, widgets/tiles.py). The window
// itself is written by the shell at startup (doc.rs), which places every plugin's card between these.

import { Theme, Icons, Icon, FocusRing, Button, IconButton, TipBody, TipUse, ShortcutMenu } from "@ui-kit/ui-kit.slint";

export struct BannerData {
    key: string,
    title: string,
    text: string,
    details: string,
    // "err", "warn" or "info"
    kind: string,
    actions: [string],
}

export struct TileData {
    id: string,
    name: string,
    // "to Telescope", already in the person's language (texts with named blanks are filled in by the shell)
    output: string,
    stop-label: string,
    state: string,
    // "status_ok", "status_warn", "status_err" or "status_dim"
    kind: string,
    focused: bool,
    thumb: image,
    has-thumb: bool,
}

export global StatusColors {
    public pure function of(kind: string) -> color {
        kind == "status_ok" || kind == "ok" ? Theme.ok : kind == "status_warn" || kind == "warn" ? Theme.warn
            : kind == "status_err" || kind == "err" ? Theme.err : Theme.dim
    }
}

// The header's icon button: the kit's, a little bigger.
export component HeaderIconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: Theme.icon;
    in property <string> label;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    width: Theme.u(16);
    height: Theme.u(16);
    accessible-role: none;
    IconButton {
        width: parent.width;
        height: parent.height;
        icon: root.icon;
        icon-size: root.icon-size;
        label: root.label;
        tip: root.tip;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Start streaming: the one filled violet button in the window, red while streaming.
export component StartButton inherits Rectangle {
    in property <string> text;
    in property <bool> streaming;
    in property <bool> enabled: true;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    callback clicked;
    height: Theme.u(16);
    width: btn.min-width;
    accessible-role: none;
    btn := Button {
        width: parent.width;
        height: parent.height;
        text: root.text;
        role: root.streaming ? "danger" : "primary";
        has-icon: true;
        icon: root.streaming ? Icons.v-stop : Icons.v-play;
        icon-tint: white;
        icon-size: Theme.icon-small;
        padding-x: Theme.u(8);
        gap: Theme.u(4);
        enabled: root.enabled;
        shortcut: root.shortcut;
        clicked => { root.clicked(); }
    }
}

// The footer's FPS and Throughput: a quiet caption and a value, no pill.
export component FooterPill inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    in property <color> value-color: Theme.ink;
    in property <string> tip;
    height: Theme.u(12);
    width: lay.preferred-width;
    accessible-role: text;
    accessible-label: caption + " " + value;
    if tip != "": Tooltip { TipBody { says: tip; } }
    lay := HorizontalLayout {
        spacing: Theme.u(4);
        Text { text: caption; font-family: Theme.font; font-size: Theme.tiny; color: Theme.ink2; vertical-alignment: center; }
        Text { text: value; font-family: Theme.font; font-size: Theme.body; font-weight: Theme.w-value; color: value-color; vertical-alignment: center; }
    }
}

export component Footer inherits Rectangle {
    in property <string> status;
    in property <string> status-kind: "status_dim";
    in property <string> fps;
    in property <color> fps-color: Theme.ink;
    in property <string> fps-tip;
    in property <string> net;
    in property <color> net-color: Theme.ink;
    height: 40px;
    background: Theme.chrome;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: Theme.u(12);
        shown-status := Text {
            horizontal-stretch: 1;
            text: status;
            overflow: elide;
            if shown-status.preferred-width > shown-status.width: Tooltip { TipBody { says: shown-status.text; } }
            font-family: Theme.font;
            font-size: Theme.body;
            color: StatusColors.of(status-kind);
            vertical-alignment: center;
            accessible-role: text;
        }
        FooterPill { caption: @tr("FPS"); value: fps; value-color: fps-color; tip: fps-tip; }
        FooterPill { caption: @tr("Throughput"); value: net; value-color: net-color; }
    }
}

// A banner's action: the kit's button.
component BannerButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: Theme.row;
    width: btn.min-width;
    accessible-role: none;
    btn := Button {
        width: parent.width;
        height: parent.height;
        text: root.text;
        clicked => { root.clicked(); }
    }
}

export component Banner inherits Rectangle {
    in property <BannerData> data;
    callback action(int);
    callback dismissed;
    border-radius: Theme.r-card;
    background: (data.kind == "warn" ? Theme.warn : Theme.err).mix(Theme.card, 0.14);
    accessible-role: groupbox;
    accessible-label: data.title;
    // banner.py's margins sit inside the QSS border; here the border is inside the padding
    HorizontalLayout {
        padding-left: 15px;
        padding-right: 11px;
        padding-top: 13px;
        padding-bottom: 13px;
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            Icon { source: Icons.v-alert; tint: data.kind == "warn" ? Theme.warn : Theme.err; width: 20px; height: 20px; accessible-role: none; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: start;
            Text { text: data.title; font-family: Theme.font; font-size: Theme.body; font-weight: 600; color: Theme.text; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); }
            if data.text != "": Text { text: data.text; font-family: Theme.font; font-size: Theme.body; color: Theme.text-dim; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); }
            if data.details != "": Rectangle {
                background: #00000040;
                border-radius: 6px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    TextInput { text: data.details; read-only: true; font-family: Theme.mono; font-size: Theme.body; color: Theme.text; wrap: word-wrap; }
                }
            }
        }
        for label[i] in data.actions: VerticalLayout {
            alignment: center;
            BannerButton { text: label; clicked => { root.action(i); } }
        }
        VerticalLayout {
            alignment: start;
            IconButton {
                icon: Icons.v-close;
                icon-size: Theme.icon-small;
                label: @tr("Dismiss");
                tip: @tr("Dismiss");
                clicked => { root.dismissed(); }
            }
        }
    }
}

export component BannerArea inherits VerticalLayout {
    in property <[BannerData]> banners;
    callback action(string, int);
    callback dismissed(string);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: banners.length > 0 ? 12px : 0px;
    spacing: 8px;
    for b in banners: Banner {
        data: b;
        action(i) => { root.action(b.key, i); }
        dismissed => { root.dismissed(b.key); }
    }
}

component StreamTile inherits Rectangle {
    in property <TileData> data;
    callback focus-requested;
    callback stop-requested;
    width: lay.preferred-width;
    border-radius: Theme.r-card;
    border-width: data.focused ? Theme.stroke : 0px;
    background: touch.has-hover ? Theme.hover : Theme.card;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: data.name;
    accessible-description: data.state;
    accessible-checked: data.focused;
    accessible-action-default => { focus-requested(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") { focus-requested(); return accept; }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: Theme.r-card; width: parent.width + 2 * Theme.stroke; height: parent.height + 2 * Theme.stroke; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.focus-requested(); } }
    if !data.focused: Tooltip { TipBody { says: @tr("Show this one's settings"); } }
    lay := HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        Rectangle {
            width: 128px;
            height: 72px;
            border-radius: 6px;
            background: Theme.surface-sunk;
            clip: true;
            if data.has-thumb: Image { source: data.thumb; width: parent.width; height: parent.height; image-fit: contain; }
            if !data.has-thumb: Text { text: "…"; color: Theme.text-faint; font-family: Theme.font; }
        }
        VerticalLayout {
            spacing: 2px;
            alignment: start;
            Text { text: data.name; font-family: Theme.font; font-size: Theme.body; font-weight: 600; color: Theme.text; }
            Text { text: data.output; font-family: Theme.font; font-size: Theme.tiny; color: Theme.ink2; }
            Text { text: data.state; font-family: Theme.font; font-size: Theme.body; color: StatusColors.of(data.kind); }
        }
        VerticalLayout {
            alignment: start;
            IconButton {
                icon: Icons.v-close;
                icon-size: Theme.icon-small;
                label: data.stop-label;
                tip: data.stop-label;
                clicked => { root.stop-requested(); }
            }
        }
    }
}

export component StreamTiles inherits HorizontalLayout {
    in property <[TileData]> tiles;
    callback focus-requested(string);
    callback stop-requested(string);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: tiles.length > 1 ? 12px : 0px;
    spacing: 10px;
    alignment: start;
    if tiles.length > 1: HorizontalLayout {
        spacing: 10px;
        for t in tiles: StreamTile {
            data: t;
            focus-requested => { root.focus-requested(t.id); }
            stop-requested => { root.stop-requested(t.id); }
        }
    }
}
