// The window around the cards (app.py _build_header, _build_footer, widgets/banner.py, widgets/tiles.py). The window
// itself is written by the shell at startup (doc.rs), which places every plugin's card between these.

import { Theme, Icons, Icon, FocusRing, KeyFocus, Button, IconButton, Tip, TipBody, TipUse, ShortcutMenu, Arrival, Motion, Fade, MenuSurface, MenuItem, BarPin, PinReadout, PinChip } from "@ui-kit/ui-kit.slint";

export struct BannerData {
    key: string,
    title: string,
    text: string,
    details: string,
    // "err", "warn" or "info"
    kind: string,
    actions: [string],
}

export struct TileData {
    id: string,
    name: string,
    // "to Telescope", already in the person's language (texts with named blanks are filled in by the shell)
    output: string,
    stop-label: string,
    state: string,
    // "status_ok", "status_warn", "status_err" or "status_dim"
    kind: string,
    focused: bool,
    thumb: image,
    has-thumb: bool,
}

export global StatusColors {
    public pure function of(kind: string) -> color {
        kind == "status_ok" || kind == "ok" ? Theme.ok : kind == "status_warn" || kind == "warn" ? Theme.warn
            : kind == "status_err" || kind == "err" ? Theme.err : Theme.dim
    }
}

// The header's controls are one size, a little bigger than a card's: the bar's height less its padding
// The header's icon button: the kit's, a little bigger.
export component HeaderIconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: Theme.icon;
    in property <string> label;
    in property <string> tip;
    in property <string> tip-detail;
    in property <bool> enabled: true;
    callback clicked;
    width: Theme.u(18);
    height: Theme.u(18);
    accessible-role: none;
    IconButton {
        width: parent.width;
        height: parent.height;
        raised: true;
        icon: root.icon;
        icon-size: root.icon-size;
        label: root.label;
        tip: root.tip;
        tip-detail: root.tip-detail;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Start streaming: the one white button in the window (violet in Classic), black with a white outline while streaming (red in Classic).
export component StartButton inherits Rectangle {
    in property <string> text;
    in property <bool> streaming;
    in property <bool> enabled: true;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    callback clicked;
    height: Theme.u(18);
    // Start and Stop are the same size: the width never drops below what "Start streaming" and "Stop streaming" take
    width: max(btn.min-width, Theme.u(88));
    accessible-role: none;
    btn := Button {
        width: parent.width;
        height: parent.height;
        text: root.text;
        role: root.streaming ? "stop" : "go";
        has-icon: true;
        icon: root.streaming ? Icons.v-stop : Icons.v-play;
        icon-size: Theme.icon;
        font-size: Theme.body * 1.08;
        padding-x: Theme.u(9);
        gap: Theme.u(4);
        enabled: root.enabled;
        shortcut: root.shortcut;
        clicked => { root.clicked(); }
    }
}

// The bar under the window, the top bar's colour. The pins are the readouts people pinned from the Stats card (the camera, the frame rate
// and the throughput to begin with), each side stacking from its own edge and folding the innermost ones into "+N" when they do not
// fit. Not streaming (or while the stream says something else), the status is a dim word on the left. No dot, no badge.
export component Footer inherits Rectangle {
    in property <string> status;
    in property <string> status-kind: "status_dim";
    // The status is a word of its own (anything but the streaming sentence, which the camera pin says)
    in property <bool> status-shown: true;
    in property <[BarPin]> pins;
    // How many pins each side folded, and where its chip goes
    in property <int> left-folded;
    in property <length> left-chip-x;
    in property <int> right-folded;
    in property <length> right-chip-x;
    // Where the status starts (after the pins on the left) and how much of the bar it may use
    in property <length> status-x: Theme.u(8);
    in property <length> status-room: root.width - 2 * Theme.u(8);
    callback pin-measured(string, length, length);
    callback drag-started(string);
    callback drag-moved(string, length);
    callback drag-ended(string);
    callback unpin(string);
    height: Theme.u(20);
    background: Theme.chrome;
    status-fade := Fade { shown: status-shown && status != ""; }
    shown-status := Text {
        x: status-x;
        width: max(0px, status-room);
        height: parent.height;
        text: status;
        overflow: elide;
        font-family: Theme.font;
        font-size: Theme.body;
        color: StatusColors.of(status-kind);
        vertical-alignment: center;
        opacity: status-fade.value;
        visible: status-fade.value > 0.001;
        accessible-role: text;
        Tip { says: shown-status.text; enabled: shown-status.preferred-width > shown-status.width; inert: true; }
    }
    for pin[i] in pins: PinReadout {
        pin: pin;
        bar-w: root.width;
        measured(w, plain) => { root.pin-measured(pin.id, w, plain); }
        drag-started => { root.drag-started(pin.id); }
        drag-moved(cx) => { root.drag-moved(pin.id, cx); }
        drag-ended => { root.drag-ended(pin.id); }
        menu-asked(x) => {
            root.menu-pin = pin.id;
            root.menu-locked = pin.locked;
            root.menu-x = x;
            root.menu-current = -1;
            root.leaving = false;
            menu.show();
        }
    }
    PinChip {
        count: left-folded;
        to-x: left-chip-x;
        label: @tr("More");
        clicked => { root.open-folded(0, self.x); }
    }
    PinChip {
        count: right-folded;
        to-x: right-chip-x;
        label: @tr("More");
        clicked => { root.open-folded(1, self.x); }
    }

    // The right-click menu of a pin, and the folded pins' list, are pop-ups above the bar that ease out before they go
    property <string> menu-pin;
    property <bool> menu-locked;
    property <length> menu-x;
    property <int> menu-current: -1;
    property <bool> leaving;
    property <int> folded-side: -1;
    property <length> folded-x;
    function leave() { leaving = true; }
    function open-folded(side: int, x: length) {
        root.folded-side = side;
        root.folded-x = x;
        root.leaving = false;
        list.show();
    }
    Timer {
        interval: Motion.fade-out + 40ms;
        running: root.leaving;
        triggered => {
            root.leaving = false;
            menu.close();
            list.close();
        }
    }
    menu := PopupWindow {
        x: clamp(root.menu-x - Theme.u(4), 0px, max(0px, root.width - Theme.u(60)));
        y: -(Theme.u(18) + Theme.u(3));
        width: Theme.u(60);
        height: Theme.u(18);
        close-policy: close-on-click-outside;
        MenuSurface {
            width: parent.width;
            height: parent.height;
            leaving: root.leaving;
            VerticalLayout {
                padding: Theme.u(2.5);
                MenuItem {
                    title: @tr("Unpin");
                    enabled: !root.menu-locked;
                    current: root.menu-current == 0;
                    hovered => { root.menu-current = 0; }
                    left => { root.menu-current = -1; }
                    activate => {
                        root.unpin(root.menu-pin);
                        root.leave();
                    }
                }
            }
        }
    }
    list := PopupWindow {
        x: clamp(root.folded-x, 0px, max(0px, root.width - Theme.u(120)));
        y: -(root.folded-count * Theme.u(13) + Theme.u(5) + Theme.u(3));
        width: Theme.u(120);
        height: root.folded-count * Theme.u(13) + Theme.u(5);
        close-policy: close-on-click-outside;
        MenuSurface {
            width: parent.width;
            height: parent.height;
            leaving: root.leaving;
            VerticalLayout {
                padding: Theme.u(2.5);
                for pin in pins: HorizontalLayout {
                    if pin.state == 1 && pin.side == root.folded-side: HorizontalLayout {
                        height: Theme.u(13);
                        padding-left: Theme.u(4);
                        padding-right: Theme.u(4);
                        spacing: Theme.u(3);
                        if pin.icon != "": Icon { y: (parent.height - self.height) / 2; source: Icons.named(pin.icon); tint: Theme.faint; width: Theme.icon-small; height: Theme.icon-small; }
                        Text { text: pin.name; horizontal-stretch: 1; min-width: 0px; overflow: elide; font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; vertical-alignment: center; }
                        Text { text: pin.value; font-family: Theme.font; font-size: Theme.body; font-weight: Theme.w-value; color: pin.tone == "err" ? Theme.err : pin.tone == "warn" ? Theme.warn : Theme.ink; vertical-alignment: center; horizontal-alignment: right; }
                    }
                }
            }
        }
    }
    // How many pins the open list holds
    property <int> folded-count: folded-side == 0 ? left-folded : folded-side == 1 ? right-folded : 0;
}

// A banner's action: the kit's button.
component BannerButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: Theme.row;
    width: btn.min-width;
    accessible-role: none;
    btn := Button {
        width: parent.width;
        height: parent.height;
        text: root.text;
        clicked => { root.clicked(); }
    }
}

export component Banner inherits Rectangle {
    in property <BannerData> data;
    callback action(int);
    callback dismissed;
    border-radius: Theme.r-card;
    background: (data.kind == "warn" ? Theme.warn : Theme.err).mix(Theme.card, 0.14);
    accessible-role: groupbox;
    accessible-label: data.title;
    // banner.py's margins sit inside the QSS border; here the border is inside the padding
    HorizontalLayout {
        padding-left: Theme.u(7.5);
        padding-right: Theme.u(5.5);
        padding-top: Theme.u(6.5);
        padding-bottom: Theme.u(6.5);
        spacing: Theme.u(6);
        VerticalLayout {
            alignment: start;
            Icon { source: Icons.v-alert; tint: data.kind == "warn" ? Theme.warn : Theme.err; width: Theme.u(10); height: Theme.u(10); accessible-role: none; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.u(1.5);
            alignment: start;
            Text { text: data.title; font-family: Theme.font; font-size: Theme.body; font-weight: 600; color: Theme.ink; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); }
            if data.text != "": Text { text: data.text; font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size); }
            if data.details != "": Rectangle {
                background: #00000040;
                border-radius: Theme.r-ctl;
                HorizontalLayout {
                    padding-left: Theme.u(4);
                    padding-right: Theme.u(4);
                    padding-top: Theme.u(3);
                    padding-bottom: Theme.u(3);
                    TextInput { text: data.details; read-only: true; font-family: Theme.mono; font-size: Theme.body; color: Theme.ink; wrap: word-wrap; }
                }
            }
        }
        for label[i] in data.actions: VerticalLayout {
            alignment: center;
            BannerButton { text: label; clicked => { root.action(i); } }
        }
        VerticalLayout {
            alignment: start;
            IconButton { raised: true;
                icon: Icons.v-close;
                icon-size: Theme.icon-small;
                label: @tr("Dismiss");
                tip: @tr("Dismiss");
                clicked => { root.dismissed(); }
            }
        }
    }
}

export component BannerArea inherits VerticalLayout {
    in property <[BannerData]> banners;
    callback action(string, int);
    callback dismissed(string);
    padding-left: Theme.u(8);
    padding-right: Theme.u(8);
    padding-top: banners.length > 0 ? Theme.u(6) : 0px;
    spacing: Theme.u(4);
    for b in banners: Banner {
        data: b;
        action(i) => { root.action(b.key, i); }
        dismissed => { root.dismissed(b.key); }
    }
}

component StreamTile inherits Rectangle {
    in property <TileData> data;
    callback focus-requested;
    callback stop-requested;
    width: lay.preferred-width;
    border-radius: Theme.r-card;
    border-width: data.focused ? Theme.stroke : 0px;
    background: touch.has-hover ? Theme.hover : Theme.card;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: data.name;
    accessible-description: data.state;
    accessible-checked: data.focused;
    accessible-action-default => { focus-requested(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") { focus-requested(); return accept; }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: Theme.r-card; width: parent.width + 2 * Theme.stroke; height: parent.height + 2 * Theme.stroke; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.focus-requested(); } }
    Tip { says: data.focused ? "" : @tr("Show settings"); detail: data.focused ? "" : @tr("Show this stream's settings in the cards."); hover: touch.has-hover; focused: focus.has-focus && KeyFocus.keyboard; }
    lay := HorizontalLayout {
        padding-left: Theme.u(4);
        padding-right: Theme.u(3);
        padding-top: Theme.u(4);
        padding-bottom: Theme.u(4);
        spacing: Theme.u(5);
        Rectangle {
            width: Theme.u(64);
            height: Theme.u(36);
            border-radius: Theme.r-ctl;
            background: Theme.stage;
            clip: true;
            if data.has-thumb: Image { source: data.thumb; width: parent.width; height: parent.height; image-fit: contain; }
            if !data.has-thumb: Text { text: "…"; color: Theme.faint; font-family: Theme.font; }
        }
        VerticalLayout {
            spacing: Theme.u(1);
            alignment: start;
            Text { text: data.name; font-family: Theme.font; font-size: Theme.body; font-weight: 600; color: Theme.ink; }
            Text { text: data.output; font-family: Theme.font; font-size: Theme.tiny; color: Theme.ink2; }
            Text { text: data.state; font-family: Theme.font; font-size: Theme.body; color: StatusColors.of(data.kind); }
        }
        VerticalLayout {
            alignment: start;
            IconButton { raised: true;
                icon: Icons.v-close;
                icon-size: Theme.icon-small;
                label: data.stop-label;
                tip: data.stop-label;
                clicked => { root.stop-requested(); }
            }
        }
    }
}

export component StreamTiles inherits HorizontalLayout {
    in property <[TileData]> tiles;
    callback focus-requested(string);
    callback stop-requested(string);
    padding-left: Theme.u(8);
    padding-right: Theme.u(8);
    padding-top: tiles.length > 1 ? Theme.u(6) : 0px;
    spacing: Theme.u(5);
    alignment: start;
    if tiles.length > 1: HorizontalLayout {
        spacing: Theme.u(5);
        for t in tiles: StreamTile {
            data: t;
            focus-requested => { root.focus-requested(t.id); }
            stop-requested => { root.stop-requested(t.id); }
        }
    }
}
