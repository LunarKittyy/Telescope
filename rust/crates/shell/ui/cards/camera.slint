// The Camera card, built from ui-kit's widgets: an icon rail, then one column of controls.

import { Theme, Icons, Icon, Tip, Card, RailRow, Segmented, Slider, ToggleTile, Dial, ShortcutMenu } from "@ui-kit/ui-kit.slint";

export struct Lens {
    id: string,
    number: string,
    unit: string,
    rest: string,
    name: string,
}

// A toggle tile as the card holds it: on or off, usable, and why not.
export struct TileState {
    checked: bool,
    enabled: bool,
    tip: string,
}

component LensTile inherits Rectangle {
    in property <Lens> lens;
    in property <bool> on;
    in property <color> hue;
    callback clicked;
    height: Theme.u(27);
    horizontal-stretch: 1;
    border-radius: Theme.r-ctl;
    border-width: on ? Theme.stroke : 0px;
    border-color: hue;
    background: on ? (touch.pressed ? Theme.held(hue) : Theme.tint(hue)) : touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : Theme.raise;
    accessible-role: button;
    accessible-label: lens.name;
    accessible-checked: on;
    accessible-action-default => { root.clicked(); }
    usage := Tip { says: lens.name; hover: touch.has-hover; }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { usage.press(); } }
        clicked => { root.clicked(); }
    }
    ShortcutMenu { action: "camera.lens"; }
    VerticalLayout {
        alignment: center;
        spacing: Theme.u(1);
        HorizontalLayout {
            alignment: center;
            spacing: Theme.u(0.5);
            Text {
                text: lens.number;
                font-family: Theme.font;
                font-size: Theme.body * 1.25;
                font-weight: Theme.w-value;
                color: on ? hue : Theme.ink;
            }
            Text {
                text: lens.unit;
                font-family: Theme.font;
                font-size: Theme.small;
                font-weight: Theme.w-label;
                color: on ? hue : Theme.ink2;
                vertical-alignment: bottom;
                height: Theme.u(9);
            }
        }
        if lens.rest != "": Text {
            text: lens.rest;
            font-family: Theme.font;
            font-size: Theme.small;
            color: on ? hue : Theme.ink2;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component CameraCard inherits Card {
    in property <bool> active;
    // A source that isn't a phone is picked: the card has nothing to do then
    in property <bool> phone-only-hidden;
    in property <[Lens]> lenses;
    in property <int> current-lens: -1;
    // Up to five tiles in a row, more lenses in rows as even as they can be
    in property <int> lens-columns: 1;
    // Why a segment can't be picked, shown when it's hovered
    in property <[string]> exposure-tips;
    in property <[string]> wb-tips;
    in property <[string]> focus-tips;
    in property <string> lens-placeholder;
    // What the lens can do, quietly in the header ("Full manual control"), with the details for a tooltip
    in property <string> info;
    in property <string> info-tip;
    in property <int> exposure-mode;
    in property <[bool]> exposure-disabled: [false, false];
    in property <bool> show-manual-exposure;
    // The stops the dials turn through, as they are written, and where the lens now is among them
    in property <[string]> iso-stops;
    in property <int> iso-index;
    in property <bool> iso-enabled;
    in property <[string]> shutter-stops;
    in property <int> shutter-index;
    in property <bool> shutter-enabled;
    in property <int> ae-comp;
    in property <int> ae-min: -8;
    in property <int> ae-max: 8;
    in property <string> ae-text: "0.0 EV";
    in property <int> wb-mode;
    in property <[bool]> wb-disabled: [false, false];
    in property <bool> show-manual-wb;
    in property <int> kelvin: 5500;
    in property <string> kelvin-text: "5500 K";
    in property <int> tint;
    in property <string> tint-text: "+0";
    in property <bool> wb-enabled;
    in property <int> focus-mode;
    in property <[bool]> focus-disabled: [false, true, false];
    in property <bool> show-manual-focus;
    in property <int> focus-pos;
    in property <string> focus-text: "∞";
    in property <bool> focus-enabled;
    in property <TileState> ois: { checked: true, enabled: true };
    in property <TileState> low-light;
    in property <TileState> black-level-lock: { enabled: true };
    in property <TileState> torch: { enabled: true };
    in property <int> noise-reduction: 1;
    in property <int> sharpening: 1;
    // What a segment says on hover where its word alone would be ambiguous
    in property <[string]> noise-tips;
    in property <[string]> sharpening-tips;

    callback lens-picked(int);
    callback exposure-picked(int);
    callback iso-picked(int);
    callback shutter-picked(int);
    callback ae-moved(float);
    callback wb-picked(int);
    callback kelvin-moved(float);
    callback tint-moved(float);
    callback focus-picked(int);
    callback focus-moved(float);
    callback ois-toggled(bool);
    callback low-light-toggled(bool);
    callback bll-toggled(bool);
    callback torch-toggled(bool);
    callback nr-picked(int);
    callback edge-picked(int);

    title: @tr("Camera");
    icon: Icons.camera;
    note: info;
    // dim_until_paired: faded and disabled until there's a phone
    opacity: active ? 1 : 0.4;
    enabled: active;
    visible: !phone-only-hidden;

    // Before the phone has told its lenses: dim tiles where they will be, so the card doesn't jump when they arrive
    if lenses.length == 0: RailRow {
        has-icon: false;
        HorizontalLayout {
            spacing: Theme.gap;
            for n in 3: Rectangle {
                height: Theme.u(27);
                horizontal-stretch: 1;
                border-radius: Theme.r-ctl;
                background: Theme.trough;
                if lens-placeholder != "": Tip { says: lens-placeholder; inert: true; }
            }
        }
    }
    if lenses.length > 0: RailRow {
        has-icon: false;
        Rectangle {
            property <length> tile-width: (self.width - (lens-columns - 1) * Theme.gap) / lens-columns;
            height: ceil(lenses.length / lens-columns) * Theme.u(30) - Theme.gap;
            for lens[i] in lenses: LensTile {
                x: mod(i, lens-columns) * (parent.tile-width + Theme.gap);
                y: floor(i / lens-columns) * Theme.u(30);
                width: parent.tile-width;
                lens: lens;
                hue: root.hue;
                on: i == current-lens;
                clicked => { lens-picked(i); }
            }
        }
    }

    RailRow {
        icon: Icons.exposure;
        label: @tr("Exposure");
        hue: root.hue;
        enabled: active;
        Segmented {
            hue: root.hue;
            shortcut: "camera.exposure_mode";
            label: @tr("Exposure");
            items: [@tr("Auto"), @tr("Manual")];
            disabled: [!active || exposure-disabled[0], !active || exposure-disabled[1]];
            tips: exposure-tips;
            current: exposure-mode;
            picked(i) => { exposure-picked(i); }
        }
    }
    // Always there, dim in Auto and lit in Manual
    RailRow {
        has-icon: false;
        enabled: active;
        HorizontalLayout {
            spacing: Theme.gap;
            Dial {
                shortcut: "camera.iso";
                label: "ISO";
                hue: root.hue;
                enabled: active && iso-enabled;
                stops: iso-stops;
                current: iso-index;
                tip: iso-enabled ? "ISO" : exposure-tips[1] != "" ? exposure-tips[1] : @tr("Set Exposure to Manual to use this");
                moved(i) => { iso-picked(i); }
            }
            Dial {
                shortcut: "camera.shutter";
                label: @tr("Shutter");
                hue: root.hue;
                enabled: active && shutter-enabled;
                stops: shutter-stops;
                current: shutter-index;
                tip: shutter-enabled ? @tr("Shutter") : exposure-tips[1] != "" ? exposure-tips[1] : @tr("Set Exposure to Manual to use this");
                moved(i) => { shutter-picked(i); }
            }
        }
    }
    RailRow {
        icon: Icons.sun;
        label: @tr("Brightness");
        hue: root.hue;
        enabled: active;
        Slider {
            shortcut: "camera.compensation";
            label: @tr("Brightness");
            hue: root.hue;
            enabled: active;
            minimum: ae-min;
            maximum: ae-max;
            step: 1;
            value: ae-comp;
            readout: ae-text;
            has-default: true;
            default-value: 0;
            tip: @tr("Brightness");
            tip-detail: @tr("Double-click to reset");
            moved(v) => { ae-moved(v); }
        }
    }
    RailRow {
        icon: Icons.thermometer;
        label: @tr("White balance");
        hue: root.hue;
        enabled: active;
        Segmented {
            hue: root.hue;
            shortcut: "camera.wb_mode";
            label: @tr("White balance");
            items: [@tr("Auto"), @tr("Manual")];
            disabled: [!active || wb-disabled[0], !active || wb-disabled[1]];
            tips: wb-tips;
            current: wb-mode;
            picked(i) => { wb-picked(i); }
        }
    }
    // Two ordinary sliders: colour correction never snaps
    RailRow {
        has-icon: false;
        enabled: active;
        Slider {
            shortcut: "camera.temperature";
            label: @tr("Temperature");
            hue: root.hue;
            enabled: active && wb-enabled;
            fill: "temperature";
            minimum: 2000;
            maximum: 10000;
            step: 100;
            value: kelvin;
            readout: kelvin-text;
            has-default: true;
            default-value: 5500;
            tip: wb-enabled || wb-tips[1] == "" ? @tr("Temperature") : wb-tips[1];
            tip-detail: wb-enabled ? @tr("Double-click to reset") : wb-tips[1] == "" ? @tr("Set White balance to Manual to use this") : "";
            moved(v) => { kelvin-moved(v); }
        }
    }
    RailRow {
        has-icon: false;
        enabled: active;
        Slider {
            shortcut: "camera.tint";
            label: @tr("Tint");
            hue: root.hue;
            enabled: active && wb-enabled;
            fill: "tint";
            minimum: -150;
            maximum: 150;
            step: 1;
            value: tint;
            readout: tint-text;
            has-default: true;
            default-value: 0;
            tip: wb-enabled || wb-tips[1] == "" ? @tr("Tint") : wb-tips[1];
            tip-detail: wb-enabled ? @tr("Double-click to reset") : wb-tips[1] == "" ? @tr("Set White balance to Manual to use this") : "";
            moved(v) => { tint-moved(v); }
        }
    }
    RailRow {
        icon: Icons.focus;
        label: @tr("Focus");
        hue: root.hue;
        enabled: active;
        Segmented {
            hue: root.hue;
            shortcut: "camera.focus_mode";
            label: @tr("Focus");
            items: [@tr("Auto"), @tr("focus tap" => "Tap"), @tr("focus" => "Manual")];
            disabled: [!active || focus-disabled[0], !active || focus-disabled[1], !active || focus-disabled[2]];
            tips: focus-tips;
            current: focus-mode;
            picked(i) => { focus-picked(i); }
        }
    }
    RailRow {
        has-icon: false;
        enabled: active;
        Slider {
            shortcut: "camera.focus";
            label: @tr("Distance");
            hue: root.hue;
            enabled: active && focus-enabled;
            minimum: 0;
            maximum: 1000;
            step: 1;
            value: focus-pos;
            readout: focus-text;
            tip: focus-enabled || focus-tips[2] == "" ? @tr("Distance") : focus-tips[2];
            tip-detail: focus-enabled ? "" : focus-tips[2] == "" ? @tr("Set Focus to Manual to use this") : "";
            moved(v) => { focus-moved(v); }
        }
    }
    RailRow {
        icon: Icons.sliders;
        label: @tr("Image");
        hue: root.hue;
        enabled: active;
        VerticalLayout {
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: Theme.gap;
                ToggleTile {
                    icon: Icons.stabilize;
                    shortcut: "camera.stabilization";
                    text: @tr("Stabilization");
                    tip: ois.tip;
                    hue: root.hue;
                    enabled: active && ois.enabled;
                    checked: ois.checked;
                    toggled(on) => { ois-toggled(on); }
                }
                ToggleTile {
                    icon: Icons.moon;
                    shortcut: "camera.low_light";
                    text: @tr("Low light");
                    tip: low-light.tip;
                    hue: root.hue;
                    enabled: active && low-light.enabled;
                    checked: low-light.checked;
                    toggled(on) => { low-light-toggled(on); }
                }
            }
            HorizontalLayout {
                spacing: Theme.gap;
                ToggleTile {
                    icon: Icons.lock;
                    shortcut: "camera.black_level_lock";
                    text: @tr("Black level lock");
                    tip: black-level-lock.tip;
                    hue: root.hue;
                    enabled: active && black-level-lock.enabled;
                    checked: black-level-lock.checked;
                    toggled(on) => { bll-toggled(on); }
                }
                ToggleTile {
                    icon: Icons.torch;
                    shortcut: "camera.torch";
                    text: @tr("Torch");
                    tip: torch.tip;
                    hue: root.hue;
                    enabled: active && torch.enabled;
                    checked: torch.checked;
                    toggled(on) => { torch-toggled(on); }
                }
            }
        }
    }
    RailRow {
        icon: Icons.grain;
        label: @tr("Noise reduction");
        tip: @tr("Smooths out grain in the picture");
        hue: root.hue;
        enabled: active;
        Segmented {
            hue: root.hue;
            shortcut: "camera.noise_reduction";
            label: @tr("Noise reduction");
            items: [@tr("Off"), @tr("Fast"), @tr("High quality")];
            disabled: [!active, !active, !active];
            tips: noise-tips;
            current: noise-reduction;
            picked(i) => { nr-picked(i); }
        }
    }
    RailRow {
        icon: Icons.sharpen;
        label: @tr("Sharpening");
        tip: @tr("Crisps up the edges in the picture");
        hue: root.hue;
        enabled: active;
        Segmented {
            hue: root.hue;
            shortcut: "camera.sharpening";
            label: @tr("Sharpening");
            items: [@tr("Off"), @tr("Fast"), @tr("High quality")];
            disabled: [!active, !active, !active];
            tips: sharpening-tips;
            current: sharpening;
            picked(i) => { edge-picked(i); }
        }
    }
}
