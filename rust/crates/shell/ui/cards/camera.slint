// The Camera card, built from ui-kit's widgets: an icon rail, then one column of controls.

import { Theme, Icons, Icon, Tip, Card, RailRow, Segmented, Slider, ToggleTile, Dial, ShortcutMenu, Arrival, PictureSegmented, Unfold, Fade } from "@ui-kit/ui-kit.slint";

export struct Lens {
    id: string,
    number: string,
    unit: string,
    rest: string,
    name: string,
}

// A toggle tile as the card holds it: on or off, usable, and why not.
export struct TileState {
    checked: bool,
    enabled: bool,
    tip: string,
}

// What a lens tile shows: its number and unit over its focal length. The tile itself and its outline are the PictureSegmented's.
component LensArt inherits Rectangle {
    in property <Lens> lens;
    in property <bool> on;
    in property <color> hue;
    VerticalLayout {
        alignment: center;
        spacing: Theme.u(1);
        HorizontalLayout {
            alignment: center;
            spacing: Theme.u(0.5);
            Text {
                text: lens.number;
                font-family: Theme.font;
                font-size: Theme.body * 1.25;
                font-weight: Theme.w-value;
                color: on ? hue : Theme.ink;
            }
            Text {
                text: lens.unit;
                font-family: Theme.font;
                font-size: Theme.small;
                font-weight: Theme.w-label;
                color: on ? hue : Theme.ink2;
                vertical-alignment: bottom;
                height: Theme.u(9);
            }
        }
        // Always there, empty or not, so the focal length sits on the same baseline in every tile
        Text {
            text: lens.rest;
            height: Theme.small * 1.3;
            font-family: Theme.font;
            font-size: Theme.small;
            color: on ? hue : Theme.ink2;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// The lens tiles while the row is changing: up to five slots, each one a spring of how present its tile is. A tile that comes grows from nothing,
// one that goes shrinks to nothing and fades, the others make room, and every tile's drawing fades in or out with it, all at once; a change
// mid-way turns round from where it is. The tiles are as wide as the row leaves them (the same gaps and widths as the PictureSegmented's), so when
// everything has settled the real control takes the row over with nothing to see. Before the phone has said, three dim tiles are the row.
component LensFlow inherits Rectangle {
    in property <[Lens]> lenses;
    in property <int> current: -1;
    in property <color> hue;
    in property <string> placeholder;
    // How many tiles the row has room for: the lenses, or three dim ones until the phone has said
    property <int> count: lenses.length > 0 ? lenses.length : 3;
    // What each tile was, for as long as it is leaving
    property <Lens> h0;
    property <Lens> h1;
    property <Lens> h2;
    property <Lens> h3;
    property <Lens> h4;
    property <[Lens]> held: [h0, h1, h2, h3, h4];
    function keep() {
        if (lenses.length > 0) { h0 = lenses[0]; }
        if (lenses.length > 1) { h1 = lenses[1]; }
        if (lenses.length > 2) { h2 = lenses[2]; }
        if (lenses.length > 3) { h3 = lenses[3]; }
        if (lenses.length > 4) { h4 = lenses[4]; }
    }
    init => { keep(); }
    changed lenses => { keep(); }
    s0 := Unfold { open: root.count > 0; }
    s1 := Unfold { open: root.count > 1; }
    s2 := Unfold { open: root.count > 2; }
    s3 := Unfold { open: root.count > 3; }
    s4 := Unfold { open: root.count > 4; }
    d0 := Fade { shown: root.lenses.length > 0; }
    d1 := Fade { shown: root.lenses.length > 1; }
    d2 := Fade { shown: root.lenses.length > 2; }
    d3 := Fade { shown: root.lenses.length > 3; }
    d4 := Fade { shown: root.lenses.length > 4; }
    property <[float]> w: [s0.value, s1.value, s2.value, s3.value, s4.value];
    property <[float]> drawn: [d0.value, d1.value, d2.value, d3.value, d4.value];
    // Everything has arrived where it was going: the real control can take over
    out property <bool> settled: abs(w[0] - (count > 0 ? 1 : 0)) < 0.004 && abs(w[1] - (count > 1 ? 1 : 0)) < 0.004 && abs(w[2] - (count > 2 ? 1 : 0)) < 0.004
        && abs(w[3] - (count > 3 ? 1 : 0)) < 0.004 && abs(w[4] - (count > 4 ? 1 : 0)) < 0.004
        && abs(drawn[0] - (lenses.length > 0 ? 1 : 0)) < 0.004 && abs(drawn[1] - (lenses.length > 1 ? 1 : 0)) < 0.004 && abs(drawn[2] - (lenses.length > 2 ? 1 : 0)) < 0.004
        && abs(drawn[3] - (lenses.length > 3 ? 1 : 0)) < 0.004 && abs(drawn[4] - (lenses.length > 4 ? 1 : 0)) < 0.004;
    // The gap between a tile and the next is as present as the smaller of the two, so the row always adds up to its width
    property <[length]> gaps: [Theme.gap * min(w[0], w[1]), Theme.gap * min(w[1], w[2]), Theme.gap * min(w[2], w[3]), Theme.gap * min(w[3], w[4])];
    property <float> total: max(0.001, w[0] + w[1] + w[2] + w[3] + w[4]);
    property <length> unit: (root.width - gaps[0] - gaps[1] - gaps[2] - gaps[3]) / total;
    property <[length]> xs: [0px, unit * w[0] + gaps[0], unit * (w[0] + w[1]) + gaps[0] + gaps[1], unit * (w[0] + w[1] + w[2]) + gaps[0] + gaps[1] + gaps[2], unit * (w[0] + w[1] + w[2] + w[3]) + gaps[0] + gaps[1] + gaps[2] + gaps[3]];
    height: Theme.u(27);
    for k in 5: Rectangle {
        x: xs[k];
        width: unit * w[k];
        height: parent.height;
        border-radius: Theme.r-ctl;
        clip: true;
        background: root.current == k ? Theme.tint(root.hue) : Theme.raise.mix(Theme.trough, drawn[k]);
        opacity: clamp(w[k] * 1.4 - 0.2, 0, 1);
        // Only while there is something to draw (the tile has a lens, or is fading out)
        if k < root.lenses.length || drawn[k] > 0.002: LensArt {
            opacity: drawn[k];
            lens: k < root.lenses.length ? root.lenses[k] : root.held[k];
            hue: root.hue;
            on: root.current == k;
        }
    }
    // The picked one's outline while the tiles move, where the control's own will be
    if current >= 0 && current < count: Rectangle {
        x: xs[current];
        width: unit * w[current];
        height: parent.height;
        border-radius: Theme.r-ctl;
        border-width: Theme.stroke;
        border-color: root.hue;
    }
    if lenses.length == 0 && placeholder != "": Tip { says: @tr("Lenses"); detail: placeholder; inert: true; }
}

export component CameraCard inherits Card {
    in property <bool> active;
    idle: !active;
    // A source that isn't a phone is picked: the card has nothing to do then
    in property <bool> phone-only-hidden;
    in property <[Lens]> lenses;
    in property <[string]> lens-names;
    in property <int> current-lens: -1;
    // Up to five tiles in a row, more lenses in rows as even as they can be
    in property <int> lens-columns: 1;
    // Why a segment can't be picked: the tooltip body of its option, shown when it's hovered
    in property <[string]> exposure-tips;
    in property <[string]> wb-tips;
    in property <[string]> focus-tips;
    in property <string> lens-placeholder;
    // What the lens can do, quietly in the header ("Full manual control"), with the details for a tooltip
    in property <string> info;
    in property <string> info-tip;
    in property <int> exposure-mode;
    in property <[bool]> exposure-disabled: [false, false];
    in property <bool> show-manual-exposure;
    // The stops the dials turn through, as they are written, and where the lens now is among them
    in property <[string]> iso-stops;
    in property <int> iso-index;
    in property <bool> iso-enabled;
    in property <[string]> shutter-stops;
    in property <int> shutter-index;
    in property <bool> shutter-enabled;
    in property <int> ae-comp;
    in property <int> ae-min: -8;
    in property <int> ae-max: 8;
    in property <string> ae-text: "0.0 EV";
    in property <int> wb-mode;
    in property <[bool]> wb-disabled: [false, false];
    in property <bool> show-manual-wb;
    in property <int> kelvin: 5500;
    in property <string> kelvin-text: "5500 K";
    in property <int> tint;
    in property <string> tint-text: "+0";
    in property <bool> wb-enabled;
    in property <int> focus-mode;
    in property <[bool]> focus-disabled: [false, true, false];
    in property <bool> show-manual-focus;
    in property <int> focus-pos;
    in property <string> focus-text: "∞";
    in property <bool> focus-enabled;
    in property <TileState> ois: { checked: true, enabled: true };
    in property <TileState> low-light;
    in property <TileState> black-level-lock: { enabled: true };
    in property <TileState> torch: { enabled: true };
    in property <int> noise-reduction: 1;
    in property <int> sharpening: 1;
    // What each of Off, Fast and High quality does, for the tooltip body
    in property <[string]> noise-tip-details;
    in property <[string]> sharpening-tip-details;
    property <[string]> mode-names: [@tr("Off"), @tr("Fast"), @tr("High quality")];

    callback lens-picked(int);
    callback exposure-picked(int);
    callback iso-picked(int);
    callback shutter-picked(int);
    callback ae-moved(float);
    callback wb-picked(int);
    callback kelvin-moved(float);
    callback tint-moved(float);
    callback focus-picked(int);
    callback focus-moved(float);
    callback ois-toggled(bool);
    callback low-light-toggled(bool);
    callback bll-toggled(bool);
    callback torch-toggled(bool);
    callback nr-picked(int);
    callback edge-picked(int);

    title: @tr("Camera");
    tip: @tr("Exposure, white balance, focus, lenses and the phone camera's other settings.");
    icon: Icons.camera;
    // dim_until_paired: faded and disabled until there's a phone
    enabled: active;
    visible: !phone-only-hidden;

    // The lens tiles: dim ones before the phone has told its lenses, and the row changes with motion when the real count arrives or changes
    // (LensFlow draws it while anything moves, and the PictureSegmented, the one control with one outline, takes over once it has settled).
    // More than five lenses go in rows of the control's own, with no flow.
    RailRow {
        has-icon: false;
        Rectangle {
            // The tiles' rows: one, or as many as the control's own grid has
            property <int> rows: grid ? floor((lenses.length + max(1, lens-columns) - 1) / max(1, lens-columns)) : 1;
            height: rows * Theme.u(27) + (rows - 1) * Theme.gap;
            // More than five lenses, or fewer columns than lenses, are rows of the control's own: no flow
            property <bool> grid: lenses.length > 5 || lens-columns < lenses.length;
            property <bool> control-shown: grid || (lenses.length > 0 && flow.settled);
            flow := LensFlow {
                width: parent.width;
                visible: !control-shown;
                lenses: root.lenses;
                current: current-lens;
                hue: root.hue;
                placeholder: lens-placeholder;
            }
            // The lenses are one choice, laid out in columns, with one outline that goes across and down between them
            if control-shown: lens-tiles := PictureSegmented {
                width: parent.width;
                label: @tr("Lens");
                items: lens-names;
                disabled: [false, false, false, false, false, false, false, false, false];
                tips: lens-names;
                shortcut: "camera.lens";
                columns: lens-columns;
                hue: root.hue;
                tile-height: Theme.u(27);
                current: current-lens;
                picked(i) => { lens-picked(i); }
                for lens[i] in lenses: Rectangle {
                    x: lens-tiles.x-of(i);
                    y: lens-tiles.y-of(i);
                    width: lens-tiles.cell-width;
                    height: lens-tiles.art-height;
                    LensArt {
                        lens: lens;
                        hue: root.hue;
                        on: lens-tiles.shown == i;
                    }
                }
            }
        }
    }

    RailRow {
        icon: Icons.exposure;
        label: @tr("Exposure");
        tip-detail: @tr("Let the phone pick the exposure or set ISO and shutter speed yourself.");
        hue: root.hue;
        enabled: active;
        changed: exposure-mode != 0;
        Segmented {
            hue: root.hue;
            shortcut: "camera.exposure_mode";
            label: @tr("Exposure");
            items: [@tr("Auto"), @tr("Manual")];
            disabled: [!active || exposure-disabled[0], !active || exposure-disabled[1]];
            tips: [@tr("Auto"), @tr("Manual")];
            tip-details: ["", exposure-tips[1]];
            current: exposure-mode;
            picked(i) => { exposure-picked(i); }
        }
    }
    // Always there, dim in Auto and lit in Manual. One above the other: side by side a dial is too narrow to say 1/8000 or 12800 in full
    RailRow {
        icon: Icons.grain;
        label: "ISO";
        tip-detail: iso-enabled ? @tr("Higher ISO makes the picture brighter but grainier.") : exposure-tips[1] != "" ? exposure-tips[1] : @tr("Set Exposure to Manual to use this");
        hue: root.hue;
        enabled: active && iso-enabled;
        Dial {
            shortcut: "camera.iso";
            label: "ISO";
            hue: root.hue;
            enabled: active && iso-enabled;
            stops: iso-stops;
            current: iso-index;
            tip: "ISO";
            tip-detail: iso-enabled ? @tr("Higher ISO makes the picture brighter but grainier.") : exposure-tips[1] != "" ? exposure-tips[1] : @tr("Set Exposure to Manual to use this");
            moved(i) => { iso-picked(i); }
        }
    }
    RailRow {
        icon: Icons.timer;
        label: @tr("Shutter");
        tip-detail: shutter-enabled ? @tr("Slower shutter speeds make the picture brighter but blur movement.") : exposure-tips[1] != "" ? exposure-tips[1] : @tr("Set Exposure to Manual to use this");
        hue: root.hue;
        enabled: active && shutter-enabled;
        Dial {
            shortcut: "camera.shutter";
            label: @tr("Shutter");
            hue: root.hue;
            enabled: active && shutter-enabled;
            stops: shutter-stops;
            current: shutter-index;
            tip: @tr("Shutter");
            tip-detail: shutter-enabled ? @tr("Slower shutter speeds make the picture brighter but blur movement.") : exposure-tips[1] != "" ? exposure-tips[1] : @tr("Set Exposure to Manual to use this");
            moved(i) => { shutter-picked(i); }
        }
    }
    RailRow {
        icon: Icons.sun;
        label: @tr("Brightness");
        tip-detail: @tr("Make the picture brighter or darker than the phone's automatic exposure.");
        hue: root.hue;
        enabled: active;
        changed: ae-comp != 0;
        Slider {
            shortcut: "camera.compensation";
            label: @tr("Brightness");
            hue: root.hue;
            enabled: active;
            minimum: ae-min;
            maximum: ae-max;
            step: 1;
            value: ae-comp;
            readout: ae-text;
            marks: [0];
            has-default: true;
            default-value: 0;
            tip: @tr("Brightness");
            tip-detail: @tr("Make the picture brighter or darker than the phone's automatic exposure.");
            tip-hint: @tr("Double-click to reset");
            moved(v) => { ae-moved(v); }
        }
    }
    RailRow {
        icon: Icons.thermometer;
        label: @tr("White balance");
        tip-detail: @tr("Let the phone set the white balance or set it yourself.");
        hue: root.hue;
        enabled: active;
        changed: wb-mode != 0 || kelvin != 5500 || tint != 0;
        Segmented {
            hue: root.hue;
            shortcut: "camera.wb_mode";
            label: @tr("White balance");
            items: [@tr("Auto"), @tr("Manual")];
            disabled: [!active || wb-disabled[0], !active || wb-disabled[1]];
            tips: [@tr("Auto"), @tr("Manual")];
            tip-details: ["", wb-tips[1]];
            current: wb-mode;
            picked(i) => { wb-picked(i); }
        }
    }
    // Two ordinary sliders: colour correction never snaps
    RailRow {
        has-icon: false;
        enabled: active;
        Slider {
            shortcut: "camera.temperature";
            label: @tr("Temperature");
            hue: root.hue;
            enabled: active && wb-enabled;
            fill: "temperature";
            minimum: 2000;
            maximum: 10000;
            step: 100;
            value: kelvin;
            readout: kelvin-text;
            has-default: true;
            default-value: 5500;
            tip: @tr("Temperature");
            tip-detail: wb-enabled ? @tr("Make colours warmer or cooler.") : wb-tips[1] != "" ? wb-tips[1] : @tr("Set White balance to Manual to use this");
            tip-hint: wb-enabled ? @tr("Double-click to reset") : "";
            moved(v) => { kelvin-moved(v); }
        }
    }
    RailRow {
        has-icon: false;
        enabled: active;
        Slider {
            shortcut: "camera.tint";
            label: @tr("Tint");
            hue: root.hue;
            enabled: active && wb-enabled;
            fill: "tint";
            minimum: -150;
            maximum: 150;
            step: 1;
            value: tint;
            readout: tint-text;
            has-default: true;
            default-value: 0;
            tip: @tr("Tint");
            tip-detail: wb-enabled ? @tr("Shift colours towards green or magenta.") : wb-tips[1] != "" ? wb-tips[1] : @tr("Set White balance to Manual to use this");
            tip-hint: wb-enabled ? @tr("Double-click to reset") : "";
            moved(v) => { tint-moved(v); }
        }
    }
    RailRow {
        icon: Icons.focus;
        label: @tr("Focus");
        tip-detail: @tr("Let the phone focus automatically, click the preview to focus on a point or set the distance yourself.");
        hue: root.hue;
        enabled: active;
        changed: focus-mode != 0;
        Segmented {
            hue: root.hue;
            shortcut: "camera.focus_mode";
            label: @tr("Focus");
            items: [@tr("Auto"), @tr("focus tap" => "Tap"), @tr("focus" => "Manual")];
            disabled: [!active || focus-disabled[0], !active || focus-disabled[1], !active || focus-disabled[2]];
            tips: [@tr("Auto"), @tr("focus tap" => "Tap"), @tr("focus" => "Manual")];
            tip-details: ["", focus-tips[1], focus-tips[2]];
            current: focus-mode;
            picked(i) => { focus-picked(i); }
        }
    }
    RailRow {
        has-icon: false;
        enabled: active;
        Slider {
            shortcut: "camera.focus";
            label: @tr("Distance");
            hue: root.hue;
            enabled: active && focus-enabled;
            minimum: 0;
            maximum: 1000;
            step: 1;
            value: focus-pos;
            readout: focus-text;
            tip: @tr("Distance");
            tip-detail: focus-enabled ? @tr("How far away the camera focuses.") : focus-tips[2] != "" ? focus-tips[2] : @tr("Set Focus to Manual to use this");
            moved(v) => { focus-moved(v); }
        }
    }
    RailRow {
        icon: Icons.sliders;
        label: @tr("Image");
        hue: root.hue;
        enabled: active;
        changed: !ois.checked || low-light.checked || black-level-lock.checked || torch.checked;
        VerticalLayout {
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: Theme.gap;
                ToggleTile {
                    icon: Icons.stabilize;
                    shortcut: "camera.stabilization";
                    text: @tr("Stabilization");
                    tip: @tr("Stabilisation");
                    tip-detail: ois.tip;
                    hue: root.hue;
                    enabled: active && ois.enabled;
                    checked: ois.checked;
                    toggled(on) => { ois-toggled(on); }
                }
                ToggleTile {
                    icon: Icons.moon;
                    shortcut: "camera.low_light";
                    text: @tr("Low light");
                    tip: @tr("Low light");
                    tip-detail: low-light.tip;
                    hue: root.hue;
                    enabled: active && low-light.enabled;
                    checked: low-light.checked;
                    toggled(on) => { low-light-toggled(on); }
                }
            }
            HorizontalLayout {
                spacing: Theme.gap;
                ToggleTile {
                    icon: Icons.lock;
                    shortcut: "camera.black_level_lock";
                    text: @tr("Black level lock");
                    tip: @tr("Black level lock");
                    tip-detail: black-level-lock.tip;
                    hue: root.hue;
                    enabled: active && black-level-lock.enabled;
                    checked: black-level-lock.checked;
                    toggled(on) => { bll-toggled(on); }
                }
                ToggleTile {
                    icon: Icons.torch;
                    shortcut: "camera.torch";
                    text: @tr("Torch");
                    tip: @tr("Torch");
                    tip-detail: torch.tip;
                    hue: root.hue;
                    enabled: active && torch.enabled;
                    checked: torch.checked;
                    toggled(on) => { torch-toggled(on); }
                }
            }
        }
    }
    RailRow {
        icon: Icons.grain;
        label: @tr("Noise reduction");
        tip-detail: @tr("Smooth out grain in the picture.");
        hue: root.hue;
        enabled: active;
        changed: noise-reduction != 1;
        Segmented {
            hue: root.hue;
            shortcut: "camera.noise_reduction";
            label: @tr("Noise reduction");
            items: mode-names;
            disabled: [!active, !active, !active];
            tips: mode-names;
            tip-details: noise-tip-details;
            current: noise-reduction;
            picked(i) => { nr-picked(i); }
        }
    }
    RailRow {
        icon: Icons.sharpen;
        label: @tr("Sharpening");
        tip-detail: @tr("Make edges look crisper.");
        hue: root.hue;
        enabled: active;
        changed: sharpening != 1;
        Segmented {
            hue: root.hue;
            shortcut: "camera.sharpening";
            label: @tr("Sharpening");
            items: mode-names;
            disabled: [!active, !active, !active];
            tips: mode-names;
            tip-details: sharpening-tip-details;
            current: sharpening;
            picked(i) => { edge-picked(i); }
        }
    }
}
