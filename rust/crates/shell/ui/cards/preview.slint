// The video stage (plugins/preview.py): the letterboxed picture and the toolbar under it, no card chrome.

import { Theme, Icons, Button } from "@ui-kit/ui-kit.slint";
import { PreviewMarks, PreviewPick, LensOutline, SkeletonLine } from "../../shell/preview.slint";

// A shape a plugin draws on the preview (add_preview_layer), in px of the picture's rect
export struct LayerPath { commands: string, stroke: color, width: length, fill: color, evenodd: bool }
export struct LayerText { x: length, y: length, text: string, color: color, size: length }

export component PreviewCard inherits Rectangle {
    in property <string> fold-key;
    in property <color> hue;
    in property <bool> visible-card: true;
    // The window draws frames straight into these (preview.rs); the plugin only clears them
    in property <image> frame;
    in property <bool> has-frame;
    // What plugins draw over the frame (Cinema tools' guides and scope), the frame's size
    in property <image> overlay;
    in property <bool> has-overlay;
    in property <[LayerPath]> layer-paths;
    in property <[LayerText]> layer-texts;
    // What the stage says without a frame, and whether it's the camera-off note with its icon
    in property <string> stage-text;
    in property <bool> camera-off;
    in property <bool> showing: true;
    in property <string> toggle-text;
    in property <bool> camera-on: true;
    in property <bool> camera-enabled: true;
    in property <string> camera-tip;
    // The pop-out window is open (the window opens it, preview.rs), and how often Pop out asked to bring it forward
    in property <bool> popout;
    in property <int> popout-asks;
    // Which stream this is, counted: the window forgets what it last painted when this moves
    in property <int> stream-gen;
    // The stage's size in logical px, for the window to paint frames at
    out property <length> stage-width: surface.width;
    out property <length> stage-height: surface.height;
    // A pick under way on the picture (overlays.rs): what the window draws for it, in px of the picture's rect
    in property <bool> picking;
    in property <string> pick-dim;
    in property <string> pick-line;
    in property <string> pick-handles;
    in property <string> pick-hint;
    in property <string> pick-cursor;
    // Where the picture sits on the stage (image-fit contain)
    property <float> aspect: has-frame && frame.height > 0 ? frame.width / frame.height : surface.width / max(1px, surface.height);
    out property <length> pic-width: min(surface.width, surface.height * aspect);
    out property <length> pic-height: pic-width / max(aspect, 0.01);
    property <length> pic-x: (surface.width - pic-width) / 2;
    property <length> pic-y: (surface.height - pic-height) / 2;
    // The phone's other lenses and the people vision finds, drawn over the picture (preview.slint). warped: a plugin moved
    // the picture, so they'd land in the wrong place
    in property <[LensOutline]> lens-boxes;
    in property <float> boxes-opacity;
    in property <[SkeletonLine]> skeleton-lines;
    in property <bool> warped;
    in property <bool> lenses-enabled;
    in property <bool> lenses-on;
    in property <bool> skeleton-shown;
    in property <bool> skeleton-on;
    in property <bool> smooth-on;
    // Clicks and drags on the picture (FrameLabel): what the mouse would do here, and the square where it last focused
    in property <string> stage-cursor;
    in property <bool> marker-shown;
    in property <float> marker-u;
    in property <float> marker-v;
    callback view-pointer(string, float, float, float, float);
    callback view-wheel(float, float, float);
    callback pick-pointer(string, float, float, float, float);
    callback pick-key(string);
    callback toggle;
    callback camera-clicked;
    callback pop-out;
    callback popout-closed;
    callback lenses-clicked;
    callback skeleton-clicked;
    callback smooth-clicked;

    visible: visible-card;
    preferred-height: 240px + 2px + 55px;
    background: Theme.surface-sunk;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    clip: true;

    VerticalLayout {
        padding: 1px;
        spacing: 0px;
        surface := Rectangle {
            min-height: 240px;
            vertical-stretch: 1;
            background: Theme.surface-sunk;
            border-radius: 11px;
            accessible-role: image;
            accessible-label: @tr("Preview");
            if has-frame: Image {
                width: parent.width;
                height: parent.height;
                source: frame;
                image-fit: contain;
                image-rendering: smooth;
            }
            if has-frame && has-overlay: Image {
                width: parent.width;
                height: parent.height;
                source: overlay;
                image-fit: contain;
                image-rendering: smooth;
            }
            if has-frame && (layer-paths.length > 0 || layer-texts.length > 0): Rectangle {
                x: pic-x;
                y: pic-y;
                width: pic-width;
                height: pic-height;
                for shape in layer-paths: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: shape.commands;
                    stroke: shape.stroke;
                    stroke-width: shape.width;
                    fill: shape.fill;
                    fill-rule: shape.evenodd ? FillRule.evenodd : FillRule.nonzero;
                }
                for t in layer-texts: Text {
                    x: t.x;
                    y: t.y;
                    text: t.text;
                    color: t.color;
                    font-family: Theme.font;
                    font-size: t.size;
                }
            }
            if has-frame && !warped: PreviewMarks {
                x: pic-x;
                y: pic-y;
                width: pic-width;
                height: pic-height;
                skeleton-lines: skeleton-lines;
                lens-boxes: lens-boxes;
                boxes-opacity: boxes-opacity;
                bone: Theme.plugin-hue("vision");
                held-out: Theme.warn;
                font: Theme.font;
            }
            if !has-frame: VerticalLayout {
                alignment: center;
                spacing: 12px;
                if camera-off: HorizontalLayout {
                    alignment: center;
                    Image { source: Icons.v-camera-off; colorize: Theme.accent; width: 52px; height: 52px; }
                }
                Text {
                    text: stage-text;
                    horizontal-alignment: center;
                    font-family: Theme.font;
                    font-size: camera-off ? 15px : 13px;
                    color: camera-off ? Theme.accent-soft : Theme.text-faint;
                }
            }
            if has-frame: TouchArea {
                mouse-cursor: stage-cursor == "cross" ? MouseCursor.crosshair : stage-cursor == "grab" ? MouseCursor.grab : stage-cursor == "grabbing" ? MouseCursor.grabbing : MouseCursor.default;
                pointer-event(e) => {
                    let kind = e.kind == PointerEventKind.cancel ? "cancel"
                        : e.kind == PointerEventKind.move ? (self.pressed ? "move" : "")
                        : e.button != PointerEventButton.left ? ""
                        : e.kind == PointerEventKind.down ? "down" : e.kind == PointerEventKind.up ? "up" : "";
                    if kind != "" {
                        root.view-pointer(kind, (self.mouse-x - pic-x) / max(pic-width, 1px), (self.mouse-y - pic-y) / max(pic-height, 1px), pic-width / 1px, pic-height / 1px);
                    }
                }
                scroll-event(e) => {
                    let u = (self.mouse-x - pic-x) / max(pic-width, 1px);
                    let v = (self.mouse-y - pic-y) / max(pic-height, 1px);
                    if u < 0 || u > 1 || v < 0 || v > 1 || e.delta-y == 0 {
                        return reject;
                    }
                    root.view-wheel(u, v, e.delta-y / 60px); // a notch of the wheel is 60 px here
                    accept
                }
            }
            if has-frame && marker-shown: Rectangle {
                x: pic-x + marker-u * pic-width - 22px;
                y: pic-y + marker-v * pic-height - 22px;
                width: 44px;
                height: 44px;
                border-width: 2px;
                border-color: Theme.accent-soft;
                border-radius: 6px;
            }
            if picking: PreviewPick {
                width: parent.width;
                height: parent.height;
                pic-x: pic-x;
                pic-y: pic-y;
                pic-width: pic-width;
                pic-height: pic-height;
                pick-dim: pick-dim;
                pick-line: pick-line;
                pick-handles: pick-handles;
                pick-hint: pick-hint;
                pick-cursor: pick-cursor;
                font: Theme.font;
                pick-pointer(kind, u, v, w, h) => { root.pick-pointer(kind, u, v, w, h); }
                pick-key(key) => { root.pick-key(key); }
            }
        }
        Rectangle {
            background: Theme.surface;
            Rectangle { y: 0; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 9px;
                padding-bottom: 10px;
                spacing: 8px;
                Button {
                    text: toggle-text;
                    role: "quiet";
                    min-width: 78px;
                    has-icon: true;
                    icon: showing ? Icons.eye-off : Icons.eye;
                    icon-tint: Theme.text-dim;
                    enabled: !popout;
                    tip: @tr("Stop drawing this preview. The camera output doesn't change.");
                    clicked => { root.toggle(); }
                }
                Button {
                    width: 36px;
                    role: "quiet";
                    padding-x: 0px;
                    has-icon: true;
                    icon: camera-on ? Icons.v-camera : Icons.v-camera-off;
                    icon-size: 16px;
                    icon-tint: camera-on ? Theme.text-dim : Theme.accent;
                    enabled: camera-enabled;
                    tip: camera-tip;
                    accessible-label: @tr("Phone camera");
                    clicked => { root.camera-clicked(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if skeleton-shown: Button {
                    width: 36px;
                    role: "quiet";
                    padding-x: 0px;
                    has-icon: true;
                    icon: Icons.skeleton;
                    icon-size: 16px;
                    icon-tint: skeleton-on ? Theme.accent-soft : Theme.text-dim;
                    tip: @tr("Draw the skeleton MediaPipe finds. Doesn't show in the camera output.");
                    accessible-label: @tr("Skeleton");
                    clicked => { root.skeleton-clicked(); }
                }
                Button {
                    width: 36px;
                    role: "quiet";
                    padding-x: 0px;
                    has-icon: true;
                    icon: Icons.v-lenses;
                    icon-size: 16px;
                    icon-tint: !lenses-enabled ? Theme.text-disabled : lenses-on ? Theme.accent-soft : Theme.text-dim;
                    enabled: lenses-enabled;
                    tip: @tr("Keep showing what the phone's longer lenses see. Doesn't show in the camera output.");
                    accessible-label: @tr("Lens outlines");
                    clicked => { root.lenses-clicked(); }
                }
                Button {
                    text: @tr("Smooth");
                    role: "quiet";
                    has-icon: true;
                    icon: Icons.video;
                    icon-tint: smooth-on ? Theme.accent-soft : Theme.text-dim;
                    enabled: !popout;
                    tip: @tr("Show every frame in the preview. Uses a bit more CPU.");
                    clicked => { root.smooth-clicked(); }
                }
                Button {
                    text: @tr("Pop out");
                    role: "quiet";
                    min-width: 92px;
                    has-icon: true;
                    icon: Icons.pop-out;
                    icon-tint: Theme.text-dim;
                    clicked => { root.pop-out(); }
                }
            }
        }
    }
}
