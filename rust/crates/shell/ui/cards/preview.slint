// The video stage (plugins/preview.py): the letterboxed picture and the toolbar under it, no card chrome.

import { Theme, Icons, Button } from "@ui-kit/ui-kit.slint";

// A shape a plugin draws on the preview (add_preview_layer), in px of the picture's rect
export struct LayerPath { commands: string, stroke: color, width: length, fill: color, evenodd: bool }
export struct LayerText { x: length, y: length, text: string, color: color, size: length }

export component PreviewCard inherits Rectangle {
    in property <string> fold-key;
    in property <color> hue;
    in property <bool> visible-card: true;
    // The window draws frames straight into these (preview.rs); the plugin only clears them
    in property <image> frame;
    in property <bool> has-frame;
    // What plugins draw over the frame (Cinema tools' guides and scope), the frame's size
    in property <image> overlay;
    in property <bool> has-overlay;
    in property <[LayerPath]> layer-paths;
    in property <[LayerText]> layer-texts;
    // What the stage says without a frame, and whether it's the camera-off note with its icon
    in property <string> stage-text;
    in property <bool> camera-off;
    in property <bool> showing: true;
    in property <string> toggle-text;
    in property <bool> camera-on: true;
    in property <bool> camera-enabled: true;
    in property <string> camera-tip;
    // The pop-out window is open (the window opens it, preview.rs), and how often Pop out asked to bring it forward
    in property <bool> popout;
    in property <int> popout-asks;
    // The stage's size in logical px, for the window to paint frames at
    out property <length> stage-width: surface.width;
    out property <length> stage-height: surface.height;
    // A pick under way on the picture (overlays.rs): what the window draws for it, in px of the picture's rect
    in property <bool> picking;
    in property <string> pick-dim;
    in property <string> pick-line;
    in property <string> pick-handles;
    in property <string> pick-hint;
    in property <string> pick-cursor;
    // Where the picture sits on the stage (image-fit contain)
    property <float> aspect: has-frame && frame.height > 0 ? frame.width / frame.height : surface.width / max(1px, surface.height);
    out property <length> pic-width: min(surface.width, surface.height * aspect);
    out property <length> pic-height: pic-width / max(aspect, 0.01);
    property <length> pic-x: (surface.width - pic-width) / 2;
    property <length> pic-y: (surface.height - pic-height) / 2;
    callback pick-pointer(string, float, float, float, float);
    callback pick-key(string);
    callback toggle;
    callback camera-clicked;
    callback pop-out;
    callback popout-closed;

    visible: visible-card;
    preferred-height: 240px + 2px + 55px;
    background: Theme.surface-sunk;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    clip: true;

    VerticalLayout {
        padding: 1px;
        spacing: 0px;
        surface := Rectangle {
            min-height: 240px;
            vertical-stretch: 1;
            background: Theme.surface-sunk;
            border-radius: 11px;
            accessible-role: image;
            accessible-label: @tr("Preview");
            if has-frame: Image {
                width: parent.width;
                height: parent.height;
                source: frame;
                image-fit: contain;
                image-rendering: smooth;
            }
            if has-frame && has-overlay: Image {
                width: parent.width;
                height: parent.height;
                source: overlay;
                image-fit: contain;
                image-rendering: smooth;
            }
            if has-frame && (layer-paths.length > 0 || layer-texts.length > 0): Rectangle {
                x: pic-x;
                y: pic-y;
                width: pic-width;
                height: pic-height;
                for shape in layer-paths: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: shape.commands;
                    stroke: shape.stroke;
                    stroke-width: shape.width;
                    fill: shape.fill;
                    fill-rule: shape.evenodd ? FillRule.evenodd : FillRule.nonzero;
                }
                for t in layer-texts: Text {
                    x: t.x;
                    y: t.y;
                    text: t.text;
                    color: t.color;
                    font-family: Theme.font;
                    font-size: t.size;
                }
            }
            if !has-frame: VerticalLayout {
                alignment: center;
                spacing: 12px;
                if camera-off: HorizontalLayout {
                    alignment: center;
                    Image { source: Icons.v-camera-off; colorize: Theme.accent; width: 52px; height: 52px; }
                }
                Text {
                    text: stage-text;
                    horizontal-alignment: center;
                    font-family: Theme.font;
                    font-size: camera-off ? 15px : 13px;
                    color: camera-off ? Theme.accent-soft : Theme.text-faint;
                }
            }
            if picking: Rectangle {
                x: pic-x;
                y: pic-y;
                width: pic-width;
                height: pic-height;
                if pick-dim != "": Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: pick-dim;
                    fill: #0000005a;
                    fill-rule: evenodd;
                }
                if pick-line != "": Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: pick-line;
                    stroke: #00000082;
                    stroke-width: 4px;
                }
                if pick-line != "": Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: pick-line;
                    stroke: #ffffffeb;
                    stroke-width: 2px;
                }
                if pick-handles != "": Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: pick-handles;
                    fill: #ffffffeb;
                    stroke: #00000082;
                    stroke-width: 2px;
                }
                // The hint chip at the top of the picture, as _paint_hint draws it
                Rectangle {
                    y: 12px;
                    width: min(hint.preferred-width + 12px, parent.width - 12px);
                    height: hint.preferred-height + 6px;
                    background: #000000aa;
                    border-radius: 4px;
                    hint := Text {
                        width: parent.width - 6px;
                        text: pick-hint;
                        font-family: Theme.font;
                        font-size: 12px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
            if picking: keys := FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if e.text == Key.Return || e.text == Key.Escape {
                        root.pick-key(e.text);
                        return accept;
                    }
                    reject
                }
                TouchArea {
                    mouse-cursor: pick-cursor == "cross" ? MouseCursor.crosshair : pick-cursor == "move" ? MouseCursor.move : pick-cursor == "grab" ? MouseCursor.grab : MouseCursor.default;
                    pointer-event(e) => {
                        let u = (self.mouse-x - pic-x) / max(pic-width, 1px);
                        let v = (self.mouse-y - pic-y) / max(pic-height, 1px);
                        let kind = e.kind == PointerEventKind.move ? "move"
                            : e.button == PointerEventButton.right ? (e.kind == PointerEventKind.down ? "right" : "")
                            : e.button != PointerEventButton.left ? ""
                            : e.kind == PointerEventKind.down ? "down" : e.kind == PointerEventKind.up ? "up" : "";
                        if kind == "down" {
                            keys.focus();
                        }
                        if kind != "" {
                            root.pick-pointer(kind, u, v, pic-width / 1px, pic-height / 1px);
                        }
                    }
                }
            }
        }
        Rectangle {
            background: Theme.surface;
            Rectangle { y: 0; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 9px;
                padding-bottom: 10px;
                spacing: 8px;
                Button {
                    text: toggle-text;
                    role: "quiet";
                    min-width: 78px;
                    has-icon: true;
                    icon: showing ? Icons.eye-off : Icons.eye;
                    icon-tint: Theme.text-dim;
                    enabled: !popout;
                    tip: @tr("Stop drawing this preview. The camera output doesn't change.");
                    clicked => { root.toggle(); }
                }
                Button {
                    width: 36px;
                    role: "quiet";
                    padding-x: 0px;
                    has-icon: true;
                    icon: camera-on ? Icons.v-camera : Icons.v-camera-off;
                    icon-size: 16px;
                    icon-tint: camera-on ? Theme.text-dim : Theme.accent;
                    enabled: camera-enabled;
                    tip: camera-tip;
                    accessible-label: @tr("Phone camera");
                    clicked => { root.camera-clicked(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    width: 36px;
                    role: "quiet";
                    padding-x: 0px;
                    has-icon: true;
                    icon: Icons.v-lenses;
                    icon-size: 16px;
                    icon-tint: Theme.text-disabled;
                    enabled: false;
                    tip: @tr("Keep showing what the phone's longer lenses see. Doesn't show in the camera output.");
                    accessible-label: @tr("Lens outlines");
                }
                Button {
                    text: @tr("Pop out");
                    role: "quiet";
                    min-width: 92px;
                    has-icon: true;
                    icon: Icons.pop-out;
                    icon-tint: Theme.text-dim;
                    clicked => { root.pop-out(); }
                }
            }
        }
    }
}
