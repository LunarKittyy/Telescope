// The setup checklist on the video stage (plugins/onboarding.py): virtual camera, phone app, add a phone, start.

import { Theme, Icons, Card, Button } from "@ui-kit/ui-kit.slint";

export struct Step {
    title: string,
    text: string,
    // "status_dim", "status_ok", "status_warn" or "status_err"
    kind: string,
    done: bool,
    button: string,
    primary: bool,
    busy: bool,
}

component StepRow inherits HorizontalLayout {
    in property <int> number;
    in property <Step> step;
    in property <bool> qr-shown;
    in property <[int]> qr-cells;
    in property <int> qr-size;
    callback clicked;
    spacing: 14px;
    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            border-width: 1px;
            background: step.done ? Theme.fill : Theme.surface-raise;
            border-color: step.done ? Theme.fill : Theme.border-strong;
            Text {
                text: step.done ? "✓" : number;
                font-family: Theme.font;
                font-size: Theme.body;
                font-weight: 700;
                color: step.done ? white : Theme.accent-soft;
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        padding-top: 3px;
        spacing: 4px;
        alignment: start;
        Text { text: step.title; wrap: word-wrap; font-family: Theme.font; font-size: Theme.body; font-weight: 600; color: Theme.text; }
        Text {
            text: step.text;
            wrap: word-wrap;
            font-family: Theme.font;
            font-size: Theme.body;
            color: step.kind == "status_ok" ? Theme.ok : step.kind == "status_warn" ? Theme.warn : step.kind == "status_err" ? Theme.err : Theme.dim;
        }
        if qr-shown: HorizontalLayout {
            padding-top: 4px;
            alignment: start;
            qr := Rectangle {
                property <length> cell: 3px;
                width: (qr-size + 8) * cell;
                height: self.width;
                background: white;
                accessible-role: image;
                for i in qr-cells: Rectangle {
                    x: (mod(i, qr-size) + 4) * qr.cell;
                    y: (floor(i / qr-size) + 4) * qr.cell;
                    width: qr.cell;
                    height: qr.cell;
                    background: black;
                }
            }
        }
    }
    VerticalLayout {
        alignment: start;
        // A hidden button takes no room, as in Qt
        width: step.button != "" ? 160px : 0px;
        if step.button != "": Button {
            text: step.button;
            role: step.primary ? "primary" : "";
            height: 32px;
            enabled: !step.busy;
            clicked => { root.clicked(); }
        }
    }
}

export component OnboardingCard inherits Card {
    in property <[Step]> steps;
    in property <bool> asked;
    in property <bool> qr-shown;
    in property <[int]> qr-cells;
    in property <int> qr-size;
    callback step-clicked(int);
    callback close;
    title: @tr("Get set up");
    icon: Icons.check;
    has-action: asked;
    action-icon: Icons.v-close;
    action-label: @tr("Close the setup guide");
    action => { root.close(); }
    VerticalLayout {
        padding-top: 4px;
        spacing: 22px;
        alignment: start;
        for step[i] in steps: StepRow {
            number: i + 1;
            step: step;
            qr-shown: i == 1 && root.qr-shown;
            qr-cells: root.qr-cells;
            qr-size: root.qr-size;
            clicked => { root.step-clicked(i); }
        }
    }
}
