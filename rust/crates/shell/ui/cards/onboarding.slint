// The setup checklist on the video stage (plugins/onboarding.py): virtual camera, phone app, add a phone, start.

import { Theme, Icons, Card, Button, TipBody } from "@ui-kit/ui-kit.slint";

export struct Step {
    title: string,
    text: string,
    // The lines their QLabels' sizeHint gives them, at the width Qt guesses
    title-lines: int,
    text-lines: int,
    // "status_dim", "status_ok", "status_warn" or "status_err"
    kind: string,
    done: bool,
    button: string,
    primary: bool,
    busy: bool,
    // How to do the step, for a tooltip
    tip: string,
}

component StepRow inherits HorizontalLayout {
    in property <int> number;
    in property <Step> step;
    in property <bool> qr-shown;
    in property <[int]> qr-cells;
    in property <int> qr-size;
    // Some step shows a button: they share one grid in Qt, so every step's text leaves room for the button column
    in property <bool> button-column;
    callback clicked;
    // How much more room Qt's size hints want for its text than it needs at this width
    out property <length> hint-gap: max(0px, step.title-lines * 16px - title.preferred-height) + max(0px, step.text-lines * 16px - body.preferred-height);
    spacing: 14px;
    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            border-width: 1px;
            background: step.done ? Theme.fill : Theme.surface-raise;
            border-color: step.done ? Theme.fill : Theme.border-strong;
            Text {
                text: step.done ? "✓" : number;
                font-family: Theme.font;
                font-size: Theme.body;
                font-weight: 700;
                color: step.done ? white : Theme.accent-soft;
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        padding-top: 3px;
        spacing: 4px;
        alignment: start;
        title := Text {
            text: step.title;
            wrap: word-wrap;
            line-height-factor: Theme.line-factor(self.font-size);
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: 600;
            color: Theme.text;
            if step.tip != "": Tooltip { TipBody { says: step.tip; } }
        }
        body := Text {
            text: step.text;
            wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size);
            font-family: Theme.font;
            font-size: Theme.body;
            color: step.kind == "status_ok" ? Theme.ok : step.kind == "status_warn" ? Theme.warn : step.kind == "status_err" ? Theme.err : Theme.dim;
            if step.tip != "": Tooltip { TipBody { says: step.tip; } }
        }
        // A step that is stuck needs its how-to on the card: a tooltip can't be opened with the keyboard
        if step.kind == "status_warn" && step.tip != "": Text {
            text: step.tip;
            wrap: word-wrap;
            line-height-factor: Theme.line-factor(self.font-size);
            font-family: Theme.font;
            font-size: Theme.small;
            color: Theme.ink2;
        }
        if qr-shown: HorizontalLayout {
            padding-top: 4px;
            alignment: start;
            qr := Rectangle {
                property <length> cell: 3px;
                width: (qr-size + 8) * cell;
                height: self.width;
                background: white;
                accessible-role: image;
                accessible-label: @tr("QR code that downloads the phone app");
                for i in qr-cells: Rectangle {
                    x: (mod(i, qr-size) + 4) * qr.cell;
                    y: (floor(i / qr-size) + 4) * qr.cell;
                    width: qr.cell;
                    height: qr.cell;
                    background: black;
                }
            }
        }
    }
    VerticalLayout {
        alignment: start;
        // A hidden button takes no room, as in Qt, unless another step's button holds the column open
        width: button-column ? 160px : 0px;
        if step.button != "": Button {
            text: step.button;
            role: step.primary ? "primary" : "";
            height: 32px;
            enabled: !step.busy;
            clicked => { root.clicked(); }
        }
    }
}

export component OnboardingCard inherits Card {
    in property <[Step]> steps;
    in property <bool> asked;
    in property <bool> qr-shown;
    in property <[int]> qr-cells;
    in property <int> qr-size;
    callback step-clicked(int);
    callback close;
    // What its wrapped text's size hints add to the card's: a column with a stage card grows by it (doc.rs)
    out property <length> hint-extra: s0.hint-gap + s1.hint-gap + s2.hint-gap + s3.hint-gap;
    property <bool> any-button: steps[0].button != "" || steps[1].button != "" || steps[2].button != "" || steps[3].button != "";
    title: @tr("Get set up");
    icon: Icons.check;
    has-action: asked;
    action-icon: Icons.v-close;
    action-label: @tr("Close the setup guide");
    action => { root.close(); }
    VerticalLayout {
        padding-top: 4px;
        spacing: 22px;
        alignment: start;
        s0 := StepRow {
            number: 1;
            step: steps[0];
            qr-shown: false;
            qr-cells: root.qr-cells;
            qr-size: root.qr-size;
            button-column: root.any-button;
            clicked => { root.step-clicked(0); }
        }
        s1 := StepRow {
            number: 2;
            step: steps[1];
            qr-shown: root.qr-shown;
            qr-cells: root.qr-cells;
            qr-size: root.qr-size;
            button-column: root.any-button;
            clicked => { root.step-clicked(1); }
        }
        s2 := StepRow {
            number: 3;
            step: steps[2];
            qr-shown: false;
            qr-cells: root.qr-cells;
            qr-size: root.qr-size;
            button-column: root.any-button;
            clicked => { root.step-clicked(2); }
        }
        s3 := StepRow {
            number: 4;
            step: steps[3];
            qr-shown: false;
            qr-cells: root.qr-cells;
            qr-size: root.qr-size;
            button-column: root.any-button;
            clicked => { root.step-clicked(3); }
        }
    }
}
