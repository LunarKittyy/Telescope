// The Presets button in the header (plugins/presets.py): a menu of the saved presets with Save, Rename and Delete under
// them, and the two questions those ask (a name, and whether to replace a preset). The plugin says which question is open.

import { Theme, Icons, Button, TextField, DialogFrame, DialogButtons, WindowBox, MenuSurface, MenuItem, Motion } from "@ui-kit/ui-kit.slint";

// A row that opens a submenu: the kit's menu row with the arrow at its end
component SubmenuItem inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    in property <bool> current;
    callback hovered;
    callback left;
    callback activate;
    height: Theme.u(13);
    MenuItem {
        title: root.title;
        enabled: root.enabled;
        current: root.current;
        hovered => { root.hovered(); }
        left => { root.left(); }
        activate => { root.activate(); }
    }
    Text {
        x: parent.width - Theme.u(10);
        y: -1phx;
        height: parent.height;
        text: "›";
        font-family: Theme.font;
        font-size: Theme.body;
        color: root.enabled ? Theme.ink2 : Theme.dis;
        vertical-alignment: center;
    }
}

export component PresetsHeader inherits HorizontalLayout {
    in property <string> label;
    in property <string> tip;
    in property <[string]> names;
    in property <string> save-text;
    in property <string> rename-text;
    in property <string> delete-text;
    // "" (nothing asked), "name" (the Save and Rename question) or "replace"
    in property <string> dialog;
    in property <string> dialog-title;
    in property <string> dialog-label;
    in property <string> dialog-text;
    in property <string> ok-text;
    in property <string> confirm-text;
    in property <string> replace-title;
    in property <string> replace-text;
    in property <string> cancel-text;
    callback apply(string);
    callback save-clicked;
    callback rename-clicked(string);
    callback delete-clicked(string);
    callback name-accepted(string);
    callback replace-answered(bool);
    callback dialog-cancelled;

    // Which of the menu's submenus is open: "", "rename" or "delete"
    property <string> sub;
    // The row the pointer is on in the menu (names, then 1000 Save, 1001 Rename, 1002 Delete) and in the submenu
    property <int> current: -1;
    property <int> sub-current: -1;
    // A pick runs at once and the menus ease out after it, then the pop-ups go
    property <bool> leaving;
    function leave() { leaving = true; }
    Timer {
        interval: Motion.fade-out + 40ms;
        running: root.leaving;
        triggered => {
            root.leaving = false;
            root.sub = "";
            menu.close();
        }
    }
    // The name being typed in the Save and Rename question
    property <string> name-text;
    // Where the popups open: 6px under the button, which the header bar centres
    property <length> below: (root.height + button.height) / 2 + Theme.u(3);

    // Which question is up, so a change of `dialog` eases the right one out and then closes its pop-up
    property <bool> name-up;
    property <bool> replace-up;
    property <bool> name-going;
    property <bool> replace-going;
    changed dialog => {
        if (self.dialog == "name") {
            root.name-text = root.dialog-text;
            root.name-up = true;
            name-popup.show();
        } else if (root.name-up) {
            root.name-going = true;
        }
        if (self.dialog == "replace") {
            root.replace-up = true;
            replace-popup.show();
        } else if (root.replace-up) {
            root.replace-going = true;
        }
    }

    button := Button {
        text: label;
        has-icon: true;
        icon: Icons.bookmark;
        height: Theme.u(18);
        tip: root.label;
        tip-detail: root.tip;
        shortcut: "presets.apply";
        clicked => {
            root.sub = "";
            root.current = -1;
            root.leaving = false;
            menu.show();
        }
    }

    // One pop-up holds the menu and, beside it, the Rename or Delete list once that is asked for: a second pop-up would take the first one's place
    menu := PopupWindow {
        x: 0;
        y: root.below;
        width: Theme.u(95) * 2 + Theme.u(2);
        height: Theme.u(200);
        close-policy: close-on-click-outside;
        MenuSurface {
            x: 0px;
            y: 0px;
            width: Theme.u(95);
            height: self.preferred-height;
            leaving: root.leaving;
            VerticalLayout {
                padding: Theme.u(2.5);
                spacing: 0px;
                for name[i] in names: MenuItem {
                    title: name;
                    current: root.current == i;
                    hovered => { root.current = i; }
                    left => { root.current = -1; }
                    activate => {
                        // Before closing: the row goes with the menu, and what follows the close doesn't run
                        root.apply(name);
                        root.leave();
                    }
                }
                if names.length > 0: MenuItem { separator: true; }
                MenuItem {
                    title: save-text;
                    current: root.current == 1000;
                    hovered => { root.current = 1000; }
                    left => { root.current = -1; }
                    activate => {
                        root.leave();
                        root.save-clicked();
                    }
                }
                SubmenuItem {
                    title: rename-text;
                    enabled: names.length > 0;
                    current: root.current == 1001 || root.sub == "rename";
                    hovered => { root.current = 1001; }
                    left => { root.current = -1; }
                    activate => { root.sub = "rename"; root.sub-current = -1; }
                }
                SubmenuItem {
                    title: delete-text;
                    enabled: names.length > 0;
                    current: root.current == 1002 || root.sub == "delete";
                    hovered => { root.current = 1002; }
                    left => { root.current = -1; }
                    activate => { root.sub = "delete"; root.sub-current = -1; }
                }
            }
        }
        // The Rename or Delete list: the names again, level with the row that opened it
        if root.sub != "": MenuSurface {
            x: Theme.u(95) + Theme.u(2);
            y: Theme.u(2.5) + Theme.u(13) * names.length + (names.length > 0 ? Theme.u(4.5) : 0px) + Theme.u(13) * (root.sub == "rename" ? 1 : 2);
            width: Theme.u(95);
            height: self.preferred-height;
            leaving: root.leaving;
            VerticalLayout {
                padding: Theme.u(2.5);
                spacing: 0px;
                for name[i] in names: MenuItem {
                    title: name;
                    current: root.sub-current == i;
                    hovered => { root.sub-current = i; }
                    left => { root.sub-current = -1; }
                    activate => {
                        if (root.sub == "rename") {
                            root.rename-clicked(name);
                        } else {
                            root.delete-clicked(name);
                        }
                        root.leave();
                    }
                }
            }
        }
    }

    name-popup := PopupWindow {
        // The question eases out when asked to; only something inside the pop-up can tell its frame
        Rectangle {
            width: 0px;
            height: 0px;
            property <bool> bye: root.name-going;
            changed bye => { if (self.bye) { name-frame.leave(); } }
        }
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowBox.cover-w(Theme.u(190));
        height: WindowBox.cover-h(name-frame.preferred-height);
        close-policy: no-auto-close;
        FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.dialog-cancelled(); return accept; }
                reject
            }
            name-frame := DialogFrame {
                x: WindowBox.left(self.width);
                y: WindowBox.top(self.height);
                width: Theme.u(190);
                height: self.preferred-height;
                dismissable: true;
                dismissed => { root.dialog-cancelled(); }
                left => { root.name-going = false; root.name-up = false; name-popup.close(); }
                title: dialog-title;
                VerticalLayout {
                    spacing: Theme.u(3);
                    Text {
                        text: dialog-label;
                        font-family: Theme.font;
                        font-size: Theme.body;
                        color: Theme.ink;
                    }
                    TextField {
                        label: dialog-label;
                        text <=> root.name-text;
                        init => { self.focus-all(); }
                        accepted => { root.name-accepted(root.name-text); }
                    }
                }
                DialogButtons {
                    Button { text: cancel-text; dialog: true; clicked => { root.dialog-cancelled(); } }
                    Button { text: ok-text; role: "primary"; dialog: true; hue: Theme.plugin-hue("extras"); clicked => { root.name-accepted(root.name-text); } }
                }
            }
        }
    }

    replace-popup := PopupWindow {
        // The question eases out when asked to; only something inside the pop-up can tell its frame
        Rectangle {
            width: 0px;
            height: 0px;
            property <bool> bye: root.replace-going;
            changed bye => { if (self.bye) { replace-frame.leave(); } }
        }
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowBox.cover-w(Theme.u(200));
        height: WindowBox.cover-h(replace-frame.preferred-height);
        close-policy: no-auto-close;
        FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.replace-answered(false); return accept; }
                reject
            }
            replace-frame := DialogFrame {
                x: WindowBox.left(self.width);
                y: WindowBox.top(self.height);
                width: Theme.u(200);
                height: self.preferred-height;
                dismissable: true;
                dismissed => { root.replace-answered(false); }
                left => { root.replace-going = false; root.replace-up = false; replace-popup.close(); }
                title: replace-title;
                subtitle: confirm-text;
                DialogButtons {
                    Button { text: cancel-text; dialog: true; clicked => { root.replace-answered(false); } }
                    Button { text: replace-text; role: "primary"; dialog: true; hue: Theme.plugin-hue("extras"); clicked => { root.replace-answered(true); } }
                }
            }
        }
    }
}
