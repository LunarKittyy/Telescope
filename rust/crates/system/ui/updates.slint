// The Updates plugin: the green Update button in the header and the Telescope card on
// Updates & About. Texts with blanks come filled from Rust.

import { Theme, Icons, Icon, Button, Card, RailRow, SwitchRow, ChoiceField, Switch, DialogFrame, WindowBox } from "@ui-kit/ui-kit.slint";

global Status {
    public pure function color(kind: string) -> color {
        kind == "status_ok" ? Theme.ok : kind == "status_warn" ? Theme.warn : kind == "status_err" ? Theme.err
            : kind == "status_dim" ? Theme.text-dim : Theme.text
    }
}

component Note inherits Text {
    in property <string> kind: "status_dim";
    font-family: Theme.font;
    font-size: Theme.body;
    font-weight: kind == "val" ? 600 : 400;
    color: Status.color(kind);
    wrap: word-wrap;
    vertical-alignment: center;
}

// Green, not the accent blue: Start streaming stays the one primary button in the header
export component UpdateButton inherits Rectangle {
    in property <bool> shown;
    in property <string> tip;
    callback clicked;
    visible: shown;
    width: shown ? lay.preferred-width : 0px;
    height: 36px;
    border-radius: 10px;
    background: touch.pressed ? Theme.ok.darker(0.2) : touch.has-hover ? Theme.ok.brighter(0.1) : Theme.ok;
    accessible-role: button;
    accessible-label: @tr("Update");
    accessible-description: tip;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lay := HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        spacing: 8px;
        alignment: center;
        Icon { source: Icons.v-update; tint: white; width: 16px; height: 16px; y: (parent.height - self.height) / 2; accessible-role: none; }
        Text {
            text: @tr("Update");
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: 600;
            color: white;
            vertical-alignment: center;
        }
    }
}

export component UpdatesSettings inherits Card {
    in property <string> version-text;
    in property <[string]> channels;
    in property <int> channel;
    in property <bool> auto;
    in property <bool> portable-shown;
    in property <bool> portable;
    in property <string> status-text;
    in property <string> status-kind: "status_dim";
    in property <bool> busy;
    in property <bool> actions-shown;
    in property <bool> retry-shown;
    in property <string> update-text;
    in property <bool> update-enabled;
    // Going back to the Python version: a plain button, and a question before anything happens
    in property <bool> back-shown;
    in property <bool> back-enabled;
    in property <string> back-tip;
    in property <bool> back-open;
    in property <string> back-text;
    in property <string> back-action;
    in property <bool> back-action-enabled;
    callback back-asked;
    callback back-answered(bool);
    changed back-open => {
        if (self.back-open) {
            back-popup.show();
        } else {
            back-popup.close();
        }
    }
    callback check-now;
    callback channel-picked(int);
    callback auto-toggled(bool);
    callback portable-toggled(bool);
    callback update;
    callback notes;
    callback retry;
    title: "Telescope";
    keywords: @tr("search" => "update upgrade new version release download install latest");
    icon: Icons.v-update;
    hue: Theme.plugin-hue("extras");
    has-action: true;
    action-icon: Icons.reset;
    action-label: @tr("Check now");
    action-text: @tr("Check now");
    action => { if (!busy) { root.check-now(); } }
    RailRow {
        icon: Icons.check;
        label: @tr("This version");
        hue: root.hue;
        keywords: @tr("search" => "current build number");
        Note { text: version-text; kind: "val"; horizontal-stretch: 1; }
    }
    RailRow {
        icon: Icons.layers;
        label: @tr("Channel");
        hue: root.hue;
        keywords: @tr("search" => "stable nightly beta release track builds testing");
        enabled: !busy;
        ChoiceField {
            compact: true;
            y: (parent.height - self.height) / 2;
            caption: @tr("Channel");
            items: channels;
            current: channel;
            enabled: !busy;
            tip: @tr("Nightly");
            tip-detail: @tr("Built from every change. Fixes first, less tested.");
            picked(i) => { root.channel-picked(i); }
        }
    }
    SwitchRow {
        icon: Icons.timer;
        label: @tr("Check daily");
        keywords: @tr("search" => "automatic updates auto check every day background");
        hue: root.hue;
        checked: auto;
        toggled(on) => { root.auto-toggled(on); }
    }
    if portable-shown: SwitchRow {
        icon: Icons.folder;
        label: @tr("Keep this copy where it is");
        keywords: @tr("search" => "portable keep this copy where it is zip folder in place windows unzipped");
        tip: @tr("Updates this unzipped folder in place instead of installing Telescope for your user.");
        hue: root.hue;
        checked: portable;
        toggled(on) => { root.portable-toggled(on); }
    }
    // Qt's control_row keeps its height with nothing shown in it, so these three rows do too
    RailRow {
        has-icon: false;
        Note { text: status-text; kind: status-kind; horizontal-stretch: 1; }
    }
    RailRow {
        has-icon: false;
        HorizontalLayout {
            visible: actions-shown;
            spacing: 8px;
            alignment: start;
            Button { text: @tr("What's new"); clicked => { root.notes(); } }
            Button { text: update-text; role: "primary"; hue: Theme.plugin-hue("extras"); enabled: update-enabled; clicked => { root.update(); } }
        }
    }
    RailRow {
        has-icon: false;
        HorizontalLayout {
            visible: retry-shown;
            alignment: start;
            Button { text: @tr("Try again"); enabled: !busy; clicked => { root.retry(); } }
        }
    }
    if back-shown: RailRow {
        icon: Icons.reset;
        label: @tr("Older version");
        hue: root.hue;
        keywords: @tr("search" => "go back downgrade python previous old version revert undo rust");
        enabled: !busy;
        HorizontalLayout {
            alignment: start;
            Button {
                text: @tr("Go back to the Python version");
                tip: back-tip;
                enabled: back-enabled;
                clicked => { root.back-asked(); }
            }
        }
    }

    back-popup := PopupWindow {
        close-policy: no-auto-close;
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowBox.cover-w(max(root.width, 460px));
        height: WindowBox.cover-h(back-frame.preferred-height);
        back-frame := DialogFrame {
            x: WindowBox.left(self.width);
            y: WindowBox.top(self.height);
            width: max(root.width, 460px);
            height: self.preferred-height;
            dismissable: true;
            dismissed => { root.back-answered(false); }
            title: @tr("Go back to the Python version?");
            Note { text: back-text; kind: ""; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                // The way out is the highlighted one: going back is the thing to be sure about
                Button { height: 32px; text: back-action; enabled: back-action-enabled; clicked => { root.back-answered(true); } }
                Button { width: 96px; height: 32px; text: @tr("Cancel"); role: "primary"; hue: Theme.plugin-hue("extras"); clicked => { root.back-answered(false); } }
            }
        }
    }
}
