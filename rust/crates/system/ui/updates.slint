// The Updates plugin: the green Update button in the header and the Telescope card on
// Updates & About. Texts with blanks come filled from Rust.

import { Theme, Icons, Icon, Button, Card, RailRow, SwitchRow, ChoiceField, DialogFrame, DialogButtons, WindowBox, Status, UnfoldGroup, Unfolding } from "@ui-kit/ui-kit.slint";

// The kit's Status takes ok, warn and err; the plugin says it the way the other cards' notes did
global StatusKind {
    public pure function of(kind: string) -> string {
        kind == "status_ok" ? "ok" : kind == "status_warn" ? "warn" : kind == "status_err" ? "err" : ""
    }
}

// Green, not the accent blue: Start streaming stays the one primary button in the header
export component UpdateButton inherits Rectangle {
    in property <bool> shown;
    in property <string> tip;
    callback clicked;
    visible: shown;
    width: shown ? lay.preferred-width : 0px;
    height: 36px;
    border-radius: 10px;
    background: touch.pressed ? Theme.update-press : touch.has-hover ? Theme.update-hover : Theme.update-fill;
    accessible-role: button;
    accessible-label: @tr("Update");
    accessible-description: tip;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lay := HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        spacing: 8px;
        alignment: center;
        Icon { source: Icons.v-update; tint: Theme.on-fill; width: 16px; height: 16px; y: (parent.height - self.height) / 2; accessible-role: none; }
        Text {
            text: @tr("Update");
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: 600;
            color: Theme.on-fill;
            vertical-alignment: center;
        }
    }
}

export component UpdatesSettings inherits Card {
    in property <string> version-text;
    in property <[string]> channels;
    in property <int> channel;
    in property <bool> auto;
    in property <bool> portable-shown;
    in property <bool> portable;
    in property <string> status-text;
    in property <string> status-kind: "status_dim";
    in property <bool> busy;
    in property <bool> actions-shown;
    in property <bool> retry-shown;
    in property <string> update-text;
    in property <bool> update-enabled;
    // Going back to the Python version: a plain button, and a question before anything happens
    in property <bool> back-shown;
    in property <bool> back-enabled;
    in property <string> back-tip;
    in property <bool> back-open;
    in property <string> back-text;
    in property <string> back-action;
    in property <bool> back-action-enabled;
    // What the status line and the update button said last, kept while their rows fold away
    property <string> held-status;
    property <string> held-kind;
    property <string> held-update;
    function keep() {
        if (status-text != "") {
            held-status = status-text;
            held-kind = status-kind;
        }
        if (update-text != "") { held-update = update-text; }
    }
    init => { keep(); }
    changed status-text => { keep(); }
    changed status-kind => { keep(); }
    changed update-text => { keep(); }
    // The way out of the question: said once the dialog has faded
    property <bool> back-answer;
    callback back-asked;
    callback back-answered(bool);
    changed back-open => {
        if (self.back-open) {
            self.back-answer = false;
            back-popup.show();
        } else {
            back-popup.close();
        }
    }
    callback check-now;
    callback channel-picked(int);
    callback auto-toggled(bool);
    callback portable-toggled(bool);
    callback update;
    callback notes;
    callback retry;
    title: "Telescope";
    tip: @tr("Check for new versions and install them.");
    keywords: @tr("search" => "update upgrade new version release download install latest");
    icon: Icons.v-update;
    hue: Theme.plugin-hue("extras");
    has-action: true;
    action-icon: Icons.reset;
    action-label: @tr("Check now");
    action-text: @tr("Check now");
    action-tip-detail: @tr("Look for a new version of Telescope.");
    action => { if (!busy) { root.check-now(); } }
    // The rows that are there only in some states unfold in and out under the row they belong to
    UnfoldGroup {
        RailRow {
            icon: Icons.check;
            label: @tr("This version");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "current build number");
            Text {
                text: version-text;
                font-family: Theme.font;
                font-size: Theme.body;
                font-weight: Theme.w-value;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        Unfolding {
            open: status-text != "";
            RailRow {
                has-icon: false;
                Status { text: held-status; kind: StatusKind.of(held-kind); horizontal: "end"; }
            }
        }
        Unfolding {
            open: actions-shown;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.gap;
                    alignment: end;
                    Button { text: @tr("What's new"); clicked => { root.notes(); } }
                    Button { text: held-update; role: "primary"; hue: Theme.plugin-hue("extras"); enabled: update-enabled; clicked => { root.update(); } }
                }
            }
        }
        Unfolding {
            open: retry-shown;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    alignment: end;
                    Button { text: @tr("Try again"); enabled: !busy; clicked => { root.retry(); } }
                }
            }
        }
    }
    RailRow {
        icon: Icons.layers;
        label: @tr("Channel");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "stable nightly beta release track builds testing");
        enabled: !busy;
        ChoiceField {
            width: Theme.control-w;
            compact: true;
            name: @tr("Channel");
            items: channels;
            current: channel;
            enabled: !busy;
            tip: @tr("Nightly");
            tip-detail: @tr("Built from every change. Gets fixes first but is less tested.");
            picked(i) => { root.channel-picked(i); }
        }
    }
    SwitchRow {
        icon: Icons.timer;
        label: @tr("Check daily");
        keywords: @tr("search" => "automatic updates auto check every day background");
        hue: root.hue;
        checked: auto;
        toggled(on) => { root.auto-toggled(on); }
    }
    if portable-shown: SwitchRow {
        icon: Icons.folder;
        label: @tr("Keep this copy where it is");
        keywords: @tr("search" => "portable keep this copy where it is zip folder in place windows unzipped");
        tip: @tr("Keep this copy where it is");
        tip-detail: @tr("Update this unzipped folder in place instead of installing Telescope for your user.");
        hue: root.hue;
        checked: portable;
        toggled(on) => { root.portable-toggled(on); }
    }
    if back-shown: RailRow {
        icon: Icons.reset;
        label: @tr("Older version");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "go back downgrade python previous old version revert undo rust");
        enabled: !busy;
        Button {
            shrinks: true;
            text: @tr("Go back to the Python version");
            tip: @tr("Go back to the Python version");
            tip-detail: back-tip;
            enabled: back-enabled;
            clicked => { root.back-asked(); }
        }
    }

    back-popup := PopupWindow {
        close-policy: no-auto-close;
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowBox.cover-w(max(root.width, Theme.u(230)));
        height: WindowBox.cover-h(back-frame.preferred-height);
        back-frame := DialogFrame {
            x: WindowBox.left(self.width);
            y: WindowBox.top(self.height);
            width: max(root.width, Theme.u(230));
            height: self.preferred-height;
            dismissable: true;
            left => {
                back-popup.close();
                // A press outside never sets the answer, so it must not keep the last one
                root.back-answered(root.back-answer);
                root.back-answer = false;
            }
            title: @tr("Go back to the Python version?");
            Text {
                text: back-text;
                font-family: Theme.font;
                font-size: Theme.body;
                color: Theme.ink2;
                wrap: word-wrap;
                line-height-factor: Theme.line-factor(self.font-size);
            }
            DialogButtons {
                Button { text: back-action; dialog: true; enabled: back-action-enabled; clicked => { root.back-answer = true; back-frame.leave(); } }
                // The way out is the highlighted one: going back is the thing to be sure about
                Button { text: @tr("Cancel"); dialog: true; role: "primary"; hue: Theme.plugin-hue("extras"); clicked => { root.back-answer = false; back-frame.leave(); } }
            }
        }
    }
}
