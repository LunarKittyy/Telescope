// The Startup plugin: the sign-in switch on the General tab and the Automatic
// streaming card on Streaming. Texts that are lists, or have blanks, come filled from Rust.

import { Theme, Icons, Card, SwitchRow, RailRow, ChoiceField, NumberField } from "@ui-kit/ui-kit.slint";

export component StartupSettings inherits Card {
    in-out property <bool> open-checked;
    // Off in a dev profile, whose sign-in entry would be the real app's
    in property <bool> open-enabled: true;
    in property <string> open-tip;
    callback open-toggled(bool);
    title: @tr("Startup");
    tip: @tr("Open Telescope when you sign in.");
    keywords: @tr("search" => "login boot autostart run on startup tray minimized");
    icon: Icons.monitor;
    SwitchRow {
        icon: Icons.monitor;
        label: @tr("Open Telescope when I sign in");
        keywords: @tr("search" => "autostart login log in boot startup run on startup launch computer starts tray");
        hue: root.hue;
        checked <=> root.open-checked;
        enabled: open-enabled;
        tip: open-tip != "" ? @tr("Open Telescope when I sign in") : "";
        tip-detail: open-tip;
        toggled(on) => { root.open-toggled(on); }
    }
}

export component AutomaticSettings inherits Card {
    // What a row's list offers is found by the row too, as the old rows found it by their controls
    pure function words(items: [string]) -> string {
        items[0] + " " + items[1] + " " + items[2]
    }
    in property <[string]> start-items;
    in-out property <int> start-current;
    in property <[string]> stop-items;
    in-out property <int> stop-current;
    // The idle stop is on: its note shows and the wait and the notice are in use
    in property <bool> stops;
    in-out property <string> delay-text;
    in property <[string]> unit-items;
    in-out property <int> unit-current;
    in-out property <bool> notify-checked;
    in property <string> start-title;
    in property <string> stop-title;
    in property <string> delay-title;
    in property <string> delay-sub;
    callback start-picked(int);
    callback stop-picked(int);
    callback delay-committed(string);
    callback delay-step(int);
    callback unit-picked(int);
    callback notify-toggled(bool);
    title: @tr("Automatic streaming");
    tip: @tr("Start and stop the stream automatically when an app uses the virtual camera.");
    keywords: @tr("search" => "auto start stop camera app opens discord obs zoom meet teams phone device ready idle hands free");
    icon: Icons.bolt;
    RailRow {
        icon: Icons.play;
        label: start-title;
        tip: @tr("When streaming starts by itself");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "automatically begin streaming when phone device ready app opens the camera auto start") + " " + words(start-items);
        ChoiceField {
            width: Theme.control-w;
            compact: true;
            name: start-title;
            items: start-items;
            current <=> root.start-current;
            picked(i) => { root.start-current = i; root.start-picked(i); }
        }
    }
    RailRow {
        icon: Icons.stop;
        label: stop-title;
        tip: @tr("When streaming stops by itself");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "automatically end streaming idle no app uses the camera auto stop") + " " + words(stop-items);
        ChoiceField {
            width: Theme.control-w;
            compact: true;
            name: stop-title;
            items: stop-items;
            current <=> root.stop-current;
            picked(i) => { root.stop-current = i; root.stop-picked(i); }
        }
    }
    RailRow {
        icon: Icons.timer;
        label: delay-title;
        tip: @tr("How long to wait after the last app stops using the camera");
        tip-detail: delay-sub;
        named: true;
        hue: root.hue;
        enabled: stops;
        keywords: @tr("search" => "delay timeout idle seconds minutes how long grace period auto stop");
        HorizontalLayout {
            spacing: Theme.gap;
            alignment: end;
            // Saved once it's typed (on Enter or when the box is left), not at every digit
            NumberField {
                width: Theme.u(45);
                enabled: stops;
                label: delay-title;
                value: root.delay-text;
                committed(text) => { root.delay-committed(text); }
                step(d) => { root.delay-step(-d); }
            }
            // At least as wide as the number box and as wide as its longest unit with the field's padding, as Qt's combo box is
            Rectangle {
                width: max(Theme.u(45), longest-unit.preferred-width + Theme.u(21));
                ChoiceField {
                    compact: true;
                    enabled: stops;
                    name: delay-title;
                    items: unit-items;
                    current <=> root.unit-current;
                    picked(i) => { root.unit-current = i; root.unit-picked(i); }
                }
                Rectangle {
                    visible: false;
                    longest-unit := VerticalLayout {
                        for unit in unit-items: Text { text: unit; font-family: Theme.font; font-size: Theme.body; }
                    }
                }
            }
        }
    }
    SwitchRow {
        icon: Icons.bell;
        label: @tr("Tell me when it stops a stream");
        tip: @tr("Show a notification when streaming stops by itself");
        hue: root.hue;
        enabled: stops;
        keywords: @tr("search" => "notification notify alert popup message");
        checked <=> root.notify-checked;
        toggled(on) => { root.notify-toggled(on); }
    }
}
