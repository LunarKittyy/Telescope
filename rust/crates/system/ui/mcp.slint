// The MCP server's tab in Settings and its button in the header. The texts that are lists or carry names come filled from Rust.

import { Theme, Icons, Card, RailRow, Segmented, IconButton, Icon, FocusRing, KeyFocus, Tip, Motion, Status } from "@ui-kit/ui-kit.slint";

// One line of the activity log: when, which AI app, what it did in words. kind is "" or "refused".
export struct McpLogRow {
    time: string,
    who: string,
    text: string,
    kind: string,
}

export component McpSettings inherits VerticalLayout {
    spacing: Theme.u(7);
    // The AI apps connected now, by the name each gave; none: empty
    in property <[string]> clients;
    in property <string> none-text;
    in property <[string]> access-items: ["", ""];
    in property <int> access-current;
    // The entry for the AI app's MCP config
    in property <string> command;
    in property <string> copy-tip;
    in property <[McpLogRow]> log;
    in property <string> log-empty;
    callback access-picked(int);
    callback copy-clicked;

    Card {
        title: @tr("MCP server");
        tip: @tr("Let an AI app read and change Telescope's settings.");
        keywords: @tr("search" => "mcp ai claude model assistant agent connect access read only");
        icon: Icons.plug;
        hue: Theme.plugin-hue("extras");
        RailRow {
            icon: Icons.devices;
            label: @tr("Connected");
            named: true;
            hue: Theme.plugin-hue("extras");
            VerticalLayout {
                alignment: center;
                spacing: Theme.u(1);
                if clients.length == 0: Text {
                    text: none-text;
                    font-family: Theme.font;
                    font-size: Theme.body;
                    color: Theme.faint;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                for name in clients: Text {
                    text: name;
                    font-family: Theme.font;
                    font-size: Theme.body;
                    font-weight: Theme.w-value;
                    color: Theme.ink;
                    horizontal-alignment: right;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
        RailRow {
            icon: Icons.lock;
            label: @tr("Access");
            named: true;
            hue: Theme.plugin-hue("extras");
            Segmented {
                width: Theme.u(130);
                hue: Theme.plugin-hue("extras");
                label: @tr("Access");
                items: access-items;
                disabled: [false, false];
                has-icons: [false, false];
                icons: [Icons.colour, Icons.colour];
                current: access-current;
                picked(i) => { root.access-picked(i); }
            }
        }
        // The line to paste into the AI app's config, in monospace in a recessed well with a button that copies it
        RailRow {
            icon: Icons.keyboard;
            label: @tr("Command");
            hue: Theme.plugin-hue("extras");
            HorizontalLayout {
                spacing: Theme.gap;
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    min-height: Theme.row;
                    background: Theme.trough;
                    border-radius: Theme.r-ctl;
                    accessible-role: text;
                    accessible-label: command;
                    VerticalLayout {
                        padding: Theme.u(4);
                        Text {
                            text: command;
                            font-family: Theme.mono;
                            font-size: Theme.mono-size;
                            color: Theme.ink;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                }
                VerticalLayout {
                    alignment: start;
                    IconButton {
                        icon: Icons.copy;
                        label: @tr("Copy");
                        tip: @tr("Copy");
                        tip-detail: copy-tip;
                        clicked => { root.copy-clicked(); }
                    }
                }
            }
        }
    }

    Card {
        title: @tr("Recent activity");
        keywords: @tr("search" => "mcp ai log history what the ai did refused");
        icon: Icons.notes;
        hue: Theme.plugin-hue("extras");
        if log.length == 0: Status { text: log-empty; }
        for row in log: Rectangle {
            min-height: Theme.row;
            accessible-role: text;
            accessible-label: row.time + ", " + row.who + ", " + row.text;
            HorizontalLayout {
                spacing: Theme.gap;
                Text {
                    width: Theme.u(31);
                    text: row.time;
                    font-family: Theme.font;
                    font-size: Theme.small;
                    color: Theme.faint;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                Text {
                    width: Theme.u(45);
                    text: row.who;
                    font-family: Theme.font;
                    font-size: Theme.small;
                    color: Theme.ink2;
                    overflow: elide;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                Text {
                    horizontal-stretch: 1;
                    min-width: 1px;
                    text: row.text;
                    font-family: Theme.font;
                    font-size: Theme.body;
                    color: row.kind == "refused" ? Theme.warn : Theme.ink;
                    overflow: elide;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
    }
}

// Half of the split header button: a raised segment with its own hover, focus and press, and the thick outline while the AI is changing things
component Segment inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> label;
    in property <string> tip;
    in property <string> tip-detail;
    // The outline of state, in the accent while it is on
    in property <bool> outlined;
    callback clicked;
    accessible-role: button;
    accessible-label: label;
    accessible-description: tip-detail != "" ? tip-detail : tip;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }
    border-radius: Theme.r-ctl;
    border-width: outlined ? Theme.stroke : 0px;
    border-color: Theme.accent;
    background: !enabled ? Theme.trough : touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : Theme.raise;
    animate background, border-width { duration: Motion.tone-for(touch.pressed); easing: Motion.tone; }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") { clicked(); return accept; }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: Theme.r-ctl; x: 0px; y: 0px; width: parent.width; height: parent.height; }
    usage := Tip { says: root.tip; detail: root.tip-detail; hover: touch.has-hover; inert: !root.enabled; focused: focus.has-focus && KeyFocus.keyboard; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { usage.press(); } }
        scroll-event(e) => { usage.wheel(); reject }
        clicked => { root.clicked(); }
    }
    @children
}

// The header's MCP button, there while the plugin is on: two raised segments side by side. Left: whether an AI app is connected, and open the
// MCP settings. Right: undo what the AI changed. activity is "" at rest, "read" while it looks at things and "change" while it moves things,
// and fades back on its own.
export component McpButton inherits Rectangle {
    in property <bool> shown;
    in property <bool> connected;
    in property <string> activity;
    in property <bool> can-undo;
    in property <string> open-label;
    in property <string> open-tip;
    in property <string> undo-label;
    in property <string> undo-tip;
    callback open;
    callback undo;
    visible: shown;
    height: Theme.u(18);
    width: shown ? Theme.u(18) + Theme.u(1) + Theme.u(18) : 0px;
    HorizontalLayout {
        spacing: Theme.u(1);
        Segment {
            width: Theme.u(18);
            label: open-label;
            tip: @tr("MCP");
            tip-detail: open-tip;
            outlined: activity != "";
            clicked => { root.open(); }
            // The MCP glyph on a raised square like the bar's other buttons: an AI app's work on the picture is the outline
            // (the Segment's own), and whether one is connected is in the tooltip
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.plug;
                        tint: connected ? Theme.ink : Theme.ink2;
                        width: Theme.icon;
                        height: Theme.icon;
                        animate tint { duration: Motion.fades ? Motion.outline-out : 0ms; easing: Motion.tone; }
                    }
                }
            }
        }
        Segment {
            width: Theme.u(18);
            enabled: can-undo;
            label: undo-label;
            tip: @tr("Undo");
            tip-detail: undo-tip;
            clicked => { root.undo(); }
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.reset;
                        tint: can-undo ? Theme.ink2 : Theme.dis;
                        width: Theme.icon;
                        height: Theme.icon;
                    }
                }
            }
        }
    }
}
