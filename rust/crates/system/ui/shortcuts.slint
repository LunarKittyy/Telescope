// The Shortcuts page (plugins/shortcuts.py's ShortcutsSection and BindingEditor): the list of shortcuts, the Everywhere
// card and the editor for one shortcut, as a popup. Texts with blanks come filled from Rust.

import { Theme, Icons, Icon, Button, IconButton, Card, RailRow, SwitchRow, ListRow, Tag, Status, Unfolding, UnfoldGroup, ChoiceField, TextField, NumberField, DialogFrame, DialogButtons, WindowBox } from "@ui-kit/ui-kit.slint";

export struct BindingRow {
    keys: string,
    does: string,
    where: string,
    ok: bool,
    copy-ok: bool,
    edit-label: string,
    remove-label: string,
}

// One setting of the action being bound: a choice (items, current) or a number typed as text
export struct ParamRow {
    label: string,
    number: bool,
    items: [string],
    current: int,
    text: string,
    shown: bool,
    // Its place among the action's settings, which the callbacks name it by
    at: int,
}

// A shortcut as a list row: what it does, with where it works (or why not) under it, its keys, edit and remove. A click anywhere on
// the row edits it, a right-click offers its command line.
component Item inherits Rectangle {
    in property <BindingRow> item;
    callback edit;
    callback remove;
    callback copy-line;
    height: Theme.row + Theme.u(8);
    menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Copy command line");
                enabled: item.copy-ok;
                activated => { root.copy-line(); }
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.edit(); }
        }
    }
    ListRow {
        width: parent.width;
        height: parent.height;
        title: item.does;
        sub: item.where;
        // The keys are a keycap; amber when the shortcut can't work, with the reason in its tooltip
        VerticalLayout {
            alignment: center;
            Tag { text: item.keys; tint: item.ok ? Theme.ink2 : Theme.warn; detail: item.ok ? "" : item.where; }
        }
        IconButton {
            icon: Icons.pencil;
            label: item.edit-label;
            tip: @tr("Edit");
            tip-detail: @tr("Change the keys of this shortcut.");
            clicked => { root.edit(); }
        }
        IconButton {
            icon: Icons.trash;
            label: item.remove-label;
            clicked => { root.remove(); }
        }
    }
}

// The key a shortcut uses: press one while it has focus
component KeyBox inherits Rectangle {
    // One physical pixel: how far a centred word is lifted so its capitals sit on the middle (see Theme.font)
    property <length> lift: 1phx;
    in property <string> text;
    callback pressed(string, bool, bool, bool, bool);
    callback cleared;
    height: Theme.row;
    horizontal-stretch: 1;
    border-radius: Theme.r-ctl;
    // The outline is the focus: this box takes the keys you press
    border-width: focus.has-focus ? Theme.stroke : Theme.ctl-outline-w(touch.has-hover, false);
    border-color: focus.has-focus ? Theme.accent : Theme.ctl-outline(touch.has-hover, false);
    background: touch.has-hover && !focus.has-focus ? Theme.hover : Theme.raise;
    accessible-role: text-input;
    accessible-label: @tr("Key");
    accessible-value: text;
    forward-focus: focus;
    touch := TouchArea { clicked => { focus.focus(); } }
    focus := FocusScope {
        key-pressed(e) => {
            root.pressed(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
            accept
        }
    }
    HorizontalLayout {
        padding-left: Theme.u(6);
        padding-right: Theme.u(2);
        Text {
            y: -lift;
            horizontal-stretch: 1;
            // Unfocused and empty: QKeySequenceEdit's own placeholder
            text: root.text != "" ? root.text : focus.has-focus ? @tr("Press a key") : @tr("Press shortcut");
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: root.text != "" ? Theme.w-value : Theme.w-label;
            color: root.text != "" ? Theme.ink : Theme.faint;
            vertical-alignment: center;
        }
        if root.text != "": IconButton {
            bare: true;
            width: Theme.row - Theme.u(4);
            height: Theme.row - Theme.u(4);
            y: (parent.height - self.height) / 2;
            icon: Icons.x;
            icon-size: Theme.icon-small;
            label: @tr("Clear");
            clicked => { root.cleared(); focus.focus(); }
        }
    }
}

export component ShortcutsSettings inherits VerticalLayout {
    in property <[BindingRow]> rows;
    in property <string> note-text;
    in property <bool> system-shown;
    in property <bool> notify;
    // The editor
    in property <bool> editor-open;
    in property <string> query;
    in property <[string]> controls;
    // Which rows are a group's heading rather than a control
    in property <[bool]> control-headings;
    in property <int> control: -1;
    in property <[ParamRow]> params;
    in property <string> keys-text;
    in property <bool> global: true;
    in property <string> problem;
    in property <bool> save-enabled;
    in property <bool> copy-enabled: true;
    in property <string> copy-text;
    in property <string> copy-tip;
    callback add;
    callback edit(int);
    callback remove(int);
    callback copy-line(int);
    callback open-system;
    callback notify-toggled(bool);
    callback search(string);
    callback control-picked(int);
    callback param-picked(int, int);
    callback param-edited(int, string);
callback param-committed(int, string);
    callback param-step(int, int);
    callback key-pressed(string, bool, bool, bool, bool);
    callback key-cleared;
    callback global-toggled(bool);
    callback copy-command;
    callback save;
    callback cancel;
    spacing: Theme.u(7);
    // Which way the editor was left
    property <bool> saving;
    // The editor's problem line keeps its last words while it folds away
    property <string> held-problem;
    changed problem => { if (problem != "") { held-problem = problem; } }
    init => { held-problem = problem; }

    changed editor-open => {
        if (self.editor-open) {
            root.saving = false;
            editor.show();
        } else {
            editor.close();
        }
    }


    Card {
        title: @tr("Shortcuts");
        keywords: @tr("search" => "hotkey hotkeys keybind keybinding key bindings keys push to talk mute add remove");
        icon: Icons.keyboard;
        hue: Theme.plugin-hue("extras");
        has-action: true;
        action-icon: Icons.plus;
        action-label: @tr("Pick a control and the key for it");
        action-text: @tr("Add");
        action => { root.add(); }
        for row[i] in rows: Item {
            item: row;
            edit => { root.edit(i); }
            remove => { root.remove(i); }
            copy-line => { root.copy-line(i); }
        }
        if rows.length == 0: Status { text: @tr("No shortcuts yet"); }
    }

    Card {
        title: @tr("Everywhere");
        keywords: @tr("search" => "global system wide hotkeys background other apps");
        icon: Icons.monitor;
        hue: Theme.plugin-hue("extras");
        RailRow {
            icon: Icons.monitor;
            label: @tr("Desktop shortcut settings");
            tip-detail: note-text;
            named: true;
            hue: Theme.plugin-hue("extras");
            keywords: @tr("search" => "global hotkeys portal kde plasma gnome desktop keys rebind");
            if system-shown: Button {
                text: @tr("Open");
                tip: @tr("Global shortcuts");
                tip-detail: @tr("Where your desktop lets you change the keys of global shortcuts.");
                clicked => { root.open-system(); }
            }
        }
        SwitchRow {
            icon: Icons.bell;
            label: @tr("Notify when one runs");
            tip: @tr("Notify when one runs");
            tip-detail: @tr("While Telescope is in the background");
            keywords: @tr("search" => "notification notify toast confirmation popup");
            hue: Theme.plugin-hue("extras");
            checked: notify;
            toggled(on) => { root.notify-toggled(on); }
        }
    }

    editor := PopupWindow {
        close-policy: no-auto-close;
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        // A popup takes on a new size a frame after its content changes, which showed as a flicker. So this one stays the
        // window's size, see-through, and the frame inside follows its rows in the same frame
        width: WindowBox.cover-w(min(root.width, 520px));
        height: WindowBox.cover-h(editor-frame.preferred-height);
        editor-frame := DialogFrame {
            // BindingEditor's minimum width
            x: WindowBox.left(self.width);
            // By a typical height, not its own: each search can change its rows, and it mustn't hop up and down while typing
            y: WindowBox.top(460px);
            width: min(root.width, 520px);
            height: self.preferred-height;
            dismissable: true;
            // Cancel and Save fade the dialog out; what they decided is said when it is gone
            left => { if (root.saving) { root.save(); } else { root.cancel(); } }
            title: @tr("Keyboard shortcut");
            VerticalLayout {
                spacing: Theme.gap;
                RailRow {
                    icon: Icons.search;
                    label: @tr("Find");
                    hue: Theme.plugin-hue("extras");
                    enabled: true;
                    TextField {
                        // BindingEditor opens with the search box focused
                        init => { self.focus(); }
                        y: (parent.height - self.height) / 2;
                        horizontal-stretch: 1;
                        text: query;
                        placeholder: @tr("Search");
                        label: @tr("Find");
                        clearable: true;
                        edited(t) => { root.search(t); }
                    }
                }
                RailRow {
                    icon: Icons.sliders;
                    label: @tr("Control");
                    hue: Theme.plugin-hue("extras");
                    enabled: true;
                    ChoiceField {
                        compact: true;
                        y: (parent.height - self.height) / 2;
                        caption: @tr("Control");
                        items: controls;
                        headings: control-headings;
                        current: control;
                        picked(i) => { root.control-picked(i); }
                    }
                }
                for p in params: RailRow {
                    has-icon: false;
                    named: true;
                    label: p.label;
                    if !p.number: ChoiceField {
                        compact: true;
                        y: (parent.height - self.height) / 2;
                        caption: p.label;
                        items: p.items;
                        current: p.current;
                        picked(c) => { root.param-picked(p.at, c); }
                    }
                    if p.number: NumberField {
                        y: (parent.height - self.height) / 2;
                        horizontal-stretch: 1;
                        value: p.text;
                        keeps-focus: true;
                        label: p.label;
                        edited(t) => { root.param-edited(p.at, t); }
                        committed(t) => { root.param-committed(p.at, t); }
                        step(d) => { root.param-step(p.at, d); }
                    }
                }
                RailRow {
                    icon: Icons.keyboard;
                    label: @tr("Key");
                    hue: Theme.plugin-hue("extras");
                    enabled: true;
                    KeyBox {
                        y: (parent.height - self.height) / 2;
                        text: keys-text;
                        pressed(t, c, a, s, m) => { root.key-pressed(t, c, a, s, m); }
                        cleared => { root.key-cleared(); }
                    }
                }
                SwitchRow {
                    icon: Icons.monitor;
                    label: @tr("Also works while another app is in front");
                    hue: Theme.plugin-hue("extras");
                    checked: global;
                    toggled(on) => { root.global-toggled(on); }
                }
                UnfoldGroup {
                    Unfolding {
                        open: problem != "";
                        lead: 0px;
                        RailRow {
                            has-icon: false;
                            Status { text: held-problem; detail: held-problem; kind: "warn"; }
                        }
                    }
                }
                DialogButtons {
                    Button {
                        text: copy-text;
                        tip: @tr("Copy");
                        tip-detail: copy-tip;
                        dialog: true;
                        enabled: copy-enabled;
                        clicked => { root.copy-command(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Cancel"); dialog: true; clicked => { root.saving = false; editor-frame.leave(); } }
                    Button { text: @tr("Save"); dialog: true; role: "primary"; hue: Theme.plugin-hue("extras"); enabled: save-enabled; clicked => { root.saving = true; editor-frame.leave(); } }
                }
            }
        }
    }
}
