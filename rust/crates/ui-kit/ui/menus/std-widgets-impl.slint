// How a ContextMenuArea draws. compile.rs puts this folder on Slint's include path, which it searches before its own
// style, so right-click menus get the app's colours and the width of their longest entry (Slint's own draw in the style's
// palette and at least 280px wide). A document with Slint's std-widgets goes without this file, see compile.rs.

import { Theme } from "../theme.slint";
import { WindowBox } from "../widgets/dialog.slint";
import { MenuSurface, MenuItem } from "../widgets/menu.slint";
import { Motion } from "../widgets/motion.slint";

// Slint asks this file for these too, and its own can't be imported. The app has no menu bar.
export component MenuBarImpl { }

// A tooltip's popup: the kit's TipBody is its whole look, so this only gives the popup the size of what's inside
export component ToolTipImpl inherits Rectangle {
    in property <styled-text> text;
    VerticalLayout {
        @children
    }
}

export component PopupMenuImpl inherits Window {
    in property <[MenuEntry]> entries: [];
    callback sub-menu(menu-entry: MenuEntry) -> [MenuEntry];
    callback activated(menu-entry: MenuEntry);
    callback close-popup();
    property <int> current: -1;
    // A pick runs at once and the menu eases out after it; Escape eases it out too (a click outside is Slint's own close)
    property <bool> leaving;
    function leave() { leaving = true; }
    Timer {
        interval: Motion.fade-out + 40ms;
        running: root.leaving;
        triggered => { root.close-popup(); }
    }
    function pick(entry: MenuEntry) {
        if (!leaving) {
            root.activated(entry);
            root.leave();
        }
    }
    function step(by: int) {
        let next = current < 0 && by < 0 ? entries.length - 1 : mod(current + by + entries.length, entries.length);
        current = entries[next].is-separator ? mod(next + by + entries.length, entries.length) : next;
    }
    forward-focus: scope;
    background: transparent;
    max-width: WindowBox.width > 0 ? WindowBox.width - 16px : 4000px;
    scope := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.UpArrow) { step(-1); return accept; }
            if (e.text == Key.DownArrow) { step(1); return accept; }
            if (e.text == Key.Return && current >= 0 && entries[current].enabled) { pick(entries[current]); return accept; }
            if (e.text == Key.Escape) { root.leave(); return accept; }
            reject
        }
        MenuSurface {
            leaving: root.leaving;
            VerticalLayout {
                padding: Theme.u(2.5);
                widest := VerticalLayout {
                    height: 0px;
                    visible: false;
                    for entry in entries: Text {
                        text: entry.title;
                        font-family: Theme.font;
                        font-size: Theme.body;
                    }
                }
                for entry[i] in entries: MenuItem {
                    preferred-width: widest.preferred-width + Theme.u(8);
                    title: entry.title;
                    separator: entry.is-separator;
                    enabled: entry.enabled;
                    current: root.current == i;
                    hovered => { root.current = i; }
                    left => { root.current = -1; }
                    activate => { root.pick(entry); }
                }
            }
        }
    }
}
