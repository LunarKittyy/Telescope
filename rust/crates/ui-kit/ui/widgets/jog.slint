// A jog: a handle on a short track that springs back to the middle when let go. Drag it either way and the further it goes the more it
// asks for, and the owner keeps going for as long as it's held out. A click at one side of the track is one small step that way.

import { Theme } from "../theme.slint";
import { Reveal } from "folds.slint";
import { FocusRing, KeyFocus } from "basics.slint";
import { Tip } from "tip.slint";
import { Settle } from "motion.slint";
import { FineAxis } from "fine.slint";

export component Jog inherits Rectangle {
    // What the two ends are called, in the track's own corners
    in property <string> near-text;
    in property <string> far-text;
    // What a screen reader calls it
    in property <string> label;
    in property <string> tip;
    in property <string> tip-detail;
    // A last, smaller and dimmer line: what a gesture does ("Double-click to reset")
    in property <string> tip-hint;
    in property <[string]> tip-keys;
    in property <bool> enabled: true;
    in property <color> hue: Theme.accent;
    // How far the handle is from the middle, -1 (all the way toward the first end) to 1. Asked for in 48ths, so a drag tells the owner
    // about 100 different places and no more.
    out property <float> offset;
    // The handle moved to a new place, or went back to 0 because it was let go
    callback moved(float);
    // A click at one side (-1 or 1), or the arrow keys
    callback tapped(int);
    // Where the handle's middle goes at the ends: the track's padding and half a handle in from its edge
    property <length> reach: root.width / 2 - 8px - handle.width / 2;
    property <bool> dragging;
    property <bool> on-handle;
    property <length> pressed-at;
    property <int> asked;
    // Shift while dragging goes finer: the handle follows a tenth of the pointer's travel
    fine := FineAxis { }
    property <bool> shift-now;
    function drag-to(x: length) {
        offset = clamp((fine.at(x / 1px, shift-now, -100000, 100000) * 1px - root.width / 2) / max(1px, reach), -1, 1);
        let q = round(offset * 48);
        if (q != asked) {
            asked = q;
            moved(q / 48);
        }
    }
    function let-go() {
        dragging = false;
        offset = 0;
        if (asked != 0) {
            asked = 0;
            moved(0);
        }
    }
    out property <string> control-kind: "jog";
    height: Theme.row;
    horizontal-stretch: 1;
    min-width: Theme.u(48);
    border-radius: Theme.r-ctl;
    background: !enabled ? Theme.raise.mix(Theme.card, 0.4) : touch.has-hover || dragging ? Theme.hover : Theme.raise;
    border-width: !enabled ? Theme.outline-w : Theme.ctl-outline-w(touch.has-hover, dragging);
    border-color: !enabled ? Theme.dis-outline : Theme.ctl-outline(touch.has-hover, dragging);
    accessible-role: slider;
    accessible-label: label;
    accessible-description: tip-detail == "" ? tip : tip + ". " + tip-detail;
    accessible-action-increment => { if (enabled) { tapped(1); } }
    accessible-action-decrement => { if (enabled) { tapped(-1); } }
    changed enabled => { if (!enabled && dragging) { let-go(); } }
    forward-focus: focus;
    focus := FocusScope {
        focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
        focus-lost => { if (dragging) { let-go(); } }
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.modifiers.control || e.modifiers.meta || e.modifiers.alt) { return reject; }
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) { tapped(-1); return accept; }
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) { tapped(1); return accept; }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: 7px; width: parent.width + 2 * Theme.stroke; height: parent.height + 2 * Theme.stroke; }
    usage := Tip { says: root.tip; detail: root.tip-detail; hint: root.tip-hint; keys: root.tip-keys; hover: touch.has-hover; inert: !root.enabled; focused: focus.has-focus && KeyFocus.keyboard; }
    Text {
        x: 11px;
        width: root.width / 2 - 24px;
        height: parent.height;
        text: root.near-text;
        font-family: Theme.font;
        font-size: Theme.small;
        color: enabled ? Theme.faint : Theme.dis;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    Text {
        x: root.width / 2 + 13px;
        width: root.width / 2 - 24px;
        height: parent.height;
        text: root.far-text;
        font-family: Theme.font;
        font-size: Theme.small;
        color: enabled ? Theme.faint : Theme.dis;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    // The middle, where it comes to rest: a mark the handle sits over
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.stroke;
        height: Theme.u(6);
        border-radius: 1px;
        background: enabled ? Theme.line-hover : Theme.line-strong;
    }
    handle := Rectangle {
        width: Theme.u(7);
        height: Theme.u(11);
        y: (parent.height - self.height) / 2;
        x: (parent.width - self.width) / 2 + glide.value * root.reach;
        border-radius: Theme.r-handle;
        background: !enabled ? Theme.dis : touch.pressed || dragging ? hue.brighter(0.15) : touch.has-hover ? hue.brighter(0.1) : hue;
    }
    // Back to the middle in a moment rather than a jump, but never behind a hand that's moving it
    glide := Settle { to: root.offset; snap: root.dragging; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.ew-resize;
        scroll-event(e) => { usage.wheel(); reject }
        pointer-event(e) => {
            shift-now = e.modifiers.shift;
            if (e.kind == PointerEventKind.down) { usage.press(); }
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                focus.focus();
                fine.begin(self.mouse-x / 1px);
                pressed-at = self.mouse-x;
                on-handle = abs(self.mouse-x - root.width / 2) <= handle.width / 2 + 4px;
                // A press on the handle holds it at once, one beside it waits to see whether it's a click or a drag
                dragging = on-handle;
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                if (dragging) { let-go(); }
                else if (!on-handle) { tapped(self.mouse-x < root.width / 2 ? -1 : 1); }
            }
            if (e.kind == PointerEventKind.cancel && dragging) { let-go(); }
        }
        moved => {
            if (self.pressed) {
                if (!dragging && abs(self.mouse-x - pressed-at) > 4px) {
                    dragging = true;
                    fine.begin(self.mouse-x / 1px);
                }
                if (dragging) { drag-to(self.mouse-x); }
            }
        }
    }
}
