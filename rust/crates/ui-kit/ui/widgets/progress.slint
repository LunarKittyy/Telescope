// Kind "progress": how far something has got, as a bar that fills from the left. `value` runs 0 to 1. A card or banner names the two colours
// when it sits on a surface where the resting ones would vanish.

import { Theme } from "../theme.slint";

export component ProgressBar inherits Rectangle {
    out property <string> control-kind: "progress";
    in property <float> value;
    in property <color> track: Theme.trough;
    in property <color> fill: Theme.accent;
    height: Theme.track;
    border-radius: self.height / 2;
    background: root.track;
    clip: true;
    accessible-role: AccessibleRole.progress-indicator;
    accessible-value: Math.round(root.value * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    Rectangle {
        x: 0px;
        width: parent.width * clamp(root.value, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
    }
}
