// The labelled slider row from widgets/controls.py.

import { Theme } from "../theme.slint";
import { Reveal } from "folds.slint";
import { FocusRing } from "basics.slint";
import { TipBody } from "tip.slint";

// The theme's QSlider: a quiet 4px groove and a handle in the card's hue; value_label reads it out on the right.
export component Slider inherits HorizontalLayout {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    // Where the parent says it is. A drag never writes here, so a parent's `value: zoom` keeps following zoom.
    in-out property <float> value: 0;
    // Where the person last put it, shown until the parent says something new
    property <float> local;
    property <bool> touched;
    out property <float> shown: touched ? local : value;
    changed value => { touched = false; }
    in property <float> step: 1;
    in property <string> readout;
    in property <string> label;
    in property <color> hue: Theme.accent;
    in property <bool> enabled: true;
    // false drops the readout column, for a slider with a box of its own beside it
    in property <bool> has-readout: true;
    // value_label's fits: wider than the usual column when its words need it
    in property <length> readout-width: 56px;
    // Dots on the groove (NoScrollSlider.set_snaps, at most four) that a dragged handle sticks to within snap-px; only a
    // drag snaps, keys and clicks on the groove step freely
    in property <[float]> marks;
    in property <length> snap-px: 5px;
    // The row it sits in: a control_row's 36px, or a bare QSlider's 20px
    in property <length> row-height: 36px;
    // A double-click puts the slider back here (NoScrollSlider.set_default)
    in property <bool> has-default;
    in property <float> default-value;
    // A tooltip on the slider and its readout
    in property <string> tip;
    callback moved(float);
    callback released(float);
    spacing: 8px;
    horizontal-stretch: 1;
    track := Rectangle {
        horizontal-stretch: 1;
        min-width: 84px;
        height: row-height;
        property <length> inset: 10px; // padding 3px + groove margin 7px: where the handle's centre runs
        property <float> fraction: (shown - minimum) / max(0.0001, maximum - minimum);
        // The value a dragged handle at `v` sticks to: the first mark within reach, else itself
        function snapped(v: float) -> float {
            if (marks.length > 0 && abs((marks[0] - v) / max(0.0001, maximum - minimum) * (track.width - 2 * track.inset)) <= snap-px) { return marks[0]; }
            if (marks.length > 1 && abs((marks[1] - v) / max(0.0001, maximum - minimum) * (track.width - 2 * track.inset)) <= snap-px) { return marks[1]; }
            if (marks.length > 2 && abs((marks[2] - v) / max(0.0001, maximum - minimum) * (track.width - 2 * track.inset)) <= snap-px) { return marks[2]; }
            if (marks.length > 3 && abs((marks[3] - v) / max(0.0001, maximum - minimum) * (track.width - 2 * track.inset)) <= snap-px) { return marks[3]; }
            return v;
        }
        accessible-role: slider;
        accessible-label: label;
        accessible-value: shown;
        accessible-value-minimum: minimum;
        accessible-value-maximum: maximum;
        accessible-value-step: step;
        accessible-description: tip;
        forward-focus: slider-focus;
        slider-focus := FocusScope {
            focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
            enabled: root.enabled;
            key-pressed(e) => {
                if (e.text == Key.LeftArrow) { local = max(minimum, shown - step); touched = true; moved(local); released(local); return accept; }
                if (e.text == Key.RightArrow) { local = min(maximum, shown + step); touched = true; moved(local); released(local); return accept; }
                reject
            }
        }
        Rectangle {
            x: track.inset;
            width: parent.width - 2 * track.inset;
            height: 4px;
            border-radius: 2px;
            background: enabled ? Theme.border-strong : Theme.surface-raise;
        }
        for mark in marks: Rectangle {
            x: track.inset - 2.5px + (mark - minimum) / max(0.0001, maximum - minimum) * (track.width - 2 * track.inset);
            y: (parent.height - 5px) / 2;
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: enabled ? Theme.text-faint : Theme.text-disabled;
        }
        handle := Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            x: track.inset - 7px + track.fraction * (track.width - 2 * track.inset);
            background: !enabled ? Theme.text-disabled : (touch.has-hover || touch.pressed) ? hue.brighter(0.15) : hue;
            FocusRing { shown: slider-focus.has-focus; radius: 7px; width: parent.width + 4px; height: parent.height + 4px; }
        }
        touch := TouchArea {
            enabled: root.enabled;
            property <float> picked: clamp((self.mouse-x - track.inset) / (track.width - 2 * track.inset), 0, 1);
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    local = round((minimum + picked * (maximum - minimum)) / step) * step;
                    touched = true;
                    root.moved(local);
                }
                if (e.kind == PointerEventKind.move && self.pressed) {
                    local = snapped(round((minimum + picked * (maximum - minimum)) / step) * step);
                    touched = true;
                    root.moved(local);
                }
                if (e.kind == PointerEventKind.up) {
                    released(shown);
                }
            }
            moved => {
                if (self.pressed) {
                    local = snapped(round((minimum + picked * (maximum - minimum)) / step) * step);
                    touched = true;
                    root.moved(local);
                }
            }
            double-clicked => {
                if (has-default) {
                    local = default-value;
                    touched = true;
                    root.moved(local);
                    root.released(local);
                }
            }
        }
        if tip != "": Tooltip { TipBody { says: tip; } }
    }
    if has-readout: Text {
        width: readout-width;
        text: readout;
        font-family: Theme.font;
        font-size: Theme.body;
        font-weight: 600;
        // QLabel#val outranks QLabel:disabled in the theme, so a disabled readout keeps the accent's soft shade
        color: enabled ? hue : Theme.accent-soft;
        horizontal-alignment: right;
        vertical-alignment: center;
        if tip != "": Tooltip { TipBody { says: tip; } }
    }
}
