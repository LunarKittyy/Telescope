// What a tooltip shows, styled like QToolTip in theme.py: raised fill, hover border, 6px corners, wrapping at about 64
// characters. Slint's Tooltip can't be inherited, so it goes inside one: Tooltip { TipBody { says: "..."; } }

import { Theme } from "../theme.slint";
import { WindowBox } from "dialog.slint";

export component TipBody inherits Rectangle {
    in property <string> says;
    background: Theme.sel;
    border-radius: Theme.r-ctl;
    out property <string> control-kind: "tip";
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        Text {
            text: root.says;
            max-width: WindowBox.width > 0 ? min(470px, WindowBox.width - 34px) : 470px;
            wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size);
            font-family: Theme.font;
            font-size: Theme.body;
            color: Theme.text;
        }
    }
}

// Tells a control whether it is being used, which keeps its tooltip down: a press or the wheel on it counts, until the
// pointer leaves it. A Tooltip inside `if !usage.used` is then gone and its popup with it.
export component TipUse inherits Rectangle {
    out property <string> control-kind: "helper";
    in property <bool> hover;
    out property <bool> used;
    // The wheel makes the TouchArea drop its hover for a moment, which isn't leaving
    property <bool> wheeled;
    width: 0px;
    height: 0px;
    public function press() { used = true; }
    public function wheel() { used = true; wheeled = true; }
    changed hover => {
        if (!hover) {
            if (wheeled) { wheeled = false; } else { used = false; }
        }
    }
}
