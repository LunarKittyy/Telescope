// One setting as a row of a card, and the small tag that marks one (widgets/controls.py: setting_row, Tag).

import { Theme } from "../theme.slint";
import { Tip } from "tip.slint";
import { Icon } from "basics.slint";
import { Motion } from "motion.slint";

// settings_search.keywords: carried as a zero-size Text with accessible-role none, which is no accessible node at all (the search reads "kind", a unit separator, then the words)
export component SearchWords inherits Rectangle {
    out property <string> control-kind: "helper";
    in property <string> words;
    // A card's words are for what's under it too
    in property <bool> card;
    // What a control offers: a row is found by the choices in it too
    in property <bool> control;
    width: 0px;
    height: 0px;
    Text {
        width: 0px;
        height: 0px;
        color: transparent;
        accessible-role: none;
        text: (card ? "card-words" : control ? "control-words" : "setting-words") + "\u{1f}" + words;
    }
}

// setting_row: its name on the left, its controls on the right, on the card itself. The settings search finds
// it by name and small print.
export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> keywords;
    // A disabled row greys its text, as Qt greys a disabled strip's labels
    in property <bool> enabled: true;
    // setting_row's below: a note across the row's width under the name and the controls
    in property <string> note;
    in property <color> note-color: Theme.text-dim;
    min-height: Theme.row + Theme.u(8);
    out property <string> control-kind: "strip";
    // No box of its own: a raised strip inside a card stacked two backgrounds and hid the switch's track, so the row sits on the card
    accessible-role: groupbox;
    accessible-id: "setting";
    accessible-label: title;
    accessible-description: sub;
    if keywords != "": SearchWords { words: keywords; }
    strip-hover := TouchArea { enabled: root.enabled; }
    VerticalLayout {
        padding-top: Theme.u(4);
        padding-bottom: Theme.u(4);
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 1px;
                alignment: center;
                Text {
                    text: title;
                    font-family: Theme.font;
                    font-size: Theme.body;
                    color: enabled ? Theme.text : Theme.text-disabled;
                    wrap: word-wrap;
                    line-height-factor: Theme.line-factor(self.font-size);
                    // The row is named by it already, and so is a switch in it
                    accessible-role: none;
                    // What the row explains is a tooltip, not a line of its own
                    Tip { says: root.sub; hover: strip-hover.has-hover; }
                }
            }
            // Qt centres the controls on the strip
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    @children
                }
            }
        }
        if note != "": Text {
            text: note;
            font-family: Theme.font;
            font-size: Theme.small;
            color: note-color;
            wrap: word-wrap;
            line-height-factor: Theme.line-factor(self.font-size);
        }
    }
}

// What the settings search finds a row by, for a row whose own text a screen reader skips (its switch says it). It covers the
// text it sits in (give it that size) and, like SearchWords, is not announced.
export component SettingMark inherits Rectangle {
    out property <string> control-kind: "helper";
    in property <string> name;
    in property <string> keywords;
    accessible-role: none;
    accessible-id: "setting";
    accessible-label: name;
    if keywords != "": SearchWords { words: keywords; }
}

// Tag: a small raised label in a colour at 14% under its text in that colour ("Experimental"), with `r-ctl` corners like every control.
// `detail` is its tooltip body, where the word alone needs a sentence.
export component Tag inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <color> tint: Theme.warn;
    height: 20px;
    width: label.preferred-width + 16px;
    border-radius: Theme.r-ctl;
    out property <string> control-kind: "badge";
    background: tint.with-alpha(0.14);
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    accessible-description: detail;
    label := Text {
        text: root.text;
        font-family: Theme.font;
        font-size: floor(Theme.body * 0.88 / 1px) * 1px; // 0.88 of the body size, which Qt draws at 11
        font-weight: 600;
        color: root.tint.brighter(0.08);
        accessible-role: none;
    }
    if detail != "": Tip { says: root.text; detail: root.detail; inert: true; }
}

// Kind "status": what a card is doing, as one coloured word or short phrase on one line (never a sentence): "Streaming", "Stopped",
// "Sheet unclear". `kind` is "" (quiet), "ok", "warn" or "err". `detail` is a sentence for the tooltip, the way a status explains itself.
// It takes the room it is given and ends in an ellipsis; it has no surface.
export component Status inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <string> kind;
    in property <length> font-size: Theme.body;
    in property <int> font-weight: Theme.w-value;
    in property <string> horizontal: "start";
    out property <string> control-kind: "status";
    out property <color> ink: kind == "ok" ? Theme.ok : kind == "warn" ? Theme.warn : kind == "err" ? Theme.err : Theme.ink2;
    height: Theme.row;
    min-width: 0px;
    horizontal-stretch: 1;
    preferred-width: label.preferred-width;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    accessible-description: detail;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-family: Theme.font;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.ink;
        animate color { duration: Motion.tone-for(false); easing: Motion.tone; }
        horizontal-alignment: root.horizontal == "end" ? right : root.horizontal == "center" ? center : left;
        vertical-alignment: center;
        overflow: elide;
        wrap: no-wrap;
        accessible-role: none;
    }
    if detail != "" || label.preferred-width > root.width: Tip { says: detail != "" ? root.text : ""; detail: root.detail; inert: true; }
}

// Kind "row": a row of a list in a dialog or a card (your devices, a folder list): a raised strip with the name and a dim line under it
// on the left and the row's own buttons (raised icon buttons) on the right. The names of a list line up on the strip's left edge, and
// the strips have the card's gap between them, so each is plainly one row. Give it the buttons as children.
export component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <image> icon;
    in property <bool> has-icon;
    in property <color> icon-tint: Theme.ink2;
    in property <bool> enabled: true;
    out property <string> control-kind: "list-row";
    height: sub != "" ? Theme.row + Theme.u(8) : Theme.row + Theme.u(4);
    background: enabled ? Theme.raise : Theme.raise.mix(Theme.card, 0.4);
    border-radius: Theme.r-ctl;
    accessible-role: groupbox;
    accessible-label: title;
    accessible-description: sub;
    HorizontalLayout {
        padding-left: Theme.u(6);
        padding-right: Theme.u(4);
        spacing: Theme.u(4);
        if has-icon: Icon {
            source: icon;
            tint: root.enabled ? icon-tint : Theme.dis;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: Theme.u(0.5);
            Text {
                text: root.title;
                font-family: Theme.font;
                font-size: Theme.body;
                font-weight: Theme.w-value;
                color: root.enabled ? Theme.ink : Theme.dis;
                overflow: elide;
                accessible-role: none;
            }
            if sub != "": Text {
                text: root.sub;
                font-family: Theme.font;
                font-size: Theme.small;
                color: root.enabled ? Theme.ink2 : Theme.dis;
                overflow: elide;
                accessible-role: none;
            }
        }
        HorizontalLayout {
            spacing: Theme.gap;
            alignment: end;
            padding-top: (root.height - Theme.row) / 2;
            padding-bottom: (root.height - Theme.row) / 2;
            @children
        }
    }
}
