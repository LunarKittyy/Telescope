// On and off: the switch, and the icon tile that holds one (widgets/controls.py).

import { Theme } from "../theme.slint";
import { Reveal } from "folds.slint";
import { Icon, FocusRing } from "basics.slint";
import { TipBody } from "tip.slint";
import { ShortcutMenu } from "shortcut-menu.slint";

// common.Switch: a 36x20 track at the row's end.
export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    in property <bool> enabled: true;
    // A tooltip, when there's something to say beyond the label
    in property <string> tip;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    // A switch that's risky to leave on stays red while it is
    in property <bool> danger;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: !enabled ? (checked ? Theme.border-strong : Theme.surface-raise)
        : checked && danger ? Theme.err
        : checked ? (touch.has-hover ? Theme.fill-hover : Theme.fill)
        : (touch.has-hover ? Theme.border-hover : Theme.border-strong);
    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { checked = !checked; toggled(checked); }
    forward-focus: focus;
    focus := FocusScope {
        focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == " ") { checked = !checked; toggled(checked); return accept; }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: 10px; width: parent.width + 4px; height: parent.height + 4px; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { checked = !checked; toggled(checked); }
    }
    if root.shortcut != "": ShortcutMenu { action: root.shortcut; }
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        y: 3px;
        x: checked ? parent.width - 17px : 3px;
        background: !enabled ? Theme.text-disabled : checked ? white : Theme.text-dim;
        animate x { duration: 90ms; }
    }
    if tip != "": Tooltip { TipBody { says: tip; } }
}

// controls.SwitchTile: icon, name and switch in a small raised tile; the icon takes the card's hue while on.
export component SwitchTile inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <color> hue: Theme.accent;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    callback toggled(bool);
    height: 40px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    background: Theme.surface-raise;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 9px;
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { sw.checked = !sw.checked; sw.toggled(sw.checked); }
    }
    if root.shortcut != "": ShortcutMenu { action: root.shortcut; }
    // The QSS border sits outside the layout's 10px margins
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 9px;
        Icon {
            source: icon;
            tint: checked && enabled ? hue : Theme.text-dim;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            horizontal-stretch: 1;
            font-family: Theme.font;
            font-size: Theme.body;
            color: enabled ? Theme.text : Theme.text-disabled;
            vertical-alignment: center;
            wrap: word-wrap; line-height-factor: Theme.line-factor(self.font-size);
        }
        Rectangle {
            width: 36px;
            sw := Switch {
                y: (parent.height - self.height) / 2;
                checked <=> root.checked;
                enabled: root.enabled;
                label: root.text;
                toggled(on) => { root.toggled(on); }
            }
        }
    }
}
