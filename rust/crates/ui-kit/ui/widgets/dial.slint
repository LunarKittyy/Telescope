// A row of stops to drag or scroll through, for a value that moves in steps (ISO, shutter time).

import { Theme } from "../theme.slint";
import { Reveal } from "folds.slint";
import { FocusRing, TouchRing, KeyFocus } from "basics.slint";
import { Tip } from "tip.slint";
import { ShortcutMenu } from "shortcut-menu.slint";
import { Motion, Settle, Tone, Fade, Flick } from "motion.slint";
import { Fine, FineAxis } from "fine.slint";

// Kind "dial": a strip of ticks, one for every value, with the names of the labelled ones sliding under a mark at the centre, dragged, scrolled or keyed through, saying `moved` then `released` with the tick's place in `stops`; it sits in the card, never in a bubble. Shift while dragging or scrolling goes a tenth as far and, on a `free` dial, between the ticks (`moved-between`); a click on the value types one. See STYLE.md.
export component Dial inherits Rectangle {
    // Every value the dial can sit on, in order, as it is written ("100", "1/60"): a tick each
    in property <[string]> stops;
    // How many ticks make a step of the scale (a camera's full stop is three third-stops): only every `per-label`th is named in the strip, the first being `label-from`. The rest are shown when the dial is on them
    in property <int> per-label: 1;
    in property <int> label-from: 0;
    // Where the parent says it is, as a place in `stops`. A drag never writes here, so a parent's `current: iso-index` keeps following it.
    in-out property <int> current: 0;
    // How far from that tick it is towards the next or the previous one (a fraction of a tick, -0.5 to 0.5), with the value as it reads there
    in property <float> between: 0;
    in property <string> value-text;
    // The values are not only the ticks: Shift goes between them and a typed value is the owner's to read (`typed`)
    in property <bool> free: false;
    // Counts up when the owner could not use what was typed: the numbers shake and the value stays
    in property <int> rejected: 0;
    // Where the person last put it, shown until the parent says something new
    property <int> local;
    property <float> local-between;
    property <bool> touched;
    out property <int> shown: clamp(touched ? local : current, 0, max(0, stops.length - 1));
    out property <float> shown-between: touched ? local-between : between;
    // The place it sits at, in ticks
    out property <float> shown-place: shown + shown-between;
    changed current => { touched = false; }
    changed between => { touched = false; }
    // What it is called, small in its top left corner and to a screen reader ("ISO")
    in property <string> label;
    in property <color> hue: Theme.accent;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <string> tip-detail;
    // A last, smaller and dimmer line: what a gesture does ("Double-click to reset")
    in property <string> tip-hint;
    in property <[string]> tip-keys;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    // The id of the setting it is, for the outline when something outside the window reads or changes it
    in property <string> setting;
    out property <string> control-kind: "dial";
    callback moved(int);
    // The dial sits between two ticks: the nearer tick's place and how far from it, -0.5 to 0.5
    callback moved-between(int, float);
    callback released(int);
    // A value typed over the dial's own, as it was written
    callback typed(string);
    // What the arrows move by: one tick. Shift with an arrow and the Page keys move by a tenth of the ticks
    out property <int> key-big: max(1, round((stops.length - 1) / 10));
    property <int> last-tick: max(0, stops.length - 1);
    // Every way of setting a tick from the keyboard or the wheel goes through here, saying what a drag says: moved, then released
    function set-to(i: int) {
        if (!enabled) { return; }
        let to = clamp(i, 0, last-tick);
        if (stops.length > 0 && (to != shown || shown-between != 0)) {
            strip.sync();
            quick = true;
            recent = true;
            step-timer.restart();
            local = to;
            local-between = 0;
            touched = true;
            moved(to);
            released(to);
        }
    }
    // The tick `by` ticks past the place, the way `dir` goes: from between two ticks the first step reaches the next one that way
    function step-by(dir: int, by: int) {
        let p = shown-place;
        set-to(dir > 0 ? floor(p + 0.0001) + by : ceil(p - 0.0001) - by);
    }
    // A place between the ticks, from Shift and the wheel
    function set-place(p: float) {
        if (!enabled || stops.length == 0) { return; }
        let to = clamp(p, 0, last-tick);
        let i = round(to);
        if (abs(to - shown-place) > 0.00001) {
            strip.sync();
            quick = true;
            recent = true;
            step-timer.restart();
            local = i;
            local-between = to - i;
            touched = true;
            if (to == i) { moved(i); } else { moved-between(i, to - i); }
            released(i);
        }
    }
    // The strip's place in stops, which a drag moves smoothly and which otherwise slides to the tick that is picked
    property <float> pos: strip.value;
    // Where the strip is now, in ticks, for a test
    out property <float> strip-place: strip.value;
    // A key or a wheel turn just set it: the strip is there at once. A drag follows the finger, and a tick that something else picked is slid to.
    property <bool> quick;
    // Only a finger puts the strip somewhere at once: a key or a wheel notch slides it, retargeting a slide still going
    strip := Settle { to: dragging ? drag-pos : shown-place; snap: dragging; }
    held-tone := Tone { on: held; }
    Timer {
        interval: 80ms;
        running: quick;
        triggered => { quick = false; }
    }
    property <float> drag-pos;
    property <float> drag-from;
    property <length> drag-x;
    property <bool> dragging;
    property <bool> shift-now;
    property <bool> held: dragging && touch.pressed;
    // Shift's slower going while a drag is on
    fine := FineAxis { }
    // The wheel's turns that haven't made a tick yet
    property <float> wheel-sum;
    // How far apart the labelled ticks are along the strip, and the ticks themselves
    property <length> pitch: clamp(root.width * 0.35, Theme.u(20), Theme.u(34));
    property <float> per: max(1, per-label);
    property <length> tick-pitch: pitch / per;
    property <length> mid: root.width / 2;
    property <length> big: round(Theme.body * 17 / 13 / 1px) * 1px;
    // Typing over the value
    property <bool> is-typing;
    property <bool> typing-by-key;
    function start-typing(by-key: bool) {
        if (enabled && free && stops.length > 0) {
            typing-by-key = by-key;
            is-typing = true;
        }
    }
    // A box that is open when the dial goes disabled is dropped, so nothing typed in it is sent
    changed enabled => {
        if (!enabled && is-typing) {
            is-typing = false;
            KeyFocus.given-back += 1;
        }
    }
    function typing-done(text: string, apply: bool) {
        if (is-typing) {
            is-typing = false;
            if (typing-by-key) { focus.focus(); } else { KeyFocus.given-back += 1; }
            if (apply && enabled && text != "") { touched = false; typed(text); }
        }
    }
    // A value the owner would not have: the numbers shake, one way, the other, and back
    property <int> shake-step;
    changed rejected => { shake-step = 1; }
    shaker := Flick { to: shake-step == 1 ? 1 : shake-step == 2 ? -1 : 0; }
    Timer {
        interval: 90ms;
        running: shake-step != 0;
        triggered => { shake-step = shake-step >= 3 ? 0 : shake-step + 1; }
    }
    property <length> shake-x: shaker.value * Theme.u(2);
    // The readout is smaller while the dial is being moved (a drag held, wheel notches or keys coming) and swells when it is let go (about 200 ms after the last step), and shrinks again quickly when it moves
    property <bool> recent;
    step-timer := Timer {
        interval: 200ms;
        running: root.recent;
        triggered => { root.recent = false; }
    }
    settled := Tone { on: !(held || recent); fall: 120ms; rise: 260ms; }
    // Read once as the dial is made, so it starts at its big size
    init => { settled.sync(); }
    // The readout's scale: a layer while it is scaled (femtovg hints glyphs and rounds a text scale, so a font size or a plain scale moves in whole pixels, with the same height for several frames and then a jump; a layer is a picture of the text, which scales in fractions of a pixel). At rest the scale is 1 and there is no layer, so the text is plain and pixel sharp
    out property <float> grown: (Theme.body + (big - Theme.body) * settled.value) / big;
    // What the readout says: the value, in the owner's words between two ticks
    out property <string> read: stops.length == 0 ? "" : shown-between != 0 && value-text != "" ? value-text : stops[shown];
    // The stops arriving after the dash that held their place (the phone names its ISOs late): half solid in the first frame, then up
    arriving := Fade { shown: stops.length > 0; }
    property <float> solid: Motion.between(Motion.arrive-from, 1, arriving.value);
    height: Theme.u(24);
    horizontal-stretch: 1;
    min-width: Theme.u(40);
    border-radius: Theme.r-ctl;
    border-width: !enabled ? Theme.outline-w : held ? Theme.stroke : Theme.ctl-outline-w(touch.has-hover, false);
    border-color: !enabled ? Theme.dis-outline : held ? hue : Theme.ctl-outline(touch.has-hover, false);
    background: !enabled ? Theme.raise.mix(Theme.card, 0.4)
        : held ? Theme.tint(hue)
        : touch.has-hover ? Theme.hover : Theme.raise;
    animate background, border-width, border-color { duration: Motion.tone-for(held); easing: Motion.tone; }
    accessible-role: slider;
    accessible-label: label;
    accessible-value: read;
    accessible-value-minimum: 0;
    accessible-value-maximum: max(0, stops.length - 1);
    accessible-value-step: 1;
    accessible-description: tip-detail == "" ? tip : tip + ". " + tip-detail;
    accessible-action-increment => { if (enabled) { step-by(1, 1); } }
    accessible-action-decrement => { if (enabled) { step-by(-1, 1); } }
    forward-focus: focus;
    focus := FocusScope {
        focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
        enabled: root.enabled;
        key-pressed(e) => {
            let by = e.modifiers.shift ? key-big : 1;
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) { step-by(1, by); return accept; }
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) { step-by(-1, by); return accept; }
            if (e.text == Key.PageUp) { step-by(1, key-big); return accept; }
            if (e.text == Key.PageDown) { step-by(-1, key-big); return accept; }
            if (e.text == Key.Home) { set-to(0); return accept; }
            if (e.text == Key.End) { set-to(stops.length - 1); return accept; }
            if (e.text == "\n" && free) { start-typing(true); return accept; }
            reject
        }
    }
    TouchRing { setting: root.setting; width: parent.width; height: parent.height; radius: Theme.r-ctl; }
    // The ticks: one for every value, the labelled ones taller, fading toward the ends
    for stop[t] in stops: Rectangle {
        property <bool> major: per-label <= 1 || mod(t + 1000 * per-label - label-from, per-label) == 0;
        property <length> at: mid + (t - pos) * tick-pitch;
        property <float> near: clamp((1 - abs(at - mid) / (root.width / 2)) / 0.45, 0, 1);
        x: at - Theme.u(0.5);
        y: root.height - Theme.u(3) - self.height;
        width: Theme.u(1);
        height: major ? Theme.u(3.5) : Theme.u(2);
        border-radius: Theme.u(0.5);
        background: enabled ? Theme.ink : Theme.dis;
        opacity: near * (major ? 0.55 : 0.25) * solid;
    }
    // The names of the full stops, small, sliding by with their ticks and fading out as they come to the readout, so they never lie over it; the ticks between are not named
    for stop[i] in stops: Rectangle {
        property <bool> major: per-label <= 1 || mod(i + 1000 * per-label - label-from, per-label) == 0;
        property <length> from-mid: abs(mid + (i - pos) * tick-pitch - mid);
        property <float> slots: abs(i - pos) / per;
        property <float> far: slots <= 1 ? 1 : max(0, (1.6 - slots) / 0.6);
        // Gone when its near edge comes within a hair of the readout's, in full a few pixels further out, so long names at their resting place stay clear
        property <length> inner: rt.preferred-width * grown / 2 + name.preferred-width / 2 + Theme.u(1);
        property <float> clear: clamp((from-mid - inner) / Theme.u(5), 0, 1);
        visible: major && slots < 1.6;
        x: mid + (i - pos) * tick-pitch - self.width / 2 + shake-x;
        y: Theme.u(5);
        width: pitch - Theme.u(3);
        height: Theme.u(13);
        opacity: solid * 0.45 * clear * far;
        name := Text {
            width: parent.width;
            height: parent.height;
            text: stop;
            font-family: Theme.font;
            font-size: Theme.small;
            font-weight: Theme.w-value;
            color: !enabled ? Theme.dis : Theme.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
    // The readout: always the current value, at the mark, only its text changes
    Rectangle {
        visible: stops.length > 0 && !is-typing;
        width: pitch * big / Theme.small;
        height: Theme.u(13);
        x: mid - self.width / 2 + shake-x;
        y: Theme.u(5);
        transform-scale: grown;
        Rectangle {
            cache-rendering-hint: grown < 0.9999;
            opacity: solid;
            rt := Text {
                width: parent.width;
                height: parent.height;
                text: read;
                font-family: Theme.font;
                font-size: big;
                font-weight: Theme.w-value;
                color: !enabled ? Theme.dis : Theme.ink;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
        }
    }
    if stops.length == 0: Text {
        x: mid - Theme.u(20);
        y: Theme.u(5);
        width: Theme.u(40);
        height: Theme.u(13);
        text: "-";
        font-family: Theme.font;
        font-size: big;
        font-weight: Theme.w-value;
        color: Theme.dis;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    if is-typing: TextInput {
        x: mid - self.width / 2;
        y: Theme.u(5);
        width: pitch;
        height: Theme.u(13);
        text: read;
        font-family: Theme.font;
        font-size: big;
        font-weight: Theme.w-value;
        color: Theme.ink;
        selection-background-color: Theme.fill;
        selection-foreground-color: Theme.on-fill;
        horizontal-alignment: center;
        vertical-alignment: center;
        single-line: true;
        enabled: root.enabled;
        accessible-label: root.label;
        init => { self.focus(); self.select-all(); }
        accepted => { root.typing-done(self.text, true); }
        changed has-focus => { if (!self.has-focus) { root.typing-done(self.text, false); } }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.typing-done(self.text, false);
                return accept;
            }
            reject
        }
    }
    Text {
        x: Theme.u(5);
        y: Theme.u(2.5);
        width: parent.width - Theme.u(10);
        text: label;
        font-family: Theme.font;
        font-size: Theme.tiny;
        font-weight: Theme.w-label;
        color: enabled ? Theme.ink2 : Theme.dis;
        overflow: elide;
        accessible-role: none;
    }
    // The mark the tick under it is read against
    Rectangle {
        x: mid - Theme.u(1);
        y: root.height - Theme.u(2.5) - self.height;
        width: Theme.u(2);
        height: Theme.u(5.5);
        border-radius: Theme.u(1);
        background: !enabled ? Theme.dis : Theme.lit(hue, held-tone.value);
    }
    FocusRing { shown: focus.has-focus; radius: Theme.r-ctl; width: parent.width + 2 * Theme.stroke; height: parent.height + 2 * Theme.stroke; }
    usage := Tip { says: root.tip; detail: root.tip-detail; hint: root.tip-hint; keys: root.tip-keys; shortcut: root.shortcut; hover: touch.has-hover; inert: !root.enabled; focused: focus.has-focus && KeyFocus.keyboard; }
    touch := TouchArea {
        enabled: root.enabled && !is-typing;
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        scroll-event(e) => {
            usage.wheel();
            // Shift often turns a wheel sideways
            wheel-sum += (e.delta-y != 0px ? e.delta-y : e.delta-x) / 1px;
            // A notch of a mouse wheel is 60 and makes a tick; a touchpad's smaller turns add up to one
            let turned = wheel-sum >= 0 ? floor(wheel-sum / 60) : ceil(wheel-sum / 60);
            if (turned != 0) {
                wheel-sum -= turned * 60;
                if (e.modifiers.shift && free) {
                    set-place(shown-place + turned * Fine.factor);
                } else {
                    set-to(round(shown-place + turned));
                }
            }
            accept
        }
        // The pointer's place on the strip, in ticks, as a plain drag would have it
        function at-pointer() -> float { drag-from - (self.mouse-x - drag-x) / tick-pitch }
        function follow() {
            let p = fine.at(at-pointer(), shift-now, 0, last-tick);
            drag-pos = p;
            if (stops.length > 0) {
                let q = free && fine.fine ? p : round(p);
                let i = round(q);
                if (i != shown || abs(q - i - shown-between) > 0.0005) {
                    local = i;
                    local-between = q - i;
                    touched = true;
                    if (q == i) { root.moved(i); } else { root.moved-between(i, q - i); }
                }
            }
        }
        pointer-event(e) => {
            shift-now = e.modifiers.shift;
            if (e.kind == PointerEventKind.down) { usage.press(); }
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                dragging = true;
                focus.focus();
                drag-from = shown-place;
                drag-pos = shown-place;
                drag-x = self.mouse-x;
                fine.begin(shown-place);
            }
            if (e.kind == PointerEventKind.move && dragging && self.pressed) { follow(); }
            if (dragging && ((e.kind == PointerEventKind.up && e.button == PointerEventButton.left) || e.kind == PointerEventKind.cancel)) {
                dragging = false;
                // A press that went nowhere: on a tick beside the mark it picks that tick, on the mark's own it types over the value
                if (e.kind == PointerEventKind.up && abs(self.mouse-x - drag-x) < Theme.u(2) && stops.length > 0) {
                    let to = clamp(round(drag-from + (self.mouse-x - mid) / tick-pitch), 0, last-tick);
                    if (to == round(drag-from)) {
                        start-typing(false);
                    } else if (to != shown) {
                        local = to;
                        local-between = 0;
                        touched = true;
                        root.moved(to);
                    }
                }
                released(shown);
            }
        }
        moved => {
            if (self.pressed && dragging) { follow(); }
        }
    }
    if root.shortcut != "": ShortcutMenu { action: root.shortcut; }
}
