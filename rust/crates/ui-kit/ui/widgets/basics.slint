// Icons, the focus ring and buttons, sized in the same design pixels.

import { Theme } from "../theme.slint";
import { Reveal } from "folds.slint";
import { TipBody, TipUse } from "tip.slint";
import { ShortcutMenu } from "shortcut-menu.slint";

// A line icon (widgets/line_icons.py), white in the file and tinted here.
export component Icon inherits Image {
    in property <color> tint: Theme.ink2;
    out property <string> control-kind: "icon";
    colorize: tint;
    image-fit: contain;
    image-rendering: smooth;
    // A picture beside words, never something to announce
    accessible-role: none;
}

// What the focus last came from: true after Tab or an arrow key, false after a pointer press. The window's input watch
// sets it (shell's input.rs). A window that holds a scope for shortcuts takes the focus back when given-back goes up.
export global KeyFocus {
    in-out property <bool> keyboard;
    in-out property <int> given-back;
}

// A setting an outside caller (the MCP server) just read or changed, by its id ("colour_grading.contrast"). The window fills items
// and lets `on` go false after a moment, which fades the outline, then clears them. Controls that carry that id draw a TouchRing.
export struct TouchedSetting {
    id: string,
    on: bool,
    changed: bool,
}

export global Touched {
    in-out property <[TouchedSetting]> items;
}

// The outline round a control that was just touched from outside: a change is the stronger one. Fills its parent, which gives the shape.
export component TouchRing inherits Rectangle {
    in property <string> setting;
    in property <length> radius: Theme.r-ctl;
    out property <string> control-kind: "outline";
    if setting != "": Rectangle {
        for t in Touched.items: Rectangle {
            if t.id == root.setting: Rectangle {
                x: -Theme.u(1.5);
                y: -Theme.u(1.5);
                width: root.width + Theme.u(3);
                height: root.height + Theme.u(3);
                border-radius: radius + Theme.u(1.5);
                border-width: t.changed ? Theme.stroke : Theme.u(0.5);
                border-color: Theme.accent;
                opacity: t.on ? 1 : 0;
                animate opacity { duration: 500ms; easing: ease-out; }
            }
        }
    }
}

// theme.focus_ring: an accent outline drawn just outside a control while it has focus from the keyboard. A click can
// leave a control focused, and the ring stays away for that (theme.keyboard_focus).
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <length> radius: Theme.r-ctl;
    out property <string> control-kind: "outline";
    x: -Theme.stroke;
    y: -Theme.stroke;
    border-radius: radius + Theme.stroke;
    border-width: shown && KeyFocus.keyboard ? Theme.stroke : 0px;
    border-color: Theme.accent;
}

// A link the person can click: the text in the accent colour, which opens its address.
export component LinkText inherits Rectangle {
    in property <string> text;
    in property <string> url;
    in property <length> font-size: Theme.small;
    out property <string> control-kind: "link";
    callback opened(string);
    height: Theme.u(9);
    // As wide as its words, or as wide as the place gives it, where it ends in an ellipsis
    preferred-width: label.preferred-width;
    min-width: 0px;
    accessible-role: button;
    accessible-label: text;
    accessible-description: url;
    accessible-action-default => { root.opened(url); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                if (!e.repeat) { root.opened(url); }
                return accept;
            }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: Theme.r-handle; width: parent.width + 2 * Theme.stroke; height: parent.height + 2 * Theme.stroke; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.opened(url); } }
    label := Text {
        width: parent.width;
        text: root.text;
        font-family: Theme.font;
        font-size: root.font-size;
        color: touch.has-hover ? Theme.ink : Theme.accent-soft;
        vertical-alignment: center;
        overflow: elide;
    }
    // The underline of a link under the pointer, as long as the words show
    if touch.has-hover: Rectangle {
        x: 0px;
        y: parent.height / 2 + root.font-size * 0.62;
        width: min(label.preferred-width, parent.width);
        height: 1px;
        background: Theme.ink;
    }
}

// Kind "button": a raised fill with no line round it, semibold. role "primary" is the one filled violet button, "danger" the
// red one, "quiet" a ghost that only shows a fill when hovered. Anything that opens a menu is a ChoiceField, not a Button.
export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <color> icon-tint: Theme.ink2;
    in property <string> role: "";
    in property <length> icon-size: Theme.icon-small;
    // A square of colour before the text, as a QPushButton draws a swatch icon
    in property <bool> has-swatch;
    in property <color> swatch;
    in property <length> font-size: Theme.body;
    in property <int> font-weight: Theme.w-value;
    in property <length> padding-x: Theme.u(6);
    in property <length> gap: Theme.u(4);
    in property <bool> enabled: true;
    // A tooltip, when there's something to say beyond the label
    in property <string> tip;
    // A setting row's button, on no fill until hovered
    in property <bool> strip;
    // A disabled quiet button stays on no fill
    in property <bool> quiet-when-disabled;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    // The label gives way to a narrow place and ends in an ellipsis (a folder's name)
    in property <bool> shrinks;
    out property <string> control-kind: "button";
    callback clicked;
    height: Theme.row;
    // A long label gives way to a narrow place at some width and ends in an ellipsis; a short one never shrinks
    min-width: shrinks ? 0px : min(lay.preferred-width, Theme.u(70));
    border-radius: Theme.r-ctl;
    background: !enabled ? (quiet-when-disabled ? transparent : Theme.trough)
        : role == "danger" ? Theme.err.mix(Theme.card, touch.pressed ? 0.35 : touch.has-hover ? 0.5 : 0.42)
        : role == "primary" ? (touch.pressed ? Theme.fill-press : touch.has-hover ? Theme.fill-hover : Theme.fill)
        : role == "quiet" || strip ? (touch.pressed ? Theme.raise : touch.has-hover ? Theme.hover : transparent)
        : (touch.pressed ? Theme.sel : touch.has-hover ? Theme.hover : Theme.raise);
    accessible-role: button;
    accessible-label: text;
    accessible-description: tip == text ? "" : tip;
    accessible-action-default => { if (enabled) { clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
        enabled: root.enabled;
        key-pressed(e) => {
            if (enabled && (e.text == " " || e.text == "\n")) {
                clicked();
                return accept;
            }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: root.border-radius; width: parent.width + 2 * Theme.stroke; height: parent.height + 2 * Theme.stroke; }
    usage := TipUse { hover: touch.has-hover; }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { usage.press(); }
        }
        scroll-event(e) => { usage.wheel(); reject }
        clicked => { if (enabled) { root.clicked(); } }
    }
    if root.shortcut != "": ShortcutMenu { action: root.shortcut; }
    if tip != "" && !usage.used: Tooltip { TipBody { says: tip; } }
    lay := HorizontalLayout {
        padding-left: padding-x;
        padding-right: padding-x;
        spacing: gap;
        alignment: center;
        if has-icon: Icon {
            source: icon;
            tint: !enabled ? Theme.dis : icon-tint;
            width: icon-size;
            height: icon-size;
            y: (parent.height - self.height) / 2;
        }
        if has-swatch: Rectangle {
            width: Theme.icon-small;
            height: Theme.icon-small;
            border-radius: Theme.r-handle / 2;
            y: (parent.height - self.height) / 2;
            background: swatch;
            opacity: enabled ? 1 : 0.5;
        }
        if text != "": Text {
            text: root.text;
            overflow: elide;
            horizontal-stretch: root.shrinks ? 1 : 0;
            min-width: root.shrinks ? 0px : min(self.preferred-width, Theme.u(60));
            font-family: Theme.font;
            font-size: root.font-size;
            font-weight: root.font-weight;
            color: !enabled ? Theme.dis : role == "primary" || role == "danger" ? white : role == "quiet" ? Theme.ink2 : Theme.ink;
            vertical-alignment: center;
        }
    }
}

// Kind "icon-button": a ghost with just an icon, square, a fill only while hovered.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: Theme.icon;
    in property <string> label;
    // A tooltip, when there's something to say beyond the label
    in property <string> tip;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    in property <bool> enabled: true;
    out property <string> control-kind: "icon-button";
    callback clicked;
    width: Theme.row;
    height: Theme.row;
    border-radius: Theme.r-ctl;
    background: !enabled ? Theme.trough : touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-description: tip == label ? "" : tip;
    accessible-action-default => { if (enabled) { clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") { clicked(); return accept; }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: Theme.r-ctl; width: parent.width + 2 * Theme.stroke; height: parent.height + 2 * Theme.stroke; }
    usage := TipUse { hover: touch.has-hover; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { usage.press(); } }
        scroll-event(e) => { usage.wheel(); reject }
        clicked => { root.clicked(); }
    }
    if root.shortcut != "": ShortcutMenu { action: root.shortcut; }
    if tip != "" && !usage.used: Tooltip { TipBody { says: tip; } }
    Icon { source: icon; tint: !enabled ? Theme.dis : touch.has-hover ? Theme.ink : Theme.ink2; width: icon-size; height: icon-size; }
}
