// The kit's motion: a handful of named motions, each tuned here once and used everywhere. Read the Motion section of rust/crates/ui-kit/STYLE.md.
// Every motion is a spring that Slint steps itself (easing: spring(bounce), duration is the spring's period). A spring that is given a new
// target mid-move keeps its speed, so a retarget bends the movement instead of restarting it, and it only asks for frames while it moves.
// A spring is animated on an element's own number (a border width), not on a property of the component or an x: the interpreter the app
// runs the kit through only carries the speed of a retarget over for the built-in properties that are not geometry.
// Each motion drives one number (`value`, 0 to 1 between two states); the control turns it into a place, a size, a colour or an opacity, so one
// motion owns each property and the control never writes it back as a new value.
// Two families: spatial motions (places and sizes) may overshoot a little when they are small and fast, effects (colour, opacity) never do.

import { Theme } from "../theme.slint";

export global Motion {
    // The system's reduced-motion setting, or the Appearance option: moves snap, colour and opacity changes stay
    in-out property <bool> reduced: false;
    // Nothing moves, colour and opacity included
    in-out property <bool> off: false;
    // A person's pointer opened or closed a fold (a key snaps it), set by the control that folds
    in-out property <bool> by-pointer: false;

    // Each spring's period: it is within 2% of its target after about one, and at rest after about one and a half
    out property <duration> settle: 200ms;
    out property <duration> flick: 200ms;
    out property <duration> pop: 150ms;
    // A button's press going back after a click, slow enough that a quick click is still seen
    out property <duration> press-out: 220ms;
    // How long a click on a slider's track waits to see whether it is the first of a double-click
    out property <duration> double-click: 350ms;
    // A multi-select tile's outline and inside fading in and out
    out property <duration> tile-in: 120ms;
    out property <duration> tile-out: 150ms;
    out property <duration> tone-up: 90ms;
    out property <duration> tone-down: 140ms;
    out property <duration> fade-in: 120ms;
    out property <duration> fade-out: 100ms;
    // The worm that follows a pick (see Worm): its leading edge is stiff and quick and lands exactly, its trailing edge starts a beat later
    // on a softer spring (bounce 0.3, a literal in WormEdge) and passes its place a little as it snaps in. The same time however far it goes.
    out property <duration> worm-lead: 110ms;
    out property <duration> worm-trail: 190ms;
    out property <duration> worm-lag: 45ms;
    // The outline round a control that something outside the window just touched, going out slowly enough to be seen
    out property <duration> outline-out: 240ms;
    out property <duration> unfold-open: 170ms;
    out property <duration> unfold-close: 130ms;

    // The curve every colour change takes: critically damped, so a colour never passes either end
    out property <easing> tone: spring(0.0);
    // How long a colour takes to follow its state: at once for a press or a key, or with motion off
    public pure function tone-for(instant: bool) -> duration { !fades || instant ? 0ms : tone-up }
    // A move across and down leads with one axis: it takes this share of the usual time, and the other axis this much of it, so the
    // path bows and never runs straight or turns a corner
    out property <float> lead: 0.85;
    out property <float> trail: 1.45;
    // The scale a popping bubble starts from
    out property <float> pop-from: 0.9;
    // How solid content that took a placeholder's place is in its first frame, so the swap leaves no gap
    out property <float> arrive-from: 0.45;

    // A move that is allowed to be seen
    out property <bool> moves: !reduced && !off;
    // A change of colour or opacity that is allowed to be seen
    out property <bool> fades: !off;

    // A number between two, which a spring's overshoot may pass: the place of a flicked handle
    public pure function between(a: float, b: float, t: float) -> float { a + (b - a) * t }
}

// Kind "helper". Settle: a place or a size that has to go somewhere calm and big enough to see, as a slider's handle does when something
// other than the person moved it. Critically damped: no overshoot, whatever the distance. `snap` follows `to` with no easing at all (a
// finger on the control, a key, a layout that is resizing). Goes in a control (not in a layout).
export component Settle {
    out property <string> control-kind: "helper";
    in property <float> to;
    in property <bool> snap;
    // How much longer than the usual it takes: the trailing axis of a move across and down, so its path bows
    in property <float> pace: 1;
    out property <float> value: bar.border-width / 1px;
    bar := Rectangle {
        visible: false;
        width: 0px;
        height: 0px;
        border-width: root.to * 1px;
        animate border-width {
            duration: snap || !Motion.moves ? 0ms : Motion.settle * pace;
            easing: spring(0.0);
        }
    }
}

// Kind "helper". Flick: a small thing that jumps between two places in a blink, a switch's handle. It eases in from rest (the first frames
// barely move, a spring starts at full speed) and passes its place by about 2% on the way in, so it never touches the track's border.
// A curve, not a spring: a retarget mid-move restarts from where it is.
export component Flick {
    out property <string> control-kind: "helper";
    in property <float> to;
    in property <bool> snap;
    out property <float> value: bar.border-width / 1px;
    bar := Rectangle {
        visible: false;
        width: 0px;
        height: 0px;
        border-width: root.to * 1px;
        animate border-width {
            duration: snap || !Motion.moves ? 0ms : Motion.flick;
            easing: cubic-bezier(0.45, 0, 0.25, 1.2);
        }
    }
}

// Kind "helper". Pop: a bubble's size coming and going. `value` runs 0 to 1 with a small overshoot and `scale` takes it from Motion.pop-from
// to 1; its opacity is a Fade's, never this. It reads itself once when it is made, so the owner can set `to` right after (in its init)
// and the move still starts from 0.
export component Pop {
    out property <string> control-kind: "helper";
    in property <float> to;
    in property <bool> snap;
    out property <float> value: bar.border-width / 1px;
    // The scale for the current value
    out property <float> scale: Motion.between(Motion.pop-from, 1, value);
    init => { value; }
    bar := Rectangle {
        visible: false;
        width: 0px;
        height: 0px;
        border-width: root.to * 1px;
        animate border-width {
            duration: snap || !Motion.moves ? 0ms : Motion.pop;
            easing: spring(0.4);
        }
    }
}

// Kind "helper". Tone: how far a colour has come from its rest to its lit state (hover, press, held), 0 to 1. Critically damped and held
// inside 0 and 1, so a colour made from it never flashes past either end, even when a reversal carries the spring's speed on.
// A press comes in at once with `instant-in`; `snap` is a key.
export component Tone {
    out property <string> control-kind: "helper";
    in property <bool> on;
    in property <bool> snap;
    in property <bool> instant-in;
    in property <duration> rise: Motion.tone-up;
    in property <duration> fall: Motion.tone-down;
    out property <float> value: clamp(bar.border-width / 1px, 0, 1);
    bar := Rectangle {
        visible: false;
        width: 0px;
        height: 0px;
        border-width: root.on ? 1px : 0px;
        animate border-width {
            duration: snap || !Motion.fades || (root.on && instant-in) ? 0ms : root.on ? rise : fall;
            easing: spring(0.0);
        }
    }
}

// Kind "helper". Fade: an opacity going to 1 or 0, in a touch longer than it goes out. Critically damped, held inside 0 and 1.
export component Fade {
    out property <string> control-kind: "helper";
    in property <bool> shown;
    in property <bool> snap;
    out property <float> value: clamp(bar.border-width / 1px, 0, 1);
    init => { value; }
    bar := Rectangle {
        visible: false;
        width: 0px;
        height: 0px;
        border-width: root.shown ? 1px : 0px;
        animate border-width {
            duration: snap || !Motion.fades ? 0ms : root.shown ? Motion.fade-in : Motion.fade-out;
            easing: spring(0.0);
        }
    }
}

// Kind "helper". Arrival: for content that took a placeholder's place in one frame. `solid` is Motion.arrive-from in the first frame (never
// empty, so nothing jumps) and rises to 1 over a fade. Goes in the thing that arrives, which uses `solid` as its opacity.
export component Arrival {
    out property <string> control-kind: "helper";
    out property <float> solid: Motion.between(Motion.arrive-from, 1, fade.value);
    property <bool> here;
    fade := Fade { shown: here; }
    init => { here = true; }
}

// Kind "helper". Unfold: a fold opening or closing, 1 open and 0 shut. The one motion that is itself a change of height, so it is the only
// one allowed to move what is under it. Critically damped. A key snaps (`snap`), a click or a press moves it.
export component Unfold {
    out property <string> control-kind: "helper";
    in property <bool> open;
    in property <bool> snap;
    out property <float> value: clamp(bar.border-width / 1px, 0, 1);
    bar := Rectangle {
        visible: false;
        width: 0px;
        height: 0px;
        border-width: root.open ? 1px : 0px;
        animate border-width {
            duration: snap || !Motion.moves ? 0ms : root.open ? Motion.unfold-open : Motion.unfold-close;
            easing: spring(0.0);
        }
    }
}

// Kind "helper". One side of a Worm: a length that follows `to` on the leading spring (stiff, no overshoot) or the trailing one (softer,
// a beat late, a little overshoot). Goes in the Worm, which is not in a layout.
component WormEdge {
    in property <length> to;
    in property <bool> lead;
    in property <bool> snap;
    // A beat more, for the second axis of a move across and down
    in property <duration> after;
    out property <length> value: bar.border-width;
    bar := Rectangle {
        visible: false;
        width: 0px;
        height: 0px;
        border-width: root.to;
        animate border-width {
            delay: snap || !Motion.moves ? 0ms : (lead ? 0ms : Motion.worm-lag) + after;
            duration: snap || !Motion.moves ? 0ms : lead ? Motion.worm-lead : Motion.worm-trail;
            easing: lead ? spring(0.0) : spring(0.3);
        }
    }
}

// Kind "outline". Worm: the picked option's outline and muted inside, which stretches onto a newly picked option instead of vanishing and
// appearing. The edge on the side it travels to is the leading one and the other trails (see Motion.worm-*), so it stretches then
// contracts, in the same time however far it goes. On a grid one axis leads and the other follows (the path bows). Give it the picked
// cell's place (`to-x`, `to-y`, `to-w`, `to-h`, in its parent) and draw it over the options' surfaces and under their text.
// `snap` puts it there at once (a key, a layout resizing); the first place it is given is never animated.
export component Worm inherits Rectangle {
    out property <string> control-kind: "outline";
    in property <length> to-x;
    in property <length> to-y;
    in property <length> to-w;
    in property <length> to-h;
    in property <color> hue: Theme.accent;
    in property <length> radius: Theme.r-ctl;
    // The picked option is held down
    in property <bool> pressed;
    in property <bool> snap;
    // False while there is nothing picked, or what is picked can't show the outline (disabled)
    in property <bool> shown: true;
    // Where it is, for a test
    out property <length> left: l.value;
    out property <length> right: r.value;
    out property <length> top: t.value;
    out property <length> bottom: b.value;
    // Which way the last pick went on each axis, and which axes it moved on, latched when the target moves
    property <bool> fwd: true;
    property <bool> down: true;
    property <bool> h-moved;
    property <bool> v-moved;
    property <length> last-cx: -1px;
    property <length> last-cy: -1px;
    // The first place is where it starts, not something it travels to
    property <bool> placed;
    function retarget() {
        let cx = to-x + to-w / 2;
        let cy = to-y + to-h / 2;
        if (cx != last-cx || cy != last-cy) {
            h-moved = cx != last-cx;
            v-moved = cy != last-cy;
            if (h-moved) { fwd = cx > last-cx; }
            if (v-moved) { down = cy > last-cy; }
            last-cx = cx;
            last-cy = cy;
        }
    }
    property <length> cx: to-x + to-w / 2;
    property <length> cy: to-y + to-h / 2;
    changed cx => { retarget(); }
    changed cy => { retarget(); }
    changed to-w => { retarget(); if (to-w > 0px) { placed = true; } }
    init => {
        last-cx = cx;
        last-cy = cy;
        placed = to-w > 0px;
    }
    property <bool> still: snap || !placed;
    // Across and down: across leads, down follows a beat later
    property <duration> late: h-moved && v-moved ? Motion.worm-lag * 1.5 : 0ms;
    l := WormEdge { to: root.to-x; lead: !fwd; snap: still; }
    r := WormEdge { to: root.to-x + root.to-w; lead: fwd; snap: still; }
    t := WormEdge { to: root.to-y; lead: !down; snap: still; after: late; }
    b := WormEdge { to: root.to-y + root.to-h; lead: down; snap: still; after: late; }
    x: l.value;
    y: t.value;
    width: max(0px, r.value - l.value);
    height: max(0px, b.value - t.value);
    visible: shown && to-w > 0px;
    border-radius: radius;
    border-width: Theme.stroke;
    border-color: hue;
    background: pressed ? Theme.held(hue) : Theme.tint(hue);
    animate background { duration: Motion.tone-for(pressed || snap); easing: Motion.tone; }
}
