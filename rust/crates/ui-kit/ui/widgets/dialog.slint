// A dialog as Qt draws one (dialog_layout, dialog_header): the window's background, 20/18 margins, a 14pt title and a dim
// line under it. A plugin shows it inside a PopupWindow, over the rest of the window, so it carries its own edge.

import { Theme } from "../theme.slint";
import { WindowBox } from "window-box.slint";
import { TipLayer } from "tip.slint";
export { WindowBox }

// A dialog that sets `dismissable` goes by its x and y in a pop-up covering the whole window (WindowBox.cover-w and cover-h),
// and a press on the window beside it calls `dismissed`, to do what Cancel does. A pop-up swallows every press outside itself,
// so it has to be the window's size for the dialog to see them. A press that starts inside the dialog never gets there, so a
// slider dragged or text selected out past the edge leaves it open.

export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> dismissable;
    callback dismissed();
    background: Theme.card;
    border-radius: Theme.r-card;
    out property <string> control-kind: "dialog";
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #000000a0;
    if dismissable: TouchArea {
        x: -5000px;
        y: -5000px;
        width: 10000px;
        height: 10000px;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.dismissed(); }
        }
    }
    // The dialog's own face takes its clicks, so the one behind it only gets what lands beside the dialog
    if dismissable: TouchArea { }
    // From the top: a layout left to fill a popup that's still the old size would spread its rows
    VerticalLayout {
        alignment: start;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 18px;
        padding-bottom: 18px;
        spacing: 14px;
        VerticalLayout {
            spacing: 2px;
            Text {
                text: title;
                font-family: Theme.font;
                font-size: 19px; // 14pt is 18.67px, drawn at 19
                font-weight: 600;
                color: Theme.text;
            }
            if subtitle != "": Text {
                text: subtitle;
                font-family: Theme.font;
                font-size: Theme.body;
                color: Theme.text-dim;
                wrap: word-wrap;
                line-height-factor: Theme.line-factor(self.font-size);
            }
        }
        @children
    }
    // A tooltip of a control in the dialog: the pop-up covers the window's own layer
    TipLayer { }
}
