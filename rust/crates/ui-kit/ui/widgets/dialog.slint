// A dialog as Qt draws one (dialog_layout, dialog_header): the window's background, 20/18 margins, a 14pt title and a dim
// line under it. A plugin shows it inside a PopupWindow, over the rest of the window, so it carries its own edge.

import { Theme } from "../theme.slint";
import { WindowBox } from "window-box.slint";
import { TipLayer } from "tip.slint";
import { Motion, Fade, Pop } from "motion.slint";
export { WindowBox }

// A dialog that sets `dismissable` goes by its x and y in a pop-up covering the whole window (WindowBox.cover-w and cover-h),
// and a press on the window beside it calls `dismissed`, to do what Cancel does. A pop-up swallows every press outside itself,
// so it has to be the window's size for the dialog to see them. A press that starts inside the dialog never gets there, so a
// slider dragged or text selected out past the edge leaves it open.

// The dialog's button row, last in the frame: right-aligned, the card's gap between buttons, one Button row tall. Give it Buttons with
// `dialog: true` (an even floor on their width); the primary action goes last.
export component DialogButtons inherits HorizontalLayout {
    out property <string> control-kind: "helper";
    alignment: end;
    spacing: Theme.gap;
    padding-top: Theme.u(2);
}

export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> dismissable;
    callback dismissed();
    // A dialog pops in from a little under its size and fades in when it is made, and goes the same way: a card that closes it calls
    // `leave()` (instead of closing its pop-up) and closes the pop-up in `left`, which comes once the fade is over. A press on the window
    // beside it eases out too, then says `dismissed` (and `left`).
    callback left();
    property <bool> arrived;
    property <bool> leaving;
    property <bool> from-outside;
    out property <float> presence: fade.value;
    init => { arrived = true; }
    public function leave() {
        sync();
        leaving = true;
    }
    function sync() {
        fade.sync();
        pop.sync();
    }
    fade := Fade { shown: arrived && !leaving; }
    pop := Pop { to: arrived && !leaving ? 1 : 0; }
    Timer {
        interval: Motion.fades ? Motion.fade-out + 40ms : 1ms;
        running: leaving;
        triggered => {
            leaving = false;
            root.left();
            if (from-outside) {
                from-outside = false;
                root.dismissed();
            }
        }
    }
    opacity: fade.value;
    transform-scale: pop.scale;
    background: Theme.card;
    border-radius: Theme.r-card;
    out property <string> control-kind: "dialog";
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #000000a0;
    if dismissable: TouchArea {
        x: -5000px;
        y: -5000px;
        width: 10000px;
        height: 10000px;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && !root.leaving) { root.from-outside = true; root.leave(); }
        }
    }
    // The dialog's own face takes its clicks, so the one behind it only gets what lands beside the dialog
    if dismissable: TouchArea { }
    // From the top: a layout left to fill a popup that's still the old size would spread its rows
    VerticalLayout {
        alignment: start;
        padding-left: Theme.u(10);
        padding-right: Theme.u(10);
        padding-top: Theme.u(9);
        padding-bottom: Theme.u(9);
        spacing: Theme.u(7);
        VerticalLayout {
            spacing: Theme.u(1);
            Text {
                text: title;
                font-family: Theme.font;
                font-size: 19px; // 14pt is 18.67px, drawn at 19
                font-weight: 600;
                color: Theme.ink;
            }
            if subtitle != "": Text {
                text: subtitle;
                font-family: Theme.font;
                font-size: Theme.body;
                color: Theme.ink2;
                wrap: word-wrap;
                line-height-factor: Theme.line-factor(self.font-size);
            }
        }
        @children
    }
    // A tooltip of a control in the dialog: the pop-up covers the window's own layer
    TipLayer { }
}
