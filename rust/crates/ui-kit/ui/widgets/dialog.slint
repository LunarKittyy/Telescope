// A dialog as Qt draws one (dialog_layout, dialog_header): the window's background, 20/18 margins, a 14pt title and a dim
// line under it. A plugin shows it inside a PopupWindow, over the rest of the window, so it carries its own edge.

import { Theme } from "../theme.slint";

// The main window's size, for a dialog shown from inside a card to centre itself on the window.
export global WindowBox {
    in-out property <length> width;
    in-out property <length> height;
    // Where a dialog this big goes
    public pure function left(w: length) -> length { max(8px, (self.width - w) / 2) }
    public pure function top(h: length) -> length { max(8px, (self.height - h) / 2) }
    // A dialog's height, held to the window where the window's size is known
    public pure function cap(h: length) -> length { self.height > 0 ? min(h, self.height - 16px) : h }
}

export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.border-hover;
    border-radius: 12px;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #000000a0;
    // From the top: a layout left to fill a popup that's still the old size would spread its rows
    VerticalLayout {
        alignment: start;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 18px;
        padding-bottom: 18px;
        spacing: 14px;
        VerticalLayout {
            spacing: 2px;
            Text {
                text: title;
                font-family: Theme.font;
                font-size: 19px; // 14pt is 18.67px, drawn at 19
                font-weight: 600;
                color: Theme.text;
            }
            if subtitle != "": Text {
                text: subtitle;
                font-family: Theme.font;
                font-size: Theme.body;
                color: Theme.text-dim;
                wrap: word-wrap;
                line-height-factor: Theme.line-factor(self.font-size);
            }
        }
        @children
    }
}
