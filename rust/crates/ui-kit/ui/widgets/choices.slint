// Picking one of a few (segmented_row) or one of many (a QComboBox).

import { Theme } from "../theme.slint";
import { Reveal } from "folds.slint";
import { Icon, FocusRing } from "basics.slint";
import { ShortcutMenu } from "shortcut-menu.slint";

// segmented_row: equal segments in one track, the picked one a filled pill.
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <[bool]> disabled;
    // A 13px line icon before each item's text, where has-icons says so
    in property <[image]> icons;
    in property <[bool]> has-icons;
    in property <string> label;
    in-out property <int> current: 0;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    // Room above and below the 32px track, to sit in a 36px form row; 0 for a row of its own (segmented_row alone)
    in property <length> margin: 2px;
    callback picked(int);
    height: 32px + 2 * margin;
    horizontal-stretch: 1;
    forward-focus: focus;
    accessible-role: tab-list;
    accessible-label: label;
    focus := FocusScope {
        focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
        key-pressed(e) => {
            if (e.text == Key.LeftArrow && current > 0 && !disabled[current - 1]) { current -= 1; picked(current); return accept; }
            if (e.text == Key.RightArrow && current < items.length - 1 && !disabled[current + 1]) { current += 1; picked(current); return accept; }
            reject
        }
    }
    track := Rectangle {
        y: margin;
        height: 32px;
        background: Theme.surface-raise;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 8px;
        FocusRing { shown: focus.has-focus; radius: 8px; width: parent.width + 4px; height: parent.height + 4px; }
    }
    HorizontalLayout {
        y: margin;
        height: 32px;
        padding: 3px;
        spacing: 2px;
        for item[i] in items: seg := Rectangle {
            property <bool> on: i == current;
            property <bool> off: disabled[i];
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            border-radius: 6px;
            background: on ? (off ? Theme.border-strong : seg-touch.has-hover ? Theme.fill-hover : Theme.fill)
                : (seg-touch.has-hover && !off ? Theme.surface-hover : transparent);
            accessible-role: tab;
            accessible-label: label + ": " + item;
            accessible-checkable: true;
            accessible-checked: on;
            seg-touch := TouchArea {
                mouse-cursor: off ? default : pointer;
                clicked => {
                    if (!off) {
                        current = i;
                        picked(i);
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                if has-icons[i]: Icon {
                    y: (parent.height - 13px) / 2;
                    source: icons[i];
                    tint: off ? Theme.text-disabled : on ? white : Theme.text-dim;
                    width: 13px;
                    height: 13px;
                    accessible-role: none;
                }
                Text {
                    text: item;
                    font-family: Theme.font;
                    font-size: Theme.body;
                    font-weight: on ? 600 : 400;
                    color: off ? Theme.text-disabled : on ? white : seg-touch.has-hover ? Theme.text : Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
    if root.shortcut != "": ShortcutMenu { action: root.shortcut; }
}

// controls.ChoiceTile in "field" style: small caption over the value, chevron on the right, a list when clicked.
// compact: a plain combo box (NoScrollComboBox in a control_row), 32px with the value alone.
export component ChoiceField inherits Rectangle {
    // Whether its list is open
    out property <bool> open;
    // Items that went away while the list was open, by index: greyed out and can't be picked
    in property <[bool]> gone;
    property <bool> clicked-open;
    in property <string> caption;
    in property <bool> compact;
    // A small icon before the text (the header's phone picker), and its text in bold
    in property <image> icon;
    in property <bool> has-icon;
    in property <color> icon-tint: Theme.text-dim;
    in property <bool> bold;
    in property <[string]> items;
    in-out property <int> current;
    in property <bool> enabled: true;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    callback picked(int);
    height: compact ? 32px : 48px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    border-radius: compact ? 7px : 10px;
    border-width: 1px;
    background: touch.has-hover && enabled ? Theme.surface-hover : Theme.surface-raise;
    // Qt's plain combo box has the strong border; the tile its quiet one
    border-color: touch.has-hover && enabled ? Theme.border-hover : compact ? Theme.border-strong : Theme.border;
    accessible-role: combobox;
    accessible-label: caption;
    accessible-value: items[current];
    forward-focus: focus;
    focus := FocusScope {
        focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.UpArrow && current > 0) { current -= 1; picked(current); return accept; }
            if (e.text == Key.DownArrow && current < items.length - 1) { current += 1; picked(current); return accept; }
            if (e.text == " " || e.text == "\n") { popup.show(); return accept; }
            reject
        }
        focus-lost => { clicked-open = root.open; }
    }
    FocusRing { shown: focus.has-focus && !clicked-open; radius: compact ? 7px : 10px; width: parent.width + 4px; height: parent.height + 4px; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            // Something has to hold the focus for the list's own to go back to when it closes (see `watch`)
            clicked-open = true;
            focus.focus();
            popup.show();
        }
    }
    if root.shortcut != "": ShortcutMenu { action: root.shortcut; }
    if has-icon: Icon {
        source: icon;
        tint: icon-tint;
        x: 11px;
        width: 14px;
        height: 14px;
        accessible-role: none;
    }
    if compact: VerticalLayout {
        padding-left: has-icon ? 33px : 12px; // the phone picker's 32px padding sits inside its border
        padding-right: 30px;
        alignment: center;
        Text {
            text: items[current];
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: bold ? 600 : 400;
            color: enabled ? Theme.text : Theme.text-disabled;
            overflow: elide;
        }
    }
    // _two_lines: the caption's capitals and the value's read as one block centred top to bottom, the value's capitals
    // 9px under the caption's baseline (stacked_baselines, with Inter's capitals 8px tall at 11px and 9px at 13px)
    property <length> first-baseline: round((root.height / 1px - 26) / 2 + 8) * 1px;
    if !compact: Text {
        x: has-icon ? 32px : 12px;
        y: first-baseline - 11px * 1984 / 2048;
        width: root.width - self.x - 30px;
        text: caption;
        font-family: Theme.font;
        font-size: 11px; // 0.88 of the body size, 11.44px, which Qt draws at 11
        color: enabled ? Theme.text-faint : Theme.text-disabled;
        overflow: elide;
    }
    if !compact: Text {
        x: has-icon ? 32px : 12px;
        y: first-baseline + 18px - 13px * 1984 / 2048;
        width: root.width - self.x - 30px;
        text: items[current];
        font-family: Theme.font;
        font-size: Theme.body;
        font-weight: 600;
        color: enabled ? Theme.text : Theme.text-disabled;
        overflow: elide;
    }
    Icon {
        source: @image-url("../icons/chevron.svg");
        x: parent.width - 12px - self.width;
        width: compact ? 10px : 14px;
        height: compact ? 10px : 14px;
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        // Slint doesn't say when a popup closes, but its focus goes back to the field then. Taken a moment after it
        // opens, since opening clears the focus
        watch := FocusScope {
            focus-lost => { root.open = false; }
        }
        Timer {
            interval: 1ms;
            running: !root.open;
            triggered => {
                root.open = true;
                watch.focus();
            }
        }
        Rectangle {
            background: Theme.surface-raise;
            border-width: 1px;
            border-color: Theme.border-hover;
            border-radius: 7px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000080;
            VerticalLayout {
                padding: 4px;
                for item[i] in items: Rectangle {
                    property <bool> is-gone: gone[i];
                    height: 26px;
                    border-radius: 5px;
                    background: is-gone ? transparent : i == current ? Theme.fill : item-touch.has-hover ? Theme.surface-hover : transparent;
                    item-touch := TouchArea {
                        enabled: !is-gone;
                        clicked => {
                            current = i;
                            picked(i);
                        }
                    }
                    Text {
                        x: 8px;
                        text: item;
                        font-family: Theme.font;
                        font-size: Theme.body;
                        color: is-gone ? Theme.text-disabled : i == current ? white : Theme.text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
