// The named fills of a slider's track (STYLE.md, Sliders). A card names one, it never draws its own.
// Slint's software renderer squares off a gradient's corners and a clip's, so a fill is a square strip with a solid cap at each end.

export global Fills {
    // The grey a ramp starts and ends at, as a level from black (0) to white (1)
    pure function low(kind: string) -> float {
        kind == "shadows" ? 0.03 : kind == "highlights" ? 0.5 : kind == "lift" ? 0.0 : kind == "gamma" ? 0.3 : kind == "gain" ? 0.6 : kind == "offset" ? 0.25 : kind == "pivot" ? 0.0 : 0.0
    }
    pure function high(kind: string) -> float {
        kind == "shadows" ? 0.5 : kind == "highlights" ? 1.0 : kind == "lift" ? 0.4 : kind == "gamma" ? 0.7 : kind == "gain" ? 1.0 : kind == "offset" ? 0.7 : kind == "pivot" ? 1.0 : 1.0
    }
    pure function grey(level: float) -> color { #ffffff.mix(#000000, level) }
    // Vibrance: pastel at the left, ever more saturated to the right, the hue moving on as it goes
    pure function vivid(i: int) -> color {
        i == 0 ? #e0aebf : i == 1 ? #e9b48f : i == 2 ? #cfe56d : i == 3 ? #33f0c0 : #3366ff
    }
    // White balance: temperature runs blue, grey, amber and tint runs green, grey, magenta, the same on every card
    pure function balance(kind: string, i: int) -> color {
        kind == "temperature" ? (i == 0 ? #4a7fd4 : i == 1 ? #4a7fd4.mix(#9a9a9a, 0.5) : i == 2 ? #9a9a9a : i == 3 ? #9a9a9a.mix(#e8a45a, 0.5) : #e8a45a)
            : (i == 0 ? #3fcf6e : i == 1 ? #3fcf6e.mix(#9a9a9a, 0.5) : i == 2 ? #9a9a9a : i == 3 ? #9a9a9a.mix(#e04fc8, 0.5) : #e04fc8)
    }
    // The track's colour at stop i of 0 to 4, evenly spaced. "gradient" runs ga, gb, gc.
    public pure function stop(kind: string, i: int, ga: color, gb: color, gc: color) -> color {
        kind == "temperature" || kind == "tint" ? balance(kind, i)
            : kind == "gradient" ? (i == 0 ? ga : i == 1 ? ga.mix(gb, 0.5) : i == 2 ? gb : i == 3 ? gb.mix(gc, 0.5) : gc)
            : kind == "tolerance" || kind == "spill" ? ga.mix(gb, 1 - i / 4)
            : kind == "vibrance" ? vivid(i)
            : grey(low(kind) + (high(kind) - low(kind)) * i / 4)
    }
    // The colour a fraction of the way along the track
    public pure function at(kind: string, fraction: float, ga: color, gb: color, gc: color) -> color {
        stop(kind, min(3, floor(clamp(fraction, 0, 1) * 4)), ga, gb, gc).mix(stop(kind, min(3, floor(clamp(fraction, 0, 1) * 4)) + 1, ga, gb, gc), 1 - (clamp(fraction, 0, 1) * 4 - min(3, floor(clamp(fraction, 0, 1) * 4))))
    }
    // True where the handle takes the colour under it; a grey ramp keeps the card's colour, since black or white would vanish
    public pure function colours-handle(kind: string) -> bool { kind == "gradient" || kind == "temperature" || kind == "tint" || kind == "vibrance" || kind == "tolerance" || kind == "spill" }
    // The fills that are a ramp of stops: everything but plain, the zebra, the edge and the bar
    public pure function is-ramp(kind: string) -> bool { !(kind == "plain" || kind == "contrast" || kind == "edges" || kind == "threshold") }
    // The threshold bar: the track is as tall as the row and fills to a live value, and the handle sets the level it warns at
    public pure function is-bar(kind: string) -> bool { kind == "threshold" }
    // How much of the card's own colour lies over a fill at rest. These three run along the whole track in the screen's own bright colours, so they
    // are put down further than a range's colours to weigh the same as a plain fill's quietened colour
    public pure function rest-veil(kind: string) -> float { kind == "tolerance" || kind == "edges" || kind == "spill" ? 0.68 : 0.5 }
    // The zebra's flat grey, before its stripes come in
    out property <color> zebra-grey: #808080;
}

// A ramp of colours along the track with rounded ends
export component RampFill inherits Rectangle {
    out property <string> control-kind: "slider";
    in property <string> kind;
    in property <color> ga;
    in property <color> gb;
    in property <color> gc;
    property <length> r: self.height / 2;
    Rectangle {
        x: 0px;
        width: r * 2;
        border-radius: r;
        background: Fills.stop(kind, 0, ga, gb, gc);
    }
    Rectangle {
        x: parent.width - r * 2;
        width: r * 2;
        border-radius: r;
        background: Fills.stop(kind, 4, ga, gb, gc);
    }
    Rectangle {
        x: r;
        width: parent.width - r * 2;
        background: @linear-gradient(90deg, Fills.stop(kind, 0, ga, gb, gc) 0%, Fills.stop(kind, 1, ga, gb, gc) 25%, Fills.stop(kind, 2, ga, gb, gc) 50%, Fills.stop(kind, 3, ga, gb, gc) 75%, Fills.stop(kind, 4, ga, gb, gc) 100%);
    }
}

// Contrast: flat grey at the left that fades into 45 degree black and white stripes, ending on a white one so the round end is clean
export component ZebraFill inherits Rectangle {
    out property <string> control-kind: "slider";
    property <length> h: self.height;
    property <length> r: h / 2;
    // Each stripe is as wide as the track is high
    property <length> stripe: h;
    // Where the last stripe starts along its top edge: its bottom edge is a track height to the left
    property <length> edge: self.width - r * 2;
    // Stripes counted back from the right end, 0 being the white one that runs into the cap
    property <int> count: ceil(self.width / stripe) + 1;
    border-radius: r;
    background: Fills.zebra-grey;
    Rectangle {
        x: r;
        width: parent.width - r * 2;
        clip: true;
        for k in count: Path {
            property <length> left: edge - h - k * stripe;
            // How far along the track this stripe sits, which sets how strongly it shows
            property <float> strength: clamp(((left + h / 2) / root.width - 0.2) / 0.6, 0, 1);
            x: left - r;
            y: 0px;
            width: k == 0 ? parent.width - (left - r) : stripe + h;
            height: h;
            viewbox-width: self.width / 1px;
            viewbox-height: self.height / 1px;
            commands: k == 0 ? "M 0 " + h / 1px + " L " + self.width / 1px + " " + h / 1px + " L " + self.width / 1px + " 0 L " + h / 1px + " 0 Z"
                : "M 0 " + h / 1px + " L " + stripe / 1px + " " + h / 1px + " L " + (stripe + h) / 1px + " 0 L " + h / 1px + " 0 Z";
            fill: Math.mod(k, 2) == 0 ? #ffffff.with-alpha(strength) : #000000.with-alpha(strength);
        }
    }
    Rectangle {
        x: parent.width - r * 2;
        width: r * 2;
        border-radius: r;
        background: #ffffff;
    }
}

// Edges: the first colour on the left and the second on the right, with a step between them that is hard at the track's start and
// spreads out to the whole track at its end, so the handle's place is how soft the edge is
export component EdgeFill inherits Rectangle {
    out property <string> control-kind: "slider";
    in property <color> ga;
    in property <color> gb;
    // 0 to 1: how much of the track the step spreads over
    in property <float> softness;
    property <length> r: self.height / 2;
    // The step's two ends along the strip between the caps, as a share of it
    property <length> strip: max(1px, self.width - r * 2);
    property <length> span: max(1px, softness * self.width);
    property <float> from: clamp((self.width / 2 - span / 2 - r) / strip, 0, 1);
    property <float> to: clamp((self.width / 2 + span / 2 - r) / strip, 0, 1);
    Rectangle {
        x: 0px;
        width: r * 2;
        border-radius: r;
        background: ga;
    }
    Rectangle {
        x: parent.width - r * 2;
        width: r * 2;
        border-radius: r;
        background: gb;
    }
    Rectangle {
        x: r;
        width: parent.width - r * 2;
        background: @linear-gradient(90deg, ga 0%, ga from * 100%, gb to * 100%, gb 100%);
    }
}
