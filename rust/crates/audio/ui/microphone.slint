// The Microphone card (desktop/telescope/plugins/microphone.py and widgets/level_meter.py). Texts with blanks come
// filled from Rust; the Install VB-Cable question is a popup inside the card.

import { Theme, Icons, Icon, Button, Card, FormRow, Slider, Switch, TextField, TipBody } from "@ui-kit/ui-kit.slint";

// The meter's numbers from the plugin: bar ends and the held marker as 0..1 along it, and which light is on.
export struct MeterState {
    peak: float,
    rms: float,
    hold: float,
    lit: string,
    muted: bool,
    readout: string,
    red: bool,
}

global Status {
    public pure function color(kind: string) -> color {
        kind == "status_ok" ? Theme.ok : kind == "status_warn" ? Theme.warn : kind == "status_err" ? Theme.err
            : kind == "status_dim" ? Theme.text-dim : Theme.text
    }
}

// wrapped_note: a QLabel#dim, so body size
component Note inherits Text {
    in property <string> kind: "status_dim";
    font-family: Theme.font;
    font-size: Theme.body;
    color: Status.color(kind);
    wrap: word-wrap;
}

// One zone of a bar, in its own colour along the bar the way hardware meters light up.
component Zone inherits Rectangle {
    in property <float> from;
    in property <float> to;
    in property <float> level;
    in property <color> tone;
    in property <float> alpha;
    in property <length> track;
    property <length> left: round(from * track / 1px) * 1px;
    property <length> right: round(min(level, to) * track / 1px) * 1px;
    x: left;
    width: level > from ? max(0px, right - left) : 0px;
    background: tone.with-alpha(alpha);
}

// LevelMeter: peak and RMS bars, a held peak marker, ticks under the bar and a clip light. A click clears the hold.
component LevelMeter inherits Rectangle {
    in property <MeterState> state;
    callback clicked;
    property <length> dot: 8px;
    property <length> inset: 10px;
    property <length> bar-h: 8px;
    property <length> track-w: root.width - inset - dot - 6px - 1px;
    property <length> top: (root.height - bar-h) / 2 - 2px;
    min-width: 84px;
    height: 36px;
    horizontal-stretch: 1;
    function tone(zone: int) -> color {
        state.muted ? Theme.text-faint : zone == 2 ? Theme.err : zone == 1 ? Theme.warn : Theme.ok
    }
    function at(p: float) -> length {
        p * track-w
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    bar := Rectangle {
        x: inset + 0.5px;
        y: top;
        width: track-w;
        height: bar-h;
        border-radius: bar-h / 2;
        background: Theme.surface-sunk;
        clip: true;
        // Peak at 55%, RMS on top at full colour; zones at -18 and -6 dBFS
        Zone { from: 0; to: 0.55; level: state.peak; tone: tone(0); alpha: 0.55; track: track-w; height: bar-h; }
        Zone { from: 0.55; to: 0.85; level: state.peak; tone: tone(1); alpha: 0.55; track: track-w; height: bar-h; }
        Zone { from: 0.85; to: 1; level: state.peak; tone: tone(2); alpha: 0.55; track: track-w; height: bar-h; }
        Zone { from: 0; to: 0.55; level: state.rms; tone: tone(0); alpha: 1; track: track-w; height: bar-h; }
        Zone { from: 0.55; to: 0.85; level: state.rms; tone: tone(1); alpha: 1; track: track-w; height: bar-h; }
        Zone { from: 0.85; to: 1; level: state.rms; tone: tone(2); alpha: 1; track: track-w; height: bar-h; }
        if state.hold >= 0: Rectangle {
            x: min(max(at(state.hold), 3px), track-w - bar-h / 2) - 1px;
            width: 2px;
            height: bar-h;
            background: state.muted ? Theme.text-dim : Theme.text;
        }
    }
    Rectangle {
        x: bar.x;
        y: bar.y;
        width: bar.width;
        height: bar.height;
        border-radius: bar.border-radius;
        border-width: 1px;
        border-color: Theme.border-strong;
    }
    // Ticks at -40, -30, -20, -12 and -6 dBFS
    for p in [0.16667, 0.25, 0.5, 0.7, 0.85]: Rectangle {
        x: inset + round(p * track-w / 1px) * 1px;
        y: top + bar-h + 3px;
        width: 1px;
        height: 3px;
        background: Theme.border-strong;
    }
    Rectangle {
        x: root.width - dot - 0.5px;
        y: top + bar-h / 2 - dot / 2;
        width: dot;
        height: dot;
        border-radius: dot / 2;
        background: state.lit == "clip" ? Theme.err : state.lit == "limit" ? Theme.warn : Theme.surface-sunk;
        border-width: state.lit == "" ? 1px : 0px;
        border-color: Theme.border-strong;
    }
    tip := TouchArea { }
    if tip.has-hover: Tooltip {
        TipBody { says: @tr("Yellow means the limiter is holding loud peaks down and red means the sound clipped (click to clear)."); }
    }
}

component DialogFrame inherits Rectangle {
    in property <string> title;
    background: Theme.surface-raise;
    border-width: 1px;
    border-color: Theme.border-strong;
    border-radius: 12px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000080;
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        Text {
            text: title;
            font-family: Theme.font;
            font-size: Theme.card-title;
            font-weight: 600;
            color: Theme.text;
        }
        @children
    }
}

export component MicrophoneCard inherits Card {
    // Greyed out until a phone is paired
    in property <bool> active;
    // On for the stream the panels show: the controls are there
    in property <bool> here;
    in property <bool> on;
    in property <bool> toggle-enabled: true;
    in property <string> mic-label: @tr("Phone mic");
    in property <string> toggle-name;
    in property <string> toggle-tip;
    in property <bool> muted;
    in property <string> mute-text: @tr("Mute");
    in property <string> mute-tip;
    in property <MeterState> meter;
    in property <int> gain;
    in property <int> gain-min: -24;
    in property <int> gain-max: 12;
    in property <string> gain-text: "0 dB";
    in property <string> gain-tip;
    in property <bool> auto-level;
    in property <bool> nr;
    in property <bool> nr-enabled: true;
    in property <string> nr-note;
    in property <string> nr-tip;
    in property <string> status-text;
    in property <string> status-kind: "status_dim";
    // The fix for a problem (Install VB-Cable, Get VB-Cable)
    in property <string> fix-text;
    in property <bool> fix-shown;
    // The Install VB-Cable question
    in property <bool> confirm-open;
    in property <string> origin;
    in property <string> donationware;
    // The donate link's words, translated, without its markup
    in property <string> donate-text;
    callback toggled(bool);
    callback mute-toggled(bool);
    callback gain-moved(float);
    callback gain-typed(string);
    callback auto-toggled(bool);
    callback nr-toggled(bool);
    callback fix-clicked;
    callback meter-clicked;
    callback confirm-answered(bool);
    callback donate;

    title: @tr("Microphone");
    icon: Icons.v-mic;
    opacity: active ? 1 : 0.4;
    enabled: active;
    // The Mute button and the on/off switch sit in the header, so the card says at a glance whether the mic is in use
    has-action: here;
    action-text: mute-text;
    action-icon: muted ? Icons.v-mic-off : Icons.v-mic;
    action-tint: muted ? Theme.err : Theme.text-dim;
    action-label: mute-tip;
    action => { root.mute-toggled(!muted); }
    has-switch: true;
    switch-checked: on;
    switch-enabled: toggle-enabled;
    switch-label: toggle-name;
    switch-tip: toggle-tip;
    switch-toggled(v) => { root.toggled(v); }

    changed confirm-open => {
        if (confirm-open) { question.show(); }
    }

    if here: FormRow {
        label: mic-label;
        HorizontalLayout {
            spacing: 8px;
            LevelMeter { state: meter; clicked => { root.meter-clicked(); } }
            // Inset like the gain box's text above it (its 10px padding plus the border)
            HorizontalLayout {
                width: 78px;
                padding-right: 11px;
                Text {
                    text: meter.readout;
                    font-family: Theme.font;
                    font-size: Theme.body;
                    color: meter.red ? Theme.err : Theme.text-dim;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
    if here: FormRow {
        label: @tr("Gain");
        HorizontalLayout {
            spacing: 8px;
            Slider {
                hue: root.hue;
                has-readout: false;
                minimum: gain-min;
                maximum: gain-max;
                value: gain;
                label: @tr("Gain");
                has-default: true;
                default-value: 0;
                tip: @tr("Double-click to reset");
                moved(v) => { root.gain-moved(v); }
            }
            gain-box := TextField {
                width: 78px;
                y: 2px;
                text: gain-text;
                align-right: true;
                label: @tr("Gain");
                accepted => { root.gain-typed(self.text); }
                step(d) => { root.gain-moved(gain - d); }
            }
        }
    }
    if here: FormRow {
        label: @tr("Auto level");
        Rectangle { horizontal-stretch: 1; }
        Switch {
            y: 8px;
            checked: auto-level;
            label: @tr("Auto level");
            tip: @tr("Evens out quiet and loud speech.");
            toggled(v) => { root.auto-toggled(v); }
        }
    }
    if here: FormRow {
        label: @tr("Noise reduction");
        HorizontalLayout {
            spacing: 10px;
            // Alone, the switch sits at the row's end like the others; with the reason, the reason follows it
            if nr-note == "": Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 36px;
                Switch {
                    y: 8px;
                    checked: nr;
                    enabled: nr-enabled;
                    label: @tr("Noise reduction");
                    tip: nr-tip;
                    toggled(v) => { root.nr-toggled(v); }
                }
            }
            Note {
                text: nr-note;
                visible: nr-note != "";
                max-width: nr-note != "" ? 10000px : 0px;
                vertical-alignment: center;
                horizontal-stretch: nr-note != "" ? 1 : 0;
            }
        }
    }
    // Left out with `if`: a row hidden at 0px still takes the card's spacing
    if status-text != "": FormRow {
        label: "";
        Note {
            text: status-text;
            kind: status-kind;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    if fix-shown: FormRow {
        label: "";
        Button {
            y: 1px;
            text: fix-text;
            clicked => { root.fix-clicked(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }

    question := PopupWindow {
        x: 0px;
        y: 40px;
        width: root.width;
        close-policy: close-on-click-outside;
        DialogFrame {
            title: @tr("Install VB-Cable");
            Note { text: @tr("The phone's mic needs VB-Audio Virtual Cable on Windows."); kind: "status_none"; }
            Note { text: @tr("VB-Cable is made by VB-Audio, not Telescope. Telescope can download it from vb-audio.com and open VB-Audio's own setup, which asks for admin. Restart the computer when it's done."); }
            // VB-Audio's own two lines stay in English, as their licence asks for them word for word
            Note { text: origin + "\n" + donationware; }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: donate-text;
                    role: "quiet";
                    clicked => { root.donate(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: @tr("Cancel");
                    clicked => { question.close(); root.confirm-answered(false); }
                }
                Button {
                    text: @tr("Download and install");
                    role: "primary";
                    clicked => { question.close(); root.confirm-answered(true); }
                }
            }
        }
    }
}
