// The Microphone card. Texts with blanks come
// filled from Rust; the Install VB-Cable question is a popup inside the card.

import { Theme, Icons, Icon, Button, Card, RailRow, SwitchRow, Slider, Switch, Tip, TipBody, DialogFrame, WindowBox } from "@ui-kit/ui-kit.slint";

// The meter's numbers from the plugin: bar ends and the held marker as 0..1 along it, and which light is on.
export struct MeterState {
    peak: float,
    rms: float,
    hold: float,
    lit: string,
    muted: bool,
    readout: string,
    red: bool,
}

global Status {
    public pure function color(kind: string) -> color {
        kind == "status_ok" ? Theme.ok : kind == "status_warn" ? Theme.warn : kind == "status_err" ? Theme.err
            : kind == "status_dim" ? Theme.ink2 : Theme.ink
    }
}

// wrapped_note: a QLabel#dim, so body size
component Note inherits Text {
    in property <string> kind: "status_dim";
    font-family: Theme.font;
    font-size: Theme.body;
    color: Status.color(kind);
    wrap: word-wrap;
}

// One zone of a bar, in its own colour along the bar the way hardware meters light up.
component Zone inherits Rectangle {
    in property <float> from;
    in property <float> to;
    in property <float> level;
    in property <color> tone;
    in property <float> alpha;
    in property <length> track;
    property <length> left: round(from * track / 1px) * 1px;
    property <length> right: round(min(level, to) * track / 1px) * 1px;
    x: left;
    width: level > from ? max(0px, right - left) : 0px;
    background: tone.with-alpha(alpha);
}

// LevelMeter: peak and RMS bars, a held peak marker and ticks under the bar. The bar's end cap lights when the limiter works or the
// sound clipped. A click clears the hold.
component LevelMeter inherits Rectangle {
    in property <MeterState> state;
    callback clicked;
    property <length> inset: Theme.u(5);
    property <length> bar-h: Theme.u(4);
    property <length> track-w: root.width - inset;
    property <length> top: (root.height - bar-h) / 2 - Theme.u(1);
    min-width: Theme.u(42);
    height: Theme.row;
    horizontal-stretch: 1;
    function tone(zone: int) -> color {
        state.muted ? Theme.dis : zone == 2 ? Theme.err : zone == 1 ? Theme.warn : Theme.ok
    }
    function at(p: float) -> length {
        p * track-w
    }
    bar := Rectangle {
        x: inset;
        y: top;
        width: track-w;
        height: bar-h;
        border-radius: bar-h / 2;
        background: Theme.trough;
        clip: true;
        // Peak at 55%, RMS on top at full colour; zones at -18 and -6 dBFS
        Zone { from: 0; to: 0.55; level: state.peak; tone: tone(0); alpha: 0.55; track: track-w; height: bar-h; }
        Zone { from: 0.55; to: 0.85; level: state.peak; tone: tone(1); alpha: 0.55; track: track-w; height: bar-h; }
        Zone { from: 0.85; to: 1; level: state.peak; tone: tone(2); alpha: 0.55; track: track-w; height: bar-h; }
        Zone { from: 0; to: 0.55; level: state.rms; tone: tone(0); alpha: 1; track: track-w; height: bar-h; }
        Zone { from: 0.55; to: 0.85; level: state.rms; tone: tone(1); alpha: 1; track: track-w; height: bar-h; }
        Zone { from: 0.85; to: 1; level: state.rms; tone: tone(2); alpha: 1; track: track-w; height: bar-h; }
        if state.hold >= 0: Rectangle {
            x: min(max(at(state.hold), Theme.u(1.5)), track-w - bar-h / 2) - Theme.u(0.5);
            width: Theme.u(1);
            height: bar-h;
            background: state.muted ? Theme.ink2 : Theme.ink;
        }
        // The end cap: the limiter holding peaks down, or the sound clipping
        Rectangle {
            x: track-w - bar-h;
            width: bar-h;
            height: bar-h;
            border-radius: bar-h / 2;
            background: state.lit == "clip" ? Theme.err : state.lit == "limit" ? Theme.warn : transparent;
        }
    }
    // Ticks at -40, -30, -20, -12 and -6 dBFS
    for p in [0.16667, 0.25, 0.5, 0.7, 0.85]: Rectangle {
        x: inset + round(p * track-w / 1px) * 1px;
        y: top + bar-h + Theme.u(1.5);
        width: Theme.u(0.5);
        height: Theme.u(1.5);
        background: Theme.line-strong;
    }
    // One area for the click and the tooltip: a second one on top would take the click
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tip { says: @tr("Level"); detail: @tr("Yellow: the limiter is holding peaks down. Red: it clipped."); hint: @tr("Click to clear"); hover: touch.has-hover; }
}

export component MicrophoneCard inherits Card {
    // Greyed out until a phone is paired
    in property <bool> active;
    // On for the stream the panels show: the controls are there
    in property <bool> here;
    in property <bool> on;
    in property <bool> toggle-enabled: true;
    in property <string> mic-label: @tr("Phone mic");
    in property <string> toggle-name;
    in property <string> toggle-tip;
    in property <bool> muted;
    in property <string> mute-text: @tr("Mute");
    in property <string> mute-tip;
    in property <MeterState> meter;
    in property <int> gain;
    in property <int> gain-min: -24;
    in property <int> gain-max: 12;
    in property <string> gain-text: "0 dB";
    in property <string> gain-tip;
    in property <bool> auto-level;
    in property <bool> nr;
    in property <bool> nr-enabled: true;
    in property <string> nr-note;
    in property <string> nr-tip;
    in property <string> status-text;
    in property <string> status-kind: "status_dim";
    // The fix for a problem (Install VB-Cable, Get VB-Cable)
    in property <string> fix-text;
    in property <bool> fix-shown;
    // The Install VB-Cable question
    // Goes up each time the install has to be asked about: a click outside closes the question with no answer, and the next ask has to open it again
    in property <int> confirm-asked;
    in property <string> origin;
    in property <string> donationware;
    // The donate link's words, translated, without its markup
    in property <string> donate-text;
    callback toggled(bool);
    callback mute-toggled(bool);
    callback gain-moved(float);
    callback auto-toggled(bool);
    callback nr-toggled(bool);
    callback fix-clicked;
    callback meter-clicked;
    callback confirm-answered(bool);
    callback donate;

    title: @tr("Microphone");
    tip: @tr("Use the phone's microphone on this computer.");
    icon: Icons.mic;
    opacity: active ? 1 : 0.4;
    enabled: active;
    // The Mute button and the on/off switch sit in the header, so the card says at a glance whether the mic is in use. Mute is an
    // icon of its own width, so swapping Mute and Unmute never moves the title
    has-action: here;
    action-icon: muted ? Icons.v-mic-off : Icons.mic;
    action-tint: muted ? Theme.err : Theme.ink2;
    action-label: mute-text;
    action-tip-detail: mute-tip;
    action-shortcut: "microphone.mute";
    action => { root.mute-toggled(!muted); }
    has-switch: true;
    switch-shortcut: "microphone.on";
    switch-checked: on;
    switch-enabled: toggle-enabled;
    switch-label: toggle-name;
    switch-tip: toggle-name;
    switch-tip-detail: toggle-tip;
    switch-toggled(v) => { root.toggled(v); }

    changed confirm-asked => {
        question.show();
    }

    if here: RailRow {
        icon: Icons.mic;
        label: mic-label;
        tip: @tr("Level");
        tip-detail: @tr("Yellow: the limiter is holding peaks down. Red: it clipped.");
        hue: root.hue;
        HorizontalLayout {
            spacing: Theme.gap;
            LevelMeter { state: meter; clicked => { root.meter-clicked(); } }
            Text {
                width: Theme.u(28);
                text: meter.readout;
                font-family: Theme.font;
                font-size: Theme.body;
                font-weight: Theme.w-value;
                color: meter.red ? Theme.err : Theme.ink2;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
    if here: RailRow {
        icon: Icons.volume;
        label: @tr("Gain");
        tip-detail: gain-tip;
        hue: root.hue;
        changed: gain != 0;
        Slider {
            hue: root.hue;
            readout: gain-text;
            minimum: gain-min;
            maximum: gain-max;
            value: gain;
            label: @tr("Gain");
            shortcut: "microphone.gain";
            has-default: true;
            default-value: 0;
            tip: @tr("Gain");
            tip-detail: gain-tip;
            tip-hint: @tr("Double-click to reset");
            moved(v) => { root.gain-moved(v); }
        }
    }
    if here: SwitchRow {
        icon: Icons.waveform;
        label: @tr("Auto level");
        hue: root.hue;
        changed: auto-level;
        checked: auto-level;
        tip: @tr("Auto level");
        tip-detail: @tr("Even out quiet and loud speech.");
        toggled(v) => { root.auto-toggled(v); }
    }
    if here: RailRow {
        icon: Icons.denoise;
        label: @tr("Noise reduction");
        tip-detail: nr-tip;
        hue: root.hue;
        named: true;
        changed: nr;
        HorizontalLayout {
            spacing: Theme.gap;
            alignment: end;
            // RNNoise missing: a round red mark with the reason as its tooltip, so the switch stays where it is
            if nr-note != "": Rectangle {
                width: Theme.u(8);
                y: (parent.height - self.height) / 2;
                height: Theme.u(8);
                border-radius: self.height / 2;
                background: Theme.err;
                accessible-role: text;
                accessible-label: nr-note;
                Text {
                    text: "!";
                    font-family: Theme.font;
                    font-size: Theme.small;
                    font-weight: 700;
                    color: Theme.on-hue;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                Tip { says: @tr("Noise reduction unavailable"); detail: nr-note; inert: true; }
            }
            VerticalLayout {
                alignment: center;
                Switch {
                    hue: root.hue;
                    checked: nr;
                    enabled: nr-enabled;
                    label: @tr("Noise reduction");
                    tip: @tr("Noise reduction");
                    tip-detail: nr-tip;
                    toggled(v) => { root.nr-toggled(v); }
                }
            }
        }
    }
    // Left out with `if`: a row hidden at 0px still takes the card's spacing
    if status-text != "": RailRow {
        has-icon: false;
        Note {
            text: status-text;
            kind: status-kind;
            vertical-alignment: center;
        }
    }
    if fix-shown: RailRow {
        has-icon: false;
        Button {
            text: fix-text;
            clicked => { root.fix-clicked(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }

    question := PopupWindow {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowBox.cover-w(max(root.width, Theme.u(230)));
        height: WindowBox.cover-h(question-frame.preferred-height);
        close-policy: no-auto-close;
        question-frame := DialogFrame {
            x: WindowBox.left(self.width);
            y: WindowBox.top(self.height);
            width: max(root.width, Theme.u(230));
            height: self.preferred-height;
            dismissable: true;
            dismissed => { question.close(); root.confirm-answered(false); }
            title: @tr("Install VB-Cable");
            Note { text: @tr("VB-Cable is made by VB-Audio. Telescope downloads it from vb-audio.com and opens its setup, which asks for admin. Restart the computer afterwards."); kind: "status_none"; }
            // VB-Audio's own two lines stay in English, as their licence asks for them word for word
            Note { text: origin + "\n" + donationware; }
            HorizontalLayout {
                spacing: Theme.u(4);
                Button {
                    text: donate-text;
                    clicked => { root.donate(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: @tr("Cancel");
                    clicked => { question.close(); root.confirm-answered(false); }
                }
                Button {
                    text: @tr("Download and install");
                    role: "primary";
                    hue: root.hue;
                    clicked => { question.close(); root.confirm-answered(true); }
                }
            }
        }
    }
}
