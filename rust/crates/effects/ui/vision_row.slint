// The status row on cards that use vision (widgets/vision_status.py). Joined after parts.slint, which has the imports.

component VisionRow inherits HorizontalLayout {
    in property <string> text;
    in property <bool> download;
    callback download-clicked;
    spacing: 8px;
    Note {
        horizontal-stretch: 1;
        text: root.text;
        kind: "status_warn";
    }
    if download: Button {
        text: @tr("Download");
        clicked => { root.download-clicked(); }
    }
}
