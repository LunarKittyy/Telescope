// Transforms' own controls, joined after parts.slint.

// Segments that switch on and off on their own (two SegmentButtons side by side in segmented_row, each checkable)
component Toggles inherits Rectangle {
    in property <[string]> items;
    in property <[image]> icons;
    in property <[bool]> checked;
    in property <string> label;
    in property <bool> enabled: true;
    // The action each one stands for: a right-click on it offers a keyboard shortcut
    in property <[string]> shortcuts;
    // The id of the setting each one is, for the outline when something outside the window reads or changes it
    in property <[string]> settings;
    callback toggled(int, bool);
    height: 36px;
    horizontal-stretch: 1;
    Rectangle {
        y: 2px;
        height: 32px;
        background: Theme.surface-raise;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 8px;
    }
    HorizontalLayout {
        y: 2px;
        height: 32px;
        padding: 3px;
        spacing: 2px;
        for item[i] in items: Rectangle {
            property <bool> on: checked[i];
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            border-radius: 6px;
            background: on ? (seg-touch.has-hover ? Theme.fill-hover : Theme.fill) : (seg-touch.has-hover ? Theme.surface-hover : transparent);
            accessible-role: checkbox;
            accessible-label: item;
            accessible-checkable: true;
            accessible-checked: on;
            accessible-action-default => { if (root.enabled) { root.toggled(i, !on); } }
            seg-touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.toggled(i, !on); }
            }
            if shortcuts[i] != "": ShortcutMenu { action: shortcuts[i]; }
            TouchRing { setting: settings[i]; width: parent.width; height: parent.height; radius: 6px; }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Icon {
                    y: (parent.height - 13px) / 2;
                    source: icons[i];
                    tint: on ? white : Theme.text-dim;
                    width: 13px;
                    height: 13px;
                    accessible-role: none;
                }
                Text {
                    text: item;
                    font-family: Theme.font;
                    font-size: Theme.body;
                    font-weight: on ? 600 : 400;
                    color: on ? white : seg-touch.has-hover ? Theme.text : Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
