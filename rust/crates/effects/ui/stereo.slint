// The 3D card. Joined after parts.slint, which has the imports.

export component StereoCard inherits Card {
    in property <bool> on;
    in property <string> switch-name;
    in property <string> switch-help;
    in property <[string]> look-items;
    in property <int> look-current;
    in property <string> look-tip;
    in property <float> depth;
    in property <string> depth-text;
    in property <string> depth-tip;
    in property <float> height-shift;
    in property <string> height-text;
    in property <string> height-tip;
    in property <float> size-percent;
    in property <string> size-text;
    in property <string> size-tip;
    in property <float> tilt;
    in property <string> tilt-text;
    in property <string> tilt-tip;
    in property <float> timing;
    in property <string> timing-text;
    in property <string> timing-tip;
    in-out property <bool> fine-open;
    in property <string> fine-tip;
    in-out property <bool> swap;
    in property <string> swap-tip;
    in property <bool> match-enabled;
    in property <string> match-tip;
    in property <bool> reset-enabled;
    in property <string> reset-tip;
    in property <bool> reset-shown;
    in property <string> badge;
    in property <string> badge-kind: "status_dim";
    in property <string> badge-detail;
    in property <float> brightness;
    in property <string> brightness-text;
    in property <string> brightness-tip;
    in property <bool> brightness-enabled;
    // The headset viewer
    in property <bool> headset;
    in property <string> headset-name;
    in property <string> headset-tip;
    in property <string> headset-problem;
    in property <bool> headset-url-shown;
    in property <string> headset-url-text;
    in property <[int]> headset-qr-cells;
    in property <int> headset-qr-size;
    in property <string> headset-qr-label;
    in property <string> headset-qr-tip;
    in property <bool> headset-address-shown;
    in property <[string]> headset-addresses;
    in property <int> headset-address-current;
    in property <string> headset-address-tip;
    in property <string> headset-link-tip;
    in property <string> headset-copy-text;
    in property <string> headset-copy-tip;
    in property <string> headset-new-link-text;
    in property <string> headset-new-link-tip;
    callback headset-toggled(bool);
    callback headset-address-picked(int);
    callback headset-copy-clicked;
    callback headset-new-link-clicked;
    callback switch-toggled-by-hand(bool);
    callback look-picked(int);
    callback depth-moved(float);
    callback height-moved(float);
    callback size-moved(float);
    callback tilt-moved(float);
    callback timing-moved(float);
    callback brightness-moved(float);
    callback fine-toggled(bool);
    callback swap-toggled(bool);
    callback match-clicked;
    callback reset-match-clicked;
    callback reset-clicked;

    // What the rows that come and go said last, kept while they fold away
    property <string> held-problem;
    property <string> held-url;
    property <[int]> held-cells;
    property <int> held-size;
    property <[string]> held-addresses;
    property <int> held-address;
    function keep() {
        if (headset-problem != "") { held-problem = headset-problem; }
        if (headset-url-shown) {
            held-url = headset-url-text;
            held-cells = headset-qr-cells;
            held-size = headset-qr-size;
            held-addresses = headset-addresses;
            held-address = headset-address-current;
        }
    }
    init => { keep(); }
    changed headset-problem => { keep(); }
    changed headset-url-shown => { keep(); }
    changed headset-url-text => { keep(); }
    changed headset-qr-cells => { keep(); }
    changed headset-qr-size => { keep(); }
    changed headset-addresses => { keep(); }
    changed headset-address-current => { keep(); }

    title: @tr("3D");
    tip: @tr("Make one 3D picture from two phones.");
    icon: Icons.cube;
    has-switch: true;
    switch-shortcut: "stereo.on";
    switch-checked: on;
    switch-label: switch-name;
    switch-tip: switch-name;
    switch-tip-detail: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }
    tag: badge;
    tag-detail: badge-detail;
    tag-tint: StatusInk.color(badge-kind);
    has-reset: true;
    reset-lit: reset-shown;
    reset-label: @tr("Reset");
    reset-detail: @tr("Puts the look, the eye order and the fine tune sliders back and drops the match. The switch stays as it is and the phones keep their exposure.");
    reset => { root.reset-clicked(); }

    RailRow {
        icon: Icons.eye;
        label: @tr("Look");
        tip: @tr("Look");
        tip-detail: look-tip;
        hue: root.hue;
        changed: look-current != 0;
        ChoiceField {
            compact: true;
            caption: @tr("Look");
            items: look-items;
            current: look-current;
            tip: @tr("Look");
            tip-detail: look-tip;
            picked(i) => { root.look-picked(i); }
        }
    }
    SwitchRow {
        icon: Icons.mirror;
        label: @tr("Swap eyes");
        tip: @tr("Swap eyes");
        tip-detail: swap-tip;
        hue: root.hue;
        changed: swap;
        checked: root.swap;
        toggled(v) => {
            root.swap = v;
            root.swap-toggled(v);
        }
    }
    RailRow {
        icon: Icons.compare;
        label: @tr("Match");
        tip: @tr("Match");
        tip-detail: match-tip;
        hue: root.hue;
        enabled: match-enabled || reset-enabled;
        Button {
            horizontal-stretch: 1;
            enabled: match-enabled;
            text: @tr("Match");
            tip: @tr("Match");
            tip-detail: match-tip;
            clicked => { root.match-clicked(); }
        }
        Button {
            horizontal-stretch: 1;
            enabled: reset-enabled;
            text: @tr("Reset match");
            tip: @tr("Reset match");
            tip-detail: reset-tip;
            clicked => { root.reset-match-clicked(); }
        }
    }
    RailSlider {
        icon: Icons.sun;
        label: @tr("Brightness");
        tip-detail: brightness-tip;
        enabled: brightness-enabled;
        minimum: -2;
        maximum: 2;
        step: 0.1;
        value: brightness;
        readout: brightness-text;
        hue: root.hue;
        has-default: true;
        default-value: 0;
        moved(v) => { root.brightness-moved(v); }
    }
    UnfoldGroup {
        SwitchRow {
            icon: Icons.sliders;
            label: @tr("Fine tune");
            tip: @tr("Fine tune");
            tip-detail: fine-tip;
            hue: root.hue;
            changed: depth != 0 || height-shift != 0 || size-percent != 100 || tilt != 0 || timing != 0;
            checked: root.fine-open;
            toggled(v) => {
                root.fine-open = v;
                root.fine-toggled(v);
            }
        }
        Unfolding {
            open: root.fine-open;
            // never taller than its rows, so spare height in the card isn't left as a gap above the badges
            max-height: self.preferred-height;
            RailSlider {
                icon: Icons.stretch;
                label: @tr("Depth");
                tip-detail: depth-tip;
                minimum: -5;
                maximum: 5;
                step: 0.1;
                value: depth;
                readout: depth-text;
                hue: root.hue;
                has-default: true;
                default-value: 0;
                moved(v) => { root.depth-moved(v); }
            }
            RailSlider {
                icon: Icons.stretch-tall;
                label: @tr("Height");
                tip-detail: height-tip;
                minimum: -5;
                maximum: 5;
                step: 0.1;
                value: height-shift;
                readout: height-text;
                hue: root.hue;
                has-default: true;
                default-value: 0;
                moved(v) => { root.height-moved(v); }
            }
            RailSlider {
                icon: Icons.aspect;
                label: @tr("Size");
                tip-detail: size-tip;
                minimum: 80;
                maximum: 125;
                step: 0.1;
                value: size-percent;
                readout: size-text;
                hue: root.hue;
                has-default: true;
                default-value: 100;
                two-way: true;
                centre: 100;
                moved(v) => { root.size-moved(v); }
            }
            RailSlider {
                icon: Icons.rotate;
                label: @tr("Tilt");
                tip-detail: tilt-tip;
                minimum: -5;
                maximum: 5;
                step: 0.1;
                value: tilt;
                readout: tilt-text;
                hue: root.hue;
                has-default: true;
                default-value: 0;
                moved(v) => { root.tilt-moved(v); }
            }
            RailSlider {
                icon: Icons.timer;
                label: @tr("Timing");
                tip-detail: timing-tip;
                minimum: -200;
                maximum: 200;
                step: 1;
                value: timing;
                readout: timing-text;
                hue: root.hue;
                has-default: true;
                default-value: 0;
                moved(v) => { root.timing-moved(v); }
            }
        }
    }
    UnfoldGroup {
        SwitchRow {
            icon: Icons.monitor;
            label: headset-name;
            tip: headset-name;
            tip-detail: headset-tip;
            hue: root.hue;
            checked: headset;
            toggled(v) => { root.headset-toggled(v); }
        }
        Unfolding {
            open: headset-problem != "";
            RailRow {
                has-icon: false;
                Status { text: @tr("Headset failed to start"); detail: held-problem; kind: "err"; horizontal: "end"; }
            }
        }
        Unfolding {
            open: headset-url-shown;
            RailRow {
                icon: Icons.qr;
                label: headset-qr-label;
                tip: headset-qr-label;
                tip-detail: headset-qr-tip;
                hue: root.hue;
                HorizontalLayout {
                    alignment: end;
                    QrCode { cells: held-cells; size: held-size; cell: Theme.unit * 2; label: headset-qr-label; }
                }
            }
        }
        Unfolding {
            open: headset-url-shown && headset-address-shown;
            RailRow {
                icon: Icons.wifi;
                label: @tr("Address");
                tip: @tr("Address");
                tip-detail: headset-address-tip;
                hue: root.hue;
                ChoiceField {
                    compact: true;
                    caption: @tr("Address");
                    items: held-addresses;
                    current: held-address;
                    tip: @tr("Address");
                    tip-detail: headset-address-tip;
                    picked(i) => { root.headset-address-picked(i); }
                }
            }
        }
        Unfolding {
            open: headset-url-shown;
            RailRow {
                icon: Icons.link;
                label: @tr("Link");
                tip: @tr("Link");
                tip-detail: headset-link-tip;
                hue: root.hue;
                VerticalLayout {
                    spacing: Theme.gap;
                    Text {
                        text: held-url;
                        font-family: Theme.font;
                        font-size: Theme.body;
                        color: Theme.ink;
                        overflow: elide;
                        min-width: 0px;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap;
                        Button { horizontal-stretch: 1; text: headset-copy-text; tip: headset-copy-text; tip-detail: headset-copy-tip; clicked => { root.headset-copy-clicked(); } }
                        Button { horizontal-stretch: 1; text: headset-new-link-text; tip: headset-new-link-text; tip-detail: headset-new-link-tip; clicked => { root.headset-new-link-clicked(); } }
                    }
                }
            }
        }
    }
}
