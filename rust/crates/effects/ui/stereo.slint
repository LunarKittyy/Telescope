// The 3D card. Joined after parts.slint, which has the imports.

// Up to two state badges side by side on one row that unfolds in and out with their words, each one keeping its last words while the row shuts.
component BadgeUnfold inherits Unfolding {
    in property <string> first;
    in property <string> first-kind: "status_dim";
    in property <string> first-detail;
    in property <string> second;
    in property <string> second-kind: "status_dim";
    in property <string> second-detail;
    property <string> held-first;
    property <string> held-first-kind;
    property <string> held-first-detail;
    property <string> held-second;
    property <string> held-second-kind;
    property <string> held-second-detail;
    property <bool> any: first != "" || second != "";
    function keep() {
        if (root.first != "") {
            held-first = root.first;
            held-first-kind = root.first-kind;
            held-first-detail = root.first-detail;
        }
        if (root.second != "") {
            held-second = root.second;
            held-second-kind = root.second-kind;
            held-second-detail = root.second-detail;
        }
    }
    open: any;
    init => { keep(); }
    changed first => { keep(); }
    changed first-kind => { keep(); }
    changed first-detail => { keep(); }
    changed second => { keep(); }
    changed second-kind => { keep(); }
    changed second-detail => { keep(); }
    RailRow {
        has-icon: false;
        HorizontalLayout {
            alignment: start;
            spacing: Theme.u(4);
            if held-first != "" && (root.first != "" || !root.any): Rectangle {
                width: first-badge.width;
                first-badge := Tag { y: (parent.height - self.height) / 2; text: held-first; detail: held-first-detail; tint: StatusInk.color(held-first-kind); }
            }
            if held-second != "" && (root.second != "" || !root.any): Rectangle {
                width: second-badge.width;
                second-badge := Tag { y: (parent.height - self.height) / 2; text: held-second; detail: held-second-detail; tint: StatusInk.color(held-second-kind); }
            }
        }
    }
}

export component StereoCard inherits Card {
    in property <bool> on;
    in property <string> switch-name;
    in property <string> switch-help;
    in property <[string]> look-items;
    in property <int> look-current;
    in property <string> look-tip;
    in property <float> depth;
    in property <string> depth-text;
    in property <string> depth-tip;
    in property <float> height-shift;
    in property <string> height-text;
    in property <string> height-tip;
    in property <float> size-percent;
    in property <string> size-text;
    in property <string> size-tip;
    in property <float> tilt;
    in property <string> tilt-text;
    in property <string> tilt-tip;
    in property <float> timing;
    in property <string> timing-text;
    in property <string> timing-tip;
    in-out property <bool> fine-open;
    in property <string> fine-tip;
    in-out property <bool> swap;
    in property <string> swap-tip;
    in property <bool> match-enabled;
    in property <string> match-tip;
    in property <bool> reset-enabled;
    in property <string> reset-tip;
    in property <bool> reset-shown;
    in property <string> status;
    in property <string> status-kind: "status_dim";
    in property <string> status-detail;
    in property <string> match-status;
    in property <string> match-status-kind: "status_dim";
    in property <string> match-status-detail;
    callback switch-toggled-by-hand(bool);
    callback look-picked(int);
    callback depth-moved(float);
    callback height-moved(float);
    callback size-moved(float);
    callback tilt-moved(float);
    callback timing-moved(float);
    callback fine-toggled(bool);
    callback swap-toggled(bool);
    callback match-clicked;
    callback reset-match-clicked;
    callback reset-clicked;

    title: @tr("3D");
    tip: @tr("Make one 3D picture from two phones.");
    icon: Icons.cube;
    has-switch: true;
    switch-shortcut: "stereo.on";
    switch-checked: on;
    switch-label: switch-name;
    switch-tip: switch-name;
    switch-tip-detail: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }
    has-reset: true;
    reset-lit: reset-shown;
    reset-label: @tr("Reset");
    reset-detail: @tr("Puts the look, the eye order and the fine tune sliders back and drops the match. The switch stays as it is and the phones keep their exposure.");
    reset => { root.reset-clicked(); }

    RailRow {
        icon: Icons.eye;
        label: @tr("Look");
        tip: @tr("Look");
        tip-detail: look-tip;
        hue: root.hue;
        changed: look-current != 0;
        ChoiceField {
            compact: true;
            caption: @tr("Look");
            items: look-items;
            current: look-current;
            tip: @tr("Look");
            tip-detail: look-tip;
            picked(i) => { root.look-picked(i); }
        }
    }
    SwitchRow {
        icon: Icons.mirror;
        label: @tr("Swap eyes");
        tip: @tr("Swap eyes");
        tip-detail: swap-tip;
        hue: root.hue;
        changed: swap;
        checked: root.swap;
        toggled(v) => {
            root.swap = v;
            root.swap-toggled(v);
        }
    }
    RailRow {
        icon: Icons.compare;
        label: @tr("Match");
        tip: @tr("Match");
        tip-detail: match-tip;
        hue: root.hue;
        enabled: match-enabled || reset-enabled;
        Button {
            horizontal-stretch: 1;
            enabled: match-enabled;
            text: @tr("Match");
            tip: @tr("Match");
            tip-detail: match-tip;
            clicked => { root.match-clicked(); }
        }
        Button {
            horizontal-stretch: 1;
            enabled: reset-enabled;
            text: @tr("Reset match");
            tip: @tr("Reset match");
            tip-detail: reset-tip;
            clicked => { root.reset-match-clicked(); }
        }
    }
    UnfoldGroup {
        SwitchRow {
            icon: Icons.sliders;
            label: @tr("Fine tune");
            tip: @tr("Fine tune");
            tip-detail: fine-tip;
            hue: root.hue;
            changed: depth != 0 || height-shift != 0 || size-percent != 100 || tilt != 0 || timing != 0;
            checked: root.fine-open;
            toggled(v) => {
                root.fine-open = v;
                root.fine-toggled(v);
            }
        }
        Unfolding {
            open: root.fine-open;
            RailSlider {
                icon: Icons.stretch;
                label: @tr("Depth");
                tip-detail: depth-tip;
                minimum: -5;
                maximum: 5;
                step: 0.1;
                value: depth;
                readout: depth-text;
                hue: root.hue;
                has-default: true;
                default-value: 0;
                moved(v) => { root.depth-moved(v); }
            }
            RailSlider {
                icon: Icons.stretch-tall;
                label: @tr("Height");
                tip-detail: height-tip;
                minimum: -5;
                maximum: 5;
                step: 0.1;
                value: height-shift;
                readout: height-text;
                hue: root.hue;
                has-default: true;
                default-value: 0;
                moved(v) => { root.height-moved(v); }
            }
            RailSlider {
                icon: Icons.aspect;
                label: @tr("Size");
                tip-detail: size-tip;
                minimum: 80;
                maximum: 125;
                step: 0.1;
                value: size-percent;
                readout: size-text;
                hue: root.hue;
                has-default: true;
                default-value: 100;
                two-way: true;
                centre: 100;
                moved(v) => { root.size-moved(v); }
            }
            RailSlider {
                icon: Icons.rotate;
                label: @tr("Tilt");
                tip-detail: tilt-tip;
                minimum: -5;
                maximum: 5;
                step: 0.1;
                value: tilt;
                readout: tilt-text;
                hue: root.hue;
                has-default: true;
                default-value: 0;
                moved(v) => { root.tilt-moved(v); }
            }
            RailSlider {
                icon: Icons.timer;
                label: @tr("Timing");
                tip-detail: timing-tip;
                minimum: -200;
                maximum: 200;
                step: 1;
                value: timing;
                readout: timing-text;
                hue: root.hue;
                has-default: true;
                default-value: 0;
                moved(v) => { root.timing-moved(v); }
            }
        }
        BadgeUnfold {
            first: status;
            first-kind: status-kind;
            first-detail: status-detail;
            second: match-status;
            second-kind: match-status-kind;
            second-detail: match-status-detail;
        }
    }
}
