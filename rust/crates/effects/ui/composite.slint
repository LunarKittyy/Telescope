// The One picture card. Joined after parts.slint, which has the imports.

export component CompositeCard inherits Card {
    in property <bool> on;
    in property <string> switch-name;
    in property <string> switch-help;
    in property <[string]> layout-items;
    // -1 while the picture isn't one of the saved layouts
    in property <int> layout-current: -1;
    in property <bool> layout-enabled;
    in property <string> layout-tip;
    in property <bool> edit-shown;
    in property <string> status;
    in property <string> status-detail;
    in property <string> status-kind: "status_dim";
    callback switch-toggled-by-hand(bool);
    callback layout-picked(int);
    callback edit-clicked;
    in property <bool> director;
    in property <bool> director-enabled;
    in property <string> director-name;
    in property <string> director-detail;
    callback director-toggled(bool);
    in property <bool> reset-shown;
    callback reset-clicked;
    in property <[string]> transition-items;
    in property <int> transition-current;
    in property <[string]> ease-items;
    in property <int> ease-current;
    in property <float> transition-ms;
    in property <string> transition-ms-text;
    in property <bool> transition-shown;
    callback transition-picked(int);
    callback ease-picked(int);
    callback transition-length-moved(float);

    title: @tr("One picture");
    tip: @tr("Combine the running streams into one picture.");
    icon: Icons.layout;
    header-status: status;
    header-status-detail: status-detail;
    header-status-kind: status-kind == "status_ok" ? "ok" : status-kind == "status_warn" ? "warn" : status-kind == "status_err" ? "err" : "";
    has-switch: true;
    switch-shortcut: "composite.on";
    switch-checked: on;
    switch-label: switch-name;
    switch-tip: switch-name;
    switch-tip-detail: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }
    has-reset: true;
    reset-lit: reset-shown;
    reset-label: @tr("Reset");
    reset-detail: @tr("Clear the current layout without touching saved layouts.");
    reset => { root.reset-clicked(); }

    UnfoldGroup {
        RailRow {
            icon: Icons.layout;
            label: @tr("Layout");
            hue: root.hue;
            Rectangle {
                horizontal-stretch: 1;
                ChoiceField {
                    width: parent.width;
                    compact: true;
                    caption: @tr("Layout");
                    items: layout-items;
                    current: layout-current;
                    enabled: layout-enabled;
                    tip: @tr("Layout");
                    tip-detail: root.layout-tip;
                    shortcut: "composite.layout";
                    picked(i) => { root.layout-picked(i); }
                }
                // The combo box's placeholder while no saved layout is picked
                if layout-current < 0: Text {
                    x: Theme.u(5.5);
                    width: parent.width - Theme.u(20);
                    text: @tr("Not saved");
                    font-family: Theme.font;
                    font-size: Theme.body;
                    color: Theme.ink2;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Unfolding {
            open: edit-shown;
            RailRow {
                has-icon: false;
                Button {
                    horizontal-stretch: 1;
                    text: @tr("Edit picture");
                    tip: @tr("Edit picture");
                    tip-detail: @tr("Open the editor for the layout.");
                    has-icon: true;
                    icon: Icons.pencil;
                    icon-tint: Theme.ink2;
                    clicked => { root.edit-clicked(); }
                }
            }
        }
        SwitchRow {
            icon: Icons.layout;
            label: director-name;
            tip: director-name;
            tip-detail: director-detail;
            hue: root.hue;
            enabled: director-enabled;
            changed: director;
            checked: root.director;
            toggled(v) => { root.director-toggled(v); }
        }
        Unfolding {
            open: true;
            RailRow {
                icon: Icons.film;
                label: @tr("Transition");
                hue: root.hue;
                ChoiceField {
                    horizontal-stretch: 1;
                    compact: true;
                    caption: @tr("Transition");
                    items: transition-items;
                    current: transition-current;
                    tip: @tr("Transition");
                    tip-detail: @tr("How the picture goes from one layout to the next. Glide moves the tiles to their new places and the rest mix the two pictures.");
                    picked(i) => { root.transition-picked(i); }
                }
            }
        }
        Unfolding {
            open: transition-shown;
            RailSlider {
                icon: Icons.timer;
                hue: root.hue;
                label: @tr("Length");
                minimum: 100;
                maximum: 3000;
                value: transition-ms;
                readout: transition-ms-text;
                tip-detail: @tr("How long a transition takes.");
                has-default: true;
                default-value: 600;
                moved(v) => { root.transition-length-moved(v); }
            }
        }
        Unfolding {
            open: transition-shown;
            RailRow {
                icon: Icons.gauge;
                label: @tr("Easing");
                hue: root.hue;
                ChoiceField {
                    horizontal-stretch: 1;
                    compact: true;
                    caption: @tr("Easing");
                    items: ease-items;
                    current: ease-current;
                    tip: @tr("Easing");
                    tip-detail: @tr("Springy and Bouncy overshoot a little and settle, Smooth glides without overshooting and Even goes at one speed.");
                    picked(i) => { root.ease-picked(i); }
                }
            }
        }
    }
}
