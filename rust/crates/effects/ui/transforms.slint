// The Transforms card. Joined after parts.slint and pad.slint.

// The zoom and pan map: the whole frame in its own shape, centred in a row of fixed height so the card never changes size when the
// phone turns, with the crop drawn on it and dragged directly. Zoom stays the slider above. The picture is small and still until
// the crop is touched, and lies under the crop's dimmed surround.
component ZoomMap inherits Rectangle {
    in property <float> zoom: 1;
    in property <float> pan-x;
    in property <float> pan-y;
    in property <bool> enabled: true;
    in property <color> hue: Theme.accent;
    in property <string> tip;
    in property <string> label;
    in property <string> shortcut;
    in property <[ShortcutEntry]> shortcut-adds;
    in property <string> setting-x;
    in property <string> setting-y;
    in property <image> picture;
    in property <bool> has-picture;
    in property <float> aspect: 1.7778;
    in property <[float]> share: [0, 0, 1, 1];
    in property <bool> share-on;
    callback moved(float, float);
    callback grabbed(bool);
    height: Theme.u(76);
    horizontal-stretch: 1;
    property <float> span: 1 - 1 / max(1, zoom);
    map := Pad {
        width: min(parent.width, parent.height * max(0.2, aspect));
        height: min(parent.height, parent.width / max(0.2, aspect));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        x-minimum: 0.5 * (1 - root.span);
        x-maximum: 0.5 * (1 + root.span);
        y-minimum: 0.5 * (1 - root.span);
        y-maximum: 0.5 * (1 + root.span);
        value-x: 0.5 + root.pan-x * root.span / 2;
        value-y: 0.5 + root.pan-y * root.span / 2;
        step-x: 0.005;
        step-y: 0.005;
        box-w: self.width / max(1, root.zoom);
        box-h: self.height / max(1, root.zoom);
        has-centre: false;
        has-default: true;
        default-x: 0.5;
        default-y: 0.5;
        enabled: root.enabled;
        hue: root.hue;
        tip: root.tip;
        label: root.label;
        spoken: Spoken.pan(root.pan-x, root.pan-y);
        shortcut: root.shortcut;
        shortcut-adds: root.shortcut-adds;
        setting-x: root.setting-x;
        setting-y: root.setting-y;
        moved(x, y) => { root.moved(x, y); }
        changed held => { root.grabbed(self.held); }
        // Nothing to show yet: the thirds of a picture, faint, so the map reads as a frame and not a dead box
        if !root.has-picture: Rectangle {
            for t in [1, 2]: Rectangle {
                x: parent.width * t / 3 - Theme.u(0.25);
                width: Theme.u(0.5);
                background: Theme.ink.with-alpha(0.07);
            }
            for t in [1, 2]: Rectangle {
                y: parent.height * t / 3 - Theme.u(0.25);
                height: Theme.u(0.5);
                background: Theme.ink.with-alpha(0.07);
            }
        }
        if root.has-picture: Image {
            width: parent.width;
            height: parent.height;
            source: root.picture;
            image-fit: fill;
            image-rendering: smooth;
        }
        // Where the phone's own lens sees, while that is less than the whole frame
        if root.share-on: Rectangle {
            x: root.share[0] * parent.width;
            y: root.share[1] * parent.height;
            width: root.share[2] * parent.width;
            height: root.share[3] * parent.height;
            Rectangle { y: 0px; height: Theme.u(0.5); background: Theme.ink.with-alpha(0.55); }
            Rectangle { y: parent.height - Theme.u(0.5); height: Theme.u(0.5); background: Theme.ink.with-alpha(0.55); }
            Rectangle { x: 0px; width: Theme.u(0.5); background: Theme.ink.with-alpha(0.55); }
            Rectangle { x: parent.width - Theme.u(0.5); width: Theme.u(0.5); background: Theme.ink.with-alpha(0.55); }
        }
    }
}

export component TransformsCard inherits Card {
    // Greyed out until a phone is paired
    in property <bool> active: true;
    in property <[bool]> flips: [false, false];
    in property <int> rotation: 0;
    in property <float> zoom: 1;
    in property <float> zoom-max: 10;
    in property <[float]> zoom-marks;
    in property <bool> zoom-free: true;
    in property <string> zoom-text: "1.0\u{d7}";
    in property <string> zoom-tip;
    // The lens dot beside the zoom: "" for none, "on" for a longer lens and "off" for not the lens this zoom would get
    in property <string> dot-level;
    in property <string> dot-tip;
    in property <float> pan-x;
    in property <float> pan-y;
    in property <bool> pan-enabled;
    in property <string> pan-text;
    // The map: the whole frame as the phone sends it (a small picture that only moves while it is touched), its shape (width over
    // height), and where the phone's own share of it lies when that is less than the whole (x, y, width, height of 0 to 1)
    in property <image> map-picture;
    in property <bool> map-has-picture;
    in property <float> map-aspect: 1.7778;
    in property <[float]> map-share: [0, 0, 1, 1];
    in property <bool> map-share-on;
    in property <float> stretch-x: 100;
    in property <float> stretch-y: 100;
    in property <string> stretch-x-text;
    in property <string> stretch-y-text;
    in property <string> reset-tip;
    in property <string> pan-tip;
    in property <string> pan-add-x;
    in property <string> pan-add-y;
    in property <string> reset-hint;
    in property <[string]> stretch-tips: ["", ""];
    callback reset-clicked;
    callback flip-toggled(int, bool);
    callback rotation-picked(int);
    callback zoom-moved(float);
    // The middle of the crop as a fraction of the frame, across and down, and whether the crop is held
    callback map-moved(float, float);
    callback map-grabbed(bool);
    callback stretch-moved(int, float);

    title: @tr("Transforms");
    icon: Icons.crop;
    opacity: active ? 1 : 0.4;
    enabled: active;
    has-action: true;
    action-icon: Icons.reset;
    // card_action(tr("Reset"), "reset", …)
    action-text: @tr("Reset");
    action-label: reset-tip;
    action-shortcut: "transforms.reset";
    action => { root.reset-clicked(); }

    FormRow {
        label: @tr("Flip");
        Toggles {
            items: [@tr("Mirror"), @tr("Upside down")];
            icons: [Icons.mirror, Icons.upside-down];
            checked: flips;
            enabled: active;
            label: @tr("Flip");
            shortcuts: ["transforms.flip_horizontal", "transforms.flip_vertical"];
            settings: ["transforms.flip_h", "transforms.flip_v"];
            toggled(i, on) => { root.flip-toggled(i, on); }
        }
    }
    FormRow {
        label: @tr("Rotation");
        Segmented {
            hue: root.hue;
            items: ["0\u{b0}", "90\u{b0}", "180\u{b0}", "270\u{b0}"];
            disabled: [!active, !active, !active, !active];
            has-icons: [false, false, false, false];
            icons: [Icons.colour, Icons.colour, Icons.colour, Icons.colour];
            label: @tr("Rotation");
            shortcut: "transforms.rotation";
            setting: "transforms.rotation";
            current: rotation;
            picked(i) => { root.rotation-picked(i); }
        }
    }
    FormRow {
        label: @tr("Zoom");
        enabled: zoom-free;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                Slider {
                    width: parent.width;
                    height: parent.height;
                    has-readout: false;
                    readout: zoom-text;
                    hue: root.hue;
                    enabled: active && zoom-free;
                    label: @tr("Zoom");
                    tip: root.zoom-tip;
                    shortcut: "transforms.zoom";
                    setting: "transforms.zoom";
                    minimum: 1;
                    maximum: zoom-max;
                    step: 0.01;
                    value: zoom;
                    marks: zoom-marks;
                    has-default: true;
                    default-value: 1;
                    moved(v) => { root.zoom-moved(v); }
                }
            }
            Rectangle {
                width: 56px;
                HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    if dot-level != "": Rectangle {
                        width: 6px;
                        y: (parent.height - 6px) / 2;
                        height: 6px;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: dot-level == "on" ? Theme.accent : Theme.err;
                        }
                        Tip { says: root.dot-tip; inert: true; }
                    }
                    Text {
                        text: zoom-text;
                        font-family: Theme.font;
                        font-size: Theme.body;
                        font-weight: 600;
                        color: !active ? Theme.accent-soft : zoom-free ? root.hue : Theme.text-disabled;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Tip { says: root.zoom-tip; inert: true; }
            }
        }
    }
    FormRow {
        label: @tr("Pan");
        ZoomMap {
            zoom: root.zoom;
            pan-x: root.pan-x;
            pan-y: root.pan-y;
            enabled: active && pan-enabled;
            hue: root.hue;
            tip: root.pan-tip;
            label: @tr("Pan");
            picture: root.map-picture;
            has-picture: root.map-has-picture;
            aspect: root.map-aspect;
            share: root.map-share;
            share-on: root.map-share-on;
            shortcut: "transforms.pan_x transforms.pan_y";
            shortcut-adds: [{ id: "transforms.pan_x", text: root.pan-add-x }, { id: "transforms.pan_y", text: root.pan-add-y }];
            setting-x: "transforms.pan_x";
            setting-y: "transforms.pan_y";
            moved(x, y) => { root.map-moved(x, y); }
            grabbed(on) => { root.map-grabbed(on); }
        }
    }
    SliderRow {
        enabled: active;
        label: @tr("Width");
        tip: stretch-tips[0];
        shortcut: "transforms.stretch_x";
        setting: "transforms.stretch_x";
        hint: reset-hint;
        minimum: 50;
        maximum: 200;
        value: stretch-x;
        readout: stretch-x-text;
        hue: root.hue;
        has-default: true;
        default-value: 100;
        moved(v) => { root.stretch-moved(0, v); }
    }
    SliderRow {
        enabled: active;
        label: @tr("Height");
        tip: stretch-tips[1];
        shortcut: "transforms.stretch_y";
        setting: "transforms.stretch_y";
        hint: reset-hint;
        minimum: 50;
        maximum: 200;
        value: stretch-y;
        readout: stretch-y-text;
        hue: root.hue;
        has-default: true;
        default-value: 100;
        moved(v) => { root.stretch-moved(1, v); }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
