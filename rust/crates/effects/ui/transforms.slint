// The Transforms card. Joined after parts.slint and pad.slint.

// The zoom and pan map: the whole frame in its own shape on an empty field, centred in a row of fixed height so the card never changes
// size when the phone turns, with the crop drawn on it as a rounded frame and dragged directly. Zoom stays the slider above.
component ZoomMap inherits Rectangle {
    in property <float> zoom: 1;
    in property <float> pan-x;
    in property <float> pan-y;
    in property <bool> enabled: true;
    in property <color> hue: Theme.accent;
    in property <string> tip;
    in property <string> tip-hint;
    in property <string> label;
    in property <string> shortcut;
    in property <[ShortcutEntry]> shortcut-adds;
    in property <string> setting-x;
    in property <string> setting-y;
    in property <float> aspect: 1.7778;
    callback moved(float, float);
    callback grabbed(bool);
    height: Theme.u(76);
    horizontal-stretch: 1;
    property <float> span: 1 - 1 / max(1, zoom);
    map := Pad {
        width: min(parent.width, parent.height * max(0.2, aspect));
        height: min(parent.height, parent.width / max(0.2, aspect));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        x-minimum: 0.5 * (1 - root.span);
        x-maximum: 0.5 * (1 + root.span);
        y-minimum: 0.5 * (1 - root.span);
        y-maximum: 0.5 * (1 + root.span);
        value-x: 0.5 + root.pan-x * root.span / 2;
        value-y: 0.5 + root.pan-y * root.span / 2;
        step-x: 0.005;
        step-y: 0.005;
        box-w: self.width / max(1, root.zoom);
        box-h: self.height / max(1, root.zoom);
        has-centre: false;
        has-default: true;
        default-x: 0.5;
        default-y: 0.5;
        enabled: root.enabled;
        hue: root.hue;
        tip: root.tip;
        tip-hint: root.tip-hint;
        label: root.label;
        spoken: Spoken.pan(root.pan-x, root.pan-y);
        shortcut: root.shortcut;
        shortcut-adds: root.shortcut-adds;
        setting-x: root.setting-x;
        setting-y: root.setting-y;
        moved(x, y) => { root.moved(x, y); }
        changed held => { root.grabbed(self.held); }
    }
}

export component TransformsCard inherits Card {
    in property <bool> active: true;
    idle: !active;
    // Greyed out until a phone is paired
    in property <[bool]> flips: [false, false];
    in property <int> rotation: 0;
    in property <float> zoom: 1;
    in property <float> zoom-max: 10;
    in property <[float]> zoom-marks;
    in property <bool> zoom-free: true;
    in property <string> zoom-text: "1.0\u{d7}";
    in property <string> zoom-tip;
    // The lens dot beside the zoom: "" for none, "on" for a longer lens and "off" for not the lens this zoom would get
    in property <string> dot-level;
    in property <string> dot-tip;
    in property <float> pan-x;
    in property <float> pan-y;
    in property <bool> pan-enabled;
    in property <string> pan-text;
    // The map's shape: the frame's width over its height
    in property <float> map-aspect: 1.7778;
    in property <float> stretch-x: 100;
    in property <float> stretch-y: 100;
    in property <string> stretch-x-text;
    in property <string> stretch-y-text;
    in property <string> pan-tip;
    in property <string> pan-add-x;
    in property <string> pan-add-y;
    in property <string> reset-hint;
    in property <[string]> stretch-tips: ["", ""];
    callback reset-clicked;
    callback flip-toggled(int, bool);
    callback rotation-picked(int);
    callback zoom-moved(float);
    // The middle of the crop as a fraction of the frame, across and down, and whether the crop is held
    callback map-moved(float, float);
    callback map-grabbed(bool);
    callback stretch-moved(int, float);

    title: @tr("Transforms");
    tip: @tr("Zoom, pan, flip, rotate and stretch the picture.");
    icon: Icons.crop;
    enabled: active;
    in property <string> reset-help;
    has-reset: true;
    reset-detail: reset-help;
    reset-lit: flips[0] || flips[1] || rotation != 0 || zoom != 1 || pan-x != 0 || pan-y != 0 || stretch-x != 100 || stretch-y != 100;
    reset-label: @tr("Reset");
    reset => { root.reset-clicked(); }

    RailRow {
        icon: Icons.mirror;
        label: @tr("Flip");
        hue: root.hue;
        enabled: active;
        changed: flips[0] || flips[1];
        HorizontalLayout {
            spacing: Theme.gap;
            ToggleTile {
                icon: Icons.mirror;
                text: @tr("Mirror");
                tip: @tr("Mirror");
                tip-detail: @tr("Flip the picture left to right.");
                shortcut: "transforms.flip_horizontal";
                setting: "transforms.flip_h";
                hue: root.hue;
                enabled: active;
                checked: flips[0];
                toggled(on) => { root.flip-toggled(0, on); }
            }
            ToggleTile {
                icon: Icons.upside-down;
                text: @tr("Upside down");
                tip: @tr("Upside down");
                tip-detail: @tr("Flip the picture top to bottom.");
                shortcut: "transforms.flip_vertical";
                setting: "transforms.flip_v";
                hue: root.hue;
                enabled: active;
                checked: flips[1];
                toggled(on) => { root.flip-toggled(1, on); }
            }
        }
    }
    RailRow {
        icon: Icons.rotate;
        label: @tr("Rotation");
        hue: root.hue;
        enabled: active;
        changed: rotation != 0;
        Segmented {
            hue: root.hue;
            items: ["0\u{b0}", "90\u{b0}", "180\u{b0}", "270\u{b0}"];
            disabled: [!active, !active, !active, !active];
            has-icons: [false, false, false, false];
            icons: [Icons.colour, Icons.colour, Icons.colour, Icons.colour];
            label: @tr("Rotation");
            tips: [@tr("Rotation"), @tr("Rotation"), @tr("Rotation"), @tr("Rotation")];
            shortcut: "transforms.rotation";
            setting: "transforms.rotation";
            current: rotation;
            picked(i) => { root.rotation-picked(i); }
        }
    }
    RailRow {
        icon: Icons.zoom;
        label: @tr("Zoom");
        hue: root.hue;
        enabled: zoom-free && active;
        changed: zoom != 1;
        HorizontalLayout {
            spacing: Theme.gap;
            Rectangle {
                horizontal-stretch: 1;
                Slider {
                    width: parent.width;
                    height: parent.height;
                    has-readout: false;
                    readout: zoom-text;
                    hue: root.hue;
                    enabled: active && zoom-free;
                    label: @tr("Zoom");
                    tip: @tr("Zoom");
                    tip-detail: root.zoom-tip;
                    tip-hint: root.reset-hint;
                    shortcut: "transforms.zoom";
                    setting: "transforms.zoom";
                    minimum: 1;
                    maximum: zoom-max;
                    step: 0.01;
                    value: zoom;
                    marks: zoom-marks;
                    has-default: true;
                    default-value: 1;
                    moved(v) => { root.zoom-moved(v); }
                }
            }
            Rectangle {
                width: Theme.u(28);
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.u(2);
                    if dot-level != "": Rectangle {
                        width: Theme.u(3);
                        y: (parent.height - Theme.u(3)) / 2;
                        height: Theme.u(3);
                        Rectangle {
                            width: Theme.u(3);
                            height: Theme.u(3);
                            border-radius: Theme.u(1.5);
                            background: dot-level == "on" ? Theme.accent : Theme.err;
                        }
                        Tip { says: @tr("Lens switch"); detail: root.dot-tip; inert: true; }
                    }
                    Text {
                        text: zoom-text;
                        font-family: Theme.font;
                        font-size: Theme.body;
                        font-weight: Theme.w-value;
                        color: !active || !zoom-free ? Theme.dis : root.hue;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Tip { says: @tr("Zoom"); detail: root.zoom-tip; hint: root.reset-hint; inert: true; }
            }
        }
    }
    RailRow {
        icon: Icons.pan;
        label: @tr("Pan");
        hue: root.hue;
        enabled: active && pan-enabled;
        changed: pan-x != 0 || pan-y != 0;
        ZoomMap {
            zoom: root.zoom;
            pan-x: root.pan-x;
            pan-y: root.pan-y;
            enabled: active && pan-enabled;
            hue: root.hue;
            tip: @tr("Pan");
            tip-hint: root.pan-tip;
            label: @tr("Pan");
            aspect: root.map-aspect;
            shortcut: "transforms.pan_x transforms.pan_y";
            shortcut-adds: [{ id: "transforms.pan_x", text: root.pan-add-x }, { id: "transforms.pan_y", text: root.pan-add-y }];
            setting-x: "transforms.pan_x";
            setting-y: "transforms.pan_y";
            moved(x, y) => { root.map-moved(x, y); }
            grabbed(on) => { root.map-grabbed(on); }
        }
    }
    RailSlider {
        icon: Icons.stretch;
        enabled: active;
        label: @tr("Width");
        tip: @tr("Width");
        tip-detail: stretch-tips[0];
        tip-hint: reset-hint;
        shortcut: "transforms.stretch_x";
        setting: "transforms.stretch_x";
        minimum: 50;
        maximum: 200;
        value: stretch-x;
        readout: stretch-x-text;
        hue: root.hue;
        has-default: true;
        default-value: 100;
        moved(v) => { root.stretch-moved(0, v); }
    }
    RailSlider {
        icon: Icons.stretch-tall;
        enabled: active;
        label: @tr("Height");
        tip: @tr("Height");
        tip-detail: stretch-tips[1];
        tip-hint: reset-hint;
        shortcut: "transforms.stretch_y";
        setting: "transforms.stretch_y";
        minimum: 50;
        maximum: 200;
        value: stretch-y;
        readout: stretch-y-text;
        hue: root.hue;
        has-default: true;
        default-value: 100;
        moved(v) => { root.stretch-moved(1, v); }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
