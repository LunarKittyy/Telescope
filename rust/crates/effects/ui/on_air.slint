// The On Air sign's tab in Settings: three cards. Joined after parts.slint, which has the imports.

// The plugin's own status kinds as the kit's Status says them
global SignKind {
    public pure function of(kind: string) -> string {
        kind == "status_ok" ? "ok" : kind == "status_warn" ? "warn" : kind == "status_err" ? "err" : ""
    }
}

// A named row with a one-line text box at the right edge, as wide as every other control of the page
component UrlRow inherits RailRow {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    named: true;
    TextField {
        width: Theme.u(130);
        label: root.label;
        placeholder: root.placeholder;
        text <=> root.text;
        tip: root.tip;
        tip-detail: root.tip-detail;
        edited(t) => { root.edited(t); }
    }
}

export component OnAirSettings inherits VerticalLayout {
    spacing: Theme.u(7);
    // Whether it's on air now, and what that's called
    in property <string> state-text;
    in property <string> state-kind: "status_dim";
    in property <[string]> trigger-items: ["", "", "", ""];
    in property <int> trigger-current;
    in property <string> trigger-tip;
    in property <bool> page;
    in property <string> new-link-tip;
    in property <string> page-name;
    // Why the sign page isn't up
    in property <string> problem;
    in property <bool> url-shown;
    in property <[int]> qr-cells;
    in property <int> qr-size;
    in property <string> qr-label;
    in property <bool> address-shown;
    in property <[string]> addresses;
    in property <int> address-current;
    in property <string> address-tip;
    in property <string> url-text;
    in property <string> copy-text;
    in property <string> copy-tip;
    in property <string> page-note;
    // The webhook: its settings are only sent when they were loaded, since what's typed is the box's own
    in-out property <string> webhook-url;
    in-out property <string> webhook-on;
    in-out property <string> webhook-off;
    in property <string> url-problem;
    in property <int> method-current;
    in property <string> on-placeholder;
    in property <string> off-placeholder;
    in property <string> payload-tip;
    in property <string> test-text;
    in property <string> test-kind: "status_dim";
    callback trigger-picked(int);
    callback page-toggled(bool);
    callback new-link-clicked;
    callback address-picked(int);
    callback copy-clicked;
    callback url-edited(string);
    callback method-picked(int);
    callback on-edited(string);
    callback off-edited(string);
    callback test-clicked(bool);

    // What the rows that come and go said last, kept while they fold away
    property <string> held-problem;
    property <string> held-url;
    property <[int]> held-cells;
    property <int> held-size;
    property <[string]> held-addresses;
    property <int> held-address;
    property <string> held-url-problem;
    property <string> held-test;
    property <string> held-test-kind;
    function keep() {
        if (problem != "") { held-problem = problem; }
        if (url-shown) {
            held-url = url-text;
            held-cells = qr-cells;
            held-size = qr-size;
            held-addresses = addresses;
            held-address = address-current;
        }
        if (url-problem != "") { held-url-problem = url-problem; }
        if (test-text != "") {
            held-test = test-text;
            held-test-kind = test-kind;
        }
    }
    init => { keep(); }
    changed problem => { keep(); }
    changed url-shown => { keep(); }
    changed url-text => { keep(); }
    changed qr-cells => { keep(); }
    changed qr-size => { keep(); }
    changed addresses => { keep(); }
    changed address-current => { keep(); }
    changed url-problem => { keep(); }
    changed test-text => { keep(); }
    changed test-kind => { keep(); }

    Card {
        title: @tr("On Air sign");
        tip: @tr("Shows the people around you that your camera or microphone is in use.");
        icon: Icons.bell;
        hue: Theme.plugin-hue("on_screen");
        RailRow {
            icon: Icons.bell;
            label: @tr("Now");
            named: true;
            hue: Theme.plugin-hue("on_screen");
            Status { text: state-text; kind: SignKind.of(state-kind); horizontal: "end"; }
        }
        RailRow {
            icon: Icons.bolt;
            label: @tr("On air when");
            named: true;
            hue: Theme.plugin-hue("on_screen");
            ChoiceField {
                width: Theme.u(130);
                compact: true;
                name: @tr("On air when");
                items: trigger-items;
                current: trigger-current;
                tip: @tr("On air when");
                tip-detail: root.trigger-tip;
                picked(i) => { root.trigger-picked(i); }
            }
        }
    }
    Card {
        title: @tr("Sign on another device");
        keywords: @tr("search" => "tablet phone screen page link qr code");
        icon: Icons.qr;
        hue: Theme.plugin-hue("on_screen");
        has-action: true;
        action-icon: Icons.reset;
        action-tip-detail: new-link-tip;
        action-text: @tr("New link");
        action-enabled: page;
        action => { root.new-link-clicked(); }
        UnfoldGroup {
            SwitchRow {
                icon: Icons.monitor;
                label: @tr("Show the sign on a web page");
                hue: Theme.plugin-hue("on_screen");
                checked: page;
                toggled(v) => { root.page-toggled(v); }
            }
            Unfolding {
                open: problem != "";
                RailRow {
                    has-icon: false;
                    Status { text: @tr("The page didn't start"); detail: held-problem; kind: "err"; horizontal: "end"; }
                }
            }
            Unfolding {
                open: url-shown;
                RailRow {
                    icon: Icons.qr;
                    label: qr-label;
                    named: true;
                    hue: Theme.plugin-hue("on_screen");
                    HorizontalLayout {
                        alignment: end;
                        QrCode { cells: held-cells; size: held-size; cell: 4px; label: qr-label; }
                    }
                }
            }
            Unfolding {
                open: url-shown && address-shown;
                RailRow {
                    icon: Icons.wifi;
                    label: @tr("Address");
                    named: true;
                    hue: Theme.plugin-hue("on_screen");
                    ChoiceField {
                        width: Theme.u(130);
                        compact: true;
                        name: @tr("Address");
                        items: held-addresses;
                        current: held-address;
                        tip: @tr("Address");
                        tip-detail: root.address-tip;
                        picked(i) => { root.address-picked(i); }
                    }
                }
            }
            Unfolding {
                open: url-shown;
                // The sentences about opening the link and the browser's warning are its tooltip
                RailRow {
                    icon: Icons.link;
                    label: @tr("Link");
                    tip-detail: page-note;
                    hue: Theme.plugin-hue("on_screen");
                    HorizontalLayout {
                        spacing: Theme.gap;
                        Text {
                            text: held-url;
                            font-family: Theme.font;
                            font-size: Theme.body;
                            color: Theme.ink;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            min-width: 0px;
                        }
                        Button { text: copy-text; tip: copy-text; tip-detail: copy-tip; clicked => { root.copy-clicked(); } }
                    }
                }
            }
        }
    }
    Card {
        title: @tr("Webhook");
        keywords: @tr("search" => "smart home light home assistant url http request automation");
        icon: Icons.plug;
        hue: Theme.plugin-hue("on_screen");
        UnfoldGroup {
            UrlRow {
                icon: Icons.link;
                hue: Theme.plugin-hue("on_screen");
                label: @tr("Address");
                placeholder: "http://homeassistant.local:8123/api/webhook/…";
                text <=> root.webhook-url;
                edited(t) => { root.url-edited(t); }
            }
            Unfolding {
                open: url-problem != "";
                RailRow {
                    has-icon: false;
                    Status { text: held-url-problem; kind: "err"; horizontal: "end"; }
                }
            }
        }
        RailRow {
            icon: Icons.send-phone;
            label: @tr("Method");
            named: true;
            hue: Theme.plugin-hue("on_screen");
            Segmented {
                width: Theme.u(60);
                items: ["POST", "GET"];
                tips: ["POST", "GET"];
                tip-details: [@tr("POST sends the text as the request body and GET adds it to the address."), @tr("POST sends the text as the request body and GET adds it to the address.")];
                label: @tr("Method");
                current: method-current;
                picked(i) => { root.method-picked(i); }
            }
        }
        UrlRow {
            icon: Icons.eye;
            hue: Theme.plugin-hue("on_screen");
            label: @tr("Going on air");
            placeholder: on-placeholder;
            tip: @tr("Going on air");
            tip-detail: payload-tip;
            text <=> root.webhook-on;
            edited(t) => { root.on-edited(t); }
        }
        UrlRow {
            icon: Icons.eye-off;
            hue: Theme.plugin-hue("on_screen");
            label: @tr("Going off air");
            placeholder: off-placeholder;
            tip: @tr("Going off air");
            tip-detail: payload-tip;
            text <=> root.webhook-off;
            edited(t) => { root.off-edited(t); }
        }
        UnfoldGroup {
            RailRow {
                icon: Icons.play;
                label: @tr("Send a test");
                named: true;
                hue: Theme.plugin-hue("on_screen");
                HorizontalLayout {
                    spacing: Theme.gap;
                    alignment: end;
                    Button { text: @tr("On air"); clicked => { root.test-clicked(true); } }
                    Button { text: @tr("Off air"); clicked => { root.test-clicked(false); } }
                }
            }
            Unfolding {
                open: test-text != "";
                RailRow {
                    has-icon: false;
                    Status { text: held-test; kind: SignKind.of(held-test-kind); horizontal: "end"; }
                }
            }
        }
    }
}
