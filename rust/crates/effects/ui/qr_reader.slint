// The QR codes card. Joined after parts.slint, which has the imports.

export component QrReaderCard inherits Card {
    in property <bool> active: true;
    idle: !active;
    // Greyed out until a phone is paired
    in property <bool> on;
    in property <bool> notify: true;
    in property <string> switch-name;
    in property <string> switch-help;
    in property <string> notify-name;
    in property <string> copy-text;
    in property <string> copy-tip;
    in property <bool> copy-shown;
    in property <string> status;
    in property <string> status-kind: "status_dim";
    // What the status said last, kept while its row shuts
    property <string> held-status;
    property <string> held-kind;
    function keep() {
        if (status != "") {
            held-status = status;
            held-kind = status-kind;
        }
    }
    init => { keep(); }
    changed status => { keep(); }
    changed status-kind => { keep(); }
    callback switch-toggled-by-hand(bool);
    callback notify-toggled(bool);
    callback copy-clicked;

    title: @tr("QR codes");
    tip: @tr("Copy QR codes held up to the camera to the clipboard.");
    icon: Icons.qr;
    enabled: active;
    has-switch: true;
    switch-shortcut: "qr_reader.on";
    switch-enabled: active;
    switch-checked: on;
    switch-label: switch-name;
    switch-tip: switch-name;
    switch-tip-detail: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }

    // The status and Copy come and go above the switch: the row under them keeps clear of the gap while they are shut
    UnfoldGroup {
        found := Unfolding {
            open: status != "" || copy-shown;
            lead: 0px;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.u(4);
                    StatusLine { text: found.open ? status : held-status; kind: found.open ? status-kind : held-kind; }
                    if copy-shown: Button { text: copy-text; tip: copy-text; tip-detail: copy-tip; clicked => { root.copy-clicked(); } }
                }
            }
        }
        VerticalLayout {
            padding-top: found.value * Theme.gap;
            SwitchRow {
                icon: Icons.bell;
                label: @tr("Notify me when a code is read");
                hue: root.hue;
                enabled: active;
                checked: notify;
                toggled(v) => { root.notify-toggled(v); }
            }
        }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
