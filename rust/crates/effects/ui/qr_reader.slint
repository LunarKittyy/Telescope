// The QR codes card. Joined after parts.slint, which has the imports.

export component QrReaderCard inherits Card {
    // Greyed out until a phone is paired
    in property <bool> active: true;
    in property <bool> on;
    in property <bool> notify: true;
    in property <string> switch-name;
    in property <string> switch-help;
    in property <string> notify-name;
    in property <string> copy-text;
    in property <string> copy-tip;
    in property <bool> copy-shown;
    in property <string> status;
    in property <string> status-kind: "status_dim";
    callback switch-toggled-by-hand(bool);
    callback notify-toggled(bool);
    callback copy-clicked;

    title: @tr("QR codes");
    tip: @tr("Copy QR codes held up to the camera to the clipboard.");
    icon: Icons.qr;
    opacity: active ? 1 : 0.4;
    enabled: active;
    has-switch: true;
    switch-shortcut: "qr_reader.on";
    switch-enabled: active;
    switch-checked: on;
    switch-label: switch-name;
    switch-tip: switch-name;
    switch-tip-detail: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }

    if status != "" || copy-shown: HorizontalLayout {
        spacing: 8px;
        alignment: stretch;
        Note { text: status; kind: status-kind; horizontal-stretch: 1; }
        if copy-shown: VerticalLayout {
            alignment: start;
            Button { text: copy-text; tip: copy-text; tip-detail: copy-tip; clicked => { root.copy-clicked(); } }
        }
    }
    // Switch("Notify me…"): the text on the left, the track at the right end, the whole row toggling it
    HorizontalLayout {
        height: 32px;
        spacing: 12px;
        Text {
            text: @tr("Notify me when a code is read");
            font-family: Theme.font;
            font-size: Theme.body;
            color: active ? Theme.text : Theme.text-disabled;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    notify-switch.checked = !notify-switch.checked;
                    root.notify-toggled(notify-switch.checked);
                }
            }
        }
        notify-switch := Switch {
            hue: root.hue;
            enabled: active;
            y: (parent.height - self.height) / 2;
            checked: notify;
            label: notify-name;
            toggled(v) => { root.notify-toggled(v); }
        }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
