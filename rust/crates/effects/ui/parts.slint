// What both cards of this crate are built from. The plugins join this file and their card into one source (Rust's concat!),
// so it holds the only import line.

import { Theme, Icons, Icon, FocusRing, Button, IconButton, Card, FormRow, Slider, Switch, Segmented, ChoiceField, TextField, TipBody, QrCode } from "@ui-kit/ui-kit.slint";

global Status {
    public pure function color(kind: string) -> color {
        kind == "status_ok" ? Theme.ok : kind == "status_warn" ? Theme.warn : kind == "status_err" ? Theme.err
            : kind == "status_dim" ? Theme.text-dim : Theme.text
    }
}

// wrapped_note: a QLabel#dim, so body size
component Note inherits Text {
    in property <string> kind: "status_dim";
    font-family: Theme.font;
    font-size: Theme.body;
    color: Status.color(kind);
    wrap: word-wrap;
}

// control_row with a slider and its readout, and the tooltip the slider has in Qt
component SliderRow inherits FormRow {
    in property <string> tip;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 0;
    in property <float> step: 1;
    in property <string> readout;
    in property <color> hue: Theme.accent;
    in property <bool> has-default;
    in property <float> default-value;
    // "Double-click to reset", added to the tip of a slider that has a default
    in property <string> hint;
    callback moved(float);
    Rectangle {
        horizontal-stretch: 1;
        Slider {
            width: parent.width;
            height: parent.height;
            hue: root.hue;
            enabled: root.enabled;
            label: root.label;
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            value: root.value;
            readout: root.readout;
            has-default: root.has-default;
            default-value: root.default-value;
            moved(v) => { root.moved(v); }
        }
        if tip != "": Tooltip { TipBody { says: has-default && hint != "" ? root.tip + "\n" + hint : root.tip; } }
    }
}

// The keys the two hand-drawn controls understand, by the names editors.rs knows
global Keys {
    public pure function name(text: string) -> string {
        text == Key.LeftArrow ? "left" : text == Key.RightArrow ? "right" : text == Key.UpArrow ? "up" : text == Key.DownArrow ? "down"
            : text == Key.Home ? "home" : text == Key.Delete ? "delete" : text == Key.Backspace ? "backspace"
            : text == "[" ? "[" : text == "]" ? "]" : ""
    }
}

// ColourWheel: a puck on a ring of hues. Drag anywhere (it doesn't jump to the pointer), arrows move it, Home or a
// double-click puts it back. The pointer is reported in radii of the area the puck moves in.
component Wheel inherits Rectangle {
    in property <float> puck-x;
    in property <float> puck-y;
    in property <color> puck-colour: #808080;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <string> label;
    callback pressed();
    callback dragged(float, float, bool);
    callback released();
    callback reset();
    callback key(string, bool);
    height: 124px;
    horizontal-stretch: 1;
    min-width: 88px;
    property <length> radius: min(self.width, self.height) / 2 - 11px;
    property <length> cx: self.width / 2;
    property <length> cy: self.height / 2;
    property <length> px: cx + puck-x * radius;
    property <length> py: cy - puck-y * radius;
    forward-focus: focus;
    accessible-role: slider;
    accessible-label: label;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (Keys.name(e.text) != "" && Keys.name(e.text) != "[" && Keys.name(e.text) != "]") {
                root.key(Keys.name(e.text), e.modifiers.shift);
                return accept;
            }
            reject
        }
    }
    // The ring of hues, each where a puck pointing at it would push the picture: 72 arcs, since the software renderer
    // doesn't clip a gradient to a border radius
    property <length> ring: radius + 6.5px;
    for c[i] in [#ff4a89, #ff499b, #ff48ad, #ff47be, #ff47cf, #ff48e0, #ff48ee, #ff4af9, #fc4bff, #f44dff, #eb4fff, #de52ff, #d155ff, #c358ff, #b45cff, #a660ff, #9664ff, #8868ff, #786cff, #6972ff, #5a76ff, #4a7cff, #3c80ff, #2e86ff, #218aff, #148fff, #0a93ff, #0498ff, #009cf9, #00a0ee, #00a4e0, #00a8cf, #00acbe, #00aead, #00b19b, #00b389, #00b577, #00b664, #00b752, #00b841, #00b830, #00b71f, #00b611, #00b606, #04b400, #0ab200, #14b000, #21ad00, #2eaa00, #3ca700, #4aa300, #5a9f00, #699b00, #789700, #889200, #968e00, #a68800, #b48400, #c37e00, #d17a00, #de7500, #eb7000, #f46c00, #fc6700, #ff6306, #ff5f11, #ff5b1f, #ff5730, #ff5441, #ff5052, #ff4e64, #ff4c77] : Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: c;
        stroke-width: 5px;
        opacity: enabled ? 1 : 0.3;
        MoveTo {
            x: (cx + ring * sin(i * 5deg - 0.4deg)) / 1px;
            y: (cy - ring * cos(i * 5deg - 0.4deg)) / 1px;
        }
        ArcTo {
            x: (cx + ring * sin(i * 5deg + 5.4deg)) / 1px;
            y: (cy - ring * cos(i * 5deg + 5.4deg)) / 1px;
            radius-x: ring / 1px;
            radius-y: ring / 1px;
            sweep: true;
        }
    }
    Rectangle {
        x: cx - (radius + 4px);
        y: cy - (radius + 4px);
        width: 2 * (radius + 4px);
        height: 2 * (radius + 4px);
        border-radius: self.width / 2;
        background: Theme.surface;
    }
    // The well, lighter towards the middle: rings of solid colour, as the software renderer doesn't clip a gradient either
    for t[i] in [1.0, 0.9, 0.8, 0.7, 0.6, 0.5, 0.4, 0.3, 0.2, 0.1] : Rectangle {
        x: cx - radius * t;
        y: cy - radius * t;
        width: 2 * radius * t;
        height: 2 * radius * t;
        border-radius: radius * t;
        background: Theme.surface-raise.mix(Theme.surface-hover, t - 0.05);
    }
    Rectangle {
        x: cx - radius;
        y: cy - radius;
        width: 2 * radius;
        height: 2 * radius;
        border-radius: radius;
        border-width: 1px;
        border-color: Theme.border-strong;
    }
    Rectangle { x: cx - radius; y: cy - 0.5px; width: 2 * radius; height: 1px; background: Theme.border-strong; }
    Rectangle { x: cx - 0.5px; y: cy - radius; width: 1px; height: 2 * radius; background: Theme.border-strong; }
    for r in [0.33, 0.66]: Rectangle {
        x: cx - radius * r;
        y: cy - radius * r;
        width: 2 * radius * r;
        height: 2 * radius * r;
        border-radius: radius * r;
        border-width: 1px;
        border-color: Theme.border-strong;
    }
    if puck-x != 0 || puck-y != 0: Path {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        commands: "M \{cx / 1px} \{cy / 1px} L \{px / 1px} \{py / 1px}";
        stroke: Theme.text-dim;
        stroke-width: 1.2px;
    }
    Rectangle {
        x: px - 7px;
        y: py - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 2px;
        border-color: enabled ? Theme.text : Theme.text-disabled;
        background: enabled ? puck-colour : Theme.surface-raise;
    }
    FocusRing {
        shown: focus.has-focus;
        x: cx - (radius + 13px);
        y: cy - (radius + 13px);
        width: 2 * (radius + 13px);
        height: 2 * (radius + 13px);
        radius: radius + 13px;
    }
    touch := TouchArea {
        enabled: root.enabled;
        property <length> from-x;
        property <length> from-y;
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                self.from-x = self.mouse-x;
                self.from-y = self.mouse-y;
                focus.focus();
                root.pressed();
            }
            if (e.kind == PointerEventKind.move && self.pressed) {
                root.dragged((self.mouse-x - self.from-x) / radius, (self.mouse-y - self.from-y) / radius, e.modifiers.shift);
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        double-clicked => { root.reset(); }
    }
    if tip != "": Tooltip { TipBody { says: root.tip; } }
}

export struct CurvePoint {
    x: float,
    y: float,
}

// CurveEditor: points on a square joined by the curve the grade applies. The pointer goes out in pixels of this control.
component CurveBox inherits Rectangle {
    in property <bool> hue-curve;
    in property <bool> enabled: true;
    // The curve as an SVG path in a 1000 x 1000 box, y down
    in property <string> line;
    in property <[CurvePoint]> points: [{ x: 0, y: 0 }];
    in property <int> picked: -1;
    in property <color> colour: Theme.text;
    in property <string> tip;
    in property <string> label;
    callback pressed(float, float, float, float, bool);
    callback moved(float, float, float, float);
    callback released();
    callback double-clicked(float, float, float, float);
    callback key(string, bool);
    height: 200px;
    horizontal-stretch: 1;
    property <length> pad: 8px;
    property <length> area-w: self.width - 2 * pad;
    property <length> area-h: self.height - pad - (hue-curve ? 14px : pad);
    property <color> tone: enabled ? colour : Theme.text-disabled;
    forward-focus: focus;
    accessible-role: slider;
    accessible-label: label;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (Keys.name(e.text) != "") {
                root.key(Keys.name(e.text), e.modifiers.shift);
                return accept;
            }
            reject
        }
    }
    Rectangle {
        x: pad - 1px;
        y: pad - 1px;
        width: area-w + 2px;
        height: area-h + 2px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface-sunk;
    }
    if hue-curve: Rectangle {
        x: pad;
        y: pad + area-h + 4px;
        width: area-w;
        height: 6px;
        border-radius: 2px;
        opacity: enabled ? 1 : 0.4;
        background: @linear-gradient(90deg, #d96262 0%, #d99d62 8%, #d9d962 17%, #9dd962 25%, #62d962 33%, #62d99d 42%, #62d9d9 50%, #629dd9 58%, #6262d9 67%, #9d62d9 75%, #d962d9 83%, #d9629d 92%, #d96262 100%);
    }
    for i in [1, 2, 3]: Rectangle { x: pad + area-w * i / 4; y: pad; width: 1px; height: area-h; background: Theme.border; }
    for i in [1, 2, 3]: Rectangle { x: pad; y: pad + area-h * i / 4; width: area-w; height: 1px; background: Theme.border; }
    // The line nothing changes along
    Path {
        x: pad;
        y: pad;
        width: area-w;
        height: area-h;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: hue-curve ? "M 0 50 L 100 50" : "M 0 100 L 100 0";
        stroke: Theme.border-strong;
        stroke-width: 1px;
    }
    Rectangle {
        x: pad - 2px;
        y: pad - 2px;
        width: area-w + 4px;
        height: area-h + 4px;
        clip: true;
        Path {
            x: 2px;
            y: 2px;
            width: area-w;
            height: area-h;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: line;
            stroke: tone;
            stroke-width: 2px;
        }
    }
    for p[i] in points: Rectangle {
        x: pad + p.x * area-w - 5px;
        y: pad + (1 - p.y) * area-h - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        border-width: 1.5px;
        border-color: tone;
        background: i == picked && enabled ? colour : Theme.surface;
    }
    FocusRing { shown: focus.has-focus; radius: 6px; x: 1px; y: 1px; width: root.width - 2px; height: root.height - 2px; }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.crosshair;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && (e.button == PointerEventButton.left || e.button == PointerEventButton.right)) {
                focus.focus();
                root.pressed(self.mouse-x / 1px, self.mouse-y / 1px, root.width / 1px, root.height / 1px, e.button == PointerEventButton.right);
            }
            if (e.kind == PointerEventKind.move && self.pressed) {
                root.moved(self.mouse-x / 1px, self.mouse-y / 1px, root.width / 1px, root.height / 1px);
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        double-clicked => { root.double-clicked(self.mouse-x / 1px, self.mouse-y / 1px, root.width / 1px, root.height / 1px); }
    }
    if tip != "": Tooltip { TipBody { says: root.tip; } }
}
