// What both cards of this crate are built from. The plugins join this file and their card into one source (Rust's concat!),
// so it holds the only import line.

import { Theme, Icons, Icon, FocusRing, KeyFocus, TouchRing, Button, IconButton, Card, FormRow, Slider, Switch, Segmented, ChoiceField, Stepper, SwitchTile, ToggleTile, PictureSegmented, Dial, RailRow, SwitchRow, TextField, NumberField, FlickBar, Tip, TipBody, TipUse, QrCode, DialogFrame, ShortcutEntry, ShortcutMenu, Reveal, ColourField, WindowBox, TipLayer, Pad, ColourWheel, Motion } from "@ui-kit/ui-kit.slint";

global Status {
    public pure function color(kind: string) -> color {
        kind == "status_ok" ? Theme.ok : kind == "status_warn" ? Theme.warn : kind == "status_err" ? Theme.err
            : kind == "status_dim" ? Theme.ink2 : Theme.ink
    }
}

// wrapped_note: a QLabel#dim, so body size
component Note inherits Text {
    in property <string> kind: "status_dim";
    font-family: Theme.font;
    font-size: Theme.body;
    color: Status.color(kind);
    wrap: word-wrap;
}

// One line of status: a short word or phrase in a status colour, and the longer sentence as its tooltip. Stands in for the kit's
// Status until that is in.
component StatusLine inherits Rectangle {
    in property <string> text;
    in property <string> kind: "status_dim";
    in property <string> detail;
    height: Theme.row;
    horizontal-stretch: 1;
    accessible-role: AccessibleRole.text;
    accessible-label: detail != "" ? text + ". " + detail : text;
    shown := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-family: Theme.font;
        font-size: Theme.body;
        font-weight: Theme.w-value;
        color: Status.color(kind);
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
        Tip { says: root.detail != "" || shown.preferred-width > shown.width ? root.text : ""; detail: root.detail; enabled: root.detail != "" || shown.preferred-width > shown.width; inert: true; }
    }
}

// The red mark that says something is wrong with a control (the Microphone's Noise reduction has the same one): the reason is its tooltip
component ProblemMark inherits Rectangle {
    in property <string> says;
    in property <string> detail;
    width: Theme.u(8);
    height: Theme.u(8);
    border-radius: self.height / 2;
    background: Theme.err;
    accessible-role: text;
    accessible-label: detail != "" ? detail : says;
    Text {
        text: "!";
        font-family: Theme.font;
        font-size: Theme.small;
        font-weight: 700;
        color: Theme.on-hue;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    Tip { says: root.says; detail: root.detail; inert: true; }
}

// A file a card takes, as the control that chooses it (the picture behind you, a LUT): a raised slot with the picture's own small copy in it and its file
// name, or an empty slot ("Choose") until there is one. A picture that can't be opened shows the red mark with the reason as its tooltip.
component PictureField inherits Rectangle {
    in property <image> thumb;
    in property <bool> has-picture;
    // Something is chosen (a picture with no thumbnail, a LUT): its name reads in full ink, the empty slot's words dimmer
    in property <bool> set: has-picture;
    // The empty slot's glyph, and the thumbnail's place for something with no picture of its own
    in property <image> empty-icon: Icons.photo;
    // The file's name, or what the empty slot says
    in property <string> name;
    in property <string> problem;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <string> tip-detail;
    in property <color> hue: Theme.accent;
    callback clicked;
    height: Theme.row;
    horizontal-stretch: 1;
    min-width: Theme.u(40);
    border-radius: Theme.r-ctl;
    background: !enabled ? Theme.trough : touch.pressed ? Theme.sel : touch.has-hover ? Theme.hover : Theme.raise;
    animate background { duration: Motion.tone-for(touch.pressed); easing: Motion.tone; }
    accessible-role: button;
    accessible-label: name;
    accessible-description: problem != "" ? problem : tip;
    accessible-action-default => { if (enabled) { clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") { clicked(); return accept; }
            reject
        }
    }
    FocusRing { shown: focus.has-focus; radius: root.border-radius; width: parent.width + 2 * Theme.stroke; height: parent.height + 2 * Theme.stroke; }
    usage := Tip { says: root.tip; detail: root.tip-detail; hover: touch.has-hover; focused: focus.has-focus && KeyFocus.keyboard; inert: !root.enabled; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { usage.press(); } }
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: Theme.u(3);
        spacing: Theme.u(4);
        // The slot: the picture cropped to it, or the empty slot's own glyph
        Rectangle {
            width: Theme.u(20);
            border-radius: Theme.r-handle;
            background: Theme.trough;
            clip: true;
            if has-picture: Image {
                width: parent.width;
                height: parent.height;
                source: thumb;
                image-fit: cover;
                opacity: enabled ? 1 : 0.5;
            }
            if !has-picture: Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Theme.icon-small;
                height: Theme.icon-small;
                source: empty-icon;
                tint: set ? hue : Theme.dis;
            }
        }
        Text {
            text: name;
            overflow: elide;
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: Theme.w-value;
            color: !enabled ? Theme.dis : set ? Theme.ink : Theme.ink2;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            accessible-role: none;
        }
        if problem != "": Rectangle {
            width: Theme.u(8);
            ProblemMark { y: (parent.height - self.height) / 2; says: @tr("Can't open this picture"); detail: problem; }
        }
        Rectangle { width: Theme.u(1); }
    }
}

// control_row with a slider and its readout, and the tooltip the slider has in Qt
// FormRow with the label column a window sets for itself
component LabelRow inherits HorizontalLayout {
    in property <string> label;
    in property <bool> enabled: true;
    in property <length> label-width: Theme.u(48);
    spacing: Theme.u(4);
    min-height: Theme.row;
    Text {
        text: label;
        width: label-width;
        font-family: Theme.font;
        font-size: Theme.body;
        font-weight: Theme.w-label;
        // QLabel#form_label outranks QLabel:disabled in the theme
        color: Theme.ink;
        vertical-alignment: center;
    }
    @children
}

component SliderRow inherits LabelRow {
    in property <string> tip;
    // The tooltip's body under the title (tip, or the label when tip is empty) and its hint line; either one switches the tip to title, body and hint
    in property <string> tip-detail;
    in property <string> tip-hint;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 0;
    in property <float> step: 1;
    in property <string> readout;
    in property <color> hue: Theme.accent;
    in property <bool> has-default;
    in property <float> default-value;
    // Values a dragged handle sticks to (NoScrollSlider.set_snaps)
    in property <[float]> marks;
    // The kit slider's fills: "plain" or "gradient" along grad-a, grad-b, grad-c
    in property <string> fill: "plain";
    in property <color> grad-a: Theme.ink2;
    in property <color> grad-b: Theme.ink2;
    in property <color> grad-c: Theme.ink2;
    // "Double-click to reset", added to the tip of a slider that has a default
    in property <string> hint;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    // The id of the setting it is, for the outline when something outside the window reads or changes it
    in property <string> setting;
    // A bubble while it is touched (the slider's peek), and a picture for it
    in property <string> peek;
    in property <image> peek-picture;
    callback moved(float);
    callback peek-changed(bool);
    Rectangle {
        horizontal-stretch: 1;
        Slider {
            peek: root.peek;
            peek-picture: root.peek-picture;
            peek-changed(o) => { root.peek-changed(o); }
            setting: root.setting;
            tip: root.tip-detail != "" || root.tip-hint != "" ? (root.tip != "" ? root.tip : root.label) : root.tip != "" && has-default && hint != "" ? root.tip + "\n" + hint : root.tip;
            tip-detail: root.tip-detail;
            tip-hint: root.has-default ? root.tip-hint : "";
            shortcut: root.shortcut;
            width: parent.width;
            height: parent.height;
            hue: root.hue;
            enabled: root.enabled;
            label: root.label;
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            value: root.value;
            readout: root.readout;
            has-default: root.has-default;
            default-value: root.default-value;
            marks: root.marks;
            fill: root.fill;
            grad-a: root.grad-a;
            grad-b: root.grad-b;
            grad-c: root.grad-c;
            moved(v) => { root.moved(v); }
        }
    }
}

// A slider on the card's icon rail: the icon is the label, its word the tooltip. The row marks itself changed when the value is off its default.
component RailSlider inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> tip;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 0;
    in property <float> step: 1;
    in property <string> readout;
    in property <length> readout-width: Theme.u(28);
    in property <color> hue: Theme.accent;
    in property <bool> enabled: true;
    in property <bool> has-default;
    in property <float> default-value;
    in property <[float]> marks;
    in property <string> fill: "plain";
    in property <color> grad-a: Theme.ink2;
    in property <color> grad-b: Theme.ink2;
    in property <color> grad-c: Theme.ink2;
    // "Double-click to reset", added to the tip of a slider that has a default
    in property <string> hint;
    // The tooltip's body under the title (tip, or the label when tip is empty) and its hint line; either one switches the tip to title, body and hint
    in property <string> tip-detail;
    in property <string> tip-hint;
    in property <string> shortcut;
    in property <string> setting;
    in property <string> peek;
    in property <image> peek-picture;
    callback moved(float);
    callback peek-changed(bool);
    height: Theme.row;
    horizontal-stretch: 1;
    RailRow {
        width: parent.width;
        height: parent.height;
        icon: root.icon;
        label: root.label;
        tip: root.tip-detail != "" || root.tip-hint != "" ? root.tip : "";
        tip-detail: root.tip-detail;
        hue: root.hue;
        enabled: root.enabled;
        changed: root.has-default && abs(root.value - root.default-value) > root.step / 2;
        Rectangle {
            horizontal-stretch: 1;
            Slider {
                peek: root.peek;
                peek-picture: root.peek-picture;
                peek-changed(o) => { root.peek-changed(o); }
                setting: root.setting;
                tip: root.tip-detail != "" || root.tip-hint != "" ? (root.tip != "" ? root.tip : root.label) : root.tip != "" && root.has-default && root.hint != "" ? root.tip + "\n" + root.hint : root.tip;
                tip-detail: root.tip-detail;
                tip-hint: root.has-default ? root.tip-hint : "";
                shortcut: root.shortcut;
                width: parent.width;
                height: parent.height;
                hue: root.hue;
                enabled: root.enabled;
                label: root.label;
                minimum: root.minimum;
                maximum: root.maximum;
                step: root.step;
                value: root.value;
                readout: root.readout;
                readout-width: root.readout-width;
                has-default: root.has-default;
                default-value: root.default-value;
                marks: root.marks;
                fill: root.fill;
                grad-a: root.grad-a;
                grad-b: root.grad-b;
                grad-c: root.grad-c;
                moved(v) => { root.moved(v); }
            }
        }
    }
}

// The keys the two hand-drawn controls understand, by the names editors.rs knows
global Keys {
    public pure function name(text: string) -> string {
        text == Key.LeftArrow ? "left" : text == Key.RightArrow ? "right" : text == Key.UpArrow ? "up" : text == Key.DownArrow ? "down"
            : text == Key.Home ? "home" : text == Key.Delete ? "delete" : text == Key.Backspace ? "backspace"
            : text == "[" ? "[" : text == "]" ? "]" : ""
    }
}

// What the hand-drawn controls say to a screen reader, in plain words instead of coordinates
global Spoken {
    // The hue the puck points at, from the ring's top clockwise in 30 degree steps (the wedges' colours)
    public pure function hue-name(x: float, y: float) -> string {
        [@tr("pink"), @tr("magenta"), @tr("purple"), @tr("blue"), @tr("sky blue"), @tr("cyan"), @tr("spring green"), @tr("green"), @tr("lime"), @tr("yellow"), @tr("orange"), @tr("red")][Math.floor(Math.mod(Math.atan2(x, y) / 1deg + 375, 360) / 30)]
    }
    public pure function percent(v: float) -> int {
        Math.round(v * 100)
    }
    public pure function wheel(x: float, y: float) -> string {
        Spoken.percent(Math.sqrt(x * x + y * y)) == 0 ? @tr("neutral") : @tr("towards") + " " + Spoken.hue-name(x, y) + ", " + Spoken.percent(Math.sqrt(x * x + y * y)) + "%"
    }
    public pure function curve(count: int, picked: int, x: float, y: float) -> string {
        picked < 0 ? count + " " + @tr("points, none picked") : @tr("point") + " " + (picked + 1) + "/" + count + ", " + @tr("in") + " " + Spoken.percent(x) + "%, " + @tr("out") + " " + Spoken.percent(y) + "%"
    }
    public pure function side(n: int, negative: string, positive: string) -> string {
        n < 0 ? -n + "% " + negative : n + "% " + positive
    }
    // pan-x and pan-y run from -1 to 1, right and down positive
    public pure function pan(x: float, y: float) -> string {
        Spoken.percent(x) == 0 && Spoken.percent(y) == 0 ? @tr("centred")
            : Spoken.percent(y) == 0 ? Spoken.side(Spoken.percent(x), @tr("left"), @tr("right"))
            : Spoken.percent(x) == 0 ? Spoken.side(Spoken.percent(y), @tr("up"), @tr("down"))
            : Spoken.side(Spoken.percent(x), @tr("left"), @tr("right")) + ", " + Spoken.side(Spoken.percent(y), @tr("up"), @tr("down"))
    }
}

export struct CurvePoint {
    x: float,
    y: float,
}

// CurveEditor: points on a square joined by the curve the grade applies. The pointer goes out in pixels of this control.
component CurveBox inherits Rectangle {
    in property <bool> hue-curve;
    in property <bool> enabled: true;
    // The curve as an SVG path in a 1000 x 1000 box, y down
    in property <string> line;
    in property <[CurvePoint]> points: [{ x: 0, y: 0 }];
    in property <int> picked: -1;
    in property <color> colour: Theme.ink;
    in property <string> label;
    callback pressed(float, float, float, float, bool);
    callback moved(float, float, float, float);
    callback released();
    callback double-clicked(float, float, float, float);
    callback key(string, bool);
    height: 200px;
    horizontal-stretch: 1;
    property <length> pad: 8px;
    property <length> area-w: self.width - 2 * pad;
    property <length> area-h: self.height - pad - (hue-curve ? 14px : pad);
    property <color> tone: enabled ? colour : Theme.dis;
    forward-focus: focus;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: Spoken.curve(points.length, picked, picked >= 0 && picked < points.length ? points[picked].x : 0, picked >= 0 && picked < points.length ? points[picked].y : 0);
    accessible-description: @tr("Arrow keys move the picked point, Shift with an arrow moves it further. Left and right square brackets pick another point. Delete removes the point and Home resets the curve.");
    focus := FocusScope {
        focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
        enabled: root.enabled;
        key-pressed(e) => {
            if (Keys.name(e.text) != "") {
                root.key(Keys.name(e.text), e.modifiers.shift);
                return accept;
            }
            reject
        }
    }
    Rectangle {
        x: pad - 1px;
        y: pad - 1px;
        width: area-w + 2px;
        height: area-h + 2px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.stage;
    }
    if hue-curve: Rectangle {
        x: pad;
        y: pad + area-h + 4px;
        width: area-w;
        height: 6px;
        border-radius: 2px;
        opacity: enabled ? 1 : 0.4;
        background: @linear-gradient(90deg, #d96262 0%, #d99d62 8%, #d9d962 17%, #9dd962 25%, #62d962 33%, #62d99d 42%, #62d9d9 50%, #629dd9 58%, #6262d9 67%, #9d62d9 75%, #d962d9 83%, #d9629d 92%, #d96262 100%);
    }
    for i in [1, 2, 3]: Rectangle { x: pad + area-w * i / 4; y: pad; width: 1px; height: area-h; background: Theme.line; }
    for i in [1, 2, 3]: Rectangle { x: pad; y: pad + area-h * i / 4; width: area-w; height: 1px; background: Theme.line; }
    // The line nothing changes along
    // fill: a path keeps its viewbox's shape by default, and this box isn't square. A stroke sits half out of a path's box
    Path {
        x: pad - 0.5px;
        y: pad - 0.5px;
        width: area-w + 1px;
        height: area-h + 1px;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: ImageFit.fill;
        commands: hue-curve ? "M 0 50 L 100 50" : "M 0 100 L 100 0";
        stroke: Theme.line-strong;
        stroke-width: 1px;
    }
    Rectangle {
        x: pad - 2px;
        y: pad - 2px;
        width: area-w + 4px;
        height: area-h + 4px;
        clip: true;
        Path {
            x: 1px;
            y: 1px;
            width: area-w + 2px;
            height: area-h + 2px;
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: ImageFit.fill;
            commands: line;
            stroke: tone;
            stroke-width: 2px;
        }
    }
    for p[i] in points: Rectangle {
        x: pad + p.x * area-w - 5px;
        y: pad + (1 - p.y) * area-h - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        border-width: 1.5px;
        border-color: tone;
        background: i == picked && enabled ? colour : Theme.card;
    }
    FocusRing { shown: focus.has-focus; radius: 6px; x: 1px; y: 1px; width: root.width - 2px; height: root.height - 2px; }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.crosshair;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && (e.button == PointerEventButton.left || e.button == PointerEventButton.right)) {
                focus.focus();
                root.pressed(self.mouse-x / 1px, self.mouse-y / 1px, root.width / 1px, root.height / 1px, e.button == PointerEventButton.right);
            }
            if (e.kind == PointerEventKind.move && self.pressed) {
                root.moved(self.mouse-x / 1px, self.mouse-y / 1px, root.width / 1px, root.height / 1px);
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        double-clicked => { root.double-clicked(self.mouse-x / 1px, self.mouse-y / 1px, root.width / 1px, root.height / 1px); }
    }
}
