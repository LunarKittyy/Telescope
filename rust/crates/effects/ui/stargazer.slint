// The Stargazer card. Joined after parts.slint, which has the imports.

export component StargazerCard inherits Card {
    in property <bool> use-zoom;
    callback use-zoom-toggled(bool);
    in property <bool> active: true;
    idle: !active;
    in property <int> mode-index;
    in property <[string]> mode-items;
    // Where the frames come from: 0 the video, 1 photos
    in property <int> input-index;
    in property <[string]> input-items;
    in property <int> photo-count: 10;
    in property <string> photo-count-text;
    in property <int> photo-every;
    in property <string> photo-every-text;
    in property <bool> running;
    in property <int> frames: 300;
    in property <string> frames-text;
    in property <int> keep: 10;
    in property <string> keep-text;
    in property <int> trail: 5;
    in property <string> trail-text;
    in property <string> run-text;
    in property <bool> run-enabled;
    in property <string> save-text;
    in property <bool> save-enabled;
    in property <string> reset-text;
    in property <bool> reset-enabled;
    in property <bool> settings-reset-shown;
    in property <string> status;
    in property <string> status-kind: "status_dim";
    in property <string> tally;
    in property <string> limit;
    in property <string> focus-text;
    in property <string> camera-name;
    in property <bool> camera;
    in property <string> saved;
    in property <string> open-text;
    in property <string> open-tip;
    in property <bool> open-enabled;
    in property <bool> customize-open;
    in property <string> shot-summary;
    in property <[string]> shutter-stops;
    in property <int> shutter-index;
    in property <bool> shutter-enabled;
    in property <string> shutter-tip;
    in property <[string]> iso-stops;
    in property <int> iso-index;
    in property <int> iso-per: 3;
    in property <int> iso-from: 1;
    in property <bool> iso-enabled;
    in property <string> iso-tip;
    in property <bool> focus-enabled;
    in property <string> focus-tip;
    in property <float> focus-value;
    in property <bool> focus-unset;
    in property <string> focus-readout;
    in property <[float]> focus-marks;
    callback customize-toggled(bool);
    callback shutter-picked(int);
    callback iso-picked(int);
    callback focus-moved(float);
    callback focus-reset();
    callback mode-picked(int);
    callback input-picked(int);
    callback photo-count-moved(float);
    callback photo-every-moved(float);
    callback frames-moved(float);
    callback keep-moved(float);
    callback trail-moved(float);
    callback run-clicked;
    callback save-clicked;
    callback reset-clicked;
    callback settings-reset-clicked;
    callback camera-toggled(bool);
    callback open-clicked;

    title: @tr("Stargazer");
    tip: @tr("Stack frames from a telescope into a sharper moon or planet, a faint sky or star trails.");
    header-status: status;
    header-status-kind: status-kind == "status_ok" ? "ok" : status-kind == "status_warn" ? "warn" : status-kind == "status_err" ? "err" : "";
    header-status-detail: status;
    icon: Icons.star;
    enabled: active;
    has-reset: true;
    reset-lit: settings-reset-shown;
    reset-label: @tr("Reset settings");
    reset-detail: @tr("Set the frames, sharpest share, time between frames and photo settings back to default. The mode, where the frames come from and the camera switch aren't reset.");
    reset => { root.settings-reset-clicked(); }

    UnfoldGroup {
        Unfolding {
            open: tally != "";
            RailRow {
                has-icon: false;
                StatusLine { text: tally; detail: tally; }
            }
        }
        StatusUnfold { text: limit; kind: "status_warn"; detail: limit; }
    }
    RailRow {
        icon: Icons.focus;
        label: @tr("Focus");
        hue: root.hue;
        enabled: active;
        StatusLine { text: focus-text; detail: @tr("How sharp the picture is now and the best so far. Turn the focuser to the highest number."); }
    }
    UnfoldGroup {
        RailRow {
            icon: Icons.layers;
            label: @tr("Stack");
            hue: root.hue;
            enabled: active;
            Segmented {
                hue: root.hue;
                label: @tr("Stack");
                items: mode-items;
                tips: [@tr("Lucky imaging"), @tr("Live stack"), @tr("Star trails")];
                tip-details: [
                    @tr("Stacks only the sharpest frames of a burst. For the moon and planets. It needs the video."),
                    @tr("Adds every frame and leaves out what only shows once, like satellites and noise. For faint things."),
                    @tr("Takes the brightest value of one frame every few seconds, which draws the stars as lines."),
                ];
                disabled: [!active || running, !active || running, !active || running];
                current: mode-index;
                picked(i) => { root.mode-picked(i); }
            }
        }
        Unfolding {
            open: true;
            RailRow {
                icon: Icons.video;
                label: @tr("Frames from");
                hue: root.hue;
                enabled: active;
                Segmented {
                    hue: root.hue;
                    label: @tr("Frames from");
                    items: input-items;
                    tips: [@tr("Frames from the video"), mode-index == 0 ? @tr("Lucky imaging needs the video") : @tr("Frames from photos")];
                    tip-details: [
                        @tr("Stack the frames of the video stream."),
                        mode-index == 0
                            ? @tr("Lucky imaging looks at hundreds of frames, which photos are too slow to give. Pick Live or Trails to use photos.")
                            : @tr("Stack photos the camera takes one after the other, with a shutter speed and ISO of your own. For faint things the video can't show."),
                    ];
                    disabled: [!active || running, !active || running || mode-index == 0];
                    current: input-index;
                    picked(i) => { root.input-picked(i); }
                }
            }
        }
        // Cleaner frames, which only the video has, goes here
        Unfolding {
            open: mode-index == 0;
            RailSlider {
                icon: Icons.film;
                enabled: active && !running;
                label: @tr("Frames");
                tip: @tr("Frames to collect");
                tip-detail: @tr("How many frames to look at before stacking the sharpest ones.");
                minimum: 50;
                maximum: 2000;
                value: frames;
                readout: frames-text;
                readout-width: Theme.u(40);
                hue: root.hue;
                has-default: true;
                default-value: 300;
                moved(v) => { root.frames-moved(v); }
            }
            RailSlider {
                icon: Icons.sparkle;
                enabled: active && !running;
                label: @tr("Sharpest");
                tip: @tr("Share of frames to stack");
                tip-detail: @tr("The sharpest share of the frames that gets stacked.");
                minimum: 1;
                maximum: 100;
                value: keep;
                readout: keep-text;
                hue: root.hue;
                has-default: true;
                default-value: 10;
                moved(v) => { root.keep-moved(v); }
            }
        }
        Unfolding {
            open: mode-index == 2 && input-index == 0;
            RailSlider {
                icon: Icons.timer;
                enabled: active && !running;
                label: @tr("Every");
                tip: @tr("Time between frames");
                tip-detail: @tr("How long to wait before the next frame goes into the trails.");
                minimum: 1;
                maximum: 60;
                value: trail;
                readout: trail-text;
                hue: root.hue;
                has-default: true;
                default-value: 5;
                moved(v) => { root.trail-moved(v); }
            }
        }
    }
    Unfolding {
        open: input-index == 1;
        RailSlider {
            icon: Icons.photo;
            enabled: active && !running;
            label: @tr("Photos");
            tip: @tr("Photos to take");
            tip-detail: @tr("How many photos to take before the run ends.");
            minimum: 1;
            maximum: 200;
            value: photo-count;
            readout: photo-count-text;
            readout-width: Theme.u(40);
            hue: root.hue;
            has-default: true;
            default-value: 10;
            moved(v) => { root.photo-count-moved(v); }
        }
        RailSlider {
            icon: Icons.timer;
            enabled: active && !running;
            label: @tr("Every");
            tip: @tr("Time between photos");
            tip-detail: @tr("At least this long from the start of one photo to the start of the next. A photo that takes longer is followed straight away, never by extra ones to catch up.");
            minimum: 0;
            maximum: 300;
            value: photo-every;
            readout: photo-every-text;
            readout-width: Theme.u(40);
            hue: root.hue;
            has-default: true;
            default-value: 0;
            moved(v) => { root.photo-every-moved(v); }
        }
        UnfoldGroup {
            RailRow {
                icon: Icons.camera;
                label: @tr("Customise camera");
                hue: root.hue;
                enabled: active;
                Rectangle {
                    horizontal-stretch: 1;
                    preferred-width: 1000px;
                    height: Theme.row;
                    Button {
                        width: parent.width;
                        height: parent.height;
                        shrinks: true;
                        enabled: active && !running;
                        tip: @tr("Customise camera");
                        tip-detail: root.shot-summary;
                        accessible-label: @tr("Customise camera");
                        accessible-value: root.shot-summary;
                        accessible-expandable: true;
                        accessible-expanded: root.customize-open;
                        clicked => { root.customize-toggled(!root.customize-open); }
                    }
                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: Theme.u(6);
                        padding-right: Theme.u(6);
                        spacing: Theme.gap;
                        if root.width >= Theme.u(200): Text {
                            text: @tr("Customise camera");
                            font-family: Theme.font;
                            font-size: Theme.body;
                            font-weight: Theme.w-label;
                            color: active && !running ? Theme.ink : Theme.dis;
                            vertical-alignment: center;
                            overflow: elide;
                            min-width: 0px;
                            horizontal-stretch: 1;
                            accessible-role: none;
                        }
                        Text {
                            text: root.shot-summary;
                            font-family: Theme.font;
                            font-size: Theme.body;
                            font-weight: Theme.w-value;
                            color: active && !running ? Theme.ink : Theme.dis;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                            min-width: 0px;
                            horizontal-stretch: 1;
                            accessible-role: none;
                        }
                        Rectangle {
                            width: Theme.u(8);
                            Path {
                                width: Theme.u(8);
                                height: Theme.u(8);
                                y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
                                viewbox-x: Theme.stroke / 2 / 1px;
                                viewbox-y: Theme.stroke / 2 / 1px;
                                viewbox-width: 16 - Theme.stroke / 1px;
                                viewbox-height: 16 - Theme.stroke / 1px;
                                commands: root.customize-open ? "M 4.5 9.5 L 8 6 L 11.5 9.5" : "M 4.5 6.5 L 8 10 L 11.5 6.5";
                                stroke: active && !running ? Theme.ink : Theme.dis;
                                stroke-width: Theme.stroke;
                            }
                        }
                    }
                }
            }
            Unfolding {
                open: root.customize-open;
                ShotControls {
                    hue: root.hue;
                    enabled: active && !running;
                    shutter-stops: root.shutter-stops;
                    shutter-index: root.shutter-index;
                    shutter-enabled: root.shutter-enabled;
                    shutter-tip: root.shutter-tip;
                    iso-stops: root.iso-stops;
                    iso-index: root.iso-index;
                    iso-per: root.iso-per;
                    iso-from: root.iso-from;
                    iso-enabled: root.iso-enabled;
                    iso-tip: root.iso-tip;
                    focus-enabled: root.focus-enabled;
                    focus-tip: root.focus-tip;
                    focus-value: root.focus-value;
                    focus-unset: root.focus-unset;
                    focus-readout: root.focus-readout;
                    focus-marks: root.focus-marks;
                    shutter-picked(i) => { root.shutter-picked(i); }
                    iso-picked(i) => { root.iso-picked(i); }
                    focus-moved(v) => { root.focus-moved(v); }
                    focus-reset => { root.focus-reset(); }
                }
            }
        }
    }
    Unfolding {
        open: input-index == 1;
        SwitchRow {
            icon: Icons.zoom;
            label: @tr("Use zoom");
            tip: @tr("Use zoom");
            tip-detail: @tr("Crop the photo to the zoom and position set in Transforms.");
            hue: root.hue;
            enabled: active && !running;
            changed: use-zoom;
            checked: use-zoom;
            toggled(v) => { root.use-zoom-toggled(v); }
        }
    }
    RailRow {
        icon: Icons.play;
        label: @tr("Run");
        hue: root.hue;
        enabled: active;
        HorizontalLayout {
            spacing: Theme.gap;
            Button { horizontal-stretch: 1; preferred-width: 1000px; text: run-text; reserve: [@tr("Start"), @tr("Stop"), @tr("Stacking")]; role: "primary"; hue: root.hue; muted: true; on: running; enabled: active && run-enabled; clicked => { root.run-clicked(); } }
            if mode-index == 1 || save-enabled: Button { horizontal-stretch: 1; preferred-width: 1000px; text: save-text; enabled: active && save-enabled; clicked => { root.save-clicked(); } }
            if mode-index == 1: Button { horizontal-stretch: 1; preferred-width: 1000px; text: reset-text; enabled: active && reset-enabled; clicked => { root.reset-clicked(); } }
        }
    }
    SwitchRow {
        icon: Icons.camera;
        label: camera-name;
        tip: camera-name;
        tip-detail: @tr("Sends the stack to the virtual camera in place of the live picture, refreshed about once a second.");
        hue: root.hue;
        enabled: active;
        changed: camera;
        checked: camera;
        toggled(v) => { root.camera-toggled(v); }
    }
    RailRow {
        icon: Icons.folder;
        label: @tr("Saved");
        hue: root.hue;
        enabled: active;
        HorizontalLayout {
            spacing: Theme.u(4);
            StatusLine { text: saved; detail: saved; }
            Button { text: open-text; tip: open-text; tip-detail: open-tip; enabled: active && open-enabled; clicked => { root.open-clicked(); } }
        }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
