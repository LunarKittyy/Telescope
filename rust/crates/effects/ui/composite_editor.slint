// The One picture editor's window. Joined after parts.slint, which has the imports.

export struct TileBox {
    x: float,
    y: float,
    w: float,
    h: float,
    missing: bool,
    name: string,
    gone: string,
    hover: bool,
}

export struct Grip {
    x: float,
    y: float,
    corner: bool,
    wide: bool,
    hot: bool,
}

export struct StreamRow {
    text: string,
    // Streaming or not, as words for the icon's tip and the screen reader
    status: string,
    streaming: bool,
    dim: bool,
    // The stream is in the picture (the eye is open)
    on: bool,
    // It has a tile in the layout: it can be picked, locked and dragged to another layer
    layer: bool,
    locked: bool,
    picked: bool,
}

// _paint_chip: a small dark pill with text, for the drag's mode and the picked stream's name
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> accent;
    width: label.preferred-width + Theme.u(9);
    height: label.preferred-height + Theme.u(3);
    border-radius: self.height / 2;
    background: Theme.stage.with-alpha(0.82);
    border-width: accent ? 1px : 0px;
    border-color: Theme.plugin-hue("streaming");
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-family: Theme.font;
        font-size: Theme.body;
        color: accent ? Theme.accent-soft : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A 1 px line in Qt's DashLine: 4 px on, 2 off
component Dashes {
    in property <color> colour;
    in property <bool> across;
    property <length> long: across ? root.width : root.height;
    for i in ceil(long / Theme.u(3)): Rectangle {
        x: across ? i * Theme.u(3) : 0;
        y: across ? 0 : i * Theme.u(3);
        width: across ? min(Theme.u(2), long - i * Theme.u(3)) : 1px;
        height: across ? 1px : min(Theme.u(2), long - i * Theme.u(3));
        background: colour;
    }
}

// PictureView: the live preview on a dark stage, with the tiles' outlines on top to grab.
component PictureView inherits Rectangle {
    in property <image> picture;
    in property <float> aspect: 16 / 9;
    in property <[TileBox]> tiles;
    in property <int> selected: -1;
    in property <TileBox> selected-tile;
    in property <[Grip]> grips;
    in property <[float]> guide-xs;
    in property <[float]> guide-ys;
    in property <string> mode;
    in property <string> cursor;
    callback pointer(string, length, length, length, length, bool, bool, bool, bool);
    callback wheel(length, length, length, length, float);
    callback key(string, bool);
    property <length> pad: Theme.u(7);
    property <length> room-w: root.width - 2 * pad;
    property <length> room-h: root.height - 2 * pad;
    out property <length> area-w: round(min(room-w, room-h * aspect) / 1px) * 1px;
    out property <length> area-h: round(area-w / aspect / 1px) * 1px;
    property <length> area-x: round((root.width - area-w) / 2 / 1px) * 1px;
    property <length> area-y: round((root.height - area-h) / 2 / 1px) * 1px;
    min-width: Theme.u(260);
    min-height: Theme.u(160);
    border-radius: Theme.r-card;
    background: Theme.stage;
    accessible-role: slider;
    accessible-label: @tr("Picture preview");
    accessible-value: selected < 0 ? @tr("no picture picked") : @tr("picked") + " " + selected-tile.name + ", " + Spoken.percent(selected-tile.x) + "% " + @tr("from the left") + ", " + Spoken.percent(selected-tile.y) + "% " + @tr("from the top");
    accessible-description: @tr("Arrow keys move the picked picture a little, Shift with an arrow moves it further.");
    Rectangle {
        x: area-x;
        y: area-y;
        width: area-w;
        height: area-h;
        clip: true;
        Image { width: parent.width; height: parent.height; source: picture; image-fit: fill; }
        for t in tiles: Rectangle {
            x: t.x * parent.width;
            y: t.y * parent.height;
            width: t.w * parent.width;
            height: t.h * parent.height;
            background: t.missing ? Theme.raise.with-alpha(0.75) : transparent;
            border-width: !t.missing && t.hover ? Theme.u(0.75) : 0px;
            border-color: Theme.plugin-hue("streaming").with-alpha(0.55);
            if t.missing: Dashes { x: 0; y: 0; width: parent.width; height: 1px; across: true; colour: Theme.faint; }
            if t.missing: Dashes { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; across: true; colour: Theme.faint; }
            if t.missing: Dashes { x: 0; y: 0; width: 1px; height: parent.height; colour: Theme.faint; }
            if t.missing: Dashes { x: parent.width - 1px; y: 0; width: 1px; height: parent.height; colour: Theme.faint; }
            if t.missing: Text {
                width: parent.width - Theme.u(6);
                text: t.gone;
                wrap: word-wrap;
                font-family: Theme.font;
                font-size: Theme.body;
                color: Theme.ink2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        for x in guide-xs: Dashes { x: x * parent.width; y: 0; width: 1px; height: parent.height; colour: Theme.accent-soft; }
        for y in guide-ys: Dashes { x: 0; y: y * parent.height; height: 1px; width: parent.width; across: true; colour: Theme.accent-soft; }
    }
    Rectangle {
        x: area-x - 1px;
        y: area-y - 1px;
        width: area-w + Theme.u(1);
        height: area-h + Theme.u(1);
        border-width: 1px;
        border-color: Theme.line-strong;
    }
    if selected >= 0: Rectangle {
        x: area-x + selected-tile.x * area-w;
        y: area-y + selected-tile.y * area-h;
        width: selected-tile.w * area-w;
        height: selected-tile.h * area-h;
        Rectangle { x: -Theme.u(1); y: -Theme.u(1); width: parent.width + Theme.u(2); height: parent.height + Theme.u(2); border-width: Theme.u(1.75); border-color: Theme.stage.with-alpha(0.7); }
        Rectangle { border-width: Theme.u(0.75); border-color: Theme.plugin-hue("streaming"); }
        if selected-tile.name != "" && parent.height > Theme.u(20): Chip {
            x: Theme.u(3);
            y: Theme.u(3);
            text: selected-tile.name;
        }
    }
    for g in grips: Rectangle {
        property <length> grow: g.hot ? Theme.u(1) : 0px;
        property <length> long: g.corner ? Theme.u(5) + grow : Theme.u(8) + grow;
        property <length> short: g.corner ? Theme.u(5) + grow : Theme.u(3) + grow;
        // Whole units on both sides, so the middle of a handle falls on a pixel line at whole scales
        width: (g.corner || g.wide ? long : short) + Theme.u(1);
        height: (g.corner || g.wide ? (g.corner ? long : short) : long) + Theme.u(1);
        // The selection frame's line is drawn inside its box: its middle is half the line in from the edge
        property <length> line: Theme.u(0.75);
        property <length> on-x: abs(g.x - selected-tile.x) < 0.00001 ? line / 2 : abs(g.x - selected-tile.x - selected-tile.w) < 0.00001 ? -line / 2 : 0px;
        property <length> on-y: abs(g.y - selected-tile.y) < 0.00001 ? line / 2 : abs(g.y - selected-tile.y - selected-tile.h) < 0.00001 ? -line / 2 : 0px;
        x: area-x + g.x * area-w + on-x - self.width / 2;
        y: area-y + g.y * area-h + on-y - self.height / 2;
        border-radius: min(self.width, self.height) / 2;
        border-width: Theme.u(0.75);
        border-color: Theme.stage;
        background: g.hot ? white : Theme.plugin-hue("streaming");
    }
    if mode != "": Chip {
        x: area-x + Theme.u(4);
        y: area-y + Theme.u(4);
        text: mode;
        accent: true;
    }
    keys := FocusScope {
        key-pressed(e) => {
            if (Keys.name(e.text) != "") {
                root.key(Keys.name(e.text), e.modifiers.shift);
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: cursor == "move" ? MouseCursor.move : cursor == "ew" ? MouseCursor.ew-resize : cursor == "ns" ? MouseCursor.ns-resize
            : cursor == "nwse" ? MouseCursor.nwse-resize : cursor == "nesw" ? MouseCursor.nesw-resize : MouseCursor.default;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { keys.focus(); }
            let what = e.kind == PointerEventKind.down ? "down" : e.kind == PointerEventKind.up ? "up" : e.kind == PointerEventKind.move ? "move" : "";
            if (what != "") {
                root.pointer(what, self.mouse-x - area-x, self.mouse-y - area-y, area-w, area-h, e.button == PointerEventButton.right,
                             e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
            }
        }
        changed has-hover => {
            if (!self.has-hover) { root.pointer("leave", 0, 0, area-w, area-h, false, false, false, false); }
        }
        scroll-event(e) => {
            root.wheel(self.mouse-x - area-x, self.mouse-y - area-y, area-w, area-h, e.delta-y / 0.5px); // 60 px a notch here, Qt's 120 there
            accept
        }
    }
}

// A card as the editor's _card has it: not folding, hued like the group
component SideCard inherits Card {
    hue: Theme.plugin-hue("streaming");
}

// _swatch_row: a swatch showing a colour, which opens the sliders under it, and its code
component SwatchRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> code;
    in property <color> colour;
    callback clicked;
    spacing: Theme.u(5);
    Rectangle {
        width: Theme.u(32);
        height: Theme.u(16);
        y: (parent.height - self.height) / 2;
        border-radius: Theme.r-ctl;
        border-width: 1px;
        border-color: touch.has-hover ? Theme.line-hover : Theme.line-strong;
        background: root.colour;
        accessible-role: button;
        accessible-label: label + ": " + code;
        touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
        Tip { says: root.label; hover: touch.has-hover; }
    }
    Text {
        text: code;
        font-family: Theme.font;
        font-size: Theme.body;
        color: Theme.ink2;
        vertical-alignment: center;
    }
}

// A small square toggle in a row of the Streams list: an icon that says its state by its shape and by its fill, and by its accessible state
component LayerToggle inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <string> label;
    in property <string> tip;
    in property <string> tip-detail;
    callback clicked;
    width: Theme.u(14);
    height: Theme.u(14);
    border-radius: Theme.r-ctl;
    background: touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: active;
    accessible-action-default => { root.clicked(); }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        tint: touch.has-hover || root.active ? Theme.ink : Theme.faint;
        width: Theme.icon;
        height: Theme.icon;
        accessible-role: none;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    Tip { says: root.tip; detail: root.tip-detail; hover: touch.has-hover; }
}

// One row of the Streams list. A stream in the layout is held and dragged up and down to another layer (the front one is on top), as in the Card order
// dialog: the held row follows the pointer and the others make room, and let go it glides into its place.
component LayerRow inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <bool> streaming;
    in property <bool> on;
    in property <bool> dim;
    in property <bool> layer;
    in property <bool> locked;
    in property <bool> picked;
    in property <length> to;
    in property <bool> held;
    in property <length> held-y;
    in property <bool> any-held;
    in property <bool> joined;
    callback eye-clicked(bool);
    callback lock-clicked(bool);
    callback pick-clicked;
    callback drag-started(length);
    callback drag-moved(length, length);
    callback drag-ended;
    place := Settle { to: (root.held ? root.held-y : root.to) / 1px; snap: root.held; }
    y: round(place.value * 1px / 1phx) * 1phx;
    z: root.held ? 10 : 0;
    tone := Tone { on: (touch.has-hover && !root.any-held && root.layer) || root.held; }
    background: root.picked ? Theme.hover : Theme.raise.mix(Theme.hover, tone.value);
    border-radius: Theme.r-ctl;
    border-width: root.held ? Theme.ctl-outline-w(false, true) : 0px;
    border-color: Theme.ctl-outline(false, true);
    drop-shadow-blur: root.held ? Theme.u(4) : 0px;
    drop-shadow-offset-y: root.held ? Theme.u(1) : 0px;
    drop-shadow-color: root.held ? Theme.shadow : transparent;
    accessible-role: list-item;
    accessible-label: root.title + " (" + root.status + ")";
    accessible-item-selectable: true;
    accessible-item-selected: root.picked;
    touch := TouchArea {
        property <length> grab;
        property <bool> down;
        property <bool> dragging;
        property <bool> was-dragged;
        mouse-cursor: root.layer ? MouseCursor.grab : MouseCursor.default;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && root.layer) {
                down = true;
                was-dragged = false;
                grab = self.mouse-y;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                down = false;
                if (dragging) {
                    dragging = false;
                    root.drag-ended();
                }
            }
        }
        moved => {
            if (down && !dragging && abs(self.mouse-y - grab) > Theme.u(2)) {
                dragging = true;
                was-dragged = true;
                root.drag-started(root.y);
            }
            if (dragging) {
                root.drag-moved(root.y + self.mouse-y - grab, grab);
            }
        }
        clicked => { if (root.layer && !was-dragged) { root.pick-clicked(); } }
    }
    Tip { says: root.status; hover: touch.has-hover && touch.mouse-x < Theme.u(18) && !root.any-held; }
    HorizontalLayout {
        // one rhythm: the same inset from the row's edge on the left, top and bottom, and the same gap between the parts
        padding-left: Theme.u(2);
        padding-right: Theme.u(2);
        spacing: Theme.u(2);
        Rectangle {
            width: Theme.u(14);
            height: Theme.u(14);
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r-ctl;
            background: Theme.card;
            accessible-role: none;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.streaming ? Icons.camera : Icons.camera-off;
                tint: root.streaming ? Theme.ink2 : Theme.faint;
                width: Theme.icon;
                height: Theme.icon;
                accessible-role: none;
            }
        }
        Text {
            text: root.title;
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: root.picked ? 600 : 400;
            color: root.dim || !root.on ? Theme.ink2 : Theme.ink;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            accessible-role: none;
        }
        if !root.joined: LayerToggle {
            y: (parent.height - self.height) / 2;
            icon: root.on ? Icons.eye : Icons.eye-off;
            active: root.on;
            label: root.title;
            tip: root.on ? @tr("In the picture") : @tr("Not in the picture");
            tip-detail: root.on ? @tr("Take this stream out of the picture.") : @tr("Put this stream in the picture.");
            clicked => { root.eye-clicked(!root.on); }
        }
        if !root.joined && root.layer: LayerToggle {
            y: (parent.height - self.height) / 2;
            icon: Icons.lock;
            active: root.locked;
            label: @tr("Lock");
            tip: root.locked ? @tr("Locked") : @tr("Unlocked");
            tip-detail: root.locked ? @tr("Let this stream be moved and changed again.") : @tr("Pin this stream so it can't be moved or changed until it is unlocked.");
            clicked => { root.lock-clicked(!root.locked); }
        }
        // the eye and the lock as one tile with a thin divider
        if root.joined: Rectangle {
            width: root.layer ? Theme.u(28) : Theme.u(14);
            height: Theme.u(14);
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r-ctl;
            background: Theme.card;
            clip: true;
            HorizontalLayout {
                LayerToggle {
                    width: root.layer ? Theme.u(14) : parent.width;
                    height: parent.height;
                    border-radius: 0px;
                    icon: root.on ? Icons.eye : Icons.eye-off;
                    active: root.on;
                    label: root.title;
                    tip: root.on ? @tr("In the picture") : @tr("Not in the picture");
                    tip-detail: root.on ? @tr("Take this stream out of the picture.") : @tr("Put this stream in the picture.");
                    clicked => { root.eye-clicked(!root.on); }
                }
                if root.layer: Rectangle { width: Theme.u(0.5); background: Theme.line; }
                if root.layer: LayerToggle {
                    width: Theme.u(13.5);
                    height: parent.height;
                    border-radius: 0px;
                    icon: Icons.lock;
                    active: root.locked;
                    label: @tr("Lock");
                    tip: root.locked ? @tr("Locked") : @tr("Unlocked");
                    tip-detail: root.locked ? @tr("Let this stream be moved and changed again.") : @tr("Pin this stream so it can't be moved or changed until it is unlocked.");
                    clicked => { root.lock-clicked(!root.locked); }
                }
            }
        }
        // the grip: two columns of three dots
        if root.layer: Rectangle {
            width: Theme.u(8);
            accessible-role: none;
            for i in 6: Rectangle {
                x: (parent.width - Theme.u(4.5)) / 2 + Math.mod(i, 2) * Theme.u(3);
                y: (parent.height - Theme.u(7)) / 2 + Math.floor(i / 2) * Theme.u(3);
                width: Theme.u(1.5);
                height: Theme.u(1.5);
                border-radius: self.width / 2;
                background: Theme.faint;
            }
        }
    }
}

// A number box with its letter inside at the left (X, Y, W, H), the number right aligned
component PlaceField inherits Rectangle {
    in property <string> short;
    in property <string> name;
    in property <string> detail;
    in property <string> value;
    callback committed(string);
    callback step(int);
    horizontal-stretch: 1;
    height: Theme.u(16);
    NumberField {
        width: parent.width;
        height: parent.height;
        label: root.name;
        tip: root.name;
        tip-detail: root.detail;
        value: root.value;
        committed(t) => { root.committed(t); }
        step(d) => { root.step(d); }
    }
    Text {
        x: Theme.u(4);
        width: Theme.u(8);
        height: parent.height;
        text: root.short;
        font-family: Theme.font;
        font-size: Theme.body;
        color: Theme.ink2;
        vertical-alignment: center;
    }
}

export component CompositeEditor inherits Window {
    title: @tr("Edit picture");
    // The window's size, for a tooltip to stay inside it
    init => {
        WindowBox.width = self.width;
        WindowBox.height = self.height;
    }
    changed width => { WindowBox.width = self.width; }
    changed height => { WindowBox.height = self.height; }
    background: Theme.ground;
    min-width: Theme.u(480);
    min-height: Theme.u(300);
    in property <image> picture;
    in property <int> canvas-width: 1920;
    in property <int> canvas-height: 1080;
    in property <[string]> layout-items;
    in property <int> layout-current: -1;
    in property <bool> layout-enabled;
    in property <bool> saved;
    in property <bool> starts-enabled;
    in property <[TileBox]> tiles;
    in property <int> selected: -1;
    in property <TileBox> selected-tile;
    in property <[Grip]> handles;
    in property <[float]> guide-xs;
    in property <[float]> guide-ys;
    in property <string> mode;
    in property <string> cursor;
    in property <[StreamRow]> streams;
    in property <bool> few-streams;
    in property <bool> joined-controls: false;
    in property <bool> tile-shown;
    in property <float> zoom: 100;
    in property <float> zoom-max: 400;
    in property <string> zoom-text;
    in property <float> border;
    in property <float> border-max: 40;
    in property <string> border-text;
    in property <string> border-colour: "#ffffff";
    in property <color> border-swatch;
    in property <float> radius;
    in property <float> radius-max: 200;
    in property <string> radius-text;
    in property <bool> fit-enabled;
    in property <bool> tile-locked;
    in property <int> layer-count;
    in property <string> pos-x-text;
    in property <string> pos-y-text;
    in property <string> size-w-text;
    in property <string> size-h-text;
    in property <[string]> swap-items;
    in property <bool> swap-enabled;
    in property <bool> back-enabled;
    in property <bool> front-enabled;
    in property <string> background-code: "#15151a";
    in property <color> background-swatch;
    in property <string> picture-name;
    in property <bool> has-picture;
    in property <string> colour-target;
    in property <[int]> channels: [0, 0, 0];
    in property <bool> asking-name;
    in property <string> ask-title;
    in property <string> ask-start;
    in property <bool> confirming;
    in property <string> confirm-text;
    callback pointer(string, length, length, length, length, bool, bool, bool, bool);
    callback wheel(length, length, length, length, float);
    callback key(string, bool);
    callback start-from(int);
    callback layout-picked(int);
    callback save-clicked;
    callback rename-clicked;
    callback delete-clicked;
    callback name-entered(string);
    callback name-cancelled;
    callback replace-answered(bool);
    callback stream-toggled(int, bool);
    callback zoom-moved(float);
    callback border-moved(float);
    callback radius-moved(float);
    callback fit-clicked;
    callback stream-picked(int);
    callback stream-locked(int, bool);
    callback stream-moved(int, int);
    callback box-committed(string, string);
    callback box-step(string, int);
    callback swap-picked(int);
    callback restack(int);
    callback colour-clicked(string);
    callback channel-moved(int, float);
    callback picture-clicked;
    callback no-picture;
    callback close-clicked;

    VerticalLayout {
        padding-left: Theme.u(10);
        padding-right: Theme.u(10);
        padding-top: Theme.u(9);
        padding-bottom: Theme.u(9);
        spacing: Theme.u(7);
        VerticalLayout {
            spacing: Theme.u(1);
            Text { text: @tr("Edit picture"); font-family: Theme.font; font-size: Theme.heading; font-weight: 600; color: Theme.ink; }
        }
        HorizontalLayout {
            spacing: Theme.u(6);
            vertical-stretch: 1;
            Rectangle {
                horizontal-stretch: 1;
                Card {
                    title: @tr("Picture");
                    tip: @tr("Drag a stream to move it. Hold Ctrl to move it without snapping. The arrow keys move it a pixel and Shift with them ten.");
                    icon: Icons.layout;
                    hue: Theme.plugin-hue("streaming");
                    PictureView {
                        vertical-stretch: 1;
                        picture: root.picture;
                        aspect: canvas-width / max(1, canvas-height);
                        tiles: root.tiles;
                        selected: root.selected;
                        selected-tile: root.selected-tile;
                        grips: root.handles;
                        guide-xs: root.guide-xs;
                        guide-ys: root.guide-ys;
                        mode: root.mode;
                        cursor: root.cursor;
                        pointer(k, x, y, w, h, r, c, s, a) => { root.pointer(k, x, y, w, h, r, c, s, a); }
                        wheel(x, y, w, h, d) => { root.wheel(x, y, w, h, d); }
                        key(k, s) => { root.key(k, s); }
                    }
                }
                // The card's header widget in Qt, right of the title
                starts := HorizontalLayout {
                    x: parent.width - self.width - Theme.u(8.5);
                    y: Theme.u(7.5);
                    width: self.preferred-width;
                    height: Theme.u(16);
                    spacing: Theme.u(3);
                    Text { text: @tr("Start from"); font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; vertical-alignment: center; }
                    for label[i] in [@tr("Side by side"), @tr("Big and small"), @tr("Grid")]: Button {
                        text: label;
                        enabled: starts-enabled;
                        tip: label;
                        tip-detail: @tr("Start a new layout with the running streams arranged like this.");
                        clicked => { root.start-from(i); }
                    }
                }
            }
            Rectangle {
                width: Theme.u(192);
                property <length> side-y;
                property <bool> overflows: column.preferred-height > self.height;
                side := Flickable {
                    viewport-height: column.preferred-height;
                    viewport-y <=> side-y;
                column := VerticalLayout {
                    x: 0;
                    width: Theme.u(187); // Qt narrows it for the bar: here the width would hang on the height it gives
                    spacing: Theme.u(6);
                    alignment: start;
                    SideCard {
                        title: @tr("Layout");
                        icon: Icons.bookmark;
                        has-action: true;
                        action-icon: Icons.bookmark;
                        action-text: @tr("Save as");
                        action-tip-detail: @tr("Save this layout under a new name.");
                        action => { root.save-clicked(); }
                        HorizontalLayout {
                            spacing: Theme.u(3);
                            ChoiceField {
                                compact: true;
                                y: (parent.height - self.height) / 2;
                                caption: @tr("Layout");
                                placeholder: @tr("Not saved");
                                items: layout-items;
                                current: layout-current;
                                enabled: layout-enabled;
                                picked(i) => { root.layout-picked(i); }
                            }
                            IconButton { raised: true; icon: Icons.pencil; label: @tr("Rename"); tip: @tr("Rename"); tip-detail: @tr("Rename this layout."); clicked => { if (saved) { root.rename-clicked(); } } }
                            IconButton { raised: true; icon: Icons.trash; label: @tr("Delete"); tip: @tr("Delete"); tip-detail: @tr("Delete this layout."); clicked => { if (saved) { root.delete-clicked(); } } }
                        }
                    }
                    SideCard {
                        title: @tr("Streams");
                        icon: Icons.video;
                        list := Rectangle {
                            property <length> row-h: Theme.row + Theme.u(2);
                            property <length> pitch: row-h + Theme.u(2);
                            // The row held, where it is held, and the row it would take the place of
                            property <int> held: -1;
                            property <length> held-y;
                            property <int> drop: -1;
                            height: max(0px, streams.length * pitch - Theme.u(2));
                            // Where row i sits, with the held one's place made for it
                            function slot-y(i: int) -> length {
                                let shift = held < 0 ? 0 : (held < drop && i > held && i <= drop) ? -1 : (held > drop && i >= drop && i < held) ? 1 : 0;
                                return (i + shift) * pitch;
                            }
                            for row[i] in streams: LayerRow {
                                x: 0px;
                                width: parent.width;
                                height: list.row-h;
                                title: row.text;
                                status: row.status;
                                streaming: row.streaming;
                                on: row.on;
                                dim: row.dim;
                                layer: row.layer;
                                locked: row.locked;
                                picked: row.picked;
                                to: row.layer ? list.slot-y(i) : i * list.pitch;
                                held: list.held == i;
                                held-y: list.held-y;
                                any-held: list.held >= 0;
                                joined: root.joined-controls;
                                eye-clicked(on) => { root.stream-toggled(i, on); }
                                lock-clicked(locked) => { root.stream-locked(i, locked); }
                                pick-clicked => { root.stream-picked(i); }
                                drag-started(top) => {
                                    list.held = i;
                                    list.drop = i;
                                    list.held-y = top;
                                }
                                drag-moved(top, grab) => {
                                    list.held-y = max(0px, min((layer-count - 1) * list.pitch, top));
                                    list.drop = max(0, min(layer-count - 1, round(list.held-y / list.pitch)));
                                }
                                drag-ended => {
                                    let from = list.held;
                                    let target = list.drop;
                                    list.held = -1;
                                    if (from != target) { root.stream-moved(from, target); }
                                }
                            }
                        }
                        if few-streams: Note { text: @tr("Two streams required"); kind: "status_dim"; }
                    }
                    SideCard {
                        title: @tr("Picked stream");
                        icon: Icons.crop;
                        has-action: tile-shown;
                        action-icon: Icons.aspect;
                        action-text: @tr("Fit its shape");
                        action-tip-detail: @tr("Give the box the stream's original shape again, without cropping or stretching.");
                        action-enabled: fit-enabled;
                        action => { root.fit-clicked(); }
                        if tile-shown: VerticalLayout {
                            spacing: Theme.u(2);
                            if tile-locked: Note { text: @tr("Locked. Unlock it in the Streams list to change it."); kind: "status_dim"; }
                            shown-tile-name := Text {
                                text: selected-tile.name;
                                font-family: Theme.font;
                                font-size: Theme.body;
                                font-weight: 600;
                                color: Theme.ink;
                                overflow: elide;
                                height: Theme.u(14);
                                vertical-alignment: center;
                                Tip { says: shown-tile-name.text; enabled: shown-tile-name.preferred-width > shown-tile-name.width; inert: true; }
                            }
                            SectionHeading { text: @tr("Place"); }
                            HorizontalLayout {
                                spacing: Theme.gap;
                                PlaceField {
                                    short: @tr("X");
                                    name: @tr("Left");
                                    detail: @tr("How far the left edge of the stream is from the left edge of the picture, in pixels.");
                                    value: pos-x-text;
                                    committed(t) => { root.box-committed("x", t); }
                                    step(d) => { root.box-step("x", -d); }
                                }
                                PlaceField {
                                    short: @tr("Y");
                                    name: @tr("Top");
                                    detail: @tr("How far the top edge of the stream is from the top of the picture, in pixels.");
                                    value: pos-y-text;
                                    committed(t) => { root.box-committed("y", t); }
                                    step(d) => { root.box-step("y", -d); }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.gap;
                                PlaceField {
                                    short: @tr("W");
                                    name: @tr("Width");
                                    detail: @tr("The width of the stream's box in pixels.");
                                    value: size-w-text;
                                    committed(t) => { root.box-committed("w", t); }
                                    step(d) => { root.box-step("w", -d); }
                                }
                                PlaceField {
                                    short: @tr("H");
                                    name: @tr("Height");
                                    detail: @tr("The height of the stream's box in pixels.");
                                    value: size-h-text;
                                    committed(t) => { root.box-committed("h", t); }
                                    step(d) => { root.box-step("h", -d); }
                                }
                            }
                            ChoiceField {
                                compact: true;
                                caption: @tr("Swap with");
                                placeholder: @tr("Swap with…");
                                items: swap-items;
                                current: -1;
                                enabled: swap-enabled;
                                tip: @tr("Swap with");
                                tip-detail: @tr("Trade this stream's place and size with another stream's.");
                                picked(i) => { root.swap-picked(i); }
                            }
                            HorizontalLayout {
                                spacing: Theme.gap;
                                Button { horizontal-stretch: 1; text: @tr("Send back"); enabled: back-enabled; clicked => { root.restack(-1); } }
                                Button { horizontal-stretch: 1; text: @tr("Bring forward"); enabled: front-enabled; clicked => { root.restack(1); } }
                            }
                            SectionHeading { text: @tr("Look"); }
                            SliderRow {
                                label-width: Theme.u(36);
                                hue: Theme.plugin-hue("streaming");
                                label: @tr("Zoom");
                                tip-hint: @tr("Scroll to zoom and drag with the right mouse button to move. Double-click to reset.");
                                minimum: 100;
                                maximum: zoom-max;
                                value: zoom;
                                readout: zoom-text;
                                has-default: true;
                                default-value: 100;
                                moved(v) => { root.zoom-moved(v); }
                            }
                            SliderRow {
                                label-width: Theme.u(36);
                                hue: Theme.plugin-hue("streaming");
                                label: @tr("Corners");
                                maximum: radius-max;
                                value: radius;
                                readout: radius-text;
                                tip-detail: @tr("How round the corners are.");
                                has-default: true;
                                default-value: 0;
                                moved(v) => { root.radius-moved(v); }
                            }
                            SliderRow {
                                label-width: Theme.u(36);
                                hue: Theme.plugin-hue("streaming");
                                label: @tr("Border");
                                maximum: border-max;
                                value: border;
                                readout: border-text;
                                tip-detail: @tr("How thick the border is.");
                                has-default: true;
                                default-value: 0;
                                moved(v) => { root.border-moved(v); }
                            }
                            LabelRow {
                                label-width: Theme.u(36);
                                label: @tr("Colour");
                                SwatchRow {
                                    label: @tr("Border colour");
                                    code: border-colour;
                                    colour: border-swatch;
                                    clicked => { root.colour-clicked("border"); }
                                }
                            }
                            Unfolding {
                                open: colour-target == "border";
                                lead: Theme.u(1);
                                VerticalLayout {
                                    for name[i] in [@tr("Red"), @tr("Green"), @tr("Blue")]: SliderRow {
                                        label-width: Theme.u(36);
                                        hue: Theme.plugin-hue("streaming");
                                        label: name;
                                        minimum: 0;
                                        maximum: 255;
                                        value: channels[i];
                                        readout: channels[i];
                                        moved(v) => { root.channel-moved(i, v); }
                                    }
                                }
                            }
                        }
                    }
                    SideCard {
                        title: @tr("Background");
                        icon: Icons.image;
                        LabelRow {
                            label-width: Theme.u(36);
                            label: @tr("Colour");
                            SwatchRow {
                                label: @tr("Background colour");
                                code: background-code;
                                colour: background-swatch;
                                clicked => { root.colour-clicked("background"); }
                            }
                        }
                        Unfolding {
 open: colour-target == "background";
 lead: Theme.u(1);
 VerticalLayout {
                            for name[i] in [@tr("Red"), @tr("Green"), @tr("Blue")]: SliderRow {
                                    label-width: Theme.u(36);
                                    hue: Theme.plugin-hue("streaming");
                                label: name;
                                minimum: 0;
                                maximum: 255;
                                value: channels[i];
                                readout: channels[i];
                                moved(v) => { root.channel-moved(i, v); }
                            }
                        }
 }
                        LabelRow {
                            label-width: Theme.u(36);
                            label: @tr("Picture");
                            shown-picture-name := Text { text: picture-name; font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; Tip { says: shown-picture-name.text; enabled: shown-picture-name.preferred-width > shown-picture-name.width; inert: true; } }
                            Button { y: Theme.u(1); text: @tr("Picture"); tip: @tr("Picture"); tip-detail: @tr("Show a picture behind the streams instead of the colour."); clicked => { root.picture-clicked(); } }
                            if has-picture: IconButton { raised: true; y: Theme.u(1.5); icon: Icons.x; label: @tr("No picture"); clicked => { root.no-picture(); } }
                        }
                    }
                }
                }
                if overflows: FlickBar {
                    x: parent.width - self.width;
                    y: 0;
                    width: Theme.u(5);
                    height: parent.height;
                    content: column.preferred-height;
                    viewport: parent.height;
                    position <=> side-y;
                }
            }
        }
        HorizontalLayout {
            padding-top: Theme.u(2);
            alignment: end;
            Button { width: Theme.u(48); text: @tr("Close"); clicked => { root.close-clicked(); } }
        }
    }

    // QInputDialog and QMessageBox, inside the window: it's the window they belong to
    if asking-name || confirming: Rectangle {
        background: Theme.scrim.with-alpha(Theme.scrim-a);
        TouchArea { }
        DialogFrame {
            width: Theme.u(210);
            height: self.preferred-height;
            title: asking-name ? ask-title : @tr("Replace layout");
            if asking-name: VerticalLayout {
                spacing: Theme.u(6);
                Text { text: @tr("Name:"); font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; }
                name := TextField {
                    text: ask-start;
                    label: @tr("Name:");
                    accepted => { root.name-entered(self.text); }
                    init => { self.focus(); }
                }
                HorizontalLayout {
                    spacing: Theme.u(4);
                    alignment: end;
                    Button { width: Theme.u(48); text: @tr("Cancel"); clicked => { root.name-cancelled(); } }
                    Button { width: Theme.u(48); text: @tr("OK"); role: "primary"; hue: Theme.plugin-hue("streaming"); clicked => { root.name-entered(name.text); } }
                }
            }
            if confirming: VerticalLayout {
                spacing: Theme.u(6);
                Note { text: confirm-text; kind: ""; }
                HorizontalLayout {
                    spacing: Theme.u(4);
                    alignment: end;
                    Button { width: Theme.u(48); text: @tr("No"); clicked => { root.replace-answered(false); } }
                    Button { width: Theme.u(48); text: @tr("Yes"); role: "primary"; hue: Theme.plugin-hue("streaming"); clicked => { root.replace-answered(true); } }
                }
            }
        }
    }
    TipLayer { }
}
