// The Privacy blur card. Joined after parts.slint and vision_row.slint.

export component PrivacyBlurCard inherits Card {
    in property <bool> active: true;
    idle: !active;
    // Greyed out until a phone is paired
    in property <bool> on: false;
    in property <string> switch-help;
    in property <int> mode: 0;
    in property <string> mode-tip;
    in property <bool> now: false;
    in property <string> now-tip;
    in property <string> vision-text;
    in property <bool> vision-download;
    callback switch-toggled-by-hand(bool);
    callback mode-picked(int);
    callback now-clicked;
    callback download-clicked;

    title: @tr("Privacy blur");
    tip: @tr("Blur the other people or show the wait screen when someone else is in the picture.");
    icon: Icons.eye-off;
    enabled: active;
    has-switch: true;
    switch-shortcut: "privacy_blur.auto";
    switch-enabled: active;
    switch-checked: on;
    switch-label: @tr("Privacy blur");
    switch-tip: @tr("Privacy blur");
    switch-tip-detail: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }

    RailRow {
        icon: Icons.eye-off;
        label: @tr("What happens");
        hue: root.hue;
        enabled: active;
        ChoiceField {
            enabled: active;
            compact: true;
            caption: @tr("Privacy blur: what happens");
            items: [@tr("Blur the others"), @tr("Blur all but me"), @tr("Show the wait screen")];
            current: mode;
            shortcut: "privacy_blur.mode";
            tip: @tr("Privacy blur: what happens");
            tip-detail: mode-tip;
            picked(i) => { root.mode-picked(i); }
        }
    }
    RailRow {
        icon: Icons.blur;
        label: @tr("Blur now");
        hue: root.hue;
        enabled: active;
        Button {
            horizontal-stretch: 1;
            enabled: active;
            text: @tr("Blur now");
            tip: @tr("Blur now");
            tip-detail: now-tip;
            // a checked QPushButton: the filled one
            role: now ? "primary" : "";
            hue: root.hue;
            shortcut: "privacy_blur.now";
            clicked => { root.now-clicked(); }
        }
    }
    if vision-text != "": VisionStatus {
        text: vision-text;
        download: vision-download;
        download-clicked => { root.download-clicked(); }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
