// The Photos card (desktop/telescope/plugins/photos.py). Joined after parts.slint, which has the imports.

// control_row with a drop-down and the tooltip it has in Qt
component PickRow inherits FormRow {
    in property <[string]> items;
    in property <int> current;
    in property <string> tip;
    in property <string> shortcut;
    callback picked(int);
    Rectangle {
        horizontal-stretch: 1;
        ChoiceField {
            enabled: root.enabled;
            width: parent.width;
            compact: true;
            caption: root.label;
            items: root.items;
            current: root.current;
            shortcut: root.shortcut;
            picked(i) => { root.picked(i); }
        }
        if tip != "": Tooltip { TipBody { says: root.tip; } }
    }
}

// control_row with a number box (a QSpinBox without buttons)
component NumberRow inherits FormRow {
    in property <string> text;
    // The text the box goes back to whenever sync changes (a refused key, leaving the box)
    in property <string> restore;
    in property <int> sync;
    in property <string> tip;
    callback edited(string);
    callback left;
    changed sync => { field.text = root.restore; }
    HorizontalLayout {
        alignment: start;
        Rectangle {
            width: 78px;
            field := TextField {
                enabled: root.enabled;
                width: parent.width;
                height: 32px;
                y: 2px;
                label: root.label;
                text: root.text;
                align-right: true;
                edited(t) => { root.edited(t); }
                changed has-focus => { if (!self.has-focus) { root.left(); } }
            }
            if tip != "": Tooltip { TipBody { says: root.tip; } }
        }
    }
}

export component PhotosCard inherits Card {
    // Greyed out until a phone is paired, and gone for a source that isn't a phone
    in property <bool> active: true;
    in property <bool> shown: true;
    in property <string> take-text;
    in property <string> take-tip;
    in property <bool> take-enabled;
    in property <string> open-text;
    in property <string> open-tip;
    in property <bool> open-shown;
    in property <string> status;
    in property <string> status-kind: "status_dim";
    in property <string> info;
    in property <bool> info-shown;
    in property <[string]> format-items: [""];
    in property <int> format-current;
    in property <bool> format-shown;
    in property <int> quality: 95;
    in property <string> quality-text;
    in property <bool> quality-shown;
    in property <string> reset-hint;
    in property <[string]> mode-items: [""];
    in property <int> mode-current;
    in property <bool> mode-shown;
    in property <string> mode-tip;
    in property <[string]> shots-items: [""];
    in property <int> shots-current;
    in property <bool> shots-shown;
    in property <string> burst-text;
    in property <string> burst-restore;
    in property <int> burst-sync;
    in property <bool> burst-shown;
    in property <[string]> bracket-items: ["", "", "", ""];
    in property <int> bracket-current;
    in property <bool> bracket-shown;
    in property <string> focus-text;
    in property <string> focus-restore;
    in property <int> focus-sync;
    in property <string> focus-tip;
    in property <bool> focus-shown;
    in property <[string]> exposure-items: [""];
    in property <int> exposure-current;
    in property <bool> exposure-shown;
    in property <string> exposure-tip;
    in property <[string]> timer-items: ["", "", ""];
    in property <int> timer-current;
    in property <string> best-name;
    in property <string> best-tip;
    in property <bool> best;
    in property <bool> best-shown;
    in property <[string]> distortion-items: ["", "", ""];
    in property <int> distortion-current;
    in property <bool> distortion-shown;
    in property <string> folder-name;
    in property <string> folder-tip;
    in property <string> folder-tip-text;
    in property <string> change-text;
    callback take-clicked;
    callback open-clicked;
    callback choice-picked(int, int);
    callback quality-moved(float);
    callback number-edited(int, string);
    callback number-left(int);
    callback timer-picked(int);
    callback best-toggled(bool);
    callback folder-clicked;

    title: @tr("Photos");
    icon: Icons.photo;
    visible: shown;
    opacity: active ? 1 : 0.4;
    enabled: active;

    HorizontalLayout {
        spacing: 8px;
        Button { text: take-text; tip: take-tip; role: "primary"; enabled: take-enabled; shortcut: "photos.take"; clicked => { root.take-clicked(); } }
        Rectangle { horizontal-stretch: 1; }
        if open-shown: Button { text: open-text; tip: open-tip; clicked => { root.open-clicked(); } }
    }
    if status != "": Rectangle {
        height: 20px;
        Text {
            width: parent.width;
            height: parent.height;
            text: status;
            font-family: Theme.font;
            font-size: Theme.body;
            color: Status.color(status-kind);
            vertical-alignment: center;
            overflow: elide;
        }
        Tooltip { TipBody { says: root.status; } }
    }
    if info-shown: Note { text: info; }
    if format-shown: PickRow {
        enabled: active;
        label: @tr("Format");
        items: format-items;
        current: format-current;
        picked(i) => { root.choice-picked(1, i); }
    }
    if quality-shown: SliderRow {
        enabled: active;
        label: @tr("Quality");
        minimum: 50;
        maximum: 100;
        value: quality;
        readout: quality-text;
        hue: root.hue;
        has-default: true;
        default-value: 95;
        hint: reset-hint;
        moved(v) => { root.quality-moved(v); }
    }
    if mode-shown: PickRow {
        enabled: active;
        label: @tr("Mode");
        items: mode-items;
        current: mode-current;
        tip: mode-tip;
        shortcut: "photos.mode";
        picked(i) => { root.choice-picked(0, i); }
    }
    if shots-shown: PickRow {
        enabled: active;
        label: @tr("Shots");
        items: shots-items;
        current: shots-current;
        picked(i) => { root.choice-picked(2, i); }
    }
    if burst-shown: NumberRow {
        enabled: active;
        label: @tr("How many");
        text: burst-text;
        restore: burst-restore;
        sync: burst-sync;
        edited(t) => { root.number-edited(0, t); }
        left => { root.number-left(0); }
    }
    if bracket-shown: PickRow {
        enabled: active;
        label: @tr("Bracket");
        items: bracket-items;
        current: bracket-current;
        picked(i) => { root.choice-picked(4, i); }
    }
    if focus-shown: NumberRow {
        enabled: active;
        label: @tr("Steps");
        text: focus-text;
        restore: focus-restore;
        sync: focus-sync;
        tip: focus-tip;
        edited(t) => { root.number-edited(1, t); }
        left => { root.number-left(1); }
    }
    if exposure-shown: PickRow {
        enabled: active;
        label: @tr("Exposure");
        items: exposure-items;
        current: exposure-current;
        tip: exposure-tip;
        picked(i) => { root.choice-picked(3, i); }
    }
    FormRow {
        label: @tr("Timer");
        Segmented {
            items: timer-items;
            label: @tr("Timer");
            current: timer-current;
            shortcut: "photos.timer";
            picked(i) => { root.timer-picked(i); }
        }
    }
    if best-shown: FormRow {
        label: "";
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 36px;
                Switch {
                    enabled: active;
                    y: 8px;
                    checked: best;
                    label: best-name;
                    tip: best-tip;
                    toggled(v) => { root.best-toggled(v); }
                }
            }
            Text {
                text: @tr("Best quality noise reduction and sharpening");
                font-family: Theme.font;
                font-size: Theme.body;
                color: Theme.text;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }
    if distortion-shown: PickRow {
        enabled: active;
        label: @tr("Distortion fix");
        items: distortion-items;
        current: distortion-current;
        picked(i) => { root.choice-picked(5, i); }
    }
    FormRow {
        label: @tr("Save in");
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: folder-name;
                    font-family: Theme.font;
                    font-size: Theme.body;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Tooltip { TipBody { says: root.folder-tip; } }
            }
            Button { text: change-text; tip: folder-tip-text; clicked => { root.folder-clicked(); } }
        }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
