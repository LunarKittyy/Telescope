// The Photos card. Joined after parts.slint, which has the imports.
// Every control has its place whatever the lens offers, and is greyed out with its reason in a tooltip when there is nothing to pick, so
// nothing moves when a stream starts. Values that run in order (ISO, shutter speed, how many, a long exposure) step; named choices pick.

// What a shots choice looks like: one frame, a stack of them, three exposures, layers of focus
component ShotArt inherits Rectangle {
    in property <int> kind;
    in property <color> ink;
    width: Theme.u(11);
    height: Theme.u(9);
    if kind == 0: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 22;
        viewbox-height: 18;
        commands: "M 5 3 H 17 V 15 H 5 Z";
        stroke: ink;
        stroke-width: 1.5px;
        fill: transparent;
    }
    if kind == 1: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 22;
        viewbox-height: 18;
        commands: "M 8 5 V 2 H 20 V 12 H 17 M 3 6 H 15 V 16 H 3 Z";
        stroke: ink;
        stroke-width: 1.5px;
        fill: transparent;
    }
    if kind == 2: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 22;
        viewbox-height: 18;
        commands: "M 1.5 4 H 7.5 V 14 H 1.5 Z M 8.5 4 H 14.5 V 14 H 8.5 Z M 15.5 4 H 21.5 V 14 H 15.5 Z";
        stroke: ink;
        stroke-width: 1.5px;
        fill: transparent;
    }
    if kind == 3: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 22;
        viewbox-height: 18;
        commands: "M 11 1.5 L 20 5.5 L 11 9.5 L 2 5.5 Z M 2 9.5 L 11 13.5 L 20 9.5 M 2 13.5 L 11 17 L 20 13.5";
        stroke: ink;
        stroke-width: 1.5px;
        fill: transparent;
    }
}

export component PhotosCard inherits Card {
    in property <bool> customize-shown: true;
    in property <bool> customize-open;
    in property <string> shot-summary;
    in property <[string]> shot-shutter-stops: [@tr("Camera")];
    in property <int> shot-shutter-index;
    in property <bool> shot-shutter-enabled;
    in property <string> shot-shutter-tip;
    in property <[string]> shot-iso-stops: [@tr("Camera")];
    in property <int> shot-iso-index;
    in property <bool> shot-iso-enabled;
    in property <string> shot-iso-tip;
    in property <bool> shot-focus-enabled;
    in property <string> shot-focus-tip;
    in property <float> shot-focus-value;
    in property <bool> shot-focus-unset: true;
    in property <string> shot-focus-readout: @tr("Camera");
    in property <[float]> shot-focus-marks;
    callback customize-toggled(bool);
    callback shot-iso-picked(int);
    callback shot-focus-moved(float);
    callback shot-focus-reset();
    in property <bool> use-zoom;
    in property <bool> use-zoom-enabled: true;
    in property <string> use-zoom-tip;
    callback use-zoom-toggled(bool);
    in property <bool> active: true;
    idle: !active;
    // Greyed out until a phone is paired, and gone for a source that isn't a phone or a camera that takes photos
    in property <bool> shown: true;
    in property <string> take-text;
    in property <string> take-tip;
    in property <bool> take-enabled;
    in property <string> open-text;
    in property <string> open-tip;
    in property <bool> open-enabled;
    in property <string> status;
    in property <string> status-kind: "status_dim";
    // A camera's own ISO and shutter speed lists (a DSLR); empty for a phone
    in property <[string]> iso-options;
    in property <int> iso-index;
    in property <[string]> shutter-options;
    in property <int> shutter-index;
    in property <[string]> mode-options;
    in property <int> mode-index;
    in property <bool> mode-enabled;
    in property <string> mode-tip;
    in property <string> shots-tip;
    in property <string> timer-tip;
    in property <[string]> format-options;
    in property <int> format-index;
    in property <bool> format-enabled;
    // The four ways to shoot, which of them this lens offers, and the one picked
    in property <[string]> shots-names;
    in property <[bool]> shots-offered: [true, false, false, false];
    in property <int> shots-index;
    // The slot under them: how many, how many steps or which bracket, by what is picked above
    in property <string> slot-key;
    in property <string> slot-label;
    in property <[string]> slot-options;
    in property <int> slot-index;
    in property <string> slot-tip;
    // The second tile beside it: a long exposure, or how far apart the photos of an exposure bracket are
    in property <string> second-key;
    in property <string> second-label;
    in property <[string]> second-options;
    in property <int> second-index;
    in property <string> second-tip;
    // How many ticks make a full stop on the second dial, and which tick the first named one is
    in property <int> second-per: 1;
    in property <int> second-from: 0;
    // The ends of a focus bracket on the Camera card's focus scale (0 is infinity, 1000 the nearest), and where the phone is focused now
    in property <bool> focus-range-shown;
    in property <float> focus-low;
    in property <float> focus-high;
    in property <string> focus-low-text;
    in property <string> focus-high-text;
    in property <string> focus-readout;
    in property <bool> focus-live;
    in property <float> focus-live-pos;
    in property <bool> focus-range-enabled;
    in property <bool> focus-range-changed;
    in property <string> focus-range-tip;
    callback focus-range-moved(float, float);
    in property <int> distortion-index;
    in property <bool> distortion-enabled;
    in property <[string]> distortion-tips;
    // What a focus bracket saves: the photos, both, or only the merged picture
    in property <int> merge-index;
    in property <bool> merge-enabled;
    in property <[string]> merge-tips;
    in property <string> merge-off-tip;
    in property <int> brightness: 0;
    in property <bool> brightness-enabled;
    in property <string> brightness-text;
    in property <string> brightness-tip;
    callback brightness-moved(float);
    // What the arrows are called to a screen reader
    in property <string> previous-label;
    in property <string> next-label;
    in property <int> quality: 95;
    in property <string> quality-text;
    in property <bool> quality-enabled: true;
    in property <string> quality-tip;
    in property <[string]> timer-items: ["", "", ""];
    in property <int> timer-current;
    in property <string> best-name;
    in property <string> best-tip;
    in property <bool> best;
    in property <bool> best-enabled;
    in property <string> folder-name;
    in property <bool> folder-changed;
    in property <string> folder-tip;
    // The last options there were, kept while the Exposure row folds away
    property <[string]> held-iso;
    property <[string]> held-shutter;
    function keep() {
        if (iso-options.length > 0) { held-iso = iso-options; }
        if (shutter-options.length > 0) { held-shutter = shutter-options; }
    }
    init => { keep(); }
    changed iso-options => { keep(); }
    changed shutter-options => { keep(); }
    callback take-clicked;
    callback open-clicked;
    callback tile-picked(string, int);
    // One step (-1 or 1) of a stepper from a key or the wheel, and an arrow going down (with its way) and coming up
    callback tile-step(string, int);
    callback tile-hold-down(string, int);
    callback tile-hold-up();
    callback quality-moved(float);
    callback timer-picked(int);
    callback best-toggled(bool);
    callback folder-clicked;
    in property <bool> reset-shown;
    callback reset-clicked;

    title: @tr("Photos");
    tip: @tr("Take full-quality photos on the phone or a DSLR, including RAW if the camera supports it.");
    icon: Icons.photo;
    visible: shown;
    enabled: active;
    has-reset: true;
    reset-lit: reset-shown;
    reset-label: @tr("Reset");
    reset-detail: @tr("Set every photo setting except the folder back to default.");
    reset => { root.reset-clicked(); }

    UnfoldGroup {
        RailRow {
            icon: Icons.aperture;
            label: @tr("Take photo");
            hue: root.hue;
            enabled: active;
            HorizontalLayout {
                spacing: Theme.gap;
                Button { horizontal-stretch: 1; preferred-width: 1000px; text: take-text; tip: take-text; tip-detail: take-tip; role: "primary"; hue: root.hue; muted: true; enabled: active && take-enabled; shortcut: "photos.take"; clicked => { root.take-clicked(); } }
                IconButton { raised: true; icon: Icons.folder; label: open-text; tip: open-text; tip-detail: open-tip; enabled: active && open-enabled; clicked => { root.open-clicked(); } }
            }
        }
        StatusUnfold { text: status; kind: status-kind; }
        Unfolding {
            open: iso-options.length > 0 || shutter-options.length > 0;
            RailRow {
                    icon: Icons.exposure;
                    label: @tr("Exposure");
                    hue: root.hue;
                    enabled: active;
                    HorizontalLayout {
                        spacing: Theme.gap;
                        // A dial the camera stopped offering goes while the other is still on; with neither, both stay until the row has closed
                        if held-iso.length > 0 && (iso-options.length > 0 || shutter-options.length == 0): Dial {
                            label: @tr("ISO");
                            tip: @tr("ISO");
                            tip-detail: @tr("Higher ISO makes the photo brighter but grainier.");
                            hue: root.hue;
                            enabled: active;
                            stops: held-iso;
                            current: iso-index;
                            moved(i) => { root.tile-picked("iso", i); }
                        }
                        if held-shutter.length > 0 && (shutter-options.length > 0 || iso-options.length == 0): Dial {
                            label: @tr("Shutter");
                            tip: @tr("Shutter");
                            tip-detail: @tr("Slower shutter speeds make the photo brighter but blur movement.");
                            hue: root.hue;
                            enabled: active;
                            stops: held-shutter;
                            current: shutter-index;
                            moved(i) => { root.tile-picked("shutter", i); }
                        }
                    }
                }
        }
    }
    RailRow {
        icon: Icons.grid;
        label: @tr("Mode and format");
        hue: root.hue;
        enabled: active;
        changed: mode-index != 0 || format-index != 0;
        HorizontalLayout {
            spacing: Theme.gap;
            ChoiceField {
                compact: true;
                name: @tr("Mode");
                items: mode-options;
                current: mode-index;
                enabled: active && mode-enabled;
                shortcut: "photos.mode";
                tip: @tr("Mode");
                tip-detail: mode-tip;
                picked(i) => { root.tile-picked("mode", i); }
            }
            ChoiceField {
                compact: true;
                name: @tr("Format");
                items: format-options;
                current: format-index;
                enabled: active && format-enabled;
                tip: @tr("Format");
                tip-detail: @tr("The file type photos are saved as.");
                picked(i) => { root.tile-picked("format", i); }
            }
        }
    }
    RailRow {
        icon: Icons.layers;
        label: @tr("Shots");
        hue: root.hue;
        enabled: active;
        changed: shots-index != 0;
        shots := PictureSegmented {
            label: @tr("Shots");
            hue: root.hue;
            items: shots-names;
            tip-details: [shots-tip, shots-tip, shots-tip, shots-tip];
            disabled: [!active || !shots-offered[0], !active || !shots-offered[1], !active || !shots-offered[2], !active || !shots-offered[3]];
            current: shots-index;
            picked(i) => { root.tile-picked("shots", i); }
            for i in 4: ShotArt {
                x: i * shots.pitch + (shots.cell-width - self.width) / 2;
                y: (shots.art-height - self.height) / 2;
                kind: i;
                ink: !active || !shots-offered[i] ? Theme.dis : shots.shown == i ? Theme.ink : Theme.ink2;
            }
        }
    }
    // The slot under Shots keeps its place with nothing in it, so picking a way to shoot moves nothing
    RailRow {
        has-icon: false;
        enabled: active;
        HorizontalLayout {
            spacing: Theme.gap;
            Dial {
                label: slot-label != "" ? slot-label : @tr("How many");
                tip: slot-label != "" ? slot-label : @tr("How many");
                tip-detail: slot-tip;
                hue: root.hue;
                enabled: active && slot-options.length > 1;
                stops: slot-options.length > 0 ? slot-options : ["-"];
                current: slot-index;
                moved(i) => { root.tile-picked(root.slot-key, i); }
            }
            Dial {
                label: second-label;
                tip: second-label;
                tip-detail: second-tip;
                hue: root.hue;
                enabled: active && second-options.length > 1;
                stops: second-options.length > 0 ? second-options : ["-"];
                current: second-index;
                per-label: second-per;
                label-from: second-from;
                moved(i) => { root.tile-picked(root.second-key, i); }
            }
        }
    }
    Unfolding {
        open: customize-shown;
        UnfoldGroup {
            RailRow {
                icon: Icons.camera;
                label: @tr("Customise camera");
                hue: root.hue;
                enabled: active;
                Rectangle {
                    horizontal-stretch: 1;
                    preferred-width: 1000px;
                    height: Theme.row;
                    Button {
                        width: parent.width;
                        height: parent.height;
                        shrinks: true;
                        enabled: active;
                        tip: @tr("Customise camera");
                        tip-detail: root.shot-summary;
                        accessible-label: @tr("Customise camera");
                        accessible-value: root.shot-summary;
                        accessible-expandable: true;
                        accessible-expanded: root.customize-open;
                        clicked => { root.customize-toggled(!root.customize-open); }
                    }
                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: Theme.u(6);
                        padding-right: Theme.u(6);
                        spacing: Theme.gap;
                        if root.width >= Theme.u(200): Text {
                            text: @tr("Customise camera");
                            font-family: Theme.font;
                            font-size: Theme.body;
                            font-weight: Theme.w-label;
                            color: active ? Theme.ink : Theme.dis;
                            vertical-alignment: center;
                            overflow: elide;
                            min-width: 0px;
                            horizontal-stretch: 1;
                            accessible-role: none;
                        }
                        Text {
                            text: root.shot-summary;
                            font-family: Theme.font;
                            font-size: Theme.body;
                            font-weight: Theme.w-value;
                            color: active ? Theme.ink : Theme.dis;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                            min-width: 0px;
                            horizontal-stretch: 1;
                            accessible-role: none;
                        }
                        Rectangle {
                            width: Theme.u(8);
                            Path {
                                width: Theme.u(8);
                                height: Theme.u(8);
                                y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
                                viewbox-x: Theme.stroke / 2 / 1px;
                                viewbox-y: Theme.stroke / 2 / 1px;
                                viewbox-width: 16 - Theme.stroke / 1px;
                                viewbox-height: 16 - Theme.stroke / 1px;
                                commands: root.customize-open ? "M 4.5 9.5 L 8 6 L 11.5 9.5" : "M 4.5 6.5 L 8 10 L 11.5 6.5";
                                stroke: active ? Theme.ink : Theme.dis;
                                stroke-width: Theme.stroke;
                            }
                        }
                    }
                }
            }
            Unfolding {
                open: root.customize-open;
                ShotControls {
                    hue: root.hue;
                    enabled: active;
                    show-shutter: false;
                    iso-only-caption: true;
                    shutter-stops: root.shot-shutter-stops;
                    shutter-index: root.shot-shutter-index;
                    shutter-enabled: root.shot-shutter-enabled;
                    shutter-tip: root.shot-shutter-tip;
                    iso-stops: root.shot-iso-stops;
                    iso-index: root.shot-iso-index;
                    iso-enabled: root.shot-iso-enabled;
                    iso-tip: root.shot-iso-tip;
                    focus-enabled: root.shot-focus-enabled;
                    focus-tip: root.shot-focus-tip;
                    focus-value: root.shot-focus-value;
                    focus-unset: root.shot-focus-unset;
                    focus-readout: root.shot-focus-readout;
                    focus-marks: root.shot-focus-marks;
                    iso-picked(i) => { root.shot-iso-picked(i); }
                    focus-moved(v) => { root.shot-focus-moved(v); }
                    focus-reset => { root.shot-focus-reset(); }
                }
            }
        }
    }

    Unfolding {
        open: focus-range-shown;
        RailRow {
            icon: Icons.focus;
            label: @tr("Focus range");
            hue: root.hue;
            enabled: active;
            changed: focus-range-changed;
            RangeSlider {
                label: @tr("Focus range");
                hue: root.hue;
                enabled: active && focus-range-enabled;
                minimum: 0;
                maximum: 1000;
                step: 1;
                low: focus-low;
                high: focus-high;
                low-text: focus-low-text;
                high-text: focus-high-text;
                readout: focus-readout;
                    has-live: focus-live;
                live: focus-live-pos;
                tip: @tr("Focus range");
                tip-detail: focus-range-tip;
                moved(lo, hi) => { root.focus-range-moved(lo, hi); }
            }
        }
    }
    RailRow {
        icon: Icons.layers;
        label: @tr("Merge bracket");
        hue: root.hue;
        enabled: active;
        changed: merge-index != 0;
        Segmented {
            hue: root.hue;
            label: @tr("Merge bracket");
            items: [@tr("Photos"), @tr("Both"), @tr("Merged")];
            disabled: [!active || !merge-enabled, !active || !merge-enabled, !active || !merge-enabled];
            tips: [@tr("Photos"), @tr("Both"), @tr("Merged")];
            tip-details: merge-enabled ? merge-tips : [merge-off-tip, merge-off-tip, merge-off-tip];
            current: merge-index;
            picked(i) => { root.tile-picked("bracket_merge", i); }
        }
    }
    RailRow {
        icon: Icons.sun;
        label: @tr("Merged brightness");
        hue: root.hue;
        enabled: active;
        changed: brightness != 0;
        Slider {
            label: @tr("Merged brightness");
            enabled: active && brightness-enabled;
            minimum: -100;
            maximum: 100;
            value: brightness;
            readout: brightness-text;
            hue: root.hue;
            has-default: true;
            default-value: 0;
            tip: @tr("Merged brightness");
            tip-detail: brightness-tip;
            moved(v) => { root.brightness-moved(v); }
        }
    }
    RailRow {
        icon: Icons.distortion;
        label: @tr("Distortion fix");
        hue: root.hue;
        enabled: active;
        changed: distortion-index != 0;
        Segmented {
            hue: root.hue;
            label: @tr("Distortion fix");
            items: [@tr("Camera"), @tr("On"), @tr("Off")];
            disabled: [!active || !distortion-enabled, !active || !distortion-enabled, !active || !distortion-enabled];
            tips: [@tr("Camera"), @tr("On"), @tr("Off")];
            tip-details: distortion-tips;
            current: distortion-index;
            picked(i) => { root.tile-picked("distortion", i); }
        }
    }
    RailRow {
        icon: Icons.gem;
        label: @tr("Quality");
        hue: root.hue;
        enabled: active;
        changed: quality != 95;
        Slider {
            label: @tr("Quality");
            enabled: active && quality-enabled;
            minimum: 50;
            maximum: 100;
            value: quality;
            readout: quality-text;
            hue: root.hue;
            has-default: true;
            default-value: 95;
            tip: @tr("Quality");
            tip-detail: quality-tip != "" ? quality-tip : @tr("Higher quality gives bigger and cleaner JPEG files.");
            moved(v) => { root.quality-moved(v); }
        }
    }
    SwitchRow {
        icon: Icons.zoom;
        label: @tr("Use zoom");
        tip: @tr("Use zoom");
        tip-detail: use-zoom-tip != "" ? use-zoom-tip : @tr("Crop the photo to the zoom and position set in Transforms.");
        hue: root.hue;
        enabled: active && use-zoom-enabled;
        changed: use-zoom;
        checked: use-zoom;
        toggled(v) => { root.use-zoom-toggled(v); }
    }
    SwitchRow {
        icon: Icons.sparkle;
        label: best-name;
        tip: best-name;
        tip-detail: best-tip;
        hue: root.hue;
        enabled: active && best-enabled;
        changed: !best;
        checked: best;
        toggled(v) => { root.best-toggled(v); }
    }
    RailRow {
        icon: Icons.timer;
        label: @tr("Timer");
        hue: root.hue;
        enabled: active;
        changed: timer-current != 0;
        Segmented {
            hue: root.hue;
            label: @tr("Timer");
            shortcut: "photos.timer";
            items: timer-items;
            tips: timer-items;
            tip-details: [timer-tip, timer-tip, timer-tip];
            disabled: [!active, !active, !active];
            current: timer-current;
            picked(i) => { root.timer-picked(i); }
        }
    }
    RailRow {
        icon: Icons.folder;
        label: @tr("Save in");
        hue: root.hue;
        enabled: active;
        changed: folder-changed;
        Button {
            horizontal-stretch: 1;
            preferred-width: Theme.u(500);
            shrinks: true;
            text: folder-name;
            tip: @tr("Save in");
            tip-detail: @tr("The folder path photos are saved in.");
            tip-hint: folder-tip;
            enabled: active;
            clicked => { root.folder-clicked(); }
        }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
