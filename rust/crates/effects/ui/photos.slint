// The Photos card. Joined after parts.slint, which has the imports.
// Values that run in order (ISO, shutter speed, how many) are dials, named choices are tiles, and both sit side by side as far as the
// card is wide, laid out by the plugin (where each goes when three, two or one fit in a line, on a grid of 6 columns).

export struct PhotoTile {
    key: string,
    label: string,
    // "dial" steps along its list, "choice" opens it
    kind: string,
    options: [string],
    tip: string,
    shortcut: string,
    r3: int,
    c3: int,
    w3: int,
    r2: int,
    c2: int,
    w2: int,
}

export component PhotosCard inherits Card {
    // Greyed out until a phone is paired, and gone for a source that isn't a phone or a camera that takes photos
    in property <bool> active: true;
    in property <bool> shown: true;
    in property <string> take-text;
    in property <string> take-tip;
    in property <bool> take-enabled;
    in property <string> open-text;
    in property <string> open-tip;
    in property <bool> open-shown;
    in property <string> status;
    in property <string> status-kind: "status_dim";
    in property <string> info;
    in property <bool> info-shown;
    // The tiles, and where each one is in its list. Apart because the list is only replaced when it changes: replacing it rebuilds
    // every arrow, and a held one would never hear the release.
    in property <[PhotoTile]> tiles;
    in property <[int]> tile-indexes;
    // How many lines the tiles make when three or two fit in one
    in property <int> rows3;
    in property <int> rows2;
    // What a screen reader calls the arrows
    in property <string> previous-label;
    in property <string> next-label;
    in property <int> quality: 95;
    in property <string> quality-text;
    in property <bool> quality-shown;
    in property <string> reset-hint;
    in property <[string]> timer-items: ["", "", ""];
    in property <int> timer-current;
    in property <string> best-name;
    in property <string> best-tip;
    in property <bool> best;
    in property <bool> best-shown;
    in property <string> folder-name;
    in property <string> folder-tip;
    callback take-clicked;
    callback open-clicked;
    callback tile-picked(string, int);
    // One step (-1 or 1) of a dial from a key or the wheel, and an arrow going down (with its way) and coming up
    callback tile-step(string, int);
    callback tile-hold-down(string, int);
    callback tile-hold-up();
    callback quality-moved(float);
    callback timer-picked(int);
    callback best-toggled(bool);
    callback folder-clicked;

    // As many tiles side by side as are 128px wide with 8px between
    property <int> cols: root.width >= 434px ? 3 : root.width >= 298px ? 2 : 1;

    title: @tr("Photos");
    icon: Icons.photo;
    visible: shown;
    opacity: active ? 1 : 0.4;
    enabled: active;

    HorizontalLayout {
        spacing: 8px;
        Button { horizontal-stretch: 1; preferred-width: 1000px; text: take-text; tip: take-tip; role: "primary"; enabled: active && take-enabled; shortcut: "photos.take"; clicked => { root.take-clicked(); } }
        if open-shown: Button { text: open-text; tip: open-tip; clicked => { root.open-clicked(); } }
    }
    if status != "": Rectangle {
        height: 20px;
        shown-status := Text {
            width: parent.width;
            height: parent.height;
            text: status;
            font-family: Theme.font;
            font-size: Theme.body;
            color: Status.color(status-kind);
            vertical-alignment: center;
            overflow: elide;
            if shown-status.preferred-width > shown-status.width: Tooltip { TipBody { says: shown-status.text; } }
        }
        Tooltip { TipBody { says: root.status; } }
    }
    if info-shown: Note { text: info; }
    // Six columns of one width with 8px between, each tile as many of them as the plugin says: spanning grid cells would share a line out
    // by tile rather than by columns taken, so a wide tile and a narrow one in the same line would come out the same width
    grid := Rectangle {
        property <int> rows: root.cols == 3 ? root.rows3 : root.cols == 2 ? root.rows2 : root.tiles.length;
        property <length> column: (self.width - 40px) / 6;
        visible: root.tiles.length > 0;
        height: root.tiles.length > 0 ? grid.rows * 56px - 8px : 0px;
        for tile[j] in root.tiles: Rectangle {
            property <int> line: root.cols == 3 ? tile.r3 : root.cols == 2 ? tile.r2 : j;
            property <int> start: root.cols == 3 ? tile.c3 : root.cols == 2 ? tile.c2 : 0;
            property <int> span: root.cols == 3 ? tile.w3 : root.cols == 2 ? tile.w2 : 6;
            x: start * (grid.column + 8px);
            y: line * 56px;
            width: span * grid.column + (span - 1) * 8px;
            height: 48px;
            if tile.kind == "dial": Stepper {
                width: parent.width;
                caption: tile.label;
                items: tile.options;
                current: root.tile-indexes[j];
                enabled: active;
                tip: tile.tip;
                previous-label: root.previous-label;
                next-label: root.next-label;
                step(by) => { root.tile-step(tile.key, by); }
                hold-down(by) => { root.tile-hold-down(tile.key, by); }
                hold-up => { root.tile-hold-up(); }
                picked(i) => { root.tile-picked(tile.key, i); }
            }
            if tile.kind == "choice": ChoiceField {
                width: parent.width;
                caption: tile.label;
                items: tile.options;
                current: root.tile-indexes[j];
                enabled: active;
                tip: tile.tip;
                shortcut: tile.shortcut;
                picked(i) => { root.tile-picked(tile.key, i); }
            }
        }
    }
    if quality-shown: SliderRow {
        enabled: active;
        label: @tr("Quality");
        minimum: 50;
        maximum: 100;
        value: quality;
        readout: quality-text;
        hue: root.hue;
        has-default: true;
        default-value: 95;
        hint: reset-hint;
        moved(v) => { root.quality-moved(v); }
    }
    if best-shown: SwitchTile {
        enabled: active;
        icon: Icons.sliders;
        text: best-name;
        tip: best-tip;
        hue: root.hue;
        checked: best;
        toggled(v) => { root.best-toggled(v); }
    }
    FormRow {
        label: @tr("Timer");
        ChoiceField {
            compact: true;
            caption: @tr("Timer");
            items: timer-items;
            current: timer-current;
            enabled: active;
            shortcut: "photos.timer";
            picked(i) => { root.timer-picked(i); }
        }
    }
    FormRow {
        label: @tr("Save in");
        Button {
            horizontal-stretch: 1;
            preferred-width: 1000px;
            shrinks: true;
            has-icon: true;
            icon: Icons.pencil;
            text: folder-name;
            tip: folder-tip;
            enabled: active;
            clicked => { root.folder-clicked(); }
        }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
