// The Fun pack card (desktop/telescope/plugins/fun_pack.py). Joined after parts.slint, which has the imports, and vision_status.slint.

export component FunPackCard inherits Card {
    // Greyed out until a phone is paired
    in property <bool> active: true;
    in property <[string]> effect-items: [""];
    in property <int> effect: 0;
    in property <string> hint;
    in property <bool> show-plate;
    in property <string> plate-text;
    in property <bool> plate-enabled: true;
    in property <string> plate-tip;
    in property <bool> show-buttons;
    in property <bool> show-clone;
    in property <string> clone-text;
    in property <bool> clone-enabled: true;
    in property <string> clone-tip;
    in property <bool> show-clean;
    in property <string> clean-tip;
    in property <bool> show-clear;
    in property <bool> clear-enabled: true;
    // The five sliders in the card's order: Edges, Trails, Brightness, Spread, Smear
    in property <[bool]> slider-show: [false, false, false, false, false];
    in property <[float]> slider-min: [0, 1, 1, 5, 0];
    in property <[float]> slider-max: [10, 10, 10, 45, 3];
    in property <[float]> slider-value: [3, 5, 6, 20, 0];
    in property <[float]> slider-default: [3, 5, 6, 20, 0];
    in property <[string]> slider-tips: ["", "", "", "", ""];
    in property <[string]> slider-text: ["3", "5", "6", "20", "0"];
    in property <string> reset-hint;
    in property <string> effect-tip;
    in property <bool> show-direction;
    in property <int> direction: 0;
    in property <string> problem;
    in property <string> vision-text;
    in property <bool> vision-download;
    callback effect-picked(int);
    callback download-clicked;
    callback plate-clicked;
    callback clone-clicked;
    callback clean-clicked;
    callback clear-clicked;
    callback slider-moved(int, float);
    callback direction-picked(int);

    title: @tr("Fun pack");
    icon: Icons.sparkle;
    opacity: active ? 1 : 0.4;
    enabled: active;

    FormRow {
        label: @tr("Effect");
        ChoiceField {
            enabled: active;
            compact: true;
            items: effect-items;
            current: effect;
            caption: @tr("Effect");
            picked(i) => { root.effect-picked(i); }
        }
    }
    if hint != "": Note {
        text: hint;
    }
    if show-plate: HorizontalLayout {
        spacing: 8px;
        Button {
            text: plate-text;
            tip: plate-tip;
            enabled: active && (plate-enabled);
            clicked => { root.plate-clicked(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if show-buttons: HorizontalLayout {
        spacing: 8px;
        if show-clone: Button {
            text: clone-text;
            tip: clone-tip;
            enabled: active && (clone-enabled);
            clicked => { root.clone-clicked(); }
        }
        if show-clean: Button {
            enabled: active;
            text: @tr("Clean up");
            tip: clean-tip;
            clicked => { root.clean-clicked(); }
        }
        if show-clear: Button {
            text: @tr("Clear");
            enabled: active && (clear-enabled);
            clicked => { root.clear-clicked(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    // Hidden rows are left out, not shrunk: a shrunk one still gets the card's spacing
    if slider-show[0]: SliderRow {
        enabled: active;
        label: @tr("Edges");
        tip: slider-tips[0];
        minimum: slider-min[0];
        maximum: slider-max[0];
        value: slider-value[0];
        readout: slider-text[0];
        hue: root.hue;
        has-default: true;
        default-value: slider-default[0];
        hint: root.reset-hint;
        moved(v) => { root.slider-moved(0, v); }
    }
    if slider-show[1]: SliderRow {
        enabled: active;
        label: @tr("Trails");
        tip: slider-tips[1];
        minimum: slider-min[1];
        maximum: slider-max[1];
        value: slider-value[1];
        readout: slider-text[1];
        hue: root.hue;
        has-default: true;
        default-value: slider-default[1];
        hint: root.reset-hint;
        moved(v) => { root.slider-moved(1, v); }
    }
    if slider-show[2]: SliderRow {
        enabled: active;
        label: @tr("Brightness");
        tip: slider-tips[2];
        minimum: slider-min[2];
        maximum: slider-max[2];
        value: slider-value[2];
        readout: slider-text[2];
        hue: root.hue;
        has-default: true;
        default-value: slider-default[2];
        hint: root.reset-hint;
        moved(v) => { root.slider-moved(2, v); }
    }
    if slider-show[3]: SliderRow {
        enabled: active;
        label: @tr("Spread");
        tip: slider-tips[3];
        minimum: slider-min[3];
        maximum: slider-max[3];
        value: slider-value[3];
        readout: slider-text[3];
        hue: root.hue;
        has-default: true;
        default-value: slider-default[3];
        hint: root.reset-hint;
        moved(v) => { root.slider-moved(3, v); }
    }
    if slider-show[4]: SliderRow {
        enabled: active;
        label: @tr("Smear");
        tip: slider-tips[4];
        minimum: slider-min[4];
        maximum: slider-max[4];
        value: slider-value[4];
        readout: slider-text[4];
        hue: root.hue;
        has-default: true;
        default-value: slider-default[4];
        hint: root.reset-hint;
        moved(v) => { root.slider-moved(4, v); }
    }
    if show-direction: FormRow {
        label: @tr("Direction");
        Segmented {
            items: [@tr("Down"), @tr("Across")];
            disabled: [!active, !active];
            has-icons: [false, false];
            icons: [Icons.sparkle, Icons.sparkle];
            label: @tr("Direction");
            current: direction;
            picked(i) => { root.direction-picked(i); }
        }
    }
    if problem != "": Note {
        text: problem;
        kind: "status_warn";
    }
    if vision-text != "": VisionStatus {
        text: vision-text;
        download: vision-download;
        download-clicked => { root.download-clicked(); }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
