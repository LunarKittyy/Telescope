// VisionStatus: why nothing's happening yet, with a Download button when that's why. One line: a short status, and the full reason as its tooltip.
component VisionStatus inherits RailRow {
    in property <string> text;
    in property <bool> download;
    callback download-clicked;
    has-icon: false;
    HorizontalLayout {
        spacing: Theme.u(4);
        StatusLine {
            text: root.download ? @tr("Needs a download") : root.text;
            kind: "status_warn";
            detail: root.download ? root.text : "";
        }
        if download: Button { text: @tr("Download"); clicked => { root.download-clicked(); } }
    }
}
