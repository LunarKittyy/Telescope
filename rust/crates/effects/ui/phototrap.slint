// The Phototrap card. Joined after parts.slint, which has the imports.
// The tally row keeps its place with nothing in it, so a trigger moves nothing.

export component PhototrapCard inherits Card {
    in property <bool> customize-open;
    in property <string> shot-summary;
    in property <[string]> shot-shutter-stops: [@tr("Camera")];
    in property <int> shot-shutter-index;
    in property <bool> shot-shutter-enabled;
    in property <string> shot-shutter-tip;
    in property <[string]> shot-iso-stops: [@tr("Camera")];
    in property <int> shot-iso-index;
    in property <bool> shot-iso-enabled;
    in property <string> shot-iso-tip;
    in property <bool> shot-focus-enabled;
    in property <string> shot-focus-tip;
    in property <float> shot-focus-value;
    in property <bool> shot-focus-unset: true;
    in property <string> shot-focus-readout: @tr("Camera");
    in property <[float]> shot-focus-marks;
    callback customize-toggled(bool);
    callback shot-shutter-picked(int);
    callback shot-iso-picked(int);
    callback shot-focus-moved(float);
    callback shot-focus-reset();
    in property <bool> use-zoom;
    callback use-zoom-toggled(bool);
    in property <bool> active: true;
    idle: !active;
    in property <bool> armed;
    in property <string> switch-name;
    in property <string> switch-help;
    in property <string> status;
    in property <string> status-kind: "status_dim";
    in property <string> tally;
    in property <string> draw-text;
    in property <string> draw-tip;
    in property <bool> draw-enabled: true;
    in property <string> clear-text;
    in property <string> clear-tip;
    in property <bool> clear-enabled;
    in property <int> zone-count;
    in property <int> sensitivity: 5;
    in property <string> sensitivity-text;
    in property <int> count: 3;
    in property <int> count-max: 8;
    in property <string> count-text;
    in property <string> count-tip;
    in property <bool> count-enabled: true;
    in property <int> pause: 10;
    in property <string> pause-text;
    in property <string> folder-text;
    in property <string> folder-tip;
    in property <bool> night;
    in property <bool> night-enabled: true;
    in property <bool> reset-shown;
    in property <string> night-tip;
    callback switch-toggled-by-hand(bool);
    callback draw-clicked;
    callback clear-clicked;
    callback sensitivity-moved(float);
    callback count-moved(float);
    callback pause-moved(float);
    callback night-toggled(bool);
    callback folder-clicked;
    callback reset-clicked;

    title: @tr("Phototrap");
    tip: @tr("Take photos when something moves in the zones you draw on the preview.");
    icon: Icons.eye;
    header-status: status;
    header-status-kind: status-kind == "status_ok" ? "ok" : status-kind == "status_warn" ? "warn" : status-kind == "status_err" ? "err" : "";
    enabled: active;
    has-switch: true;
    switch-enabled: active;
    switch-checked: armed;
    switch-label: switch-name;
    switch-tip: switch-name;
    switch-tip-detail: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }
    has-reset: true;
    reset-lit: reset-shown;
    reset-label: @tr("Reset");
    reset-detail: @tr("Set the photo settings back to default. Your zones aren't reset.");
    reset => { root.reset-clicked(); }

    UnfoldGroup {
        StatusUnfold { text: tally; detail: tally; }
    }
    RailRow {
        icon: Icons.corners;
        label: @tr("Zones");
        hue: root.hue;
        enabled: active;
        changed: zone-count > 0;
        HorizontalLayout {
            spacing: Theme.gap;
            Button { horizontal-stretch: 1; preferred-width: 1000px; text: draw-text; tip: draw-text; tip-detail: draw-tip; hue: root.hue; enabled: active && draw-enabled; clicked => { root.draw-clicked(); } }
            Button { horizontal-stretch: 1; preferred-width: 1000px; text: clear-text; tip: clear-text; tip-detail: clear-tip; hue: root.hue; enabled: active && clear-enabled; clicked => { root.clear-clicked(); } }
        }
    }
    RailSlider {
        icon: Icons.gauge;
        enabled: active;
        label: @tr("Sensitivity");
        tip: @tr("Sensitivity");
        tip-detail: @tr("Higher catches smaller movements and more false alarms.");
        minimum: 1;
        maximum: 10;
        value: sensitivity;
        readout: sensitivity-text;
        hue: root.hue;
        has-default: true;
        default-value: 5;
        moved(v) => { root.sensitivity-moved(v); }
    }
    RailSlider {
        icon: Icons.layers;
        enabled: active && count-enabled;
        label: @tr("Photos");
        tip: @tr("Photos per trigger");
        tip-detail: count-tip;
        minimum: 2;
        maximum: count-max;
        value: count;
        readout: count-text;
        hue: root.hue;
        moved(v) => { root.count-moved(v); }
    }
    RailSlider {
        icon: Icons.timer;
        enabled: active;
        label: @tr("Pause");
        tip: @tr("Pause between triggers");
        tip-detail: @tr("How long to wait after a burst before it can go off again.");
        minimum: 1;
        maximum: 120;
        value: pause;
        readout: pause-text;
        hue: root.hue;
        has-default: true;
        default-value: 10;
        moved(v) => { root.pause-moved(v); }
    }
        UnfoldGroup {
            RailRow {
                icon: Icons.camera;
                label: @tr("Customise camera");
                hue: root.hue;
                enabled: active;
                Rectangle {
                    horizontal-stretch: 1;
                    preferred-width: 1000px;
                    height: max(Theme.row, disclosure.preferred-height);
                    Button {
                        width: parent.width;
                        height: parent.height;
                        shrinks: true;
                        enabled: active;
                        tip: @tr("Customise camera");
                        tip-detail: root.shot-summary;
                        accessible-label: @tr("Customise camera");
                        accessible-value: root.shot-summary;
                        accessible-expandable: true;
                        accessible-expanded: root.customize-open;
                        clicked => { root.customize-toggled(!root.customize-open); }
                    }
                    disclosure := HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: Theme.u(6);
                        padding-right: Theme.u(6);
                        spacing: Theme.gap;
                        Text {
                            text: @tr("Customise camera");
                            font-family: Theme.font;
                            font-size: Theme.body;
                            font-weight: Theme.w-label;
                            color: active ? Theme.ink : Theme.dis;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            min-width: 0px;
                            horizontal-stretch: 1;
                            accessible-role: none;
                        }
                        Text {
                            text: root.shot-summary;
                            font-family: Theme.font;
                            font-size: Theme.body;
                            font-weight: Theme.w-value;
                            color: active ? Theme.ink : Theme.dis;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            wrap: word-wrap;
                            min-width: 0px;
                            horizontal-stretch: 1;
                            accessible-role: none;
                        }
                        Rectangle {
                            width: Theme.u(8);
                            Path {
                                width: Theme.u(8);
                                height: Theme.u(8);
                                y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
                                viewbox-x: Theme.stroke / 2 / 1px;
                                viewbox-y: Theme.stroke / 2 / 1px;
                                viewbox-width: 16 - Theme.stroke / 1px;
                                viewbox-height: 16 - Theme.stroke / 1px;
                                commands: root.customize-open ? "M 4.5 9.5 L 8 6 L 11.5 9.5" : "M 4.5 6.5 L 8 10 L 11.5 6.5";
                                stroke: active ? Theme.ink : Theme.dis;
                                stroke-width: Theme.stroke;
                            }
                        }
                    }
                }
            }
            Unfolding {
                open: root.customize-open;
                ShotControls {
                    hue: root.hue;
                    enabled: active;
                    shutter-stops: root.shot-shutter-stops;
                    shutter-index: root.shot-shutter-index;
                    shutter-enabled: root.shot-shutter-enabled;
                    shutter-tip: root.shot-shutter-tip;
                    iso-stops: root.shot-iso-stops;
                    iso-index: root.shot-iso-index;
                    iso-enabled: root.shot-iso-enabled;
                    iso-tip: root.shot-iso-tip;
                    focus-enabled: root.shot-focus-enabled;
                    focus-tip: root.shot-focus-tip;
                    focus-value: root.shot-focus-value;
                    focus-unset: root.shot-focus-unset;
                    focus-readout: root.shot-focus-readout;
                    focus-marks: root.shot-focus-marks;
                    shutter-picked(i) => { root.shot-shutter-picked(i); }
                    iso-picked(i) => { root.shot-iso-picked(i); }
                    focus-moved(v) => { root.shot-focus-moved(v); }
                    focus-reset => { root.shot-focus-reset(); }
                }
            }
        }
    SwitchRow {
        icon: Icons.zoom;
        label: @tr("Use zoom");
        tip: @tr("Use zoom");
        tip-detail: @tr("Crop the photo to the zoom and position set in Transforms.");
        hue: root.hue;
        enabled: active;
        changed: use-zoom;
        checked: use-zoom;
        toggled(v) => { root.use-zoom-toggled(v); }
    }
    SwitchRow {
        icon: Icons.moon;
        label: @tr("Night");
        tip: @tr("Night");
        tip-detail: night-tip;
        hue: root.hue;
        enabled: active && night-enabled;
        changed: night;
        checked: night;
        toggled(v) => { root.night-toggled(v); }
    }
    RailRow {
        icon: Icons.folder;
        label: @tr("Save in");
        hue: root.hue;
        enabled: active;
        Button {
            horizontal-stretch: 1;
            preferred-width: Theme.u(500);
            shrinks: true;
            text: folder-text;
            tip: @tr("Save in");
            tip-detail: @tr("Where the photos go. Click to open the folder.");
            tip-hint: folder-tip;
            enabled: active;
            clicked => { root.folder-clicked(); }
        }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
