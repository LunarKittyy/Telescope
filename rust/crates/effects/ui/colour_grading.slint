// The Colour grading card. Joined after parts.slint, which has the imports.

// One wheel: its name and readout over the puck's disc, and the master slider under it
component WheelCell inherits VerticalLayout {
    in property <string> name;
    in property <string> wheel-label;
    in property <string> hint;
    in property <string> tip-body;
    in property <string> master-tip;
    in property <string> master-title;
    in property <string> master-shortcut;
    // The setting id of the master slider, for the outline when something outside the window reads or changes it
    in property <string> master-setting;
    // The kit fill of the master slider's track: a ramp for lift, gamma, gain or offset
    in property <string> master-fill: "plain";
    in property <string> readout;
    in property <float> puck-x;
    in property <float> puck-y;
    in property <color> puck-colour: #808080;
    in property <float> master-min;
    in property <float> master-max;
    in property <float> master-value;
    in property <float> master-step: 0.01;
    in property <float> master-default;
    in property <length> wheel-height: Theme.u(72);
    in property <color> hue: Theme.accent;
    in property <bool> enabled: true;
    callback pressed();
    callback dragged(float, float, bool);
    callback released();
    callback reset();
    callback key(string, bool);
    callback master-moved(float);
    spacing: Theme.u(2);
    horizontal-stretch: 1;
    HorizontalLayout {
        Text {
            text: name;
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: Theme.w-label;
            color: enabled ? Theme.ink : Theme.dis;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: readout;
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: Theme.w-value;
            color: enabled ? Theme.ink : Theme.dis;
            vertical-alignment: center;
        }
    }
    ColourWheel {
        height: root.wheel-height;
        puck-x: root.puck-x;
        puck-y: root.puck-y;
        puck-colour: root.puck-colour;
        hue: root.hue;
        label: root.wheel-label;
        spoken: Spoken.wheel(root.puck-x, root.puck-y);
        tip: root.wheel-label;
        tip-detail: root.tip-body;
        tip-hint: root.hint;
        enabled: root.enabled;
        pressed => { root.pressed(); }
        dragged(dx, dy, shift) => { root.dragged(dx, dy, shift); }
        released => { root.released(); }
        reset => { root.reset(); }
        key(k, shift) => { root.key(k, shift); }
    }
    Rectangle {
        height: Theme.u(10);
        Slider {
            width: parent.width;
            height: parent.height;
            row-height: parent.height;
            fill: root.master-fill;
            has-readout: false;
            hue: root.hue;
            label: root.name;
            shortcut: root.master-shortcut;
            setting: root.master-setting;
            minimum: master-min;
            maximum: master-max;
            step: master-step;
            value: master-value;
            has-default: true;
            default-value: master-default;
            tip: root.master-title;
            tip-detail: root.master-tip;
            moved(v) => { root.master-moved(v); }
        }
    }
}

export component ColourGradingCard inherits Card {
    in property <bool> active: true;
    idle: !active;
    // Greyed out until a phone is paired
    in property <bool> on: true;
    in property <string> switch-name;
    in property <string> switch-help;
    in property <bool> compare;
    in property <int> split: 50;
    in property <string> split-text;
    in property <int> page: 0;
    // Where the wheels' pucks are (x and y in the unit circle), what they add and the readouts
    in property <[float]> wheel-x: [0, 0, 0, 0];
    in property <[float]> wheel-y: [0, 0, 0, 0];
    in property <[color]> wheel-colour: [#808080, #808080, #808080, #808080];
    in property <[string]> wheel-labels: ["", "", "", ""];
    in property <[string]> master-tips: ["", "", "", ""];
    in property <[string]> master-labels: ["", "", "", ""];
    in property <string> wheel-tip;
    in property <string> wheel-hint;
    in property <[string]> master-text: ["", "", "", ""];
    in property <[float]> master-min: [0, 0, 0, 0];
    in property <[float]> master-max: [1, 1, 1, 1];
    in property <[float]> master-value: [0, 0, 0, 0];
    in property <[float]> master-step: [0.01, 0.01, 0.01, 0.01];
    in property <[float]> master-default: [0, 0, 1, 0];
    // The sliders under the wheels, in the card's order
    in property <[string]> slider-tips: ["", "", "", "", "", "", "", ""];
    in property <[string]> slider-text: ["", "", "", "", "", "", "", ""];
    in property <[float]> slider-min: [0, 0, 0, 0, 0, 0, 0, 0];
    in property <[float]> slider-max: [1, 1, 1, 1, 1, 1, 1, 1];
    in property <[float]> slider-value: [0, 0, 0, 0, 0, 0, 0, 0];
    in property <[float]> slider-step: [1, 1, 1, 1, 1, 1, 1, 1];
    in property <[float]> slider-default: [0, 0, 1, 0.435, 1, 0, 0, 0];
    // The curve page
    in property <int> curve: 0;
    in property <int> channel: 0;
    in property <string> curve-line;
    in property <[CurvePoint]> curve-points: [{ x: 0, y: 0 }];
    in property <int> curve-picked: -1;
    // The LUT page
    in property <string> lut-text: @tr("No LUT loaded");
    in property <string> lut-path;
    in property <bool> lut-loaded;
    in property <int> strength: 100;
    in property <string> strength-text;
    in property <string> lut-note;
    in property <string> export-note;
    in property <string> export-kind: "dim";
    in property <bool> replace-open;
    // Auto: busy while it looks at the picture
    in property <bool> auto-busy;
    // A stream is there for Auto to look at
    in property <bool> auto-ready: true;
    in property <string> auto-label;
    callback switch-toggled-by-hand(bool);
    callback compare-toggled(bool);
    callback split-moved(float);
    callback page-picked(int);
    callback reset-clicked;
    callback wheel-pressed(int);
    callback wheel-dragged(int, float, float, bool);
    callback wheel-released(int);
    callback wheel-reset(int);
    callback wheel-key(int, string, bool);
    callback master-moved(int, float);
    callback slider-moved(int, float);
    callback curve-picked-by-hand(int);
    callback channel-picked(int);
    callback curve-pressed(float, float, float, float, bool);
    callback curve-moved(float, float, float, float);
    callback curve-released();
    callback curve-double-clicked(float, float, float, float);
    callback curve-key(string, bool);
    callback load-clicked;
    callback clear-clicked;
    callback strength-moved(float);
    callback export-clicked;
    callback replace-answered(bool);
    callback auto-clicked;

    title: @tr("Colour grading");
    tip: @tr("Change the colours of the picture with colour wheels, curves and LUT files.");
    icon: Icons.colour;
    enabled: active;
    // Anything the grade has set off default, which lights the card's Reset
    in property <bool> grade-lit;
    has-reset: true;
    reset-lit: grade-lit;
    reset-label: @tr("Reset grade");
    reset => { root.reset-clicked(); }
    has-switch: true;
    switch-shortcut: "colour_grading.on";
    switch-setting: "colour_grading.on";
    switch-enabled: active;
    switch-checked: on;
    switch-label: switch-name;
    switch-tip: switch-name;
    switch-tip-detail: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }

    UnfoldGroup {
        SwitchRow {
            icon: Icons.compare;
            label: @tr("Compare");
            hue: root.hue;
            enabled: active;
            checked: compare;
            shortcut: "colour_grading.compare";
            tip: @tr("Compare");
            tip-detail: @tr("Show the ungraded picture left of the line on the preview. Apps always get the graded picture.");
            toggled(v) => { root.compare-toggled(v); }
        }
        // A hidden row keeps its height out of the layout with visible and max-height
        Unfolding {
            open: compare;
            RailSlider {
            icon: Icons.split;
            enabled: active;
            label: @tr("Split");
            tip: @tr("Split");
            tip-detail: @tr("Move the line between before and after.");
            minimum: 0;
            maximum: 100;
            value: split;
            readout: split-text;
            hue: root.hue;
            has-default: true;
            default-value: 50;
            moved(v) => { root.split-moved(v); }
        }
        }
    }
    // The pages and Auto on one row. Where the card is too narrow for the pages and Auto's word, Auto is its icon alone, so no page name is ever cut
    header-row := Rectangle {
        height: Theme.row;
        accessible-role: none;
        property <bool> icon-only: self.width < pages.min-width + Theme.u(4) + Theme.u(34);
        HorizontalLayout {
            spacing: Theme.u(4);
            pages := Segmented {
                hue: root.hue;
                margin: 0px;
                items: [@tr("Primaries"), @tr("Curves"), @tr("LUT")];
                disabled: [!active, !active, !active];
                has-icons: [false, false, false];
                icons: [Icons.colour, Icons.colour, Icons.colour];
                label: @tr("Page");
                tips: [@tr("Primaries"), @tr("Curves"), @tr("LUT")];
                tip-details: [@tr("Colour wheels and sliders."), @tr("Brightness, hue and saturation curves."), @tr("Load a LUT file or export the grade.")];
                current: page;
                picked(i) => { root.page-picked(i); }
            }
            // Auto keeps one width whatever it is doing: its answer shows in the icon's colour and the tooltip, never in the label. Without a
            // stream it is dimmed, and its tooltip says why.
            Button {
                width: header-row.icon-only ? Theme.row : self.preferred-width;
                enabled: active && !auto-busy && auto-ready;
                text: header-row.icon-only ? "" : @tr("Auto");
                has-icon: true;
                icon: Icons.sparkle;
                icon-tint: auto-label == "" ? Theme.ink2 : auto-label == @tr("Looks fine") ? Theme.ok : Theme.warn;
                accessible-label: @tr("Auto colour grading");
                tip: auto-busy ? @tr("Analysing the picture") : !auto-ready ? @tr("Auto") : auto-label != "" ? auto-label : @tr("Auto");
                tip-detail: auto-busy ? "" : !auto-ready ? @tr("Start the stream first, so Auto has a picture to look at.") : auto-label != "" ? "" : @tr("Set white balance, brightness, contrast and colour from about a second of the picture. You can still adjust everything on the sliders.");
                clicked => { root.auto-clicked(); }
            }
        }
    }

    // ── Primaries ─────────────────────────────────────────────────────
    PageGroup {
    clip: pg0.moving || pg1.moving || pg2.moving;
    pg0 := Page {
    shown: page == 0;
    lead: 0px;
    VerticalLayout {
        spacing: Theme.u(4);
        padding-top: Theme.u(2);
        // The wheels, two by two: four of them side by side would be too small to set a colour with, and three in a row leaves offset alone
        GridLayout {
            spacing: Theme.u(5);
            for name[i] in [@tr("Lift"), @tr("Gamma"), @tr("Gain"), @tr("Offset")]: WheelCell {
                row: floor(i / 2);
                col: mod(i, 2);
                enabled: active;
                name: name;
                wheel-label: wheel-labels[i];
                hint: root.wheel-hint;
                tip-body: root.wheel-tip;
                master-title: master-labels[i];
                master-tip: master-tips[i];
                master-shortcut: ["colour_grading.lift_master", "colour_grading.gamma_master", "colour_grading.gain_master", "colour_grading.offset_master"][i];
                master-setting: ["colour_grading.masters.lift", "colour_grading.masters.gamma", "colour_grading.masters.gain", "colour_grading.masters.offset"][i];
                master-fill: ["lift", "gamma", "gain", "offset"][i];
                readout: master-text[i];
                puck-x: wheel-x[i];
                puck-y: wheel-y[i];
                puck-colour: wheel-colour[i];
                master-min: master-min[i];
                master-max: master-max[i];
                master-value: master-value[i];
                master-step: master-step[i];
                master-default: master-default[i];
                hue: root.hue;
                pressed => { root.wheel-pressed(i); }
                dragged(dx, dy, s) => { root.wheel-dragged(i, dx, dy, s); }
                released => { root.wheel-released(i); }
                reset => { root.wheel-reset(i); }
                key(k, s) => { root.wheel-key(i, k, s); }
                master-moved(v) => { root.master-moved(i, v); }
            }
        }
        for name[i] in [@tr("Temperature"), @tr("Tint"), @tr("Contrast"), @tr("Pivot"), @tr("Saturation"), @tr("Vibrance"), @tr("Shadows"), @tr("Highlights")]: RailSlider {
            icon: [Icons.thermometer, Icons.tint, Icons.contrast, Icons.pivot, Icons.saturation, Icons.sparkle, Icons.shadows, Icons.sun][i];
            enabled: active;
            label: name;
            tip: name;
            tip-detail: slider-tips[i];
            shortcut: ["colour_grading.temperature", "colour_grading.tint", "colour_grading.contrast", "colour_grading.pivot", "colour_grading.saturation", "colour_grading.vibrance", "colour_grading.shadows", "colour_grading.highlights"][i];
            setting: ["colour_grading.temperature", "colour_grading.tint", "colour_grading.contrast", "colour_grading.pivot", "colour_grading.saturation", "colour_grading.vibrance", "colour_grading.shadows", "colour_grading.highlights"][i];
            minimum: slider-min[i];
            maximum: slider-max[i];
            step: slider-step[i];
            value: slider-value[i];
            readout: slider-text[i];
            hue: root.hue;
            // Each slider's track shows what it does: colours for temperature, tint and saturation, greys or stripes for the tones
            fill: i == 0 || i == 1 || i == 4 ? "gradient" : i == 2 ? "contrast" : i == 3 ? "pivot" : i == 5 ? "vibrance" : i == 6 ? "shadows" : "highlights";
            grad-a: i == 0 ? #5b9ee8 : i == 1 ? #6fc27a : #8d8d8d;
            grad-b: i == 0 ? #c4c4c4 : i == 1 ? #c4c4c4 : #c4a483;
            grad-c: i == 0 ? #ee9d4a : i == 1 ? #d46fc4 : #ee6a3c;
            has-default: true;
            default-value: slider-default[i];
            moved(v) => { root.slider-moved(i, v); }
        }
    }

    }
    // ── Curves ────────────────────────────────────────────────────────
    pg1 := Page {
    shown: page == 1;
    lead: 0px;
    VerticalLayout {
        spacing: Theme.u(4);
        padding-top: Theme.u(2);
        Segmented {
            hue: root.hue;
            margin: 0px;
            items: [@tr("RGB"), @tr("Hue vs sat"), @tr("Hue vs hue")];
            disabled: [!active, !active, !active];
            has-icons: [false, false, false];
            icons: [Icons.colour, Icons.colour, Icons.colour];
            label: @tr("Curve");
            tips: [@tr("RGB"), @tr("Hue vs sat"), @tr("Hue vs hue")];
            current: curve;
            picked(i) => { root.curve-picked-by-hand(i); }
        }
        if curve == 0: Segmented {
            hue: root.hue;
            margin: 0px;
            items: [@tr("All"), @tr("Red"), @tr("Green"), @tr("Blue")];
            disabled: [!active, !active, !active, !active];
            has-icons: [false, false, false, false];
            icons: [Icons.colour, Icons.colour, Icons.colour, Icons.colour];
            label: @tr("Channel");
            tips: [@tr("All"), @tr("Red"), @tr("Green"), @tr("Blue")];
            current: channel;
            picked(i) => { root.channel-picked(i); }
        }
        CurveBox {
            hue-curve: curve != 0;
            line: curve-line;
            points: curve-points;
            picked: curve-picked;
            // The curve is drawn in the channel it edits (all: the ink), or in the Look group's colour for a hue curve
            colour: curve != 0 ? Theme.plugin-hue("look") : channel == 0 ? Theme.ink : channel == 1 ? Theme.err : channel == 2 ? Theme.ok : Theme.plugin-hue("streaming");
            label: @tr("Curve");
            pressed(x, y, w, h, right) => { root.curve-pressed(x, y, w, h, right); }
            moved(x, y, w, h) => { root.curve-moved(x, y, w, h); }
            released => { root.curve-released(); }
            double-clicked(x, y, w, h) => { root.curve-double-clicked(x, y, w, h); }
            key(k, s) => { root.curve-key(k, s); }
        }
    }

    }
    // ── LUT ───────────────────────────────────────────────────────────
    pg2 := Page {
    shown: page == 2;
    lead: 0px;
    VerticalLayout {
        spacing: Theme.u(4);
        padding-top: Theme.u(2);
        UnfoldGroup {
            RailRow {
                icon: Icons.cube;
                label: @tr("LUT");
                hue: root.hue;
                enabled: active;
                changed: lut-loaded;
                HorizontalLayout {
                    spacing: Theme.u(4);
                    // The slot is the LUT: empty until one is loaded, then it reads the file's name
                    PictureField {
                        enabled: active;
                        has-picture: false;
                        set: lut-loaded;
                        empty-icon: Icons.cube;
                        name: lut-text != "" ? lut-text : @tr("Load");
                        problem: lut-note;
                        hue: root.hue;
                        tip: @tr("Load LUT");
                        tip-detail: @tr("Pick a .cube LUT file to apply on top of the grade.");
                        clicked => { root.load-clicked(); }
                    }
                    if lut-loaded: IconButton {
                        raised: true;
                        icon: Icons.x;
                        label: @tr("Remove LUT");
                        tip: @tr("Remove LUT");
                        clicked => { root.clear-clicked(); }
                    }
                    }

            }
            Unfolding {
                open: lut-loaded;
                RailSlider {
                icon: Icons.gauge;
                enabled: active;
                label: @tr("Strength");
                tip: @tr("Strength");
                tip-detail: @tr("How strongly the LUT is applied.");
                shortcut: "colour_grading.lut_strength";
                setting: "colour_grading.lut_strength";
                minimum: 0;
                maximum: 100;
                value: strength;
                readout: strength-text;
                hue: root.hue;
                has-default: true;
                default-value: 100;
                moved(v) => { root.strength-moved(v); }
            }
            }
        }
        UnfoldGroup {
            RailRow {
                icon: Icons.download;
                label: @tr("Export");
                hue: root.hue;
                enabled: active;
                HorizontalLayout {
                    Button {
                        enabled: active;
                        text: @tr("Export grade");
                        tip: @tr("Export grade");
                        tip-detail: @tr("Save the grade and LUT as a .cube file to use in other apps.");
                        clicked => { root.export-clicked(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Unfolding {
                open: export-note != "";
                RailRow {
                has-icon: false;
                StatusLine { text: export-note; kind: "status_" + export-kind; }
            }
            }
            Unfolding {
                open: replace-open;
                HorizontalLayout {
                spacing: Theme.u(4);
                Button { text: @tr("Replace"); clicked => { root.replace-answered(true); } }
                Button { text: @tr("Cancel"); clicked => { root.replace-answered(false); } }
                Rectangle { horizontal-stretch: 1; }
            }
            }
        }
    }
    }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
