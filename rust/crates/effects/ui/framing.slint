// The Auto framing card. Joined after parts.slint and vision_status.slint.

// control_row with slider_row: a slider that stays where the plugin puts it after a drag, and a readout in the card's shared column
component FramingRow inherits FormRow {
    in property <string> tip;
    in property <string> hint;
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    in property <float> default-value;
    in property <string> readout;
    in property <color> hue;
    in property <length> readout-width;
    // The action a key can stand in for: a right-click on it offers a keyboard shortcut
    in property <string> shortcut;
    callback moved(float);
    Rectangle {
        horizontal-stretch: 1;
        Slider {
            tip: root.tip + "\n" + root.hint;
            shortcut: root.shortcut;
            width: parent.width;
            height: parent.height;
            hue: root.hue;
            enabled: root.enabled;
            label: root.label;
            minimum: root.minimum;
            maximum: root.maximum;
            value <=> root.value;
            readout: root.readout;
            readout-width: root.readout-width;
            has-default: true;
            default-value: root.default-value;
            moved(v) => { root.moved(v); }
        }
    }
}

export component FramingCard inherits Card {
    // Greyed out until a phone is paired
    in property <bool> active: true;
    in-out property <bool> on;
    in-out property <bool> hand;
    in-out property <float> framing: 10;
    in-out property <float> speed: 5;
    in-out property <float> room: 2;
    in property <string> framing-text;
    in property <string> speed-text;
    in property <string> room-text;
    in property <string> framing-tip;
    in property <string> speed-tip;
    in property <string> room-tip;
    in property <string> reset-hint;
    in property <string> switch-name;
    in property <string> switch-help;
    in property <string> hand-name;
    // Every word a readout can show, a line each: value_label's fits
    in property <string> fits;
    in property <string> vision-text;
    in property <bool> vision-download;
    callback switch-toggled-by-hand(bool);
    callback framing-moved(float);
    callback speed-moved(float);
    callback room-moved(float);
    callback hand-toggled(bool);
    callback download-clicked;

    title: @tr("Auto framing");
    icon: Icons.framing;
    opacity: active ? 1 : 0.4;
    enabled: active;
    has-switch: true;
    switch-shortcut: "framing.on";
    switch-enabled: active;
    switch-checked <=> root.on;
    switch-label: switch-name;
    switch-tip: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }

    property <length> column: max(56px, ceil(widest.preferred-width / 1px) * 1px + 2px);

    Rectangle {
        height: 36px;
        FramingRow {
            width: parent.width;
            height: parent.height;
            enabled: active;
            label: @tr("Framing");
            minimum: 0;
            maximum: 30;
            value <=> root.framing;
            default-value: 10;
            readout: framing-text;
            readout-width: column;
            tip: framing-tip;
            shortcut: "framing.framing";
            hint: reset-hint;
            hue: root.hue;
            moved(v) => { root.framing-moved(v); }
        }
        // Measures the widest word, out of the card's layout
        widest := Text {
            x: 0px;
            y: 0px;
            opacity: 0;
            text: fits;
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: 600;
            accessible-role: none;
        }
    }
    FramingRow {
        enabled: active;
        label: @tr("Speed");
        minimum: 1;
        maximum: 10;
        value <=> root.speed;
        default-value: 5;
        readout: speed-text;
        readout-width: column;
        tip: speed-tip;
        shortcut: "framing.speed";
        hint: reset-hint;
        hue: root.hue;
        moved(v) => { root.speed-moved(v); }
    }
    FramingRow {
        enabled: active;
        label: @tr("Room to move");
        minimum: 0;
        maximum: 5;
        value <=> root.room;
        default-value: 2;
        readout: room-text;
        readout-width: column;
        tip: room-tip;
        hint: reset-hint;
        hue: root.hue;
        moved(v) => { root.room-moved(v); }
    }
    // Switch("Widen for something in your hand"): the text on the left, the track at the right end, the whole row toggling it
    HorizontalLayout {
        height: 32px;
        spacing: 12px;
        Text {
            text: @tr("Widen for something in your hand");
            font-family: Theme.font;
            font-size: Theme.body;
            color: active ? Theme.text : Theme.text-disabled;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.hand = !root.hand;
                    root.hand-toggled(root.hand);
                }
            }
        }
        Switch {
            enabled: active;
            y: (parent.height - self.height) / 2;
            checked <=> root.hand;
            label: hand-name;
            toggled(v) => { root.hand-toggled(v); }
        }
    }
    if vision-text != "": VisionStatus {
        text: vision-text;
        download: vision-download;
        download-clicked => { root.download-clicked(); }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}
