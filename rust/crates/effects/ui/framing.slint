// The Auto framing card. Joined after parts.slint and vision_status.slint.

export component FramingCard inherits Card {
    in property <bool> active: true;
    idle: !active;
    // Greyed out until a phone is paired
    in-out property <bool> on;
    in-out property <bool> hand;
    in-out property <float> framing: 10;
    in-out property <float> speed: 5;
    in-out property <float> room: 2;
    in property <string> framing-text;
    in property <string> speed-text;
    in property <string> room-text;
    // The bubble of the Framing slider: "picture" while the preview can't show the crop itself, "" otherwise, and the picture in it
    in property <string> framing-peek;
    in property <image> framing-picture;
    // The part of that picture the bubble shows: x, y, width and height as fractions of it (the bubble crops it, nothing is redrawn)
    in property <[float]> framing-clip: [0, 0, 1, 1];
    // Where you are and where the framing is, for the Speed bubble: you, the frame and its two trailing copies (x, y each)
    in property <[float]> speed-dots: [0.5, 0.5, 0.5, 0.5];
    in property <string> framing-tip;
    in property <string> speed-tip;
    in property <string> room-tip;
    in property <string> reset-hint;
    in property <string> switch-name;
    in property <string> switch-help;
    in property <string> hand-name;
    in property <string> hand-detail;
    // Every word a readout can show, a line each: value_label's fits
    in property <string> fits;
    in property <string> vision-text;
    in property <bool> vision-download;
    callback switch-toggled-by-hand(bool);
    callback framing-moved(float);
    callback speed-moved(float);
    callback room-moved(float);
    callback hand-toggled(bool);
    // A bubble came up or went down: the plugin makes pictures and moves dots only while one is up
    callback framing-peek-open(bool);
    callback speed-peek-open(bool);
    callback download-clicked;

    title: @tr("Auto framing");
    tip: @tr("Zoom and pan automatically to keep you in the picture.");
    icon: Icons.framing;
    enabled: active;
    has-switch: true;
    switch-shortcut: "framing.on";
    switch-enabled: active;
    switch-checked <=> root.on;
    switch-label: switch-name;
    switch-tip: switch-name;
    switch-tip-detail: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }

    property <length> column: max(Theme.u(28), ceil(widest.preferred-width / 1px) * 1px + Theme.u(1));

    Rectangle {
        height: Theme.row;
        RailRow {
            width: parent.width;
            height: parent.height;
            icon: Icons.framing;
            label: @tr("Framing");
            tip-detail: framing-tip;
            hue: root.hue;
            enabled: active;
            changed: framing != 10;
            Slider {
                enabled: active;
                label: @tr("Framing");
                tip: @tr("Framing");
                tip-detail: framing-tip;
                tip-hint: reset-hint;
                shortcut: "framing.framing";
                hue: root.hue;
                minimum: 0;
                maximum: 30;
                // Head, chest, waist and the whole body
                marks: [0, 10, 20, 30];
                value <=> root.framing;
                peek: framing-peek;
                peek-picture: framing-picture;
                peek-values: framing-clip;
                peek-changed(o) => { root.framing-peek-open(o); }
                readout: framing-text;
                readout-width: column;
                has-default: true;
                default-value: 10;
                moved(v) => { root.framing-moved(v); }
            }
        }
        // Measures the widest word, out of the card's layout
        widest := Text {
            x: 0px;
            y: 0px;
            width: 0px;
            height: 0px;
            opacity: 0;
            text: fits;
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: 600;
            accessible-role: none;
        }
    }
    RailRow {
        icon: Icons.gauge;
        label: @tr("Speed");
        tip-detail: speed-tip;
        hue: root.hue;
        enabled: active;
        changed: speed != 5;
        Slider {
            enabled: active;
            label: @tr("Speed");
            tip: @tr("Speed");
            tip-detail: speed-tip;
            tip-hint: reset-hint;
            shortcut: "framing.speed";
            hue: root.hue;
            minimum: 1;
            maximum: 10;
            value <=> root.speed;
            peek: "chase";
            peek-values: speed-dots;
            peek-changed(o) => { root.speed-peek-open(o); }
            readout: speed-text;
            readout-width: column;
            has-default: true;
            default-value: 5;
            moved(v) => { root.speed-moved(v); }
        }
    }
    RailRow {
        icon: Icons.room;
        label: @tr("Room to move");
        tip-detail: room-tip;
        hue: root.hue;
        enabled: active;
        changed: room != 2;
        Slider {
            enabled: active;
            label: @tr("Room to move");
            tip: @tr("Room to move");
            tip-detail: room-tip;
            tip-hint: reset-hint;
            hue: root.hue;
            minimum: 0;
            maximum: 5;
            value <=> root.room;
            readout: room-text;
            readout-width: column;
            has-default: true;
            default-value: 2;
            moved(v) => { root.room-moved(v); }
        }
    }
    UnfoldGroup {
        SwitchRow {
            icon: Icons.hand;
            label: hand-name;
            tip: hand-name;
            tip-detail: hand-detail;
            hue: root.hue;
            enabled: active;
            changed: hand;
            checked: root.hand;
            toggled(v) => {
                root.hand = v;
                root.hand-toggled(v);
            }
        }
        VisionStatus {
            text: vision-text;
            download: vision-download;
            download-clicked => { root.download-clicked(); }
        }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}

import { RailRow, Switch } from "@ui-kit/ui-kit.slint";
