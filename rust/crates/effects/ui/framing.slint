// The Auto framing card. Joined after parts.slint and vision_status.slint.

export component FramingCard inherits Card {
    // Greyed out until a phone is paired
    in property <bool> active: true;
    in-out property <bool> on;
    in-out property <bool> hand;
    in-out property <float> framing: 10;
    in-out property <float> speed: 5;
    in-out property <float> room: 2;
    in property <string> framing-text;
    in property <string> speed-text;
    in property <string> room-text;
    in property <string> framing-tip;
    in property <string> speed-tip;
    in property <string> room-tip;
    in property <string> reset-hint;
    in property <string> switch-name;
    in property <string> switch-help;
    in property <string> hand-name;
    // Every word a readout can show, a line each: value_label's fits
    in property <string> fits;
    in property <string> vision-text;
    in property <bool> vision-download;
    callback switch-toggled-by-hand(bool);
    callback framing-moved(float);
    callback speed-moved(float);
    callback room-moved(float);
    callback hand-toggled(bool);
    callback download-clicked;

    title: @tr("Auto framing");
    icon: Icons.framing;
    opacity: active ? 1 : 0.4;
    enabled: active;
    has-switch: true;
    switch-shortcut: "framing.on";
    switch-enabled: active;
    switch-checked <=> root.on;
    switch-label: switch-name;
    switch-tip: switch-help;
    switch-toggled(v) => { root.switch-toggled-by-hand(v); }

    property <length> column: max(Theme.u(28), ceil(widest.preferred-width / 1px) * 1px + 2px);

    Rectangle {
        height: Theme.row;
        RailRow {
            width: parent.width;
            height: parent.height;
            icon: Icons.framing;
            label: @tr("Framing");
            hue: root.hue;
            enabled: active;
            modified: framing != 10;
            Slider {
                enabled: active;
                label: @tr("Framing");
                tip: framing-tip;
                tip-detail: reset-hint;
                shortcut: "framing.framing";
                hue: root.hue;
                minimum: 0;
                maximum: 30;
                // Head, chest, waist and the whole body
                marks: [0, 10, 20, 30];
                value <=> root.framing;
                readout: framing-text;
                readout-width: column;
                has-default: true;
                default-value: 10;
                moved(v) => { root.framing-moved(v); }
            }
        }
        // Measures the widest word, out of the card's layout
        widest := Text {
            x: 0px;
            y: 0px;
            width: 0px;
            height: 0px;
            opacity: 0;
            text: fits;
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: 600;
            accessible-role: none;
        }
    }
    RailRow {
        icon: Icons.gauge;
        label: @tr("Speed");
        hue: root.hue;
        enabled: active;
        modified: speed != 5;
        Slider {
            enabled: active;
            label: @tr("Speed");
            tip: speed-tip;
            tip-detail: reset-hint;
            shortcut: "framing.speed";
            hue: root.hue;
            minimum: 1;
            maximum: 10;
            value <=> root.speed;
            readout: speed-text;
            readout-width: column;
            has-default: true;
            default-value: 5;
            moved(v) => { root.speed-moved(v); }
        }
    }
    RailRow {
        icon: Icons.room;
        label: @tr("Room to move");
        hue: root.hue;
        enabled: active;
        modified: room != 2;
        Slider {
            enabled: active;
            label: @tr("Room to move");
            tip: room-tip;
            tip-detail: reset-hint;
            hue: root.hue;
            minimum: 0;
            maximum: 5;
            value <=> root.room;
            readout: room-text;
            readout-width: column;
            has-default: true;
            default-value: 2;
            moved(v) => { root.room-moved(v); }
        }
    }
    RailRow {
        icon: Icons.hand;
        label: hand-name;
        hue: root.hue;
        enabled: active;
        modified: hand;
        ToggleTile {
            text: @tr("Things in hand");
            name: hand-name;
            tip: hand-name;
            hue: root.hue;
            enabled: active;
            checked: root.hand;
            toggled(v) => {
                root.hand = v;
                root.hand-toggled(v);
            }
        }
    }
    if vision-text != "": VisionStatus {
        text: vision-text;
        download: vision-download;
        download-clicked => { root.download-clicked(); }
    }
    // Nothing to touch until a phone is paired
    blocked: !active;
}

import { RailRow, ToggleTile } from "@ui-kit/ui-kit.slint";
