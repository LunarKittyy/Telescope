// The Webcam card: which webcam streams and how, plus whichever picture settings the camera itself offers, as rows the plugin builds.
// A DSLR's values come as a strip of tiles under its focus buttons instead (aperture and exposure step like a dial). Texts with blanks come filled from Rust.

import { Theme, Icons, Icon, Card, RailRow, Slider, ChoiceField, Segmented, SwitchTile, SectionHeading, Button, Stepper, Jog } from "@ui-kit/ui-kit.slint";

// One row of picture settings: a section heading, an Auto/Manual switch, an on/off tile, a menu or a slider. The strip's tiles are
// rows too, a "stepper" or a "menu" each.
export struct ControlRow {
    name: string,
    label: string,
    kind: string,
    icon: string,
    checked: bool,
    options: [string],
    index: int,
    minimum: float,
    maximum: float,
    step: float,
    position: float,
    // Where a double-click puts the slider back
    reset-to: float,
    tip: string,
    enabled: bool,
}

global Pick {
    public pure function icon(name: string) -> image {
        name == "sun" ? Icons.sun : name == "image" ? Icons.image : name == "focus" ? Icons.focus
            : name == "crop" ? Icons.crop : name == "moon" ? Icons.moon : Icons.sun
    }
    // What a picture setting of the camera is, by its name
    public pure function control(name: string) -> image {
        name == "exposure_auto" ? Icons.exposure : name == "exposure_time" ? Icons.timer : name == "gain" ? Icons.volume
            : name == "brightness" ? Icons.sun : name == "backlight" ? Icons.torch : name == "anti_flicker" ? Icons.bolt
            : name == "white_balance_auto" || name == "white_balance" || name == "dslr_white_balance" ? Icons.thermometer
            : name == "saturation" ? Icons.saturation : name == "hue" ? Icons.colour : name == "contrast" ? Icons.contrast
            : name == "gamma" ? Icons.sliders : name == "sharpness" ? Icons.sharpen
            : name == "focus_auto" || name == "focus" || name == "dslr_focus" ? Icons.focus
            : name == "dslr_aperture" ? Icons.aperture : name == "dslr_exposure_comp" ? Icons.exposure
            : name == "zoom" ? Icons.zoom : name == "pan" || name == "tilt" ? Icons.pan : Icons.sliders
    }
}

export component WebcamCard inherits Card {
    in property <string> status-text;
    in property <string> status-kind: "status_dim";
    in property <string> status-tip;
    in property <[string]> size-items: ["Auto"];
    in-out property <int> size-current;
    in property <bool> size-enabled;
    in property <string> size-tip;
    in property <[string]> fps-items;
    in-out property <int> fps-current;
    in property <bool> fps-enabled;
    in property <[ControlRow]> rows;
    // What each slider row reads out, by row. Apart from rows because rows are replaced whole (and every control in them rebuilt), which would break off a drag in progress.
    in property <[string]> readouts;
    // The strip of a DSLR's values, and where each one is. Apart for the same reason: a held arrow is rebuilt away if the strip is replaced.
    in property <[ControlRow]> tiles;
    in property <[int]> tile-indexes;
    in property <bool> has-controls;
    has-reset: has-controls;
    reset-lit: has-controls;
    reset-label: @tr("Reset");
    reset-detail: @tr("Set the webcam's picture settings back to default.");
    callback size-picked(int);
    callback fps-picked(int);
    callback control-set(string, float);
    // One step (-1 or 1) of a control from a key, the wheel or a click beside the jog, and an arrow going down (with its way) and coming up
    callback control-step(string, int);
    // The jog's handle at a new place, -1 to 1 (0 once let go)
    callback jog(string, float);
    callback hold-down(string, int);
    callback hold-up();

    // As many tiles side by side as are 112px wide with 8px between, the last one taking the rest of its line when it's alone on it
    property <int> tile-cols: max(1, min(root.tiles.length, floor((root.width - Theme.u(17) + Theme.u(4)) / Theme.u(60))));

    title: @tr("Webcam");
    tip: @tr("Stream from webcams and capture cards plugged into this computer.");
    icon: Icons.video;

    Text {
        height: Theme.u(9);
        text: root.status-text;
        overflow: elide;
        vertical-alignment: center;
        font-family: Theme.font;
        font-size: Theme.body;
        accessible-label: @tr("Camera");
        accessible-description: root.status-tip;
        color: root.status-kind == "status_ok" ? Theme.ok : root.status-kind == "status_warn" ? Theme.warn
            : root.status-kind == "status_err" ? Theme.err : Theme.ink2;
    }
    RailRow {
        icon: Icons.grid;
        label: @tr("Resolution");
        tip-detail: root.size-tip;
        hue: root.hue;
        enabled: root.size-enabled;
        ChoiceField {
            caption: @tr("Resolution");
            compact: true;
            items: root.size-items;
            current <=> root.size-current;
            enabled: root.size-enabled;
            tip: @tr("Resolution");
            tip-detail: root.size-tip;
            picked(i) => { root.size-current = i; root.size-picked(i); }
        }
    }
    RailRow {
        icon: Icons.film;
        label: @tr("Frame rate");
        hue: root.hue;
        enabled: root.fps-enabled;
        ChoiceField {
            caption: @tr("Frame rate");
            tip: @tr("Frame rate");
            compact: true;
            items: root.fps-items;
            current <=> root.fps-current;
            enabled: root.fps-enabled;
            picked(i) => { root.fps-current = i; root.fps-picked(i); }
        }
    }
    for row[i] in root.rows: VerticalLayout {
        SectionHeading {
            visible: row.kind == "heading";
            height: row.kind == "heading" ? self.preferred-height : 0;
            text: row.label;
            icon: Pick.icon(row.icon);
        }
        RailRow {
            visible: row.kind == "auto";
            height: row.kind == "auto" ? self.preferred-height : 0;
            icon: Pick.control(row.name);
            label: row.label;
            tip-detail: @tr("Let the webcam pick or set it yourself.");
            hue: root.hue;
            enabled: row.enabled;
            Segmented {
                hue: root.hue;
                horizontal-stretch: 1;
                items: [@tr("Auto"), @tr("Manual")];
                tips: [@tr("Auto"), @tr("Manual")];
                tip-details: [@tr("Let the webcam pick or set it yourself."), @tr("Let the webcam pick or set it yourself.")];
                current: row.checked ? 0 : 1;
                picked(i) => { root.control-set(row.name, i == 0 ? 1 : 0); }
            }
        }
        // Drag the jog toward Near or Far, the further the faster, and it springs back to stop. Focus runs autofocus once
        HorizontalLayout {
            visible: row.kind == "jog";
            height: row.kind == "jog" ? Theme.u(16) : 0;
            spacing: Theme.u(4);
            Jog {
                near-text: row.options[0];
                far-text: row.options[2];
                label: row.label;
                tip: row.label;
                tip-hint: @tr("Drag to focus, the further the faster.");
                hue: root.hue;
                enabled: row.enabled;
                moved(v) => { root.jog(row.name, v); }
                tapped(by) => { root.control-step(row.name, by); }
            }
            Button {
                text: row.options[1];
                tip: @tr("Focus once");
                enabled: row.enabled;
                clicked => { root.control-set(row.name, 1); }
            }
        }
        SwitchTile {
            visible: row.kind == "switch";
            // Not its preferred-height: that is only the text's, and drops the tile's own 40px
            height: row.kind == "switch" ? Theme.u(20) : 0;
            icon: Pick.icon(row.icon);
            text: row.label;
            tip: row.label;
            tip-detail: row.tip;
            hue: root.hue;
            checked: row.checked;
            enabled: row.enabled;
            toggled(on) => { root.control-set(row.name, on ? 1 : 0); }
        }
        RailRow {
            visible: row.kind == "menu";
            height: row.kind == "menu" ? self.preferred-height : 0;
            icon: Pick.control(row.name);
            label: row.label;
            tip-detail: row.tip;
            hue: root.hue;
            enabled: row.enabled;
            ChoiceField {
                name: row.label;
                tip: row.label;
                tip-detail: row.tip;
                horizontal-stretch: 1;
                items: row.options;
                current: row.index;
                enabled: row.enabled;
                picked(i) => { root.control-set(row.name, i); }
            }
        }
        RailRow {
            visible: row.kind == "slider";
            height: row.kind == "slider" ? self.preferred-height : 0;
            icon: Pick.control(row.name);
            label: row.label;
            tip-detail: row.tip;
            hue: root.hue;
            enabled: row.enabled;
            Slider {
                horizontal-stretch: 1;
                minimum: row.minimum;
                maximum: row.maximum;
                step: row.step;
                value: row.position;
                readout: root.readouts[i];
                label: row.label;
                hue: root.hue;
                enabled: row.enabled;
                has-default: true;
                default-value: row.reset-to;
                tip: row.label;
                tip-detail: row.tip;
                moved(v) => { root.control-set(row.name, v); }
            }
        }
    }
    // A DSLR's values, side by side as far as the card is wide
    GridLayout {
        visible: root.tiles.length > 0;
        height: root.tiles.length > 0 ? self.preferred-height : 0;
        spacing: Theme.u(4);
        for tile[j] in root.tiles: Rectangle {
            row: floor(j / root.tile-cols);
            col: mod(j, root.tile-cols);
            colspan: j == root.tiles.length - 1 && mod(root.tiles.length, root.tile-cols) == 1 ? root.tile-cols : 1;
            height: Theme.u(24);
            if tile.kind == "stepper": Stepper {
                caption: tile.label;
                items: tile.options;
                current: root.tile-indexes[j];
                enabled: tile.enabled;
                tip: tile.label;
                previous-label: @tr("Previous");
                next-label: @tr("Next");
                step(by) => { root.control-step(tile.name, by); }
                hold-down(by) => { root.hold-down(tile.name, by); }
                hold-up => { root.hold-up(); }
                picked(i) => { root.control-set(tile.name, i); }
            }
            if tile.kind == "menu": ChoiceField {
                caption: tile.label;
                items: tile.options;
                current: root.tile-indexes[j];
                follows: true;
                enabled: tile.enabled;
                tip: tile.label;
                tip-detail: tile.tip;
                picked(i) => { root.control-set(tile.name, i); }
            }
        }
    }
}
