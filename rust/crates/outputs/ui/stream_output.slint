// The Stream output card: resolution, frame rate and shape as three
// tiles, Light or Heavy, then JPEG quality or bitrate. Texts with blanks come filled from Rust.

import { Theme, Icons, Card, RailRow, Slider, Segmented, ChoiceField, UnfoldGroup, Unfolding } from "@ui-kit/ui-kit.slint";

export component StreamOutputCard inherits Card {
    in property <bool> active: true;
    idle: !active;
    // dim_until_paired: faded and disabled until there's a phone, and gone for a source that isn't one
    in property <bool> phone-only-hidden;
    in property <[string]> res-items: ["-"];
    in-out property <int> res-current;
    in property <bool> res-enabled;
    in property <[string]> fps-items;
    in-out property <int> fps-current;
    in property <string> fps-tip;
    // Rates past what the lens can do: greyed out and can't be picked
    in property <[bool]> fps-gone;
    in property <[string]> ar-items: ["-"];
    in-out property <int> ar-current;
    in property <bool> ar-enabled;
    in property <bool> h264: true;
    in property <bool> h264-enabled: true;
    in property <string> light-tip;
    in property <string> heavy-tip;
    in-out property <float> quality: 85;
    in property <string> quality-readout;
    in property <string> quality-tip;
    in-out property <float> bitrate: 0;
    in property <string> bitrate-readout;
    in property <string> bitrate-tip;
    // value_label's fits: the column both readouts share, wide enough for "100 Mbps" and the words it can show
    in property <length> readout-width: Theme.u(32);
    callback res-picked(int);
    callback fps-picked(int);
    callback ar-picked(int);
    callback format-picked(bool);
    callback quality-moved(float);
    callback bitrate-moved(float);

    title: @tr("Stream output");
    tip: @tr("The resolution, frame rate and format of the stream.");
    icon: Icons.v-stream;
    enabled: active;
    blocked: !active;
    visible: !phone-only-hidden;

    RailRow {
        icon: Icons.grid;
        label: @tr("Resolution");
        hue: root.hue;
        enabled: active;
        ChoiceField {
            caption: @tr("Resolution");
            tip: @tr("Resolution");
            compact: true;
            shortcut: "stream.resolution";
            items: root.res-items;
            current <=> root.res-current;
            enabled: root.res-enabled;
            picked(i) => { root.res-current = i; root.res-picked(i); }
        }
    }
    RailRow {
        icon: Icons.film;
        label: @tr("Frame rate");
        tip-detail: root.fps-tip;
        hue: root.hue;
        enabled: active;
        ChoiceField {
            caption: @tr("Frame rate");
            compact: true;
            shortcut: "stream.fps";
            items: root.fps-items;
            current <=> root.fps-current;
            gone: root.fps-gone;
            tip: @tr("Frame rate");
            tip-detail: root.fps-tip;
            picked(i) => { root.fps-current = i; root.fps-picked(i); }
        }
    }
    RailRow {
        icon: Icons.aspect;
        label: @tr("Shape");
        hue: root.hue;
        enabled: active;
        ChoiceField {
            caption: @tr("Shape");
            tip: @tr("Shape");
            compact: true;
            shortcut: "stream.aspect_ratio";
            items: root.ar-items;
            current <=> root.ar-current;
            enabled: root.ar-enabled;
            picked(i) => { root.ar-current = i; root.ar-picked(i); }
        }
    }
    UnfoldGroup {
        RailRow {
            icon: Icons.layers;
            label: @tr("Format");
            hue: root.hue;
            enabled: active;
            Segmented {
                hue: root.hue;
                items: [@tr("Light"), @tr("Heavy")];
                disabled: [!active || !h264-enabled, !active];
                has-icons: [true, true];
                icons: [Icons.bolt, Icons.heavy];
                tips: [@tr("Light"), @tr("Heavy")];
                tip-details: [root.light-tip, root.heavy-tip];
                label: @tr("Format");
                shortcut: "stream.format";
                current: h264 ? 0 : 1;
                picked(i) => { root.format-picked(i == 0); }
            }
        }
        Unfolding {
            open: !root.h264;
            RailRow {
                    icon: Icons.gem;
                    label: @tr("JPEG quality");
                    tip-detail: root.quality-tip;
                    hue: root.hue;
                    enabled: active;
                    changed: abs(root.quality - 85) > 0.5;
                    Slider {
                        minimum: 1;
                        maximum: 95;
                        value: root.quality;
                        readout: root.quality-readout;
                        readout-width: root.readout-width;
                        label: @tr("JPEG quality");
                        shortcut: "stream.quality";
                        hue: root.hue;
                        tip: @tr("JPEG quality");
                        tip-detail: root.quality-tip;
                        tip-hint: @tr("Double-click to reset");
                        marks: [85];
                        has-default: true;
                        default-value: 85;
                        moved(v) => { root.quality = v; root.quality-moved(v); }
                    }
                }
        }
        Unfolding {
            open: root.h264;
            RailRow {
                    icon: Icons.gauge;
                    label: @tr("Bitrate");
                    tip-detail: root.bitrate-tip;
                    hue: root.hue;
                    enabled: active;
                    changed: root.bitrate > 0.5;
                    Slider {
                        minimum: 0;
                        maximum: 101;
                        value: root.bitrate;
                        readout: root.bitrate-readout;
                        readout-width: root.readout-width;
                        label: @tr("Bitrate");
                        shortcut: "stream.bitrate";
                        hue: root.hue;
                        tip: @tr("Bitrate");
                        tip-detail: root.bitrate-tip;
                        tip-hint: @tr("Double-click to reset");
                        has-default: true;
                        default-value: 0;
                        moved(v) => { root.bitrate = v; root.bitrate-moved(v); }
                    }
                }
        }
    }
}
