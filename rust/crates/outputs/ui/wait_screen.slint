// The Wait screen plugin: its card on the Streaming tab, with a picture of what
// apps see, the choice of another one and Mirror. The picture is set from Rust (Host::set_ui_image). Texts with blanks come
// filled from Rust.

import { Theme, Icons, Card, Button, SwitchRow, RailRow, Status, UnfoldGroup, Unfolding } from "@ui-kit/ui-kit.slint";

export component WaitScreenSettings inherits Card {
    in property <image> preview;
    // The picture's size in logical px: 384 wide, as tall as the camera's shape makes it
    in property <length> preview-width: 384px;
    in property <length> preview-height: 216px;
    in property <string> picture-note;
    // The sentence behind the line under the picture, and whether it is a problem
    in property <string> picture-detail;
    in property <string> picture-kind: "status_dim";
    in property <bool> default-enabled;
    in-out property <bool> mirror-checked;
    callback choose-clicked;
    callback default-clicked;
    callback mirror-toggled(bool);
    // What the line under the picture said last, kept while it folds away
    property <string> held-note;
    property <string> held-detail;
    property <string> held-kind;
    function keep() {
        if (picture-note != "") {
            held-note = picture-note;
            held-detail = picture-detail;
            held-kind = picture-kind;
        }
    }
    init => { keep(); }
    changed picture-note => { keep(); }
    changed picture-detail => { keep(); }
    changed picture-kind => { keep(); }
    title: @tr("Wait screen");
    tip: @tr("What apps see on the virtual camera while nothing is streaming.");
    icon: Icons.moon;
    // Choosing is the page's one action, in the header like every card's; going back to the built-in picture is its reset
    has-action: true;
    action-icon: Icons.image;
    action-text: @tr("Choose image");
    action-label: @tr("Choose image");
    action => { root.choose-clicked(); }
    has-reset: true;
    reset-lit: default-enabled;
    reset-label: @tr("Use default");
    reset => { root.default-clicked(); }
    UnfoldGroup {
        // As wide as the card's rows and in the same corners as its controls
        Rectangle {
            height: self.width * preview-height / preview-width;
            border-radius: Theme.r-ctl;
            clip: true;
            Image {
                source: preview;
                width: parent.width;
                height: parent.height;
                image-fit: fill;
                image-rendering: smooth;
                accessible-role: image;
                accessible-label: @tr("Wait screen");
            }
        }
        Unfolding {
            open: picture-note != "";
            Status { text: held-note; detail: held-detail; kind: held-kind == "status_err" ? "err" : ""; }
        }
    }
    SwitchRow {
        icon: Icons.mirror;
        label: @tr("Mirror it, for apps that flip the camera");
        tip: @tr("Flip the wait screen so it shows the right way round in apps that mirror the camera");
        hue: root.hue;
        checked <=> root.mirror-checked;
        toggled(on) => { root.mirror-toggled(on); }
    }
}
