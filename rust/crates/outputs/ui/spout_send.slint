// The Spout send card: whether the shown stream's picture is shared with other programs, and how that is going.

import { Theme, Icons, Card, SwitchTile } from "@ui-kit/ui-kit.slint";

export component SpoutSendCard inherits Card {
    in property <string> status-text;
    in property <string> status-kind: "status_dim";
    in-out property <bool> checked;
    in-out property <bool> transparent;
    in property <bool> transparent-shown;
    callback toggled(bool);
    callback transparent-toggled(bool);

    title: @tr("Spout send");
    tip: @tr("Share this stream's picture with other programs on this computer, such as OBS.");
    icon: Icons.monitor;

    SwitchTile {
        icon: Icons.monitor;
        text: @tr("Share this stream");
        tip: @tr("Share this stream's picture with other programs on this computer, such as OBS.");
        hue: root.hue;
        enabled: root.enabled;
        checked <=> root.checked;
        toggled(on) => { root.checked = on; root.toggled(on); }
    }
    if root.transparent-shown: SwitchTile {
        icon: Icons.monitor;
        text: @tr("Transparent background");
        tip: @tr("Cut yourself out and share the picture with a see-through background, for programs that can lay it over something.");
        tip-detail: @tr("It uses the person cut-out of Background or Chroma key and switches Background to Blur while nothing else uses it.");
        hue: root.hue;
        checked <=> root.transparent;
        toggled(on) => { root.transparent = on; root.transparent-toggled(on); }
    }
    Text {
        height: Theme.u(9);
        visible: root.status-text != "";
        text: root.status-text;
        overflow: elide;
        vertical-alignment: center;
        font-family: Theme.font;
        font-size: Theme.body;
        accessible-label: @tr("Status");
        color: root.status-kind == "status_ok" ? Theme.ok : root.status-kind == "status_warn" ? Theme.warn
            : root.status-kind == "status_err" ? Theme.err : Theme.ink2;
    }
}
