// The Browser camera card: the code to scan, what's connected, and the
// size and rate the browser is asked to send.

import { Theme, Icons, Icon, IconButton, Card, RailRow, ChoiceField, QrCode, Reveal, Tip } from "@ui-kit/ui-kit.slint";

global Status {
    public pure function color(kind: string) -> color {
        kind == "status_ok" ? Theme.ok : kind == "status_warn" ? Theme.warn : kind == "status_err" ? Theme.err
            : kind == "status_dim" ? Theme.ink2 : Theme.ink
    }
}

// wrapped_note: a QLabel#dim, so body size
component Note inherits Text {
    in property <string> kind: "status_dim";
    // False takes it out of its layout, height and all
    in property <bool> shown: true;
    visible: shown;
    font-family: Theme.font;
    font-size: Theme.body;
    color: Status.color(kind);
    wrap: word-wrap;
    line-height-factor: Theme.line-factor(self.font-size);
    height: shown ? self.preferred-height : 0px;
}

export component BrowserCameraCard inherits Card {
    // Only while Browser camera or one of its browsers is picked
    in property <bool> shown;
    in property <string> status-text;
    in property <string> status-kind: "status_dim";
    in property <string> status-tip;
    in property <string> list-text;
    in property <bool> show-list;
    in property <string> mic-text;
    in property <string> hint-text;
    in property <string> url;
    // The link without its token, for the row
    in property <string> url-short;
    in property <[int]> qr-cells;
    in property <int> qr-size;
    in property <[string]> addresses;
    in property <int> address-index;
    in property <bool> show-addresses;
    in property <int> size-index: 1;
    in property <int> fps-index: 2;
    // The certificate warning's name and the steps through it, for the tooltip on the code
    in property <string> note-title;
    in property <string> note-text;
    in property <bool> new-link-enabled;
    callback new-link;
    callback address-picked(int);
    callback copy;
    callback size-picked(int);
    callback fps-picked(int);

    // It has the code to scan, and the column can be scrolled away from the top when Browser camera is picked in the header
    changed shown => { reveal = shown; }
    property <bool> reveal;
    Timer {
        interval: 50ms;
        running: reveal;
        triggered => {
            reveal = false;
            Reveal.show(root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        }
    }
    visible: shown;
    height: shown ? self.preferred-height : 0px;
    title: @tr("Browser camera");
    tip: @tr("Stream from any device's web browser by scanning a code.");
    icon: Icons.wifi;
    has-action: true;
    action-icon: Icons.reset;
    action-text: @tr("New link");
    action-tip-detail: @tr("Make a new code. The old code stops working.");
    action-enabled: new-link-enabled;
    action => { root.new-link(); }

    // The code is the card: centred, with what the browser is doing in one quiet line under it. The certificate steps are its tooltip.
    Rectangle {
        height: (qr-size > 0 ? (qr-size + 8) * 5px : Theme.u(56));
        if url != "": QrCode {
            x: (parent.width - self.width) / 2;
            cells: qr-cells;
            size: qr-size;
            cell: 5px;
            label: url;
        }
        if url == "": Rectangle {
            x: (parent.width - self.width) / 2;
            width: Theme.u(56);
            height: Theme.u(56);
            border-radius: Theme.r-ctl;
            background: Theme.trough;
        }
        Tip { says: note-title; detail: note-text; inert: true; }
    }
    HorizontalLayout {
        alignment: center;
        spacing: Theme.u(3);
        shown-status := Text {
            text: status-text;
            font-family: Theme.font;
            font-size: Theme.body;
            font-weight: Theme.w-label;
            color: Status.color(status-kind);
            overflow: elide;
            vertical-alignment: center;
            accessible-description: status-tip;
            Tip { says: status-tip; enabled: status-tip != ""; inert: true; }
        }
        Icon {
            y: (parent.height - self.height) / 2;
            source: Icons.help;
            tint: Theme.faint;
            width: Theme.icon-small;
            height: Theme.icon-small;
            accessible-role: none;
            Tip { says: note-title; detail: note-text; inert: true; }
        }
    }
    Note { text: list-text; shown: show-list; }
    Note { text: mic-text; kind: "status_warn"; shown: mic-text != ""; }
    Note { text: hint-text; kind: "status_warn"; shown: hint-text != ""; }
    // The link and its copy button in one row; the picker stands in for the link's text when this computer has more than one address
    RailRow {
        icon: Icons.link;
        label: @tr("Link");
        hue: root.hue;
        enabled: url != "";
        HorizontalLayout {
            spacing: Theme.gap;
            if !show-addresses: Text {
                text: url-short;
                font-family: Theme.font;
                font-size: Theme.body;
                color: Theme.ink;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if show-addresses: Rectangle {
                horizontal-stretch: 1;
                ChoiceField {
                    width: parent.width;
                    name: @tr("Address");
                    compact: true;
                    items: addresses;
                    tip: @tr("Address");
                    tip-detail: @tr("Which of this computer's addresses the code points to.");
                    current: address-index;
                    picked(i) => { root.address-picked(i); }
                }
            }
            IconButton {
                icon: Icons.copy;
                label: @tr("Copy");
                tip: @tr("Copy");
                tip-detail: @tr("Copy the link to open it on a device that can't scan the code.");
                enabled: url != "";
                clicked => { root.copy(); }
            }
        }
    }
    RailRow {
        icon: Icons.grid;
        label: @tr("Resolution");
        tip-detail: @tr("The size the browser sends. If the camera doesn't support this size the browser sends what the camera can do.");
        hue: root.hue;
        ChoiceField {
            name: @tr("Resolution");
            compact: true;
            items: ["480p", "720p", "1080p"];
            tip: @tr("Resolution");
            tip-detail: @tr("The size the browser sends. If the camera doesn't support this size the browser sends what the camera can do.");
            current: size-index;
            picked(i) => { root.size-picked(i); }
        }
    }
    RailRow {
        icon: Icons.film;
        label: @tr("Frame rate");
        hue: root.hue;
        ChoiceField {
            name: @tr("Frame rate");
            tip: @tr("Frame rate");
            compact: true;
            items: ["15 fps", "24 fps", "30 fps"];
            current: fps-index;
            picked(i) => { root.fps-picked(i); }
        }
    }
}
