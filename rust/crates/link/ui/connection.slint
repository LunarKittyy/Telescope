// The Connection plugin (desktop/telescope/plugins/connection.py): the card, the phone picker in the header, the Add
// phone and Your phones dialogs (as popups) and the UDP row in Settings. Texts with blanks come filled from Rust.

import { Theme, Icons, Icon, Button, Card, FormRow, Segmented, ChoiceField, TextField, Switch, SettingRow, Tag, DialogFrame } from "@ui-kit/ui-kit.slint";

// A plugged-in phone the Add phone dialog can pair over USB.
export struct UsbPick {
    serial: string,
    label: string,
    enabled: bool,
}

// One row of Your phones: a phone, a remembered browser, or this computer.
export struct PhoneRow {
    id: string,
    name: string,
    sub: string,
    renamable: bool,
    // The question Remove asks first, filled in
    confirm: string,
}

global Status {
    public pure function color(kind: string) -> color {
        kind == "status_ok" ? Theme.ok : kind == "status_warn" ? Theme.warn : kind == "status_err" ? Theme.err
            : kind == "status_dim" ? Theme.text-dim : Theme.text
    }

    public pure function icon(name: string) -> image {
        name == "usb" ? Icons.usb : name == "wifi" ? Icons.wifi : Icons.x
    }
}

// wrapped_note: a QLabel#dim, so body size
component Note inherits Text {
    in property <string> kind: "status_dim";
    // False takes it out of its layout, height and all
    in property <bool> shown: true;
    visible: shown;
    font-family: Theme.font;
    font-size: Theme.body;
    color: Status.color(kind);
    wrap: word-wrap;
    // Qt's line pitch, so a wrapped note lines up line by line
    line-height-factor: Theme.line-factor(self.font-size);
    height: shown ? self.preferred-height : 0px;
}

component QrCode inherits Rectangle {
    in property <[int]> cells;
    in property <int> size;
    // QRCodeWidget: 6px modules and a quiet zone of four
    property <length> cell: 6px;
    width: (size + 8) * cell;
    height: (size + 8) * cell;
    background: white;
    accessible-role: image;
    accessible-label: @tr("Pairing code");
    for i in cells: Rectangle {
        x: (mod(i, size) + 4) * cell;
        y: (floor(i / size) + 4) * cell;
        width: cell;
        height: cell;
        background: black;
    }
}

export component ConnectionCard inherits Card {
    // The link block: how the phone is doing, over what, and what to do about it
    in property <string> status-text;
    in property <string> status-kind;
    in property <string> using-text;
    in property <bool> using-shown;
    in property <string> route-icon: "x";
    in property <string> note-text;
    in property <string> note-kind: "status_dim";
    in property <bool> switch-usb-shown;
    in property <bool> update-shown;
    in property <string> update-text;
    in property <bool> update-enabled: true;
    in property <bool> route-shown;
    // 0 Automatic, 1 USB, 2 Wi-Fi
    in-out property <int> route-current;
    callback add-phone;
    callback guide;
    callback switch-usb;
    callback update;
    callback route-picked(int);

    // Add phone
    in property <bool> add-open;
    in property <string> add-subtitle;
    in property <[int]> qr-cells;
    in property <int> qr-size;
    in property <bool> wifi-shown: true;
    in property <string> wifi-text;
    in property <bool> usb-shown: true;
    in property <string> usb-text;
    in property <string> usb-kind: "status_dim";
    in property <string> usb-action;
    in property <[UsbPick]> picks;
    in property <string> result-text;
    in property <bool> paired;
    callback add-closed;
    callback pick(string);
    callback usb-action-clicked;

    title: @tr("Connection");
    icon: Icons.v-connection;
    has-action: true;
    // card_action takes line icons for help and plus
    action-icon: Icons.plus;
    action-text: @tr("Add phone");
    action-label: @tr("Pair a phone over Wi-Fi or USB");
    action => { root.add-phone(); }
    has-extra: true;
    extra-icon: Icons.help;
    extra-label: @tr("Open or close the setup guide: the virtual camera, the phone app and pairing");
    extra-name: @tr("Setup guide");
    extra => { root.guide(); }

    changed add-open => {
        if (self.add-open) {
            add-popup.show();
        } else {
            add-popup.close();
        }
    }

    // QFrame#subsection
    Rectangle {
        background: Theme.surface-raise;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 8px;
        // Qt's 12/8/12/6 margins sit inside the frame's 1px border
        VerticalLayout {
            padding-left: 13px;
            padding-right: 13px;
            padding-top: 9px;
            padding-bottom: 7px;
            spacing: 0px;
            HorizontalLayout {
                spacing: 12px;
                // RoundIcon: the card's hue at 14% under the icon in that hue
                Rectangle {
                    width: 35px;
                    height: 35px;
                    border-radius: 17.5px;
                    background: root.hue.with-alpha(0.14);
                    Icon { source: Status.icon(route-icon); tint: root.hue; width: 17px; height: 17px; accessible-role: none; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    // Qt's two lines come to 36px, a pixel more than the icon
                    min-height: using-shown ? 36px : 0px;
                    Text {
                        text: status-text;
                        font-family: Theme.font;
                        font-size: Theme.start * 1.08;
                        font-weight: 600;
                        color: Status.color(status-kind);
                        overflow: elide;
                    }
                    if using-shown: Text {
                        text: using-text;
                        font-family: Theme.font;
                        font-size: Theme.body;
                        color: Theme.text-dim;
                        overflow: elide;
                    }
                }
            }
            // Not under an `if`: Slint measures wrapped text in a conditional layout as one line, so the box would come up short
            HorizontalLayout {
                property <bool> shown: note-text != "" || switch-usb-shown || update-shown;
                visible: shown;
                max-height: shown ? 100000px : 0px;
                padding-top: shown ? 4px : 0px;
                // Lined up with the status: the 35px icon and the 12px after it
                Rectangle { width: 47px; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding-bottom: parent.shown ? 2px : 0px;
                    Note {
                        text: note-text;
                        kind: note-kind;
                        shown: note-text != "";
                    }
                    if switch-usb-shown: HorizontalLayout {
                        alignment: start;
                        // Qt's 8px from the label's box, which ends a pixel above Slint's
                        padding-top: note-text != "" ? 7px : 0px;
                        // action_button: 160 wide; Qt's push buttons are 32 tall
                        Button {
                            width: 160px;
                            height: 32px;
                            text: @tr("Switch to USB");
                            role: "primary";
                            tip: @tr("The phone was plugged in; reconnect over the cable");
                            clicked => { root.switch-usb(); }
                        }
                    }
                    if update-shown: HorizontalLayout {
                        alignment: start;
                        padding-top: switch-usb-shown ? 8px : note-text != "" ? 7px : 0px;
                        // action_button: 160 wide; Qt's push buttons are 32 tall
                        Button {
                            width: 160px;
                            height: 32px;
                            text: update-text;
                            role: "primary";
                            enabled: update-enabled;
                            clicked => { root.update(); }
                        }
                    }
                }
            }
            // Qt's 4px spacing, a 4px spacer and 4px again above the hairline
            // A note with nothing under it: Qt's label box ends 4px above Slint's there
            if route-shown: VerticalLayout {
                padding-top: note-text != "" && !switch-usb-shown && !update-shown ? 8px : 12px;
                spacing: 4px;
                Rectangle { height: 1px; background: Theme.border; }
                FormRow {
                    label: @tr("Connect via");
                    Segmented {
                        horizontal-stretch: 1;
                        items: [@tr("Auto"), "USB", "Wi-Fi"];
                        icons: [Icons.x, Icons.usb, Icons.wifi];
                        has-icons: [false, true, true];
                        current <=> root.route-current;
                        accessible-description: @tr("Automatic: USB when the phone's plugged in, Wi-Fi otherwise.");
                        picked(i) => { root.route-picked(i); }
                    }
                }
            }
        }
    }

    add-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px;
        y: 0px;
        width: max(root.width, 460px);
        DialogFrame {
            title: @tr("Add a phone");
            subtitle: add-subtitle;
            if qr-size > 0 && !paired: HorizontalLayout {
                alignment: center;
                QrCode { cells: qr-cells; size: qr-size; }
            }
            if wifi-shown && !paired: FormRow {
                label: "Wi-Fi";
                Note { text: wifi-text; horizontal-stretch: 1; }
            }
            if usb-shown && !paired: FormRow {
                label: "USB";
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Note { text: usb-text; kind: usb-kind; }
                    if usb-action != "": HorizontalLayout {
                        alignment: start;
                        Button { text: usb-action; clicked => { root.usb-action-clicked(); } }
                    }
                    for p in picks: HorizontalLayout {
                        alignment: start;
                        Button { text: p.label; enabled: p.enabled; clicked => { root.pick(p.serial); } }
                    }
                }
            }
            if paired: Text {
                text: result-text;
                font-family: Theme.font;
                font-size: Theme.card-title;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
            }
            // dialog_buttons: 4px above, 96px wide
            HorizontalLayout {
                alignment: end;
                padding-top: 4px;
                Button {
                    width: 96px;
                    height: 32px;
                    text: paired ? @tr("Done") : @tr("Cancel");
                    role: paired ? "primary" : "";
                    clicked => { root.add-closed(); }
                }
            }
        }
    }
}

// The phone picker and the Your phones button, next to the window's title.
export component PhonePicker inherits HorizontalLayout {
    in property <[string]> names;
    in-out property <int> current: -1;
    callback picked(int);
    callback manage;

    // Your phones
    in property <bool> phones-open;
    in property <[PhoneRow]> rows;
    in property <string> computer-name;
    callback phones-closed;
    callback rename(string, string);
    callback remove(string);
    callback rename-computer(string);
    callback add-phone;

    property <string> renaming;
    property <string> confirming;
    spacing: 8px;

    changed phones-open => {
        if (self.phones-open) {
            phones-popup.show();
        } else {
            phones-popup.close();
        }
    }

    // The header bar is taller than these; Qt centres them in it
    ChoiceField {
        min-width: 180px;
        height: 34px;
        y: (parent.height - self.height) / 2;
        compact: true;
        bold: true;
        has-icon: true;
        shortcut: "phone.pick";
        icon: Icons.phone;
        icon-tint: Theme.plugin-hue("streaming");
        caption: names.length == 0 ? @tr("No phone yet") : "";
        items: names;
        current <=> root.current;
        accessible-label: @tr("Phone");
        accessible-description: @tr("Which phone to stream from");
        picked(i) => { root.picked(i); }
    }
    Button {
        width: 34px;
        height: 34px;
        y: (parent.height - self.height) / 2;
        role: "quiet";
        padding-x: 0px;
        has-icon: true;
        icon: Icons.v-devices;
        icon-size: 18px;
        icon-tint: Theme.text-dim;
        tip: @tr("Your phones: add, rename, remove");
        accessible-label: @tr("Your phones");
        clicked => { root.manage(); }
    }

    phones-popup := PopupWindow {
        close-policy: no-auto-close;
        width: 460px;
        DialogFrame {
            title: @tr("Your phones");
            subtitle: @tr("Each phone keeps its own camera settings, and so does a browser once you change one. Removing a phone also unpairs it on the phone.");
            if rows.length == 0: Note { text: @tr("No phones yet. Add one to pair it with this computer."); }
            for row in rows: HorizontalLayout {
                spacing: 8px;
                if renaming == row.id: TextField {
                    horizontal-stretch: 1;
                    text: row.name;
                    accepted => {
                        root.rename(row.id, self.text);
                        root.renaming = "";
                    }
                    escape-empty => { root.renaming = ""; }
                }
                if renaming != row.id: VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: row.name; font-family: Theme.font; font-size: Theme.body; color: Theme.text; overflow: elide; }
                    if row.sub != "": Note { text: row.sub; }
                }
                if row.renamable && renaming != row.id: Button {
                    text: @tr("Rename");
                    role: "quiet";
                    clicked => { root.renaming = row.id; }
                }
                if confirming != row.id: Button {
                    text: @tr("Remove");
                    role: "quiet";
                    clicked => { root.confirming = row.id; }
                }
            }
            for row in rows: VerticalLayout {
                visible: confirming == row.id;
                height: confirming == row.id ? self.preferred-height : 0px;
                spacing: 6px;
                Note { text: row.confirm; kind: "status_warn"; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: @tr("Cancel"); clicked => { root.confirming = ""; } }
                    Button {
                        text: @tr("Remove");
                        role: "primary";
                        clicked => {
                            root.remove(row.id);
                            root.confirming = "";
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            FormRow {
                label: @tr("This computer");
                TextField {
                    horizontal-stretch: 1;
                    text: computer-name;
                    accessible-description: @tr("What phones call this computer");
                    accepted => { root.rename-computer(self.text); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: @tr("Add phone"); has-icon: true; icon: Icons.v-plus; clicked => { root.add-phone(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Close"); clicked => { root.phones-closed(); } }
            }
        }
    }
}

// Settings, Streaming tab: UDP on Wi-Fi.
export component ConnectionSettings inherits Card {
    in property <bool> udp;
    callback udp-toggled(bool);
    title: @tr("Connection");
    icon: Icons.v-connection;
    SettingRow {
        title: @tr("UDP on Wi-Fi");
        sub: @tr("Sends Light over UDP instead of TCP while the phone is on Wi-Fi. It can stutter more than TCP, so try it and see.");
        Tag { text: @tr("Experimental"); }
        Switch {
            checked: udp;
            label: @tr("UDP on Wi-Fi");
            toggled(on) => { root.udp-toggled(on); }
        }
    }
}
