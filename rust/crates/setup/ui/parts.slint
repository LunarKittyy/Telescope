// What this crate's cards are built from. The plugins join this file and their card into one source (Rust's concat!),
// so it holds the only import line.

import { Theme, Icons, Icon, FocusRing, Button, Card, SearchWords, Section, SectionHeading, Switch, SwitchTile, ToggleTile, RailRow, Slider, Segmented, ChoiceField, TextField, NumberField, KeyFocus, Tip, TipBody, Reveal, LinkText, IconButton, SwitchRow, Unfolding, UnfoldGroup, Tone, Status as KitStatus } from "@ui-kit/ui-kit.slint";

global Status {
    public pure function color(kind: string) -> color {
        kind == "status_ok" ? Theme.ok : kind == "status_warn" ? Theme.warn : kind == "status_err" ? Theme.err
            : kind == "status_dim" ? Theme.dim : Theme.ink
    }
}

// wrapped_note: a QLabel#dim with a status colour, body size
component Note inherits Text {
    in property <string> kind: "status_dim";
    font-family: Theme.font;
    font-size: Theme.body;
    color: Status.color(kind);
    wrap: word-wrap;
    line-height-factor: Theme.line-factor(self.font-size);
}

// A line of status that is a row of its own, unfolding in and out with its words (never `if text != ""`), and keeping its last words
// while it shuts. Put it in an UnfoldGroup after the row it hangs from. `text` is a plugin's own line, `kind` its own status kind.
component StatusRow inherits Unfolding {
    in property <string> text;
    in property <string> kind: "status_dim";
    // The sentence that goes with it (a line that can be long gives its words here)
    in property <string> detail;
    property <string> held-text;
    property <string> held-kind;
    property <string> held-detail;
    function keep() {
        if (text != "") {
            held-text = text;
            held-kind = kind;
            held-detail = detail;
        }
    }
    init => { keep(); }
    changed text => { keep(); }
    changed kind => { keep(); }
    changed detail => { keep(); }
    open: text != "";
    RailRow {
        has-icon: false;
        KitStatus {
            text: held-text;
            detail: held-detail;
            kind: held-kind == "status_ok" ? "ok" : held-kind == "status_warn" ? "warn" : held-kind == "status_err" ? "err" : "";
            horizontal: "end";
        }
    }
}

// A command to run by hand, in monospace in a recessed well with a button that copies it. A row that unfolds in and out with the command.
component CommandRow inherits Unfolding {
    in property <string> command;
    callback copy(string);
    property <string> held;
    init => { if (command != "") { held = command; } }
    changed command => { if (command != "") { held = command; } }
    open: command != "";
    RailRow {
        has-icon: false;
        HorizontalLayout {
            spacing: Theme.gap;
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                min-height: Theme.row;
                background: Theme.trough;
                border-radius: Theme.r-ctl;
                accessible-role: text;
                accessible-label: held;
                VerticalLayout {
                    padding: Theme.u(4);
                    Text {
                        text: held;
                        font-family: Theme.mono;
                        font-size: Theme.mono-size;
                        color: Theme.ink;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
            VerticalLayout {
                alignment: start;
                IconButton {
                    icon: Icons.copy;
                    label: @tr("Copy");
                    tip: @tr("Copy");
                    tip-detail: @tr("Copy the command to paste in a terminal.");
                    clicked => { root.copy(root.held); }
                }
            }
        }
    }
}

// A switch with its words before it (common.Switch with text): the whole row toggles it
component LabelledSwitch inherits HorizontalLayout {
    horizontal-stretch: 1;
    in-out property <bool> checked;
    in property <string> text;
    // What it is about, said before its words to a screen reader when the words repeat ("Battery under: Notify me")
    in property <string> within;
    in property <string> tip;
    in property <bool> enabled: true;
    // The choices under a warning read quieter than the warning itself
    in property <bool> dim;
    callback toggled(bool);
    spacing: 8px;
    height: 32px;
    Text {
        horizontal-stretch: 1;
        text: root.text;
        font-family: Theme.font;
        font-size: Theme.body;
        color: !enabled ? Theme.dis : dim ? Theme.ink2 : Theme.ink;
        vertical-alignment: center;
        accessible-role: none;
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                sw.checked = !sw.checked;
                root.toggled(sw.checked);
            }
        }
    }
    sw := Switch {
        y: (parent.height - self.height) / 2;
        checked <=> root.checked;
        enabled: root.enabled;
        label: root.within == "" ? root.text : root.within + ": " + root.text;
        tip: root.tip;
        toggled(on) => { root.toggled(on); }
    }
}
