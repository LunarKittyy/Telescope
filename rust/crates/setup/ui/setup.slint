// Setup's cards in Settings. Joined after parts.slint, which has the
// imports. Texts with blanks, and the ones that change with what the system says, come filled from Rust.

// The cameras Add camera set up, for streaming several cameras at once: there only while there are any, hanging from the row above
component ExtraCameraRows inherits UnfoldGroup {
    in property <color> hue;
    in property <bool> shown;
    in property <string> text;
    in property <string> kind;
    in property <bool> button;
    in property <bool> enabled;
    in property <string> tip;
    callback removed;
    Unfolding {
        open: shown;
        RailRow {
            icon: Icons.camera;
            label: @tr("Extra cameras");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "multiple second cameras add camera several streams remove virtual cameras");
            if button: Button { text: @tr("Remove"); tip: @tr("Remove"); tip-detail: root.tip; enabled: root.enabled; clicked => { root.removed(); } }
        }
    }
    StatusRow { text: shown ? root.text : ""; kind: root.kind; detail: root.text; }
}

// Virtual camera, on Virtual camera & phone: the kernel module on Linux, the driver and adb on Windows, and extra cameras
export component VirtualCameraSettings inherits Card {
    in property <bool> linux: true;
    in property <string> v4l-text;
    in property <string> v4l-kind: "status_dim";
    in property <string> v4l-command;
    in property <string> load-tip;
    in-out property <bool> persist-checked;
    in property <bool> persist-enabled: true;
    in property <string> persist-text;
    in property <string> persist-kind: "status_dim";
    in property <string> persist-command;
    in property <string> persist-tip;
    in property <bool> extras-shown;
    in property <string> extras-text;
    in property <string> extras-kind: "status_dim";
    in property <bool> extras-button;
    in property <bool> extras-enabled;
    in property <string> extras-tip;
    in property <string> uc-text;
    in property <string> uc-kind: "status_dim";
    in property <string> uc-button;
    in property <string> uc-tip;
    in property <bool> uc-primary: true;
    in property <bool> uc-enabled: true;
    in property <string> adb-text;
    in property <string> adb-kind: "status_dim";
    in property <bool> adb-row;
    in property <string> adb-button;
    in property <bool> adb-enabled: true;
    callback check-clicked;
    callback load-clicked;
    callback unload-clicked;
    callback persist-toggled(bool);
    callback extras-clicked;
    callback uc-clicked;
    callback adb-clicked;
    callback own-adb-clicked;
    callback copy(string);

    title: @tr("Virtual camera");
    tip: @tr("Set up the virtual camera that other apps see.");
    keywords: @tr("search" => "obs zoom teams discord webcam driver output device loopback");
    icon: Icons.video;
    hue: Theme.plugin-hue("streaming");

    if linux: UnfoldGroup {
        RailRow {
            icon: Icons.chip;
            label: @tr("Kernel module");
            tip-detail: @tr("Only needed when the status isn't Ready.");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "v4l2loopback linux virtual camera driver load unload check status not ready /dev/video missing fix modprobe");
            HorizontalLayout {
                spacing: Theme.gap;
                alignment: end;
                Button { text: @tr("Check"); clicked => { root.check-clicked(); } }
                Button { text: @tr("Load"); tip: @tr("Load"); tip-detail: load-tip; clicked => { root.load-clicked(); } }
                Button { text: @tr("Unload"); tip: @tr("Unload"); tip-detail: load-tip; clicked => { root.unload-clicked(); } }
            }
        }
        StatusRow { text: v4l-text; kind: v4l-kind; detail: v4l-text; }
        CommandRow { command: v4l-command; copy(c) => { root.copy(c); } }
    }
    if linux: UnfoldGroup {
        SwitchRow {
            icon: Icons.bolt;
            label: @tr("Load when the computer starts");
            tip: @tr("Load when the computer starts");
            tip-detail: root.persist-tip;
            keywords: @tr("search" => "boot startup reboot persist permanent every start modprobe v4l2loopback driver survive restart");
            hue: root.hue;
            checked <=> root.persist-checked;
            enabled: root.persist-enabled;
            toggled(on) => { root.persist-toggled(on); }
        }
        StatusRow { text: persist-text; kind: persist-kind; detail: persist-text; }
        CommandRow { command: persist-command; copy(c) => { root.copy(c); } }
        ExtraCameraRows {
            hue: root.hue;
            shown: extras-shown;
            text: extras-text;
            kind: extras-kind;
            button: extras-button;
            enabled: extras-enabled;
            tip: extras-tip;
            removed => { root.extras-clicked(); }
        }
    }
    if !linux: UnfoldGroup {
        RailRow {
            icon: Icons.chip;
            label: @tr("Driver");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "unitycapture unity video capture windows virtual camera install reinstall rename register missing not showing obs zoom");
            Button { text: uc-button; tip: uc-tip != "" ? @tr("Driver") : ""; tip-detail: uc-tip; role: uc-primary ? "primary" : ""; hue: root.hue; enabled: uc-enabled; clicked => { root.uc-clicked(); } }
        }
        StatusRow { text: uc-text; kind: uc-kind; detail: uc-text; }
    }
    // Not bundled (Google's licence doesn't allow passing it on), so it's fetched from Google when asked, or one got another way is picked
    if !linux: UnfoldGroup {
        RailRow {
            icon: Icons.usb;
            label: "ADB";
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "adb android debug bridge usb pairing download get platform-tools google own cable");
            HorizontalLayout {
                spacing: Theme.gap;
                alignment: end;
                if adb-row: Button {
                    text: adb-button;
                    enabled: adb-enabled;
                    tip: @tr("Download");
                    tip-detail: @tr("Download adb from Google for pairing and installing over USB.");
                    clicked => { root.adb-clicked(); }
                }
                if adb-row: Button {
                    text: @tr("Use my own adb");
                    enabled: adb-enabled;
                    tip: @tr("Use my own");
                    tip-detail: @tr("Pick an adb.exe or platform-tools zip you already have.");
                    clicked => { root.own-adb-clicked(); }
                }
            }
        }
        StatusRow { text: adb-text; kind: adb-kind; detail: adb-text; }
        ExtraCameraRows {
            hue: root.hue;
            shown: extras-shown;
            text: extras-text;
            kind: extras-kind;
            button: extras-button;
            enabled: extras-enabled;
            tip: extras-tip;
            removed => { root.extras-clicked(); }
        }
    }
}

// Video: hardware decoding, power-saving effects, the Zoom slider's reach and the canvas size
export component VideoSettings inherits Card {
    in property <bool> hw-enabled;
    in-out property <bool> hw-checked;
    in property <string> hw-line;
    in-out property <bool> saving-checked;
    in-out property <string> zoom-text: "10×";
    in property <[string]> canvas-items;
    in-out property <int> canvas-current;
    in property <bool> custom-shown;
    in-out property <string> custom-w-text: "1920 px";
    in-out property <string> custom-h-text: "1080 px";
    in property <string> canvas-status;
    in property <string> canvas-status-kind: "status_dim";
    in property <bool> canvas-status-shown;
    in property <bool> apply-enabled: true;
    in property <string> apply-text;
    in property <string> apply-tip;
    in property <string> canvas-command;
    callback hw-toggled(bool);
    callback saving-toggled(bool);
    callback zoom-committed(string);
    callback zoom-step(int);
    callback canvas-picked(int);
    callback custom-committed(string, string);
    callback custom-step(string, int);
    callback apply-clicked;
    callback copy(string);

    title: @tr("Video");
    tip: @tr("Hardware acceleration, power saving, zoom range and the virtual camera's size.");
    keywords: @tr("search" => "picture quality image stream camera output");
    icon: Icons.chip;
    hue: Theme.plugin-hue("streaming");

    UnfoldGroup {
        SwitchRow {
            icon: Icons.chip;
            label: @tr("Hardware acceleration");
            tip: @tr("Hardware acceleration");
            tip-detail: @tr("Decode the Light format on the graphics card from the next stream on. If the card fails the processor takes over until you restart Telescope.");
            keywords: @tr("search" => "hw accel gpu graphics card nvidia cuda amd intel vaapi d3d11 decode decoding h264 faster cpu processor laptop 4k");
            hue: root.hue;
            checked <=> root.hw-checked;
            enabled: root.hw-enabled;
            toggled(on) => { root.hw-toggled(on); }
        }
        StatusRow { text: hw-line; kind: "status_dim"; detail: hw-line; }
    }
    SwitchRow {
        icon: Icons.battery;
        label: @tr("Power-saving effects");
        tip: @tr("Power-saving effects");
        tip-detail: @tr("Use less processor and battery while Background or Auto framing is on. They follow quick movement a little later.");
        keywords: @tr("search" => "battery power energy watts laptop processor cpu usage fan heat slow blur framing mediapipe lighter effects quality");
        hue: root.hue;
        checked <=> root.saving-checked;
        toggled(on) => { root.saving-toggled(on); }
    }
    RailRow {
        icon: Icons.zoom;
        label: @tr("Max zoom");
        tip-detail: @tr("How far the Zoom slider goes. Zoom beyond the phone's own range is cropped on this computer.");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "zoom limit magnify telephoto digital crop 10x 30x slider range");
        // Saved once it's typed (on Enter or when the box is left), not at every digit
        NumberField {
            width: Theme.u(45);
            label: @tr("Max zoom");
            value: root.zoom-text;
            committed(t) => { root.zoom-committed(t); }
            step(d) => { root.zoom-step(-d); }
        }
    }
    UnfoldGroup {
        RailRow {
            icon: Icons.aspect;
            label: @tr("Canvas size");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "resolution output size 1080p 720p 4k portrait landscape aspect ratio custom width height pixels apply reload");
            // The list opens as wide as it needs
            ChoiceField {
                width: Theme.u(130);
                compact: true;
                name: @tr("Canvas size");
                items: root.canvas-items;
                current <=> root.canvas-current;
                picked(i) => { root.canvas-current = i; root.canvas-picked(i); }
            }
        }
        Unfolding {
            open: custom-shown;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.gap;
                    alignment: end;
                    NumberField {
                        width: Theme.u(45);
                        label: @tr("Canvas size");
                        value: root.custom-w-text;
                        committed(text) => { root.custom-committed("w", text); }
                        step(d) => { root.custom-step("w", -d); }
                    }
                    Text { text: "×"; font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; vertical-alignment: center; }
                    NumberField {
                        width: Theme.u(45);
                        label: @tr("Canvas size");
                        value: root.custom-h-text;
                        committed(text) => { root.custom-committed("h", text); }
                        step(d) => { root.custom-step("h", -d); }
                    }
                }
            }
        }
        Unfolding {
            open: true;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.gap;
                    KitStatus {
                        text: canvas-status-shown ? canvas-status : "";
                        detail: canvas-status-shown ? canvas-status : "";
                        kind: canvas-status-kind == "status_ok" ? "ok" : canvas-status-kind == "status_warn" ? "warn" : canvas-status-kind == "status_err" ? "err" : "";
                        horizontal: "end";
                    }
                    Button { text: apply-text; tip: apply-text; tip-detail: apply-tip; enabled: apply-enabled; clicked => { root.apply-clicked(); } }
                }
            }
        }
        CommandRow { command: canvas-command; copy(c) => { root.copy(c); } }
    }
}

// Microphone, on Audio: the Gain slider's reach and the limiter
export component MicrophoneLimits inherits Card {
    in property <string> card-group: "sound";
    in property <[string]> gain-items;
    in-out property <int> gain-current;
    in-out property <bool> limiter-checked: true;
    callback gain-picked(int);
    callback limiter-toggled(bool);

    title: @tr("Microphone");
    tip: @tr("Maximum microphone gain and the limiter.");
    keywords: @tr("search" => "audio sound voice input volume");
    icon: Icons.mic;
    hue: Theme.plugin-hue("sound");

    RailRow {
        icon: Icons.volume;
        label: @tr("Max gain");
        tip-detail: @tr("How far the Gain slider goes. Less range gives finer steps and more range helps a quiet phone.");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "microphone volume loudness boost amplify quiet decibel db slider range");
        Segmented {
            width: Theme.u(130);
            hue: root.hue;
            label: @tr("Max gain");
            items: root.gain-items;
            current <=> root.gain-current;
            picked(i) => { root.gain-current = i; root.gain-picked(i); }
        }
    }
    SwitchRow {
        icon: Icons.level;
        label: @tr("Limiter");
        tip: @tr("Limiter");
        tip-detail: @tr("Keeps loud sounds from clipping");
        keywords: @tr("search" => "microphone audio compressor distortion clipping loud peaks sound");
        hue: root.hue;
        checked <=> root.limiter-checked;
        toggled(on) => { root.limiter-toggled(on); }
    }
}

// Phone app, on Virtual camera & phone: installing Telescope.apk over USB
export component PhoneAppSettings inherits Card {
    in property <string> apk-button;
    in property <string> apk-text;
    in property <string> apk-kind: "status_dim";
    in property <bool> apk-enabled: true;
    in property <bool> pick-shown;
    in property <[string]> pick-items;
    in-out property <int> pick-current;
    callback apk-clicked;
    callback pick-done(int);
    callback pick-cancelled;

    title: @tr("Phone app");
    tip: @tr("Install the Telescope app on a phone over USB.");
    keywords: @tr("search" => "android install apk usb");
    icon: Icons.phone;
    hue: Theme.plugin-hue("streaming");

    UnfoldGroup {
        RailRow {
            icon: Icons.phone;
            label: "Telescope.apk";
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "phone app install usb android reinstall newer version sideload cable");
            Button {
                text: apk-button;
                has-icon: true;
                icon: Icons.download;
                icon-tint: Theme.ink2;
                enabled: apk-enabled;
                tip: @tr("Install");
                tip-detail: @tr("Install the Telescope.apk that came with this app, or an APK you pick, on a phone plugged in over USB.");
                clicked => { root.apk-clicked(); }
            }
        }
        StatusRow { text: apk-text; kind: apk-kind; detail: apk-text; }
        // QInputDialog.getItem's question, asked in the card
        Unfolding {
            open: pick-shown;
            RailRow {
                icon: Icons.usb;
                label: @tr("Select device");
                tip-detail: @tr("More than one phone is plugged in. Which one should get the app?");
                named: true;
                hue: root.hue;
                ChoiceField {
                    width: Theme.u(130);
                    compact: true;
                    name: @tr("Select device");
                    items: root.pick-items;
                    current <=> root.pick-current;
                    picked(i) => { root.pick-current = i; }
                }
            }
        }
        Unfolding {
            open: pick-shown;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.gap;
                    alignment: end;
                    Button { text: @tr("Cancel"); clicked => { root.pick-cancelled(); } }
                    Button { text: @tr("OK"); role: "primary"; hue: root.hue; clicked => { root.pick-done(root.pick-current); } }
                }
            }
        }
    }
}

// Look, on General: card colours and the language
export component LookSettings inherits Card {
    in-out property <int> hues-current;
    in-out property <int> theme-current;
    in property <[string]> lang-items;
    in-out property <int> lang-current;
    in property <bool> lang-restart;
    in property <string> help-text;
    callback hues-picked(int);
    callback theme-picked(int);
    callback lang-picked(int);
    callback restart-clicked;
    callback translate-clicked;

    title: @tr("Look");
    tip: @tr("Theme, card colours and language.");
    keywords: @tr("search" => "appearance theme colors colours interface");
    icon: Icons.sliders;
    hue: Theme.plugin-hue("streaming");
    // Fixing a text or adding a language is the card's one action
    has-action: true;
    action-icon: Icons.pencil;
    action-text: @tr("Help translate");
    action-label: @tr("Help translate");
    action-tip-detail: @tr("Fix a text or add a language, no coding needed.");
    action => { root.translate-clicked(); }

    RailRow {
        icon: Icons.sun;
        label: @tr("Theme");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "theme classic dark blue appearance look old");
        Segmented {
            width: Theme.u(90);
            hue: root.hue;
            label: @tr("Theme");
            items: [@tr("Default"), @tr("Classic")];
            current <=> root.theme-current;
            picked(i) => { root.theme-current = i; root.theme-picked(i); }
        }
    }
    RailRow {
        icon: Icons.colour;
        label: @tr("Card colours");
        tip: @tr("Card colours");
        tip-detail: @tr("Give every card in the main window a different colour.");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "color colour theme appearance monochrome colourful purple hue accent look");
        Segmented {
            width: Theme.u(110);
            hue: root.hue;
            label: @tr("Card colours");
            items: [@tr("Colourful"), @tr("Monochrome")];
            current <=> root.hues-current;
            picked(i) => { root.hues-current = i; root.hues-picked(i); }
        }
    }
    UnfoldGroup {
        RailRow {
            icon: Icons.chat;
            label: @tr("Language");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "language translation translate locale");
            ChoiceField {
                width: Theme.u(130);
                compact: true;
                name: @tr("Language");
                items: root.lang-items;
                current <=> root.lang-current;
                picked(i) => { root.lang-current = i; root.lang-picked(i); }
            }
        }
        // Switching asks for a restart: the word and its button, there only after another language is picked
        Unfolding {
            open: lang-restart;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.gap;
                    KitStatus { text: @tr("Restart to switch"); detail: @tr("Restart Telescope to switch to it."); kind: "warn"; horizontal: "end"; }
                    Button {
                        text: @tr("Restart now");
                        has-icon: true;
                        icon: Icons.reset;
                        icon-tint: Theme.ink2;
                        tip: @tr("Restart");
                        tip-detail: @tr("Restart Telescope in the language you picked.");
                        clicked => { root.restart-clicked(); }
                    }
                }
            }
        }
    }
}

// About, on Updates & About: who made it, the log, diagnostics, bug reports and where to find help. One row each, the button at the right edge
export component AboutSettings inherits Card {
    in property <string> version-text;
    in property <string> made-before;
    in property <string> made-link;
    in property <string> made-after;
    in property <string> diag-text;
    in property <bool> log-shown;
    callback author-clicked;
    callback diag-clicked;
    callback bug-clicked;
    callback log-clicked;
    callback help-clicked;

    title: @tr("About");
    tip: @tr("Version, log, bug reports and help.");
    keywords: @tr("search" => "info version help support credits");
    icon: Icons.help;
    hue: Theme.plugin-hue("extras");

    RailRow {
        icon: Icons.person;
        label: "Telescope";
        tip: "Telescope";
        tip-detail: version-text;
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "about author credits made by version number build");
        HorizontalLayout {
            spacing: 0px;
            alignment: end;
            Text { text: made-before; font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                LinkText { text: made-link; url: ""; font-size: Theme.body; horizontal-stretch: 0; opened(u) => { root.author-clicked(); } }
            }
            if made-after != "": Text { text: made-after; font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; vertical-alignment: center; }
        }
    }
    if log-shown: RailRow {
        icon: Icons.notes;
        label: @tr("Log");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "bug report diagnostics logs debug support problem issue help copy log file");
        Button { text: @tr("Open"); tip: @tr("Open log"); tip-detail: @tr("Open the full log. It's kept in the temp folder, which the system clears."); clicked => { root.log-clicked(); } }
    }
    RailRow {
        icon: Icons.copy;
        label: @tr("Diagnostics");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "bug report diagnostics logs debug support problem issue help copy log file");
        Button {
            text: diag-text;
            tip: @tr("Copy diagnostics");
            tip-detail: @tr("Copy info for a bug report without pairing tokens, addresses or file paths.");
            clicked => { root.diag-clicked(); }
        }
    }
    RailRow {
        icon: Icons.alert;
        label: @tr("Bug reports");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "bug report diagnostics logs debug support problem issue help copy log file");
        Button { text: @tr("Report a bug"); tip: @tr("Report a bug"); tip-detail: @tr("Copy the diagnostics and open the bug form on GitHub."); clicked => { root.bug-clicked(); } }
    }
    RailRow {
        icon: Icons.help;
        label: @tr("Need help?");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "help support troubleshooting question faq problem not working stuck ask");
        Button { text: @tr("Troubleshooting"); clicked => { root.help-clicked(); } }
    }
}
