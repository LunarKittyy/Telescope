// Setup's cards in Settings. Joined after parts.slint, which has the
// imports. Texts with blanks, and the ones that change with what the system says, come filled from Rust.

// The cameras Add camera set up, for streaming several cameras at once: there only while there are any, hanging from the row above
component ExtraCameraRows inherits UnfoldGroup {
    in property <color> hue;
    in property <bool> shown;
    in property <string> text;
    in property <string> kind;
    in property <bool> button;
    in property <bool> enabled;
    in property <string> tip;
    callback removed;
    Unfolding {
        open: shown;
        RailRow {
            icon: Icons.camera;
            label: @tr("Extra cameras");
            tip: @tr("Add more virtual cameras to stream several cameras at the same time");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "multiple second cameras add camera several streams remove virtual cameras");
            if button: Button { text: @tr("Remove"); tip: @tr("Remove"); tip-detail: root.tip; enabled: root.enabled; clicked => { root.removed(); } }
        }
    }
    StatusRow { text: shown ? root.text : ""; kind: root.kind; detail: root.text; }
}

// Virtual camera, on Virtual camera & phone: the kernel module on Linux, the driver and adb on Windows, and extra cameras
export component VirtualCameraSettings inherits Card {
    in property <bool> linux: true;
    in property <string> v4l-text;
    in property <string> v4l-kind: "status_dim";
    in property <string> v4l-command;
    in property <string> load-tip;
    in-out property <bool> persist-checked;
    in property <bool> persist-enabled: true;
    in property <string> persist-text;
    in property <string> persist-kind: "status_dim";
    in property <string> persist-command;
    in property <string> persist-tip;
    in property <bool> extras-shown;
    in property <string> extras-text;
    in property <string> extras-kind: "status_dim";
    in property <bool> extras-button;
    in property <bool> extras-enabled;
    in property <string> extras-tip;
    in property <string> uc-text;
    in property <string> uc-kind: "status_dim";
    in property <string> uc-button;
    in property <string> uc-tip;
    in property <bool> uc-primary: true;
    in property <bool> uc-enabled: true;
    in property <string> adb-text;
    in property <string> adb-kind: "status_dim";
    in property <bool> adb-row;
    in property <string> adb-button;
    in property <bool> adb-enabled: true;
    callback check-clicked;
    callback load-clicked;
    callback unload-clicked;
    callback persist-toggled(bool);
    callback extras-clicked;
    callback uc-clicked;
    callback adb-clicked;
    callback own-adb-clicked;
    callback copy(string);

    title: @tr("Virtual camera");
    tip: @tr("Set up the virtual camera that other apps see.");
    keywords: @tr("search" => "obs zoom teams discord webcam driver output device loopback");
    icon: Icons.video;
    hue: Theme.plugin-hue("streaming");

    if linux: UnfoldGroup {
        RailRow {
            icon: Icons.chip;
            label: @tr("Kernel module");
            tip: @tr("The Linux part that provides the virtual camera");
            tip-detail: @tr("Only needed when the status isn't Ready.");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "v4l2loopback linux virtual camera driver load unload check status not ready /dev/video missing fix modprobe");
            HorizontalLayout {
                spacing: Theme.gap;
                alignment: end;
                Button { text: @tr("Check"); shrinks: true; clicked => { root.check-clicked(); } }
                Button { text: @tr("Load"); shrinks: true; tip: @tr("Load"); tip-detail: load-tip; clicked => { root.load-clicked(); } }
                Button { text: @tr("Unload"); shrinks: true; tip: @tr("Unload"); tip-detail: load-tip; clicked => { root.unload-clicked(); } }
            }
        }
        StatusRow { text: v4l-text; kind: v4l-kind; detail: v4l-text; }
        CommandRow { command: v4l-command; copy(c) => { root.copy(c); } }
    }
    if linux: UnfoldGroup {
        SwitchRow {
            icon: Icons.power;
            label: @tr("Load when the computer starts");
            tip: @tr("Load when the computer starts");
            tip-detail: root.persist-tip;
            keywords: @tr("search" => "boot startup reboot persist permanent every start modprobe v4l2loopback driver survive restart");
            hue: root.hue;
            checked <=> root.persist-checked;
            enabled: root.persist-enabled;
            toggled(on) => { root.persist-toggled(on); }
        }
        StatusRow { text: persist-text; kind: persist-kind; detail: persist-text; }
        CommandRow { command: persist-command; copy(c) => { root.copy(c); } }
        ExtraCameraRows {
            hue: root.hue;
            shown: extras-shown;
            text: extras-text;
            kind: extras-kind;
            button: extras-button;
            enabled: extras-enabled;
            tip: extras-tip;
            removed => { root.extras-clicked(); }
        }
    }
    if !linux: UnfoldGroup {
        RailRow {
            icon: Icons.chip;
            label: @tr("Driver");
            tip: @tr("The Windows part that provides the virtual camera");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "unitycapture unity video capture windows virtual camera install reinstall rename register missing not showing obs zoom");
            Button { text: uc-button; tip: uc-tip != "" ? @tr("Driver") : ""; tip-detail: uc-tip; role: uc-primary ? "primary" : ""; hue: root.hue; enabled: uc-enabled; clicked => { root.uc-clicked(); } }
        }
        StatusRow { text: uc-text; kind: uc-kind; detail: uc-text; }
    }
    // Not bundled (Google's licence doesn't allow passing it on), so it's fetched from Google when asked, or one got another way is picked
    if !linux: UnfoldGroup {
        RailRow {
            icon: Icons.usb;
            label: "ADB";
            tip: @tr("Android's tool for talking to a phone over USB");
            tip-detail: @tr("Google's licence doesn't allow bundling adb. Download it or pick a copy you already have.");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "adb android debug bridge usb pairing download get platform-tools google own cable");
            HorizontalLayout {
                spacing: Theme.gap;
                alignment: end;
                if adb-row: Button {
                    text: adb-button;
                    enabled: adb-enabled;
                    tip: @tr("Download");
                    tip-detail: @tr("Download adb from Google for pairing and installing over USB.");
                    clicked => { root.adb-clicked(); }
                }
                if adb-row: Button {
                    text: @tr("Use my own adb");
                    enabled: adb-enabled;
                    tip: @tr("Use my own");
                    tip-detail: @tr("Pick an adb.exe or platform-tools zip you already have.");
                    clicked => { root.own-adb-clicked(); }
                }
            }
        }
        StatusRow { text: adb-text; kind: adb-kind; detail: adb-text; }
        ExtraCameraRows {
            hue: root.hue;
            shown: extras-shown;
            text: extras-text;
            kind: extras-kind;
            button: extras-button;
            enabled: extras-enabled;
            tip: extras-tip;
            removed => { root.extras-clicked(); }
        }
    }
}

// Video: hardware decoding, power-saving effects, the Zoom slider's reach and the canvas size
export component VideoSettings inherits Card {
    in property <bool> reset-shown;
    callback reset-clicked;
    in property <bool> hw-enabled;
    in-out property <bool> hw-checked;
    in property <string> hw-line;
    in property <[string]> gpu-items;
    in-out property <int> gpu-current;
    in property <bool> gpu-restart;
    in property <string> gpu-line;
    in property <bool> mode-shown;
    in property <[string]> mode-items;
    in-out property <int> mode-current;
    in property <bool> mode-locked;
    in-out property <bool> saving-checked;
    in-out property <string> zoom-text: "10×";
    in property <[string]> canvas-items;
    in-out property <int> canvas-current;
    in property <bool> custom-shown;
    in-out property <string> custom-w-text: "1920 px";
    in-out property <string> custom-h-text: "1080 px";
    in property <string> canvas-status;
    in property <string> canvas-status-kind: "status_dim";
    in property <bool> canvas-status-shown;
    in property <bool> apply-enabled: true;
    in property <string> apply-text;
    in property <string> apply-tip;
    in property <string> canvas-command;
    callback hw-toggled(bool);
    callback gpu-picked(int, string);
    callback mode-picked(int);
    callback restart-clicked;
    callback saving-toggled(bool);
    callback zoom-committed(string);
    callback zoom-step(int);
    callback canvas-picked(int);
    callback custom-committed(string, string);
    callback custom-step(string, int);
    callback apply-clicked;
    callback copy(string);

    title: @tr("Video");
    tip: @tr("Hardware acceleration, power saving, zoom range and the virtual camera's size.");
    has-reset: true;
    reset-lit: reset-shown;
    reset-label: @tr("Reset");
    reset-detail: @tr("Set hardware acceleration, power saving, zoom range and canvas size back to default. The canvas size changes when you press Apply.");
    reset => { root.reset-clicked(); }
    keywords: @tr("search" => "picture quality image stream camera output");
    icon: Icons.chip;
    hue: Theme.plugin-hue("streaming");

    UnfoldGroup {
        SwitchRow {
            icon: Icons.chip;
            label: @tr("Hardware acceleration");
            tip: @tr("Hardware acceleration");
            tip-detail: @tr("Decode the Light format on the graphics card from the next stream on. The processor is used until you restart Telescope if the graphics card fails.");
            keywords: @tr("search" => "hw accel gpu graphics card nvidia cuda amd intel vaapi d3d11 decode decoding h264 faster cpu processor laptop 4k");
            hue: root.hue;
            checked <=> root.hw-checked;
            enabled: root.hw-enabled;
            toggled(on) => { root.hw-toggled(on); }
        }
        StatusRow { text: hw-line; kind: "status_dim"; detail: hw-line; }
    }
    UnfoldGroup {
        RailRow {
            icon: Icons.chip;
            label: @tr("Graphics card");
            tip: @tr("Which graphics card Telescope uses");
            tip-detail: @tr("Automatic follows what your system picks. Choose a card here if the system picks the wrong one. A change applies after a restart.");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "gpu graphics card nvidia amd intel integrated discrete laptop hybrid switch choose select");
            ChoiceField {
                preferred-width: Theme.control-w;
                min-width: Theme.control-min;
                max-width: Theme.control-w;
                compact: true;
                name: @tr("Graphics card");
                items: root.gpu-items;
                current <=> root.gpu-current;
                picked(i) => { root.gpu-current = i; root.gpu-picked(i, root.gpu-items[i]); }
            }
        }
        Unfolding {
            open: mode-shown;
            RailRow {
                icon: Icons.gauge;
                label: @tr("Priority");
                tip: @tr("What the graphics should save");
                tip-detail: mode-locked ? @tr("This choice has no effect on Intel graphics.") : @tr("Less processor uses DirectX 12 and does more of the work on the graphics card, roughly halving processor use, for about 150 MB more memory. Less memory uses Vulkan and keeps more of the work on the processor. A change applies after a restart.");
                named: true;
                hue: root.hue;
                enabled: !mode-locked;
                keywords: @tr("search" => "directx dx12 vulkan graphics api processor cpu memory ram usage low laptop 8 gb windows");
                ChoiceField {
                    preferred-width: Theme.control-w;
                    min-width: Theme.control-min;
                    max-width: Theme.control-w;
                    compact: true;
                    name: @tr("Graphics priority");
                    items: root.mode-items;
                    current <=> root.mode-current;
                    picked(i) => { root.mode-current = i; root.mode-picked(i); }
                }
            }
        }
        StatusRow { text: gpu-line; kind: "status_dim"; detail: gpu-line; }
        Unfolding {
            open: gpu-restart;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.gap;
                    KitStatus { text: @tr("Restart to switch"); detail: @tr("Restart Telescope to use the graphics choices you made."); kind: "warn"; horizontal: "end"; }
                    Button {
                        text: @tr("Restart now");
                        has-icon: true;
                        icon: Icons.repeat;
                        icon-tint: Theme.ink2;
                        tip: @tr("Restart");
                        tip-detail: @tr("Restart Telescope with the graphics choices you made.");
                        clicked => { root.restart-clicked(); }
                    }
                }
            }
        }
    }
    SwitchRow {
        icon: Icons.battery;
        label: @tr("Power-saving effects");
        tip: @tr("Power-saving effects");
        tip-detail: @tr("Use less processor and battery while Background or Auto framing is on. Both react to quick movement a little later.");
        keywords: @tr("search" => "battery power energy watts laptop processor cpu usage fan heat slow blur framing mediapipe lighter effects quality");
        hue: root.hue;
        checked <=> root.saving-checked;
        toggled(on) => { root.saving-toggled(on); }
    }
    RailRow {
        icon: Icons.zoom;
        label: @tr("Max zoom");
        tip: @tr("How far the Zoom slider goes");
        tip-detail: @tr("Zoom beyond the phone's own range is cropped on this computer.");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "zoom limit magnify telephoto digital crop 10x 30x slider range");
        // Saved once it's typed (on Enter or when the box is left), not at every digit
        NumberField {
            width: Theme.u(45);
            label: @tr("Max zoom");
            value: root.zoom-text;
            committed(t) => { root.zoom-committed(t); }
            step(d) => { root.zoom-step(-d); }
        }
    }
    UnfoldGroup {
        RailRow {
            icon: Icons.aspect;
            label: @tr("Canvas size");
            tip: @tr("The size of the picture other apps get from the virtual camera");
            tip-detail: @tr("On Linux the virtual camera is reloaded for this. Close OBS and other apps using it first.");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "resolution output size 1080p 720p 4k portrait landscape aspect ratio custom width height pixels apply reload");
            // The list opens as wide as it needs
            ChoiceField {
                preferred-width: Theme.control-w;
                min-width: Theme.control-min;
                max-width: Theme.control-w;
                compact: true;
                name: @tr("Canvas size");
                items: root.canvas-items;
                current <=> root.canvas-current;
                picked(i) => { root.canvas-current = i; root.canvas-picked(i); }
            }
        }
        Unfolding {
            open: custom-shown;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.gap;
                    alignment: end;
                    NumberField {
                        width: Theme.u(45);
                        label: @tr("Canvas size");
                        value: root.custom-w-text;
                        committed(text) => { root.custom-committed("w", text); }
                        step(d) => { root.custom-step("w", -d); }
                    }
                    Text { text: "×"; font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; vertical-alignment: center; }
                    NumberField {
                        width: Theme.u(45);
                        label: @tr("Canvas size");
                        value: root.custom-h-text;
                        committed(text) => { root.custom-committed("h", text); }
                        step(d) => { root.custom-step("h", -d); }
                    }
                }
            }
        }
        Unfolding {
            open: true;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.gap;
                    KitStatus {
                        text: canvas-status-shown ? canvas-status : "";
                        detail: canvas-status-shown ? canvas-status : "";
                        kind: canvas-status-kind == "status_ok" ? "ok" : canvas-status-kind == "status_warn" ? "warn" : canvas-status-kind == "status_err" ? "err" : "";
                        horizontal: "end";
                    }
                    Button { text: apply-text; tip: apply-text; tip-detail: apply-tip; enabled: apply-enabled; clicked => { root.apply-clicked(); } }
                }
            }
        }
        CommandRow { command: canvas-command; copy(c) => { root.copy(c); } }
    }
}

// Microphone, on Audio: the Gain slider's reach and the limiter
export component MicrophoneLimits inherits Card {
    in property <bool> reset-shown;
    callback reset-clicked;
    in property <string> card-group: "sound";
    in property <[string]> gain-items;
    in-out property <int> gain-current;
    in-out property <bool> limiter-checked: true;
    callback gain-picked(int);
    callback limiter-toggled(bool);

    title: @tr("Microphone");
    tip: @tr("Maximum microphone gain and the limiter.");
    has-reset: true;
    reset-lit: reset-shown;
    reset-label: @tr("Reset");
    reset-detail: @tr("Set the gain range and limiter back to default.");
    reset => { root.reset-clicked(); }
    keywords: @tr("search" => "audio sound voice input volume");
    icon: Icons.mic;
    hue: Theme.plugin-hue("sound");

    RailRow {
        icon: Icons.volume;
        label: @tr("Max gain");
        tip: @tr("How far the Gain slider goes");
        tip-detail: @tr("Less range gives finer steps. More range helps a quiet phone.");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "microphone volume loudness boost amplify quiet decibel db slider range");
        Segmented {
            preferred-width: self.room;
            min-width: Theme.control-min;
            max-width: self.room;
            hue: root.hue;
            label: @tr("Max gain");
            items: root.gain-items;
            current <=> root.gain-current;
            picked(i) => { root.gain-current = i; root.gain-picked(i); }
        }
    }
    SwitchRow {
        icon: Icons.level;
        label: @tr("Limiter");
        tip: @tr("Limiter");
        tip-detail: @tr("Keep loud sounds from clipping");
        keywords: @tr("search" => "microphone audio compressor distortion clipping loud peaks sound");
        hue: root.hue;
        checked <=> root.limiter-checked;
        toggled(on) => { root.limiter-toggled(on); }
    }
}

// Phone app, on Virtual camera & phone: installing Telescope.apk over USB
export component PhoneAppSettings inherits Card {
    in property <string> apk-button;
    in property <string> apk-text;
    in property <string> apk-kind: "status_dim";
    in property <bool> apk-enabled: true;
    in property <bool> pick-shown;
    in property <[string]> pick-items;
    in-out property <int> pick-current;
    callback apk-clicked;
    callback pick-done(int);
    callback pick-cancelled;

    title: @tr("Phone app");
    tip: @tr("Install the Telescope app on a phone over USB.");
    keywords: @tr("search" => "android install apk usb");
    icon: Icons.phone;
    hue: Theme.plugin-hue("streaming");

    UnfoldGroup {
        RailRow {
            icon: Icons.phone;
            label: "Telescope.apk";
            tip: @tr("The phone app that streams the camera to this computer");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "phone app install usb android reinstall newer version sideload cable");
            Button {
                text: apk-button;
                has-icon: true;
                icon: Icons.download;
                icon-tint: Theme.ink2;
                enabled: apk-enabled;
                tip: @tr("Install");
                tip-detail: @tr("Install the Telescope.apk that came with this app, or an APK you pick, on a phone plugged in over USB.");
                clicked => { root.apk-clicked(); }
            }
        }
        StatusRow { text: apk-text; kind: apk-kind; detail: apk-text; }
        // QInputDialog.getItem's question, asked in the card
        Unfolding {
            open: pick-shown;
            RailRow {
                icon: Icons.usb;
                label: @tr("Select device");
                tip: @tr("Pick which phone gets the app when more than one is plugged in");
                named: true;
                hue: root.hue;
                ChoiceField {
                    preferred-width: Theme.control-w;
                    min-width: Theme.control-min;
                    max-width: Theme.control-w;
                    compact: true;
                    name: @tr("Select device");
                    items: root.pick-items;
                    current <=> root.pick-current;
                    picked(i) => { root.pick-current = i; }
                }
            }
        }
        Unfolding {
            open: pick-shown;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.gap;
                    alignment: end;
                    Button { text: @tr("Cancel"); clicked => { root.pick-cancelled(); } }
                    Button { text: @tr("OK"); role: "primary"; hue: root.hue; clicked => { root.pick-done(root.pick-current); } }
                }
            }
        }
    }
}

// Look, on General: the theme, card colours, the options that scale or swap a design token (Appearance) and the language
export component LookSettings inherits Card {
    in property <bool> reset-shown;
    callback reset-clicked;
    in-out property <int> hues-current;
    in-out property <int> theme-current;
    in-out property <int> corners-current;
    in-out property <int> text-current;
    in-out property <int> density-current;
    in-out property <bool> contrast-checked;
    in-out property <int> motion-current;
    in property <float> tip-delay;
    in property <string> tip-delay-text;
    in-out property <bool> tip-warm-checked;
    in property <[string]> lang-items;
    in-out property <int> lang-current;
    in property <bool> lang-restart;
    in property <string> help-text;
    callback hues-picked(int);
    callback theme-picked(int);
    callback corners-picked(int);
    callback text-picked(int);
    callback density-picked(int);
    callback contrast-toggled(bool);
    callback motion-picked(int);
    callback tip-delay-moved(float);
    callback tip-warm-toggled(bool);
    callback lang-picked(int);
    callback restart-clicked;
    callback translate-clicked;

    title: @tr("Look");
    tip: @tr("Theme, colours, sizes, motion and language.");
    has-reset: true;
    reset-lit: reset-shown;
    reset-label: @tr("Reset");
    reset-detail: @tr("Set the theme, colours, sizes, motion, tooltips and language back to default.");
    reset => { root.reset-clicked(); }
    keywords: @tr("search" => "appearance theme colors colours interface");
    icon: Icons.sliders;
    hue: Theme.plugin-hue("streaming");
    RailRow {
        icon: Icons.sun;
        label: @tr("Theme");
        tip: @tr("Dark, classic, OLED black or light for the whole app");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "theme classic dark blue appearance look old oled black light white");
        Segmented {
            preferred-width: self.room;
            min-width: Theme.control-min;
            max-width: self.room;
            hue: root.hue;
            label: @tr("Theme");
            items: [@tr("Dark"), @tr("Classic"), @tr("OLED"), @tr("Light")];
            current <=> root.theme-current;
            picked(i) => { root.theme-current = i; root.theme-picked(i); }
        }
    }
    RailRow {
        icon: Icons.colour;
        label: @tr("Card colours");
        tip: @tr("Card colours");
        tip-detail: @tr("Give every card in the main window a different colour.");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "color colour theme appearance monochrome colourful purple hue accent look");
        Segmented {
            preferred-width: self.room;
            min-width: Theme.control-min;
            max-width: self.room;
            hue: root.hue;
            label: @tr("Card colours");
            items: [@tr("Colourful"), @tr("Monochrome")];
            current <=> root.hues-current;
            picked(i) => { root.hues-current = i; root.hues-picked(i); }
        }
    }
    SwitchRow {
        icon: Icons.contrast;
        label: @tr("Higher contrast");
        tip: @tr("Higher contrast");
        tip-detail: @tr("Use full colours with brighter text and lines.");
        keywords: @tr("search" => "contrast accessibility vision bright text lines outline colours");
        hue: root.hue;
        checked <=> root.contrast-checked;
        toggled(on) => { root.contrast-checked = on; root.contrast-toggled(on); }
    }
    RailRow {
        icon: Icons.radius;
        label: @tr("Corners");
        tip: @tr("How round the corners of cards and controls are");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "corners round rounded sharp square radius shape");
        Segmented {
            preferred-width: self.room;
            min-width: Theme.control-min;
            max-width: self.room;
            hue: root.hue;
            label: @tr("Corners");
            items: [@tr("Sharp"), @tr("Default"), @tr("Round")];
            current <=> root.corners-current;
            picked(i) => { root.corners-current = i; root.corners-picked(i); }
        }
    }
    RailRow {
        icon: Icons.text-size;
        label: @tr("Text size");
        tip: @tr("Make every text in the app smaller or larger");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "text size font bigger smaller large small zoom readable");
        Segmented {
            preferred-width: self.room;
            min-width: Theme.control-min;
            max-width: self.room;
            hue: root.hue;
            label: @tr("Text size");
            items: [@tr("Small"), @tr("Default"), @tr("Large")];
            current <=> root.text-current;
            picked(i) => { root.text-current = i; root.text-picked(i); }
        }
    }
    RailRow {
        icon: Icons.layout;
        label: @tr("Density");
        tip: @tr("How much room there is between and inside controls");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "density compact comfortable spacing padding room tight cramped");
        Segmented {
            preferred-width: self.room;
            min-width: Theme.control-min;
            max-width: self.room;
            hue: root.hue;
            label: @tr("Density");
            items: [@tr("Compact"), @tr("Default"), @tr("Comfortable")];
            current <=> root.density-current;
            picked(i) => { root.density-current = i; root.density-picked(i); }
        }
    }
    RailRow {
        icon: Icons.trails;
        label: @tr("Motion");
        tip: @tr("Motion");
        tip-detail: @tr("Choose how much of the app moves. System follows your desktop's animation setting.");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "motion animation animations reduce reduced off movement transitions");
        ChoiceField {
            preferred-width: Theme.control-w;
            min-width: Theme.control-min;
            max-width: Theme.control-w;
            compact: true;
            name: @tr("Motion");
            items: [@tr("System"), @tr("Full"), @tr("Reduced"), @tr("Off")];
            current <=> root.motion-current;
            picked(i) => { root.motion-current = i; root.motion-picked(i); }
        }
    }
    RailRow {
        icon: Icons.timer;
        label: @tr("Tooltip delay");
        tip: @tr("Tooltip delay");
        tip-detail: @tr("How long to rest on something before its tooltip shows.");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "tooltip tooltips delay wait hint hover instant");
        Slider {
            preferred-width: Theme.control-w;
            min-width: Theme.control-min;
            max-width: Theme.control-w;
            hue: root.hue;
            label: @tr("Tooltip delay");
            minimum: 0;
            maximum: 1500;
            step: 100;
            value: root.tip-delay;
            readout: root.tip-delay-text;
            has-default: true;
            default-value: 500;
            type-in: false;
            moved(v) => { root.tip-delay-moved(v); }
        }
    }
    SwitchRow {
        icon: Icons.bolt;
        label: @tr("Show the next tooltip sooner");
        tip: @tr("Show the next tooltip sooner");
        tip-detail: @tr("Cut the wait for the next tooltip to a short rest.");
        keywords: @tr("search" => "tooltip tooltips instant next quick hover hint");
        hue: root.hue;
        checked <=> root.tip-warm-checked;
        toggled(on) => { root.tip-warm-checked = on; root.tip-warm-toggled(on); }
    }
    UnfoldGroup {
        RailRow {
            icon: Icons.chat;
            label: @tr("Language");
            tip: @tr("The language of every text in the app");
            tip-detail: @tr("Switching needs a restart.");
            named: true;
            hue: root.hue;
            keywords: @tr("search" => "language translation translate locale");
            ChoiceField {
                preferred-width: Theme.control-w;
                min-width: Theme.control-min;
                max-width: Theme.control-w;
                compact: true;
                name: @tr("Language");
                items: root.lang-items;
                current <=> root.lang-current;
                picked(i) => { root.lang-current = i; root.lang-picked(i); }
            }
        }
        // Switching asks for a restart: the word and its button, there only after another language is picked
        Unfolding {
            open: lang-restart;
            RailRow {
                has-icon: false;
                HorizontalLayout {
                    spacing: Theme.gap;
                    KitStatus { text: @tr("Restart to switch"); detail: @tr("Restart Telescope to switch to the new language."); kind: "warn"; horizontal: "end"; }
                    Button {
                        text: @tr("Restart now");
                        has-icon: true;
                        icon: Icons.repeat;
                        icon-tint: Theme.ink2;
                        tip: @tr("Restart");
                        tip-detail: @tr("Restart Telescope in the language you picked.");
                        clicked => { root.restart-clicked(); }
                    }
                }
            }
        }
    }
    // The whole button in its own row under Language, so it reads as an invitation and not as the card's action
    RailRow {
        has-icon: false;
        HorizontalLayout {
            alignment: end;
            Button {
                text: @tr("Help translate");
                has-icon: true;
                icon: Icons.pencil;
                icon-tint: Theme.ink2;
                tip: @tr("Help translate");
                tip-detail: @tr("Fix a text or add a language without any coding.");
                clicked => { root.translate-clicked(); }
            }
        }
    }
}

// About, on Updates & About: who made it, the log, diagnostics, bug reports and where to find help. One row each, the button at the right edge
export component AboutSettings inherits Card {
    in property <string> version-text;
    in property <string> made-before;
    in property <string> made-link;
    in property <string> made-after;
    in property <string> diag-text;
    in property <bool> log-shown;
    callback author-clicked;
    callback diag-clicked;
    callback bug-clicked;
    callback log-clicked;
    callback help-clicked;

    title: @tr("About");
    tip: @tr("Version, log, bug reports and help.");
    keywords: @tr("search" => "info version help support credits");
    icon: Icons.help;
    hue: Theme.plugin-hue("extras");

    RailRow {
        icon: Icons.person;
        label: "Telescope";
        tip: "Telescope";
        tip-detail: version-text;
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "about author credits made by version number build");
        HorizontalLayout {
            spacing: 0px;
            alignment: end;
            // Lifted a pixel like the link beside it and every other word the kit centres
            Rectangle { width: before-text.preferred-width; before-text := Text { y: -1phx; width: parent.width; height: parent.height; text: made-before; font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; vertical-alignment: center; } }
            VerticalLayout {
                alignment: center;
                LinkText { text: made-link; url: ""; font-size: Theme.body; horizontal-stretch: 0; opened(u) => { root.author-clicked(); } }
            }
            if made-after != "": Rectangle { width: after-text.preferred-width; after-text := Text { y: -1phx; width: parent.width; height: parent.height; text: made-after; font-family: Theme.font; font-size: Theme.body; color: Theme.ink2; vertical-alignment: center; } }
        }
    }
    if log-shown: RailRow {
        icon: Icons.notes;
        label: @tr("Log");
        tip: @tr("A record of what the app did to help track down a problem");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "log file open show temp folder");
        Button { text: @tr("Open"); tip: @tr("Open log"); tip-detail: @tr("Open the full log. The log is saved in the temp folder, which the system clears."); clicked => { root.log-clicked(); } }
    }
    RailRow {
        icon: Icons.copy;
        label: @tr("Diagnostics");
        tip: @tr("Info about your setup to include in a bug report");
        tip-detail: @tr("Pairing tokens, addresses and file paths are left out.");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "copy diagnostics info system details");
        Button {
            text: diag-text;
            tip: @tr("Copy diagnostics");
            tip-detail: @tr("Copy info for a bug report without pairing tokens, addresses or file paths.");
            clicked => { root.diag-clicked(); }
        }
    }
    RailRow {
        icon: Icons.alert;
        label: @tr("Bug reports");
        tip: @tr("Report a problem on GitHub");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "bug report diagnostics logs debug support problem issue help copy log file");
        Button { text: @tr("Report a bug"); tip: @tr("Report a bug"); tip-detail: @tr("Copy the diagnostics and open the bug form on GitHub."); clicked => { root.bug-clicked(); } }
    }
    RailRow {
        icon: Icons.help;
        label: @tr("Need help?");
        tip: @tr("Fixes for the common problems");
        named: true;
        hue: root.hue;
        keywords: @tr("search" => "help support troubleshooting question faq problem not working stuck ask");
        Button { text: @tr("Troubleshooting"); clicked => { root.help-clicked(); } }
    }
}
