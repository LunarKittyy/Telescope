// The Phone card (desktop/telescope/plugins/monitoring.py). Joined after parts.slint, which has the imports.

// StatusPill: a live reading at a glance, icon, value and a short note, tinted by how it's doing
component Pill inherits Rectangle {
    in property <string> value;
    in property <string> note;
    in property <string> kind: "status_dim";
    in property <image> icon;
    property <color> ink: kind == "status_dim" ? Theme.text-dim : Status.color(kind).brighter(0.12);
    height: 40px;
    horizontal-stretch: 1;
    min-width: 1px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: (kind == "status_dim" ? Theme.dim : Status.color(kind)).with-alpha(kind == "status_dim" ? 0.15 : 0.25);
    background: (kind == "status_dim" ? Theme.dim : Status.color(kind)).with-alpha(kind == "status_dim" ? 0.06 : 0.12);
    accessible-role: AccessibleRole.text;
    accessible-label: note == "" ? value : value + " " + note;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 9px;
        Icon { source: icon; tint: ink; width: 18px; height: 18px; y: (parent.height - self.height) / 2; accessible-role: none; }
        Text {
            text: value;
            font-family: Theme.font;
            font-size: 15px; // 1.13 of the body size, which Qt draws at 15
            font-weight: 600;
            color: ink;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            horizontal-stretch: 1;
            text: note;
            font-family: Theme.font;
            font-size: Theme.body;
            color: ink;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
}

// One warning: what counts, then whether to notify and stop the stream
component AlertBlock inherits VerticalLayout {
    in property <image> icon;
    in property <string> label;
    in property <string> spin-tip;
    in property <string> notify-tip;
    in property <string> stop-tip;
    in property <bool> enabled: true;
    in-out property <string> spin-text;
    in-out property <bool> notify;
    in-out property <bool> stop;
    callback committed(string);
    callback step(int);
    callback notify-toggled(bool);
    callback stop-toggled(bool);
    spacing: 10px;
    HorizontalLayout {
        spacing: 10px;
        Icon { source: icon; tint: Theme.plugin-hue("phone"); width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
        Text {
            horizontal-stretch: 1;
            text: label;
            font-family: Theme.font;
            font-size: Theme.body;
            color: enabled ? Theme.text : Theme.text-disabled;
            vertical-alignment: center;
        }
        SpinChip {
            text <=> root.spin-text;
            label: root.label;
            tip: root.spin-tip;
            enabled: root.enabled;
            committed(t) => { root.committed(t); }
            step(d) => { root.step(d); }
        }
    }
    // Under the label, past the icon
    HorizontalLayout {
        padding-left: 26px;
        spacing: 24px;
        LabelledSwitch {
            text: @tr("Notify me");
            tip: root.notify-tip;
            dim: true;
            enabled: root.enabled;
            checked <=> root.notify;
            toggled(on) => { root.notify-toggled(on); }
        }
        LabelledSwitch {
            text: @tr("Stop the stream");
            tip: root.stop-tip;
            dim: true;
            enabled: root.enabled;
            checked <=> root.stop;
            toggled(on) => { root.stop-toggled(on); }
        }
    }
}

export component MonitoringCard inherits Card {
    // dim_until_paired: faded and disabled until there's a phone, and gone for a source that isn't one
    in property <bool> active: true;
    in property <bool> phone-only-hidden;
    in property <string> battery-value: "—";
    in property <string> battery-note;
    in property <string> battery-kind: "status_dim";
    in property <string> battery-icon: "battery";
    in property <string> temp-value: "—";
    in property <string> temp-note;
    in property <string> temp-kind: "status_dim";
    in-out property <string> batt-text: "20%";
    in-out property <string> temp-text: "45 °C";
    in-out property <bool> batt-notify: true;
    in-out property <bool> batt-stop;
    in-out property <bool> temp-notify: true;
    in-out property <bool> temp-stop;
    callback batt-committed(string);
    callback batt-step(int);
    callback temp-committed(string);
    callback temp-step(int);
    callback alert-toggled(string, bool);

    title: @tr("Phone");
    icon: Icons.phone;
    opacity: active ? 1 : 0.4;
    enabled: active;
    visible: !phone-only-hidden;

    HorizontalLayout {
        spacing: 8px;
        Pill { value: battery-value; note: battery-note; kind: battery-kind; icon: battery-icon == "battery-charging" ? Icons.battery-charging : Icons.battery; }
        Pill { value: temp-value; note: temp-note; kind: temp-kind; icon: Icons.thermometer; }
    }
    Section {
        key: "Warnings";
        title: @tr("Warnings");
        icon: Icons.bell;
        scope: root.fold-key;
        // QFrame#subsection
        Rectangle {
            background: Theme.surface-raise;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            VerticalLayout {
                padding-left: 13px;
                padding-right: 13px;
                padding-top: 11px;
                padding-bottom: 11px;
                spacing: 10px;
                AlertBlock {
                    icon: Icons.battery;
                    label: @tr("Battery under");
                    spin-tip: @tr("Counts as low at this level, even while charging if it keeps dropping");
                    notify-tip: @tr("Show a notification when the battery runs low");
                    stop-tip: @tr("Stop the stream when the battery runs low, and at every restart until it's fine again");
                    enabled: root.active;
                    spin-text <=> root.batt-text;
                    notify <=> root.batt-notify;
                    stop <=> root.batt-stop;
                    committed(t) => { root.batt-committed(t); }
                    step(d) => { root.batt-step(d); }
                    notify-toggled(on) => { root.alert-toggled("batt-notify", on); }
                    stop-toggled(on) => { root.alert-toggled("batt-stop", on); }
                }
                // hairline
                Rectangle { height: 1px; background: Theme.border; }
                AlertBlock {
                    icon: Icons.thermometer;
                    label: @tr("Hotter than");
                    spin-tip: @tr("The temperature that counts as too hot");
                    notify-tip: @tr("Show a notification when the phone gets too hot");
                    stop-tip: @tr("Stop the stream when the phone gets too hot, and at every restart until it's fine again");
                    enabled: root.active;
                    spin-text <=> root.temp-text;
                    notify <=> root.temp-notify;
                    stop <=> root.temp-stop;
                    committed(t) => { root.temp-committed(t); }
                    step(d) => { root.temp-step(d); }
                    notify-toggled(on) => { root.alert-toggled("temp-notify", on); }
                    stop-toggled(on) => { root.alert-toggled("temp-stop", on); }
                }
            }
        }
    }
}
