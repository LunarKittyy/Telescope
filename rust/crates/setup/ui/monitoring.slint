// The Phone card. Joined after parts.slint, which has the imports.

// One warning's two tiles: whether to notify and whether to stop the stream, side by side on the card's own edges
component AlertTiles inherits HorizontalLayout {
    in property <string> label;
    in property <string> notify-tip;
    in property <string> stop-tip;
    in property <bool> enabled: true;
    in property <color> hue: Theme.accent;
    in-out property <bool> notify;
    in-out property <bool> stop;
    callback notify-toggled(bool);
    callback stop-toggled(bool);
    spacing: Theme.gap;
    ToggleTile {
        icon: Icons.bell;
        text: @tr("Notify me");
        name: root.label + ": " + @tr("Notify me");
        tip: root.notify-tip;
        hue: root.hue;
        enabled: root.enabled;
        checked <=> root.notify;
        toggled(on) => { root.notify-toggled(on); }
    }
    ToggleTile {
        icon: Icons.stop;
        text: @tr("Stop the stream");
        name: root.label + ": " + @tr("Stop the stream");
        tip: root.stop-tip;
        hue: root.hue;
        enabled: root.enabled;
        checked <=> root.stop;
        toggled(on) => { root.stop-toggled(on); }
    }
}

export component MonitoringCard inherits Card {
    // dim_until_paired: faded and disabled until there's a phone, and gone for a source that isn't one
    in property <bool> active: true;
    in property <bool> phone-only-hidden;
    // The live readings, which the bars show, and their words for the tooltips
    in property <string> battery-value: "-";
    in property <string> battery-note;
    in property <string> battery-icon: "battery";
    in property <int> battery-level;
    in property <bool> battery-has-level;
    in property <string> temp-value: "-";
    in property <string> temp-note;
    in property <float> temp-level;
    in property <bool> temp-has-level;
    // Where the warnings are set
    in property <int> batt-alert: 20;
    in property <int> temp-alert: 45;
    in-out property <string> batt-text: "20%";
    in-out property <string> temp-text: "45 °C";
    in-out property <bool> batt-notify: true;
    in-out property <bool> batt-stop;
    in-out property <bool> temp-notify: true;
    in-out property <bool> temp-stop;
    callback batt-moved(float);
    callback temp-moved(float);
    callback alert-toggled(string, bool);

    title: @tr("Phone");
    icon: Icons.phone;
    opacity: active ? 1 : 0.4;
    enabled: active;
    visible: !phone-only-hidden;

    // Each bar is the live reading, and its handle is the level to warn at
    RailRow {
        icon: Icons.battery;
        label: @tr("Battery under");
        hue: root.hue;
        enabled: root.active;
        Slider {
            label: @tr("Battery under");
            fill: "threshold";
            hue: root.hue;
            enabled: root.active;
            minimum: 5;
            maximum: 95;
            step: 1;
            value: batt-alert;
            readout: batt-text;
            level: battery-level;
            has-level: battery-has-level;
            level-text: battery-value;
            level-icon: Icons.bolt;
            has-level-icon: battery-icon == "battery-charging";
            has-default: true;
            default-value: 20;
            tip: @tr("Counts as low at this level, even while charging if it keeps dropping");
            tip-detail: battery-note;
            moved(v) => { root.batt-moved(v); }
        }
    }
    RailRow {
        has-icon: false;
        enabled: root.active;
        AlertTiles {
            label: @tr("Battery under");
            notify-tip: @tr("Show a notification when the battery runs low");
            stop-tip: @tr("Stop the stream when the battery runs low, and at every restart until it's fine again");
            enabled: root.active;
            hue: root.hue;
            notify <=> root.batt-notify;
            stop <=> root.batt-stop;
            notify-toggled(on) => { root.alert-toggled("batt-notify", on); }
            stop-toggled(on) => { root.alert-toggled("batt-stop", on); }
        }
    }
    RailRow {
        icon: Icons.thermometer;
        label: @tr("Hotter than");
        hue: root.hue;
        enabled: root.active;
        Slider {
            label: @tr("Hotter than");
            fill: "threshold";
            hue: root.hue;
            enabled: root.active;
            minimum: 35;
            maximum: 65;
            step: 1;
            value: temp-alert;
            readout: temp-text;
            level: temp-level;
            has-level: temp-has-level;
            level-text: temp-value;
            has-default: true;
            default-value: 45;
            tip: @tr("The temperature that counts as too hot");
            tip-detail: temp-note;
            moved(v) => { root.temp-moved(v); }
        }
    }
    RailRow {
        has-icon: false;
        enabled: root.active;
        AlertTiles {
            label: @tr("Hotter than");
            notify-tip: @tr("Show a notification when the phone gets too hot");
            stop-tip: @tr("Stop the stream when the phone gets too hot, and at every restart until it's fine again");
            enabled: root.active;
            hue: root.hue;
            notify <=> root.temp-notify;
            stop <=> root.temp-stop;
            notify-toggled(on) => { root.alert-toggled("temp-notify", on); }
            stop-toggled(on) => { root.alert-toggled("temp-stop", on); }
        }
    }
}
