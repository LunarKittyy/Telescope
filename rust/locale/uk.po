msgid "50 Hz"
msgstr "50 Гц"

#: rust/crates/outputs/src/webcam.rs:110
msgid "60 Hz"
msgstr "60 Гц"

#: rust/crates/outputs/src/webcam.rs:347
msgid "Check that the webcam is plugged in."
msgstr "Перевірте, чи вебкамера підключена."

