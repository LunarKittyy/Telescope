msgid "You can start streaming now."
msgstr "이제 스트리밍을 시작할 수 있어요."

msgid "You have the latest version."
msgstr "최신 버전을 사용하고 있어요."

msgid "You picked a camera that isn't a phone."
msgstr "휴대폰이 아닌 카메라를 선택했어요."

msgid "You turned this off in Plugins. To get it back, open Plugins in Settings and switch it on."
msgid_plural "You turned these off in Plugins. To get them back, open Plugins in Settings and switch them on."
msgstr[0] "플러그인에서 꺼 둔 상태예요. 다시 사용하려면 설정에서 플러그인을 열어 켜세요."

msgid "Your desktop asks you to confirm global shortcuts and you can change their keys in the desktop's settings. The key the desktop assigned is shown next to each shortcut."
msgstr "데스크톱 환경에서 전역 단축키 확인을 요청하며, 데스크톱 환경 설정에서 단축키를 변경할 수 있어요. 데스크톱 환경에서 할당한 키는 각 단축키 옆에 표시돼요."

msgid "Your devices"
msgstr "내 기기"

msgid "Your own wheels and curves would have clipped the picture. Auto applied only part of the change."
msgstr "직접 조정한 휠과 커브를 그대로 적용하면 화면이 클리핑될 수 있어요. 자동 조정은 일부만 적용했어요."

msgid "Your password (pkexec or sudo) is required because this changes system settings."
msgstr "시스템 설정을 변경하므로 비밀번호(pkexec 또는 sudo)가 필요해요."

msgid "Your password (pkexec or sudo) is required to change system settings."
msgstr "시스템 설정을 변경하려면 비밀번호(pkexec 또는 sudo)가 필요해요."

msgid "Your password (pkexec or sudo) is required."
msgstr "비밀번호(pkexec 또는 sudo)가 필요해요."

msgid "Your password is needed to switch on the virtual camera."
msgstr "가상 카메라를 켜려면 비밀번호가 필요해요."

msgid "Your password is needed."
msgstr "비밀번호가 필요해요."

msgid "Your password is required."
msgstr "비밀번호가 필요해요."

msgid "Your settings couldn't be read"
msgstr "설정을 읽을 수 없어요"

msgid "Zebras"
msgstr "지브라"

msgid "Zebras from"
msgstr "지브라 시작 기준"

#. Speed 1 to 10, slowest first, as a playful word for each step; keep them short
msgid "Zippy"
msgstr "번개"

msgid "Zones"
msgstr ""

msgid "Zoom"
msgstr "줌"

msgid "Zoom and pan to follow you as you move."
msgstr "움직임에 맞춰 따라가도록 줌 및 팬을 조절해요."

msgid "Zoom and pan to follow you."
msgstr "움직임을 따라 줌과 팬을 조절해요."

msgid "Zoom and pan to keep you in the picture as you move."
msgstr "움직일 때도 화면 안에 유지되도록 줌 및 팬을 조절해요."

msgid "Zoom beyond the phone's own range is cropped on this computer."
msgstr "휴대폰 자체 지원 범위를 초과하는 줌은 이 컴퓨터에서 잘라내어 처리돼요."

msgid "Zoom in on the phone that sees the wider view (the right one over 100%, the left one under it) to make both show the same thing."
msgstr "더 넓은 시야를 보는 휴대폰의 줌을 조정해(오른쪽은 100% 초과, 왼쪽은 100% 미만) 두 화면에 같은 장면이 보이게 하세요."

msgid "Zoom, pan, flip, rotate and stretch the picture."
msgstr "화면을 줌, 팬, 반전, 회전하거나 늘릴 수 있어요."

msgid "Zoomed on the phone's sensor"
msgstr "휴대폰 센서에서 줌 적용됨"

msgid "Zoomed on the phone's sensor as far as this lens allows, the rest on this computer"
msgstr "이 렌즈가 허용하는 만큼 휴대폰 센서에서 줌 적용 후 나머지는 이 컴퓨터에서 적용됨"

msgid "Zoomed on this computer"
msgstr "이 컴퓨터에서 줌 적용됨"

msgid "Zoomed on this computer since this lens can't zoom"
msgstr "이 렌즈는 줌을 지원하지 않아 이 컴퓨터에서 확대함"

msgid "a local socket"
msgstr "로컬 소켓"

