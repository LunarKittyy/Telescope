#, python-brace-format
msgid "The plugin has no {file}."
msgstr "플러그인에 {file} 파일이 없어요."

msgid "The plugin is a link to another folder, which plugins can't be."
msgstr "플러그인이 다른 폴더로의 링크로 되어 있지만, 플러그인은 링크일 수 없어요."

msgid "The plugin isn't turned on."
msgstr "플러그인이 켜져 있지 않아요."

#, python-brace-format
msgid "The plugin needs a newer Telescope (plugin API {wanted}; this Telescope has {have})."
msgstr "이 플러그인은 더 최신 버전의 Telescope가 필요해요(필요한 플러그인 API: {wanted}, 현재 Telescope: {have})."

#, python-brace-format
msgid "The plugin was made for an older Telescope (plugin API {api}) and needs an update."
msgstr "이 플러그인은 이전 버전의 Telescope(플러그인 API {api})용으로 제작되어 업데이트가 필요해요."

#, python-brace-format
msgid "The plugin's download (about {mb} MB) is missing. Switch the plugin off and on again to download it."
msgstr "플러그인 다운로드 파일(약 {mb} MB)이 누락되었어요. 다운로드하려면 플러그인을 껐다가 다시 켜세요."

msgid "The plugin's files changed since it was turned on. Turn the plugin on again if you trust the new version."
msgstr "플러그인을 켠 이후 플러그인 파일이 변경되었어요. 새 버전을 신뢰한다면 플러그인을 다시 켜세요."

msgid "The plugin's files couldn't be read."
msgstr "플러그인 파일을 읽을 수 없어요."

#, python-brace-format
msgid "The plugin's folder ({folder}) is deleted from the plugins folder. To use the plugin again, add it again."
msgstr "플러그인 폴더({folder})가 plugins 폴더에서 삭제되었어요. 플러그인을 다시 사용하려면 다시 추가하세요."

msgid "The preset the shortcut applies"
msgstr "단축키로 적용할 프리셋"

msgid "The processor"
msgstr "프로세서"

msgid "The processor is decoding for a while because the graphics card was too slow. The card gets another turn afterwards."
msgstr ""

msgid "The result may drift with the camera set to auto."
msgstr "카메라가 자동으로 설정되어 있으면 결과가 달라질 수 있어요."

msgid "The right picture's brightness and colour now follow the left one's."
msgstr "이제 오른쪽 화면의 밝기와 색상이 왼쪽 화면을 따라가요."

msgid "The script is on the phone's screen."
msgstr "대본이 휴대폰 화면에 표시되고 있어요."

msgid "The script shows up on the phone once you close its preview."
msgstr "휴대폰에서 미리보기를 닫으면 대본이 나타나요."

msgid "The script was closed on the phone. Send again to show it."
msgstr "휴대폰에서 대본을 닫았어요. 표시하려면 다시 보내세요."

msgid "The sender couldn't be started. It tries again with the next picture."
msgstr ""

msgid "The sender isn't running. Start it again to continue."
msgstr "송신 프로그램이 실행 중이지 않아요. 계속하려면 다시 시작하세요."

msgid "The sender isn't sharing a picture. Check that it's running and sending."
msgstr "송신 프로그램이 화면을 공유하고 있지 않아요. 프로그램이 실행 중이고 전송 중인지 확인하세요."

msgid "The sender stopped. It tries again with the next picture."
msgstr ""

msgid "The sharpest share of the frames that gets stacked."
msgstr ""

msgid "The sheet as the camera sees it"
msgstr "카메라에 보이는 그대로의 용지"

msgid "The size of the picture other apps get from the virtual camera"
msgstr "다른 앱이 가상 카메라에서 가져오는 화면 크기"

msgid "The size the browser sends. If the camera doesn't support this size the browser sends what the camera can do."
msgstr "브라우저가 보내는 크기예요. 카메라가 이 크기를 지원하지 않으면 카메라가 지원하는 크기로 보내요."

msgid "The size the stream opens the camera at. Still images and GIFs work; transparent parts show the dark background."
msgstr "스트림이 카메라를 여는 크기예요. 정지 이미지와 GIF를 사용할 수 있으며 투명한 부분은 어두운 배경으로 표시돼요."

msgid "The size the webcam sends. Auto takes the largest up to 1080p that still reaches the frame rate."
msgstr "웹캠이 전송하는 크기예요. 자동은 목표 프레임 레이트를 달성하는 최대 1080p 크기를 선택해요."

msgid "The sound server didn't answer (pactl list failed)."
msgstr "사운드 서버가 응답하지 않았어요(pactl list 실패)."

#, python-brace-format
msgid "The stream from {name} stopped unexpectedly"
msgstr "{name}의 스트림이 예기치 않게 중지되었어요"

#, python-brace-format
msgid "The stream is still running over {now} and Connect via is still set to {kept}."
msgstr "스트림이 여전히 {now}을(를) 통해 실행 중이며, 연결 방식은 여전히 {kept}(으)로 설정되어 있어요."

msgid "The stream resumes automatically once the other app closes or releases the camera."
msgstr "다른 앱이 닫히거나 카메라 사용을 해제하면 스트림이 자동으로 다시 시작돼요."

msgid "The stream stopped unexpectedly"
msgstr "스트림이 예기치 않게 중지되었어요"

msgid "The teleprompter only works with a phone as the camera."
msgstr "텔레프롬프터는 휴대폰을 카메라로 쓸 때만 작동해요."

msgid "The temperature that counts as too hot."
msgstr "너무 뜨거움으로 간주할 온도예요."

msgid "The two pictures were taken within half a frame of each other."
msgstr "두 화면이 반 프레임 이내의 시간차로 촬영되었어요."

msgid "The update failed."
msgstr "업데이트에 실패했어요."

msgid "The update information couldn't be read."
msgstr "업데이트 정보를 읽을 수 없었어요."

#, python-brace-format
msgid "The update wasn't installed while {file} is in use. Try again after a restart."
msgstr "{file}이(가) 사용 중인 동안에는 업데이트가 설치되지 않았어요. 다시 시작한 후 다시 시도해 보세요."

msgid "The version in this .zip replaces the installed version and its settings carry over. Like any added plugin, it's switched off at first."
msgstr "이 .zip 파일의 버전이 설치된 버전을 대체하며 기존 설정은 유지돼요. 다른 추가된 플러그인과 마찬가지로 처음에는 꺼져 있어요."

msgid "The version of Telescope you're running"
msgstr "현재 실행 중인 Telescope 버전"

msgid "The video is paused while the phone takes a photo"
msgstr "휴대폰에서 사진을 촬영하는 동안 비디오가 일시 정지됨"

msgid "The video is paused while the photo is taken…"
msgstr "사진을 촬영하는 동안 비디오가 일시 중지돼요…"

msgid "The video pauses while the phone maker's Night, HDR and Bokeh modes take a photo."
msgstr "휴대폰 제조사의 야간, HDR, 보케 모드로 사진을 찍는 동안 비디오가 일시 정지돼요."

msgid "The virtual camera has to be switched on first, which needs your password."
msgstr "가상 카메라를 먼저 켜야 하며, 비밀번호가 필요해요."

msgid "The virtual camera is off"
msgstr "가상 카메라가 꺼져 있음"

#, python-brace-format
msgid "The virtual camera {device} is set to {format}, which Telescope can't write. Close the apps using it, or reload v4l2loopback without keep_format."
msgstr ""

msgid "The virtual microphone stopped taking audio."
msgstr "가상 마이크가 오디오 입력을 받지 못하고 중지되었어요."

msgid "The vision pack couldn't be installed."
msgstr "Vision 팩을 설치할 수 없어요."

msgid "The web address that gets a request when the sign goes on or off air"
msgstr "표시가 온에어 또는 오프에어될 때 요청을 받을 웹 주소"

msgid "The webcam isn't plugged in. Plug the webcam back in to continue."
msgstr "웹캠이 연결되어 있지 않아요. 계속하려면 웹캠을 다시 연결하세요."

msgid "The webcam isn't sending anything. Try another resolution or frame rate."
msgstr "웹캠에서 아무것도 전송하지 않고 있어요. 다른 해상도나 프레임 레이트를 시도해 보세요."

#, python-brace-format
msgid "The webhook returned: {error}"
msgstr "웹후크 응답: {error}"

msgid "The width of the stream's box in pixels."
msgstr ""

msgid "Theme"
msgstr "테마"

msgid "Theme, colours, sizes, motion and language."
msgstr ""

msgid "There are none to remove"
msgstr "제거할 항목이 없어요"

#, python-brace-format
msgid "There can be at most {max} shortcuts. Remove a shortcut to add another."
msgstr "단축키는 최대 {max}개까지 지정할 수 있어요. 다른 단축키를 추가하려면 기존 단축키를 제거하세요."

#, python-brace-format
msgid "There's already a layout called \"{name}\". Replace it?"
msgstr "이미 \"{name}\" 레이아웃이 있어요. 바꿀까요?"

#, python-brace-format
msgid "There's already a preset called \"{name}\". Replace it?"
msgstr "이름이 \"{name}\"인 프리셋이 이미 있어요. 바꿀까요?"

msgid "There's no download for this computer yet."
msgstr "이 컴퓨터용 다운로드가 아직 제공되지 않아요."

msgid "There's no high quality cutout for this computer yet. The normal one is used instead."
msgstr "이 컴퓨터용 고화질 인물 분리가 아직 지원되지 않아요. 대신 일반 분리를 사용해요."

msgid "There's no nightly release yet."
msgstr "아직 Nightly 릴리스가 없어요."

msgid "There's no stable release yet."
msgstr "아직 안정 릴리스가 없어요."

msgid "There's no vision download for this computer yet."
msgstr "이 컴퓨터용 비전 다운로드가 아직 제공되지 않아요."

msgid "There's no vision pack for this computer."
msgstr "이 컴퓨터용 Vision 팩이 없어요."

#. framing guides drawn over the preview; "4 × 4" is a grid of four by four boxes
msgid "Thirds"
msgstr "3분할"

msgid "This LUT has colours that aren't numbers."
msgstr "이 LUT에 숫자가 아닌 색상 값이 있어요."

#, python-brace-format
msgid "This LUT has {size} points per side. Telescope takes up to {most}."
msgstr "이 LUT는 한 변당 {size}개의 점이 있어요. Telescope는 최대 {most}개까지 지원해요."

#, python-brace-format
msgid "This LUT should have {expected} colours but has {found}."
msgstr "이 LUT는 {expected}개의 색상이 있어야 하지만 {found}개가 있어요."

#, python-brace-format
msgid "This LUT's 1D table has {size} entries, which isn't a size Telescope can use."
msgstr "이 LUT의 1D 테이블에 {size}개의 항목이 있으며, 이는 Telescope에서 사용할 수 없는 크기예요."

msgid "This LUT's DOMAIN_MAX isn't above its DOMAIN_MIN."
msgstr "이 LUT의 DOMAIN_MAX가 DOMAIN_MIN보다 크지 않아요."

msgid "This Telescope has no shortcuts."
msgstr "이 Telescope에는 단축키가 없어요."

msgid "This app needs an update"
msgstr "이 앱 업데이트 필요"

msgid "This camera can't set the ISO."
msgstr ""

msgid "This camera can't set the focus for a photo."
msgstr ""

msgid "This camera can't set the shutter speed."
msgstr ""

#, python-brace-format
msgid "This camera can't set {what} for one photo."
msgstr ""

msgid "This camera can't take that kind of photo."
msgstr "이 카메라로는 해당 유형의 사진을 촬영할 수 없어요."

msgid "This camera's microphone doesn't go through Telescope. Pick it as the microphone in the app that uses the camera instead."
msgstr "이 카메라의 마이크는 Telescope를 거치지 않아요. 대신 카메라를 쓰는 앱에서 이 마이크를 직접 선택하세요."

#. added under "Starting Telescope…" while the app starts on Windows. The scan is Windows checking new program files
msgid "This can take a minute while Windows runs a security scan."
msgstr "Windows에서 보안 검사를 실행하는 동안 1분 정도 걸릴 수 있어요."

msgid "This computer"
msgstr "이 컴퓨터"

msgid "This computer couldn't set up the video connection."
msgstr "이 컴퓨터에서 비디오 연결을 설정하지 못했어요."

msgid "This computer has no network"
msgstr ""

msgid "This computer isn't connected to a network."
msgstr ""

#, python-brace-format
msgid "This computer isn't connected to a network. Connect it to the same network as {phone}, or plug the phone in with a USB cable."
msgstr ""

msgid "This computer isn't connected to a network. Reconnect it, or plug the phone in with a USB cable."
msgstr ""

msgid "This computer isn't on a network right now. Pair over USB."
msgstr "이 컴퓨터가 현재 네트워크에 연결되어 있지 않아요. USB로 페어링하세요."

#, python-brace-format
msgid "This desktop doesn't offer global shortcuts to apps ({why})."
msgstr "이 데스크톱 환경에서는 앱에 전역 단축키를 제공하지 않아요({why})."

msgid "This desktop doesn't offer global shortcuts to apps."
msgstr "이 데스크톱 환경에서는 앱에 전역 단축키를 제공하지 않아요."

msgid "This file doesn't contain adb.exe."
msgstr "이 파일에 adb.exe가 포함되어 있지 않아요."

msgid "This file is too big to be a LUT Telescope can use."
msgstr "이 파일은 너무 커서 Telescope에서 LUT로 사용할 수 없어요."

msgid "This file wasn't used while the vision pack is downloading or installing. Try again when it's done."
msgstr "Vision 팩을 다운로드하거나 설치하는 동안에는 이 파일이 사용되지 않았어요. 작업이 완료된 후 다시 시도해 보세요."

msgid "This is a source checkout. Update Telescope with git."
msgstr "소스 코드를 체크아웃한 환경이에요. git을 사용하여 Telescope를 업데이트하세요."

msgid "This is a source checkout. Update it with git."
msgstr "소스 코드 체크아웃 버전이에요. git으로 업데이트하세요."

msgid "This is the vision pack, not a plugin. It's being checked and installed in the background and the download banner shows how it goes."
msgstr "이 파일은 플러그인이 아니라 Vision 팩이에요. 백그라운드에서 확인 및 설치 중이며 다운로드 배너에 진행 상황이 표시돼요."

msgid "This isn't a .cube LUT because the size is missing."
msgstr "크기 정보가 누락되어 .cube LUT 파일이 아니에요."

msgid "This lens and mode have no extra noise reduction or sharpening to offer"
msgstr "이 렌즈와 모드는 추가 노이즈 감소나 선명도를 지원하지 않아요"

msgid "This lens can't focus on a point"
msgstr "이 렌즈는 특정 지점에 초점을 맞출 수 없어요"

msgid "This lens can't meter on a point."
msgstr "이 렌즈는 특정 지점 측광을 지원하지 않아요."

msgid "This lens has no Night mode to offer"
msgstr ""

msgid "This lens has no flash to use as a torch"
msgstr "이 렌즈에는 손전등으로 사용할 플래시가 없어요"

msgid "This lens has no manual exposure"
msgstr "이 렌즈는 수동 노출을 지원하지 않아요"

msgid "This lens has no manual focus"
msgstr "이 렌즈는 수동 초점을 지원하지 않아요"

msgid "This lens has no manual white balance"
msgstr "이 렌즈는 수동 화이트 밸런스를 지원하지 않아요"

msgid "This lens has no optical stabilisation"
msgstr "이 렌즈에는 광학 손떨림 보정이 없어요"

msgid "This lens takes one photo at a time"
msgstr ""

msgid "This mode sets its own exposure"
msgstr ""

#, python-brace-format
msgid "This one-time download (about {mb} MB) gives the Background cutout cleaner edges."
msgstr "이 1회성 다운로드 파일(약 {mb} MB)은 배경 컷아웃의 가장자리를 더 깔끔하게 다듬어 줘요."

#, python-brace-format
msgid "This one-time download (about {mb} MB) is shared by every plugin that finds people in the picture."
msgstr "이 1회성 다운로드 파일(약 {mb} MB)은 화면에서 사람을 찾는 모든 플러그인에서 공유해요."

msgid "This phone can't set the ISO."
msgstr ""

msgid "This phone can't set the shutter speed."
msgstr ""

#, python-brace-format
msgid "This phone can't set {what} for one photo."
msgstr ""

msgid "This phone can't take photos from Telescope yet. Update the app on the phone."
msgstr "이 휴대폰은 아직 Telescope에서 사진을 촬영할 수 없어요. 휴대폰의 앱을 업데이트하세요."

msgid "This phone can't take photos from Telescope. Update the app on the phone."
msgstr "이 휴대폰에서는 Telescope를 통한 사진 촬영을 지원하지 않아요. 휴대폰 앱을 업데이트하세요."

msgid "This phone can't turn its camera off yet"
msgstr "이 휴대폰은 아직 카메라 끄기를 지원하지 않음"

msgid "This phone has no H.264 encoder."
msgstr "이 휴대폰에는 H.264 인코더가 없어요."

msgid "This phone has no motion sensor for the level."
msgstr "이 휴대폰에는 수평계에 필요한 모션 센서가 없어요."

msgid "This phone's app is too old for low light"
msgstr "이 휴대폰의 앱 버전이 낮아 저조도 모드를 쓸 수 없어요"

msgid "This phone's camera can't take that photo."
msgstr "이 휴대폰의 카메라는 해당 사진을 촬영할 수 없어요."

msgid "This picture can't be shared."
msgstr ""

msgid "This plugin can't be switched off. Telescope needs it to work."
msgstr "이 플러그인은 끌 수 없어요. Telescope가 작동하는 데 필요해요."

msgid "This plugin has technical limitations that will likely never get resolved. Do not expect it to work perfectly."
msgstr "이 플러그인에는 해결되기 어려운 기술적 한계가 있어요. 완벽하게 작동하지 않을 수 있어요."

msgid "This plugin is always on while `telescope-rs dev --plugin` loads it."
msgstr "`telescope-rs dev --plugin`에서 로드하는 동안 이 플러그인은 항상 켜져 있어요."

msgid "This plugin is an early version. It may change or behave oddly."
msgstr "이 플러그인은 초기 버전이에요. 동작이 변경되거나 비정상적으로 작동할 수 있어요."

msgid "This script is too long to send to the phone."
msgstr "이 대본은 너무 길어서 휴대폰으로 보낼 수 없어요."

msgid "This translation is a first draft and some texts might read a bit oddly."
msgstr "이 번역은 초안이므로 일부 문구가 다소 어색할 수 있어요."

msgid "This update wasn't installed because it can't start on this computer."
msgstr "이 업데이트는 이 컴퓨터에서 실행할 수 없어 설치되지 않았어요."

msgid "This v4l2loopback can't add cameras while it runs (v4l2loopback-ctl is missing). Install v4l2loopback-utils or a newer v4l2loopback, then try again."
msgstr "현재 v4l2loopback은 실행 중에 카메라를 추가할 수 없어요(v4l2loopback-ctl 없음). v4l2loopback-utils 또는 더 최신 v4l2loopback을 설치한 후 다시 시도해 보세요."

msgid "This version"
msgstr "현재 버전"

