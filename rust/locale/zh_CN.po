#: rust/crates/effects/src/fun_pack.rs:46
msgid "1998 webcam"
msgstr "1998 年网络摄像头"

#: rust/crates/effects/src/fun_pack.rs:47
msgid "VHS"
msgstr "VHS"

#: rust/crates/effects/src/fun_pack.rs:48
