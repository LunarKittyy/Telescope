msgstr "光绘"

#: rust/crates/effects/src/fun_pack.rs:43
msgid "Slit-scan"
msgstr "缝隙扫描"

#: rust/crates/effects/src/fun_pack.rs:44
msgid "Stick figure"
msgstr "火柴人"

#: rust/crates/effects/src/fun_pack.rs:45
