msgid "The last start of Telescope closed while it was opening {card}. Telescope now uses another graphics card, or the processor if there is none left."
msgstr "Предыдущий запуск Telescope аварийно завершился при открытии {card}. Теперь Telescope использует другую видеокарту, а если других нет - процессор."

#, python-brace-format
msgid "The latest nightly build is {version}."
msgstr "Последняя сборка Nightly - {version}."

#, python-brace-format
msgid "The latest stable build is {version}."
msgstr "Последняя стабильная сборка - {version}."

