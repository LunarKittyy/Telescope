msgid "A browser reached this computer but hasn't accepted its certificate yet. Tap through the warning."
msgstr "Браузер подключился к этому компьютеру, но еще не принял его сертификат. Подтверди предупреждение в браузере."

msgid "A command can't hold a key down. Pick another choice to copy its command."
msgstr "Команда не может удерживать клавишу нажатой. Выбери другой вариант, чтобы скопировать команду."

msgid "A command line that does the same, for your desktop's own keyboard settings"
msgstr "Командная строка с тем же действием для настроек клавиатуры твоего графического окружения"

#, python-brace-format
msgid "A copy of the old file is at {path}."
msgstr "Копия старого файла сохранена в {path}."

