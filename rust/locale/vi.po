msgstr "Dòng lệnh có cùng tác dụng, dùng cho cài đặt bàn phím của hệ thống"

#, python-brace-format
msgid "A copy of the old file is at {path}."
msgstr "Bản sao của tệp cũ nằm tại {path}."

msgid "A frame step failed"
msgstr "Một bước xử lý khung hình bị lỗi"

