msgstr "Điện thoại không chấp nhận các cài đặt chụp ảnh đó."

#: rust/crates/link/src/stills.rs:51
msgid "The phone isn't ready for photos yet. Try again in a moment."
msgstr "Điện thoại chưa sẵn sàng để chụp ảnh. Hãy thử lại sau giây lát."

#: rust/crates/link/src/stills.rs:53
msgid "The phone's camera is off."
msgstr "Camera của điện thoại đang tắt."

#: rust/crates/link/src/stills.rs:54
msgid "The photo was interrupted by a change to the camera."
msgstr "Việc chụp ảnh đã bị gián đoạn do có thay đổi trên camera."

#: rust/crates/link/src/stills.rs:55
msgid "The phone took too long to take the photo."
msgstr "Điện thoại mất quá nhiều thời gian để chụp ảnh."

#: rust/crates/link/src/stills.rs:57
msgid "Lost the phone while it was taking the photo."
msgstr "Mất kết nối với điện thoại trong khi đang chụp ảnh."

#: rust/crates/link/src/stills.rs:58
msgid "The phone gave up on the photo, maybe because its stream stopped."
msgstr "Điện thoại đã hủy việc chụp ảnh, có thể do luồng phát đã dừng."

#: rust/crates/link/src/stills.rs:59
msgid "Telescope couldn't save the photo."
msgstr "Telescope không thể lưu ảnh."

#: rust/crates/link/src/stills.rs:60
msgid "This phone can't take photos from Telescope. Update the app on the phone."
msgstr "Điện thoại này không thể chụp ảnh từ Telescope. Hãy cập nhật ứng dụng trên điện thoại."

#: rust/crates/system/src/updates.rs:123
msgid "The update information couldn't be read."
msgstr "Không thể đọc thông tin cập nhật."

#: rust/crates/system/src/updates.rs:191
msgid "Couldn't check GitHub's certificate, so updates weren't checked. Security software or a network that inspects HTTPS can cause this."
msgstr "Không thể kiểm tra chứng chỉ của GitHub, nên các bản cập nhật chưa được kiểm tra. Phần mềm bảo mật hoặc mạng kiểm tra HTTPS có thể gây ra lỗi này."

#: rust/crates/system/src/updates.rs:192
msgid "Couldn't check for updates. Check the internet connection."
msgstr "Không thể kiểm tra bản cập nhật. Hãy kiểm tra kết nối internet."

#: rust/crates/system/src/updates.rs:271
msgid "The download was cut short. Check the internet connection and try again."
msgstr "Bản tải về bị gián đoạn. Kiểm tra kết nối Internet và thử lại."

#: rust/crates/system/src/updates.rs:275
msgid "The download didn't match its checksum, so it wasn't installed."
msgstr "Bản tải về không khớp mã kiểm tra checksum nên không được cài đặt."

#: rust/crates/system/src/updates.rs:359
msgid "The update contains unexpected paths, so it wasn't installed."
msgstr "Bản cập nhật chứa các đường dẫn bất thường, nên chưa được cài đặt."

#: rust/crates/system/src/updates.rs:411
msgid "The update contains unexpected files, so it wasn't installed."
msgstr "Bản cập nhật chứa các tệp bất thường, nên chưa được cài đặt."

#: rust/crates/system/src/updates.rs:507
msgid "The download doesn't contain Telescope, so it wasn't installed."
msgstr "Bản tải về không chứa Telescope, nên chưa được cài đặt."

