msgid "The phone's camera is off."
msgstr "Camera của điện thoại đang tắt."

#: rust/crates/link/src/stills.rs:58
msgid "The photo was interrupted by a change to the camera."
msgstr "Việc chụp ảnh đã bị gián đoạn do có thay đổi trên camera."

#: rust/crates/link/src/stills.rs:59
msgid "The phone took too long to take the photo."
msgstr "Điện thoại mất quá nhiều thời gian để chụp ảnh."

#: rust/crates/link/src/stills.rs:61
msgid "Lost the phone while it was taking the photo."
msgstr "Mất kết nối với điện thoại trong khi đang chụp ảnh."

#: rust/crates/link/src/stills.rs:62
msgid "The phone gave up on the photo, maybe because its stream stopped."
msgstr "Điện thoại đã hủy việc chụp ảnh, có thể do luồng phát đã dừng."

#: rust/crates/link/src/stills.rs:64
msgid "This phone can't take photos from Telescope. Update the app on the phone."
msgstr "Điện thoại này không thể chụp ảnh từ Telescope. Hãy cập nhật ứng dụng trên điện thoại."

#: rust/crates/system/src/updates.rs:123
msgid "The update information couldn't be read."
msgstr "Không thể đọc thông tin cập nhật."

#: rust/crates/system/src/updates.rs:191
msgid "Couldn't check GitHub's certificate, so updates weren't checked. Security software or a network that inspects HTTPS can cause this."
