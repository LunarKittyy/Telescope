msgstr[2] "{n} wtyczek nie uruchomiło się"

#: telescope/app.py:498
msgid "Telescope works without it. The Plugins tab in Settings says what went wrong."
msgid_plural "Telescope works without them. The Plugins tab in Settings says what went wrong."
msgstr[0] "Telescope działa bez niej. Karta Wtyczki w Ustawieniach wyjaśnia, co poszło nie tak."
msgstr[1] "Telescope działa bez nich. Karta Wtyczki w Ustawieniach wyjaśnia, co poszło nie tak."
msgstr[2] "Telescope działa bez nich. Karta Wtyczki w Ustawieniach wyjaśnia, co poszło nie tak."

