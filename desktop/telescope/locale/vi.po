msgid "Resize the virtual camera"
msgstr "Đổi kích thước camera ảo"

#: telescope/app.py:1628
msgid "The phone sent data this version can't read. Update both apps to the same version."
msgstr "Điện thoại đã gửi dữ liệu mà phiên bản này không thể đọc. Hãy cập nhật cả hai ứng dụng lên cùng một phiên bản."

#: telescope/app.py:1657 telescope/plugins/preview.py:593
msgid "Show"
msgstr "Hiển thị"

#: telescope/app.py:1658
msgid "Quit"
msgstr "Thoát"

#: telescope/app.py:1697
msgid "Telescope didn't answer in time."
msgstr "Telescope không phản hồi kịp thời."

#: telescope/app.py:1704
msgid "This Telescope has no shortcuts."
msgstr "Bản Telescope này không có phím tắt nào."

#: telescope/app.py:1707 telescope/plugins/shortcuts.py:382
msgid "That failed; Copy diagnostics has the details."
msgstr "Thao tác thất bại; Sao chép chẩn đoán có thông tin chi tiết."

#: telescope/app.py:1769
msgid "Only a phone's stream has the video this needs."
msgstr "Chỉ luồng phát của điện thoại mới có video mà tính năng này cần."

#: telescope/app.py:1773
msgid "Needs Light: Heavy sends whole pictures, with no keyframes to work with."
msgstr "Cần định dạng Nhẹ: Định dạng Nặng gửi toàn bộ khung hình ảnh, không có khung hình chính để xử lý."

#: telescope/app.py:2182
msgid "The stream stopped unexpectedly"
msgstr "Luồng phát đã dừng đột ngột"

#: telescope/app.py:2182 telescope/app.py:2198
msgid "Copy diagnostics has the details."
msgstr "Sao chép chẩn đoán có thông tin chi tiết."

#: telescope/app.py:2197
#, python-brace-format
msgid "The stream from {name} stopped unexpectedly"
msgstr "Luồng phát từ {name} đã dừng đột ngột"

#: telescope/app.py:2276
msgid "Telescope is still running"
msgstr "Telescope vẫn đang chạy"

#: telescope/app.py:2277
msgid "Streaming continues in the background."
msgstr "Quá trình truyền phát tiếp tục ở chế độ nền."

#: telescope/app.py:2278
msgid "It starts streaming by itself when it needs to."
msgstr "Ứng dụng sẽ tự động bắt đầu truyền phát khi cần."

#: telescope/app.py:2279
msgid "Right-click the tray icon to quit."
msgstr "Nhấp chuột phải vào biểu tượng khay hệ thống để thoát."

#: telescope/audio.py:467
msgid "Can't reach the phone's microphone."
msgstr "Không thể kết nối với micrô của điện thoại."

#: telescope/audio.py:480 telescope/audio.py:489
msgid "The phone's microphone stopped."
msgstr "Micrô của điện thoại đã dừng."

#: telescope/audio.py:515
#, python-brace-format
msgid "Couldn't open the virtual microphone: {error}"
msgstr "Không thể mở mic ảo: {error}"

#: telescope/audio.py:526
msgid "The virtual microphone stopped taking audio."
msgstr "Mic ảo đã dừng nhận âm thanh."

#. why the phone's microphone can't be used; shown next to the Microphone card
#: telescope/audio.py:687
msgid "No microphone"
msgstr "Không có micrô"

#: telescope/audio.py:689
msgid "Allow the microphone in Telescope on the phone"
msgstr "Cho phép sử dụng micrô trong Telescope trên điện thoại"

#: telescope/audio.py:690
msgid "Open Telescope on the phone once, then try again"
msgstr "Mở Telescope trên điện thoại một lần rồi thử lại"

#: telescope/audio.py:691
msgid "The phone's microphone is in use"
msgstr "Micrô của điện thoại đang được sử dụng"

#: telescope/audio.py:700
#, python-brace-format
msgid "The phone refused the microphone (HTTP {code})."
msgstr "Điện thoại đã từ chối quyền micrô (HTTP {code})."

#: telescope/browser_server.py:429
msgid "Waiting for the browser. Scan the code on the Browser camera card and tap Start."
msgstr "Đang chờ trình duyệt. Quét mã trên thẻ Camera trình duyệt và nhấn Bắt đầu."

#: telescope/browser_server.py:905
msgid "This computer couldn't set up the video connection."
msgstr "Máy tính này không thể thiết lập kết nối video."

#: telescope/colour.py:277
#, python-brace-format
msgid "Line {line} of the file isn't a colour (three numbers)."
msgstr "Dòng {line} của tệp không phải là một màu (ba số)."

#: telescope/colour.py:282
#, python-brace-format
msgid "Line {line} of the file can't be read."
msgstr "Không thể đọc dòng {line} của tệp."

#: telescope/colour.py:284
msgid "This isn't a .cube LUT: it doesn't say its size."
msgstr "Đây không phải là tệp LUT .cube: tệp không nêu rõ kích thước."

#: telescope/colour.py:286
#, python-brace-format
msgid "This LUT has {size} points per side. Telescope takes up to {most}."
msgstr "LUT này có {size} điểm mỗi cạnh. Telescope chỉ hỗ trợ tối đa {most}."

#: telescope/colour.py:289
#, python-brace-format
msgid "This LUT's 1D table has {size} entries, which isn't a size Telescope can use."
msgstr "Bảng 1D của LUT này có {size} mục, không phải là kích thước mà Telescope có thể sử dụng."

#: telescope/colour.py:292
#, python-brace-format
msgid "This LUT should have {expected} colours but has {found}."
msgstr "LUT này phải có {expected} màu nhưng lại có {found} màu."

#: telescope/colour.py:295
msgid "This LUT has colours that aren't numbers."
msgstr "LUT này chứa các giá trị màu không phải là số."

#: telescope/colour.py:307
msgid "This LUT's DOMAIN_MAX isn't above its DOMAIN_MIN."
msgstr "Giá trị DOMAIN_MAX của LUT này không lớn hơn DOMAIN_MIN."

#: telescope/colour.py:315
msgid "This file is too big to be a LUT Telescope can use."
msgstr "Tệp này quá lớn để làm LUT mà Telescope có thể sử dụng."

#: telescope/denoise.py:88
msgid "The pyrnnoise package isn't installed."
msgstr "Gói pyrnnoise chưa được cài đặt."

#: telescope/denoise.py:89
#, python-brace-format
msgid "Couldn't load RNNoise: {error}"
msgstr "Không thể tải RNNoise: {error}"

#. what goes between the items of a list but the last two, as in "Camera, Microphone and Preview"
#: telescope/i18n.py:139
msgid ", "
msgstr ", "

#. the end of a list, as in "Camera, Microphone and Preview"
#: telescope/i18n.py:141
#, python-brace-format
msgid "{items} and {last}"
msgstr "{items} và {last}"

#: telescope/i18n.py:161
#, python-brace-format
msgctxt "percentage"
msgid "{n}%"
msgstr "{n} %"

#: telescope/overlays.py:458
msgid "Click a point on the picture. Esc cancels."
msgstr "Nhấp vào một điểm trên ảnh. Nhấn Esc để hủy."

#: telescope/overlays.py:460
msgid "Drag across the picture to mark an area. Esc cancels."
msgstr "Kéo trên ảnh để đánh dấu một vùng. Nhấn Esc để hủy."

#: telescope/overlays.py:461
msgid "Drag the corners into place, then press Enter. Esc cancels."
msgstr "Kéo các góc vào đúng vị trí rồi nhấn Enter. Nhấn Esc để hủy."

#: telescope/phones.py:284
msgid "adb isn't installed, so USB can't be used (Add phone can get it)"
msgstr "adb chưa được cài đặt nên không thể dùng USB (mục Thêm điện thoại có thể tải adb)"

#: telescope/phones.py:285
msgid "adb isn't installed, so USB can't be used"
msgstr "adb chưa được cài đặt nên không thể dùng USB"

#: telescope/phones.py:286
msgid "no phone plugged in over USB"
msgstr "chưa cắm điện thoại qua USB"

#: telescope/phones.py:287
msgid "phone plugged in, but USB debugging isn't allowed yet: accept the prompt on the phone"
msgstr "đã cắm điện thoại nhưng chưa cho phép Gỡ lỗi USB: hãy chấp nhận lời nhắc trên điện thoại"

#: telescope/phones.py:288
msgid "the phone plugged in over USB is a different one"
msgstr "điện thoại cắm qua USB là một thiết bị khác"

#: telescope/phones.py:289
msgid "phone plugged in, but Telescope isn't open on it"
msgstr "đã cắm điện thoại nhưng chưa mở Telescope trên điện thoại"

#: telescope/platform/__init__.py:238
msgid "The Telescope app on the phone was signed differently. Uninstall it on the phone, then try again."
msgstr "Ứng dụng Telescope trên điện thoại có chữ ký khác. Hãy gỡ cài đặt ứng dụng trên điện thoại rồi thử lại."

#: telescope/platform/__init__.py:241
msgid "The phone already has a newer Telescope app."
msgstr "Điện thoại đã có ứng dụng Telescope mới hơn."

#: telescope/platform/__init__.py:242
msgid "adb install failed"
msgstr "cài đặt qua adb thất bại"

#: telescope/platform/adb_download.py:146
msgid "Finding the current adb…"
msgstr "Đang tìm adb hiện tại…"

#: telescope/platform/adb_download.py:154
msgid "Google's list of downloads wasn't what Telescope expected. Try again later."
msgstr "Danh sách tải về của Google không khớp với dự kiến của Telescope. Hãy thử lại sau."

#: telescope/platform/adb_download.py:160
#, python-brace-format
msgid "Downloading adb {version} from Google…"
msgstr "Đang tải về adb {version} từ Google…"

#: telescope/platform/adb_download.py:161
msgid "Downloading adb from Google…"
msgstr "Đang tải về adb từ Google…"

#: telescope/platform/adb_download.py:167 telescope/widgets/adb.py:81
msgid "Couldn't download adb. Try again."
msgstr "Không thể tải về adb. Hãy thử lại."

#: telescope/platform/adb_download.py:169
msgid "The download didn't match Google's checksum, so it wasn't used. Try again."
msgstr "Bản tải về không khớp mã kiểm tra checksum của Google nên không được dùng. Hãy thử lại."

#: telescope/platform/adb_download.py:170
msgid "Unpacking…"
msgstr "Đang giải nén…"

#: telescope/platform/adb_download.py:176
msgid "Couldn't unpack adb. Try again."
msgstr "Không thể giải nén adb. Hãy thử lại."

#: telescope/platform/adb_download.py:178
msgid "Google's download doesn't have adb.exe in it anymore."
msgstr "Bản tải về của Google không còn chứa tệp adb.exe nữa."

#: telescope/platform/adb_download.py:209
msgid "Couldn't put adb in place. Is another program using it? Try again."
msgstr "Không thể đưa adb vào đúng vị trí. Có chương trình khác đang sử dụng tệp này không? Hãy thử lại."

#: telescope/platform/adb_download.py:233
msgid "Couldn't copy adb from there."
msgstr "Không thể sao chép adb từ vị trí đó."

#: telescope/platform/adb_download.py:235
msgid "That doesn't have adb.exe in it."
msgstr "Vị trí đó không chứa tệp adb.exe."

#: telescope/platform/adb_download.py:245
msgid "Couldn't check Google's certificate, so nothing was downloaded. Security software or a network that inspects HTTPS can cause this."
msgstr "Không thể kiểm tra chứng chỉ của Google nên chưa có gì được tải về. Phần mềm bảo mật hoặc mạng kiểm tra HTTPS có thể gây ra lỗi này."

#: telescope/platform/adb_download.py:249
msgid "Couldn't reach Google. Check the internet connection and try again."
msgstr "Không thể kết nối đến Google. Hãy kiểm tra kết nối Internet và thử lại."

#: telescope/platform/adb_download.py:251
#, python-brace-format
msgid "Google wouldn't send adb to this computer (it said {code}). Google blocks Android downloads in some countries. If you get platform-tools another way, pick its adb.exe or zip instead."
msgstr "Google không gửi adb đến máy tính này (báo lỗi {code}). Google chặn tải về Android ở một số quốc gia. Nếu bạn có platform-tools bằng cách khác, hãy chọn tệp adb.exe hoặc tệp zip của gói đó thay thế."

#: telescope/platform/adb_download.py:254
#, python-brace-format
msgid "Google's server said {code}. Try again later."
msgstr "Máy chủ của Google báo lỗi {code}. Hãy thử lại sau."

#: telescope/platform/autostart.py:168
