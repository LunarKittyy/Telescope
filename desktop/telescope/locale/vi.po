#: telescope/app.py:56
msgid "The phone's camera is making fewer frames than asked for. Dim light slows it down."
msgstr "Camera của điện thoại đang tạo ít khung hình hơn yêu cầu. Ánh sáng mờ làm chậm tốc độ."

#: telescope/app.py:57
#, python-brace-format
msgid "Dynamic lowered the frame rate to {fps} fps to keep up with a slow connection."
msgstr "Định dạng Linh hoạt đã giảm tốc độ khung hình xuống {fps} fps để theo kịp kết nối chậm."

#: telescope/app.py:58
#, python-brace-format
msgid "The phone got hot and lowered the frame rate to {fps} fps for now."
msgstr "Điện thoại bị nóng và tạm thời giảm tốc độ khung hình xuống {fps} fps."

