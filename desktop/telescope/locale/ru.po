#: telescope/app.py:56
msgid "The phone's camera is making fewer frames than asked for. Dim light slows it down."
msgstr "Камера телефона выдает меньше кадров, чем запрошено. Слабое освещение замедляет ее работу."

#: telescope/app.py:57
#, python-brace-format
msgid "Dynamic lowered the frame rate to {fps} fps to keep up with a slow connection."
msgstr "Формат «Динамический» снизил частоту кадров до {fps} fps из-за медленного соединения."

#: telescope/app.py:58
#, python-brace-format
msgid "The phone got hot and lowered the frame rate to {fps} fps for now."
msgstr "Телефон нагрелся и временно снизил частоту кадров до {fps} fps."

#: telescope/app.py:128
msgid "Lost the phone - reconnecting"
msgstr "Связь с телефоном потеряна - переподключение"

#: telescope/app.py:169 telescope/plugins/browser_camera.py:569 telescope/plugins/connection.py:1198 telescope/plugins/connection.py:1242 telescope/plugins/connection.py:1402 telescope/plugins/connection.py:1438 telescope/plugins/onboarding.py:267 telescope/plugins/setup.py:829 telescope/plugins/updates.py:108 telescope/sources.py:918 telescope/widgets/vaapi_setup.py:300
msgid "Try again"
msgstr "Попробовать снова"

#: telescope/app.py:250
msgid "Telescope (dev)"
msgstr "Telescope (dev)"

#: telescope/app.py:496
#, python-brace-format
msgid "{plugins} didn't start"
msgid_plural "{plugins} didn't start"
msgstr[0] "Плагин {plugins} не запустился"
msgstr[1] "Плагины {plugins} не запустились"
msgstr[2] "Плагины {plugins} не запустились"

#: telescope/app.py:497
#, python-brace-format
msgid "{n} plugin didn't start"
msgid_plural "{n} plugins didn't start"
msgstr[0] "{n} плагин не запустился"
msgstr[1] "{n} плагина не запустились"
msgstr[2] "{n} плагинов не запустились"

#: telescope/app.py:498
msgid "Telescope works without it. The Plugins tab in Settings says what went wrong."
msgid_plural "Telescope works without them. The Plugins tab in Settings says what went wrong."
msgstr[0] "Telescope работает и без него. Во вкладке «Плагины» в Настройках написано, что пошло не так."
msgstr[1] "Telescope работает и без них. Во вкладке «Плагины» в Настройках написано, что пошло не так."
msgstr[2] "Telescope работает и без них. Во вкладке «Плагины» в Настройках написано, что пошло не так."

#: telescope/app.py:500 telescope/app.py:528
msgid "Plugins…"
msgstr "Плагины…"

#: telescope/app.py:524
#, python-brace-format
msgid "{plugins} is turned off"
msgid_plural "{plugins} are turned off"
msgstr[0] "Плагин {plugins} выключен"
msgstr[1] "Плагины {plugins} выключены"
msgstr[2] "Плагины {plugins} выключены"

#: telescope/app.py:525
msgid "You turned this off in Plugins. To get it back, open Plugins in Settings and switch it on."
msgid_plural "You turned these off in Plugins. To get them back, open Plugins in Settings and switch them on."
msgstr[0] "Ты выключил это в «Плагинах». Чтобы вернуть, открой «Плагины» в Настройках и включи."
msgstr[1] "Ты выключил их в «Плагинах». Чтобы вернуть их, открой «Плагины» в Настройках и включи их."
msgstr[2] "Ты выключил их в «Плагинах». Чтобы вернуть их, открой «Плагины» в Настройках и включи их."

#: telescope/app.py:557
#, python-brace-format
msgid "Plugins ({n} off)"
msgstr "Плагины ({n} выкл.)"

#: telescope/app.py:585
#, python-brace-format
msgid "A copy of the old file is at {path}."
msgstr "Копия старого файла сохранена в {path}."

#: telescope/app.py:587
msgid "Your settings couldn't be read"
msgstr "Не удалось прочитать твои настройки"

#: telescope/app.py:588
msgid "Telescope started with its defaults, so paired phones need pairing again."
msgstr "Telescope запущен со стандартными настройками, поэтому сопряженные телефоны нужно связать снова."

