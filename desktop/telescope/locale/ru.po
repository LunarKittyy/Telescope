msgid "Starting"
msgstr "Запуск"

#: telescope/app.py:1294
msgid "Waiting"
msgstr "Ожидание"

#: telescope/app.py:1340
msgid "Setting up more virtual cameras…"
msgstr "Настройка дополнительных виртуальных камер…"

#: telescope/app.py:1364 telescope/plugins/setup.py:722
msgid "Stop the streams going to them first"
msgstr "Сначала останови идущие в них трансляции"

#: telescope/app.py:1364
msgid "There are none to remove"
msgstr "Нечего удалять"

#: telescope/app.py:1392
#, python-brace-format
msgid "{first} to {last}"
msgstr "с {first} по {last}"

#: telescope/app.py:1394
msgid "Set up more virtual cameras"
msgstr "Настроить дополнительные виртуальные камеры"

#: telescope/app.py:1395
#, python-brace-format
msgid "To stream several cameras at once, Telescope adds more virtual cameras ({names})."
msgstr "Чтобы транслировать несколько камер одновременно, Telescope добавляет виртуальные камеры ({names})."

#: telescope/app.py:1396
msgid "This asks for your password."
msgstr "Для этого потребуется ввести пароль."

#: telescope/app.py:1396 telescope/plugins/setup.py:724
msgid "Windows asks for permission."
msgstr "Windows запросит разрешение."

#: telescope/app.py:1413
msgid "Couldn't add more virtual cameras"
msgstr "Не удалось добавить дополнительные виртуальные камеры"

#: telescope/app.py:1431
msgid "Only a phone can turn its camera off and keep streaming its mic."
msgstr "Только телефон может выключить камеру и продолжать транслировать звук с микрофона."

#: telescope/app.py:1433
msgid "Only while one camera streams."
msgstr "Только пока транслируется одна камера."

#: telescope/app.py:1435
msgid "Turn on the phone mic first. With the camera off, the mic is all that streams."
msgstr "Сначала включи микрофон телефона. При выключенной камере транслируется только звук с микрофона."

#: telescope/app.py:1437
msgid "Update Telescope on the phone to turn its camera off while streaming."
msgstr "Обнови Telescope на телефоне, чтобы выключать камеру во время трансляции."

#: telescope/app.py:1489
msgid "Turning the phone's camera on…"
msgstr "Включение камеры телефона…"

#: telescope/app.py:1497
msgid "Streaming the mic, camera off"
msgstr "Трансляция микрофона, камера выключена"

#: telescope/app.py:1522
msgid "Telescope: streaming the camera"
msgstr "Telescope: трансляция камеры"

#: telescope/app.py:1522
msgid "Telescope: streaming the camera and mic"
msgstr "Telescope: трансляция камеры и микрофона"

#: telescope/app.py:1523
msgid "Telescope: streaming the camera, mic muted"
msgstr "Telescope: трансляция камеры, звук микрофона выключен"

#: telescope/app.py:1525
msgid "Telescope: streaming the mic, camera off (muted)"
msgstr "Telescope: трансляция микрофона, камера выключена (звук выключен)"

#: telescope/app.py:1526
msgid "Telescope: streaming the mic, camera off"
msgstr "Telescope: трансляция микрофона, камера выключена"

#: telescope/app.py:1550
msgid "Stop all but one camera first, then apply again"
msgstr "Сначала останови все камеры, кроме одной, затем примени снова"

#: telescope/app.py:1562
msgid "Reloading v4l2loopback…"
msgstr "Перезагрузка v4l2loopback…"

#: telescope/app.py:1580
msgid "Restarting stream…"
msgstr "Перезапуск трансляции…"

#: telescope/app.py:1594
#, python-brace-format
msgid "Loopback reloaded: {message}"
msgstr "Loopback перезагружен: {message}"

#: telescope/app.py:1594
msgid "Canvas updated"
msgstr "Холст обновлен"

#: telescope/app.py:1598
#, python-brace-format
msgid "Reload failed: {message}"
msgstr "Не удалось перезагрузить: {message}"

#: telescope/app.py:1605 telescope/plugins/setup.py:993
msgid "Resize the virtual camera"
msgstr "Изменить размер виртуальной камеры"

#: telescope/app.py:1628
msgid "The phone sent data this version can't read. Update both apps to the same version."
msgstr "Телефон отправил данные, которые эта версия не может прочитать. Обнови оба приложения до одинаковой версии."

#: telescope/app.py:1657 telescope/plugins/preview.py:593
msgid "Show"
msgstr "Показать"

#: telescope/app.py:1658
msgid "Quit"
msgstr "Выход"

#: telescope/app.py:1697
msgid "Telescope didn't answer in time."
msgstr "Telescope не ответил вовремя."

#: telescope/app.py:1704
msgid "This Telescope has no shortcuts."
msgstr "В этом Telescope нет горячих клавиш."

#: telescope/app.py:1707 telescope/plugins/shortcuts.py:382
msgid "That failed; Copy diagnostics has the details."
msgstr "Произошла ошибка; подробности - в «Скопировать диагностику»."

#: telescope/app.py:1769
msgid "Only a phone's stream has the video this needs."
msgstr "Только в трансляции с телефона есть видео нужного формата."

#: telescope/app.py:1773
msgid "Needs Light: Heavy sends whole pictures, with no keyframes to work with."
msgstr "Требуется формат «Легкий»: «Тяжелый» передает полные кадры без ключевых кадров для обработки."

#: telescope/app.py:2182
msgid "The stream stopped unexpectedly"
msgstr "Трансляция неожиданно остановилась"

#: telescope/app.py:2182 telescope/app.py:2198
msgid "Copy diagnostics has the details."
msgstr "Подробности - в «Скопировать диагностику»."

#: telescope/app.py:2197
#, python-brace-format
msgid "The stream from {name} stopped unexpectedly"
msgstr "Трансляция с {name} неожиданно остановилась"

#: telescope/app.py:2276
msgid "Telescope is still running"
msgstr "Telescope продолжает работу"

#: telescope/app.py:2277
msgid "Streaming continues in the background."
msgstr "Трансляция продолжается в фоновом режиме."

#: telescope/app.py:2278
msgid "It starts streaming by itself when it needs to."
msgstr "Трансляция запустится сама, когда потребуется."

#: telescope/app.py:2279
msgid "Right-click the tray icon to quit."
msgstr "Нажми правой кнопкой мыши на значок в области уведомлений, чтобы выйти."

#: telescope/audio.py:467
msgid "Can't reach the phone's microphone."
msgstr "Не удалось подключиться к микрофону телефона."

#: telescope/audio.py:480 telescope/audio.py:489
msgid "The phone's microphone stopped."
msgstr "Микрофон телефона перестал работать."

#: telescope/audio.py:515
#, python-brace-format
msgid "Couldn't open the virtual microphone: {error}"
msgstr "Не удалось открыть виртуальный микрофон: {error}"

#: telescope/audio.py:526
msgid "The virtual microphone stopped taking audio."
msgstr "Виртуальный микрофон перестал принимать звук."

#. why the phone's microphone can't be used; shown next to the Microphone card
#: telescope/audio.py:687
msgid "No microphone"
msgstr "Нет микрофона"

#: telescope/audio.py:689
msgid "Allow the microphone in Telescope on the phone"
msgstr "Разреши доступ к микрофону в Telescope на телефоне"

#: telescope/audio.py:690
msgid "Open Telescope on the phone once, then try again"
msgstr "Открой Telescope на телефоне один раз, затем попробуй снова"

#: telescope/audio.py:691
msgid "The phone's microphone is in use"
msgstr "Микрофон телефона уже используется"

#: telescope/audio.py:700
#, python-brace-format
msgid "The phone refused the microphone (HTTP {code})."
msgstr "Телефон отклонил доступ к микрофону (HTTP {code})."

#: telescope/browser_server.py:429
msgid "Waiting for the browser. Scan the code on the Browser camera card and tap Start."
msgstr "Ожидание браузера. Сканируй код на карточке «Камера в браузере» и нажми «Старт»."

#: telescope/browser_server.py:905
msgid "This computer couldn't set up the video connection."
msgstr "Этот компьютер не смог установить видеосоединение."

#: telescope/colour.py:277
#, python-brace-format
msgid "Line {line} of the file isn't a colour (three numbers)."
msgstr "Строка {line} файла не является цветом (три числа)."

#: telescope/colour.py:282
#, python-brace-format
msgid "Line {line} of the file can't be read."
msgstr "Не удалось прочитать строку {line} файла."

#: telescope/colour.py:284
msgid "This isn't a .cube LUT: it doesn't say its size."
msgstr "Это не LUT-файл .cube: в нем не указан размер."

#: telescope/colour.py:286
#, python-brace-format
msgid "This LUT has {size} points per side. Telescope takes up to {most}."
msgstr "У этого LUT {size} точек на сторону. Telescope поддерживает не более {most}."

#: telescope/colour.py:289
#, python-brace-format
msgid "This LUT's 1D table has {size} entries, which isn't a size Telescope can use."
msgstr "Одномерная таблица этого LUT содержит {size} записей, Telescope не может использовать такой размер."

#: telescope/colour.py:292
#, python-brace-format
msgid "This LUT should have {expected} colours but has {found}."
msgstr "В этом LUT должно быть {expected} цветов, но найдено {found}."

#: telescope/colour.py:295
msgid "This LUT has colours that aren't numbers."
msgstr "В этом LUT есть цвета, заданные не числами."

#: telescope/colour.py:307
msgid "This LUT's DOMAIN_MAX isn't above its DOMAIN_MIN."
msgstr "В этом LUT значение DOMAIN_MAX не превышает DOMAIN_MIN."

#: telescope/colour.py:315
msgid "This file is too big to be a LUT Telescope can use."
msgstr "Этот файл слишком большой для LUT, который может использовать Telescope."

#: telescope/denoise.py:88
msgid "The pyrnnoise package isn't installed."
msgstr "Пакет pyrnnoise не установлен."

#: telescope/denoise.py:89
#, python-brace-format
msgid "Couldn't load RNNoise: {error}"
msgstr "Не удалось загрузить RNNoise: {error}"

#. what goes between the items of a list but the last two, as in "Camera, Microphone and Preview"
#: telescope/i18n.py:139
msgid ", "
msgstr ", "

#. the end of a list, as in "Camera, Microphone and Preview"
#: telescope/i18n.py:141
#, python-brace-format
msgid "{items} and {last}"
msgstr "{items} и {last}"

#: telescope/i18n.py:161
#, python-brace-format
msgctxt "percentage"
msgid "{n}%"
msgstr "{n} %"

#: telescope/overlays.py:458
msgid "Click a point on the picture. Esc cancels."
msgstr "Нажми на точку на картинке. Esc - отмена."

#: telescope/overlays.py:460
msgid "Drag across the picture to mark an area. Esc cancels."
msgstr "Проведи по картинке, чтобы выделить область. Esc - отмена."

#: telescope/overlays.py:461
msgid "Drag the corners into place, then press Enter. Esc cancels."
msgstr "Перетащи углы на место, затем нажми Enter. Esc - отмена."

#: telescope/phones.py:284
msgid "adb isn't installed, so USB can't be used (Add phone can get it)"
msgstr "adb не установлен, поэтому USB нельзя использовать («Добавить телефон» поможет скачать его)"

#: telescope/phones.py:285
msgid "adb isn't installed, so USB can't be used"
msgstr "adb не установлен, поэтому USB нельзя использовать"

#: telescope/phones.py:286
msgid "no phone plugged in over USB"
msgstr "телефон не подключен по USB"

#: telescope/phones.py:287
msgid "phone plugged in, but USB debugging isn't allowed yet: accept the prompt on the phone"
msgstr "телефон подключен, но отладка по USB еще не разрешена: подтверди запрос на телефоне"

#: telescope/phones.py:288
msgid "the phone plugged in over USB is a different one"
msgstr "по USB подключен другой телефон"

#: telescope/phones.py:289
msgid "phone plugged in, but Telescope isn't open on it"
msgstr "телефон подключен, но Telescope на нем не открыт"

#: telescope/platform/__init__.py:238
msgid "The Telescope app on the phone was signed differently. Uninstall it on the phone, then try again."
msgstr "Приложение Telescope на телефоне подписано иначе. Удали его на телефоне, затем попробуй снова."

#: telescope/platform/__init__.py:241
msgid "The phone already has a newer Telescope app."
msgstr "На телефоне уже установлена более новая версия Telescope."

#: telescope/platform/__init__.py:242
msgid "adb install failed"
msgstr "ошибка adb install"

#: telescope/platform/adb_download.py:146
msgid "Finding the current adb…"
msgstr "Поиск актуальной версии adb…"

#: telescope/platform/adb_download.py:154
msgid "Google's list of downloads wasn't what Telescope expected. Try again later."
msgstr "Список загрузок Google отличается от того, что ожидал Telescope. Попробуй позже."

#: telescope/platform/adb_download.py:160
#, python-brace-format
msgid "Downloading adb {version} from Google…"
msgstr "Скачивание adb {version} от Google…"

#: telescope/platform/adb_download.py:161
msgid "Downloading adb from Google…"
msgstr "Скачивание adb от Google…"

#: telescope/platform/adb_download.py:167 telescope/widgets/adb.py:81
msgid "Couldn't download adb. Try again."
msgstr "Не удалось скачать adb. Попробуй снова."

#: telescope/platform/adb_download.py:169
msgid "The download didn't match Google's checksum, so it wasn't used. Try again."
msgstr "Скачанный файл не совпал с контрольной суммой Google, поэтому он не был использован. Попробуй снова."

#: telescope/platform/adb_download.py:170
msgid "Unpacking…"
msgstr "Распаковка…"

#: telescope/platform/adb_download.py:176
msgid "Couldn't unpack adb. Try again."
msgstr "Не удалось распаковать adb. Попробуй снова."

#: telescope/platform/adb_download.py:178
msgid "Google's download doesn't have adb.exe in it anymore."
msgstr "В скачанном архиве Google больше нет файла adb.exe."

#: telescope/platform/adb_download.py:209
msgid "Couldn't put adb in place. Is another program using it? Try again."
msgstr "Не удалось поместить adb на место. Возможно, его использует другая программа? Попробуй снова."

#: telescope/platform/adb_download.py:233
msgid "Couldn't copy adb from there."
msgstr "Не удалось скопировать adb оттуда."

#: telescope/platform/adb_download.py:235
msgid "That doesn't have adb.exe in it."
msgstr "Там нет файла adb.exe."

#: telescope/platform/adb_download.py:245
msgid "Couldn't check Google's certificate, so nothing was downloaded. Security software or a network that inspects HTTPS can cause this."
msgstr "Не удалось проверить сертификат Google, поэтому ничего не было скачано. Причиной может быть защитное ПО или сеть, проверяющая HTTPS."

#: telescope/platform/adb_download.py:249
msgid "Couldn't reach Google. Check the internet connection and try again."
msgstr "Не удалось связаться с Google. Проверь подключение к интернету и попробуй снова."

#: telescope/platform/adb_download.py:251
#, python-brace-format
msgid "Google wouldn't send adb to this computer (it said {code}). Google blocks Android downloads in some countries. If you get platform-tools another way, pick its adb.exe or zip instead."
msgstr "Google отказался передать adb этому компьютеру (код ответа: {code}). Google блокирует загрузку Android в некоторых странах. Если у тебя есть platform-tools из другого источника, выбери файл adb.exe или zip-архив."

#: telescope/platform/adb_download.py:254
#, python-brace-format
msgid "Google's server said {code}. Try again later."
msgstr "Сервер Google ответил: {code}. Попробуй позже."

#: telescope/platform/autostart.py:168
#, python-brace-format
msgid "Couldn't set Telescope to open at sign-in: {error}"
msgstr "Не удалось настроить запуск Telescope при входе в систему: {error}"

#: telescope/platform/autostart.py:206
#, python-brace-format
msgid "Couldn't stop Telescope opening at sign-in: {error}"
msgstr "Не удалось отключить запуск Telescope при входе в систему: {error}"

#: telescope/platform/hotkeys_portal.py:118
