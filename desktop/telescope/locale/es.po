msgid "Google's list of downloads wasn't what Telescope expected. Try again later."
msgstr "La lista de descargas de Google no era la que Telescope esperaba. Intenta de nuevo más tarde."

#: telescope/platform/adb_download.py:160
#, python-brace-format
msgid "Downloading adb {version} from Google…"
msgstr "Descargando adb {version} desde Google…"

