#: telescope/app.py:721 telescope/app.py:1533 telescope/app.py:1598 telescope/audio.py:688 telescope/plugins/shortcuts.py:165 telescope/plugins/webcam.py:412 telescope/sources.py:181 telescope/stream.py:477 telescope/stream_flow.py:156
msgid "Not streaming"
msgstr "스트리밍 중 아님"

