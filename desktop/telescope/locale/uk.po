#, python-brace-format
msgid "{plugins} is turned off"
msgid_plural "{plugins} are turned off"
msgstr[0] "{plugins} вимкнено"
msgstr[1] "{plugins} вимкнено"
msgstr[2] "{plugins} вимкнено"

#: telescope/app.py:470
msgid "You turned this off in Plugins. To get it back, open Plugins in Settings and switch it on."
msgid_plural "You turned these off in Plugins. To get them back, open Plugins in Settings and switch them on."
msgstr[0] "Ви вимкнули це в Плагінах. Щоб повернути, відкрийте «Плагіни» в Налаштуваннях і ввімкніть його."
msgstr[1] "Ви вимкнули це в Плагінах. Щоб повернути, відкрийте «Плагіни» в Налаштуваннях і ввімкніть їх."
msgstr[2] "Ви вимкнули це в Плагінах. Щоб повернути, відкрийте «Плагіни» в Налаштуваннях і ввімкніть їх."

#: telescope/app.py:502
#, python-brace-format
msgid "Plugins ({n} off)"
msgstr "Плагіни ({n} вимк.)"

