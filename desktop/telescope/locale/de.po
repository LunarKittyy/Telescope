#: telescope/platform/__init__.py:238
msgid "The Telescope app on the phone was signed differently. Uninstall it on the phone, then try again."
msgstr "Die Telescope-App auf dem Smartphone wurde anders signiert. Deinstalliere sie auf dem Smartphone und versuche es erneut."

#: telescope/platform/__init__.py:241
msgid "The phone already has a newer Telescope app."
msgstr "Auf dem Smartphone ist bereits eine neuere Telescope-App vorhanden."

#: telescope/platform/__init__.py:242
msgid "adb install failed"
msgstr "adb-Installation fehlgeschlagen"

#: telescope/platform/adb_download.py:146
msgid "Finding the current adb…"
msgstr "Aktuelle adb-Version wird gesucht…"

#: telescope/platform/adb_download.py:154
msgid "Google's list of downloads wasn't what Telescope expected. Try again later."
msgstr "Die Download-Liste von Google entsprach nicht den Erwartungen von Telescope. Versuche es später erneut."

#: telescope/platform/adb_download.py:160
#, python-brace-format
msgid "Downloading adb {version} from Google…"
msgstr "adb {version} wird von Google heruntergeladen…"

#: telescope/platform/adb_download.py:161
msgid "Downloading adb from Google…"
msgstr "adb wird von Google heruntergeladen…"

#: telescope/platform/adb_download.py:167 telescope/widgets/adb.py:81
msgid "Couldn't download adb. Try again."
msgstr "adb konnte nicht heruntergeladen werden. Versuche es erneut."

#: telescope/platform/adb_download.py:169
msgid "The download didn't match Google's checksum, so it wasn't used. Try again."
msgstr "Der Download stimmte nicht mit der Prüfsumme von Google überein und wurde daher nicht verwendet. Versuche es erneut."

#: telescope/platform/adb_download.py:170
msgid "Unpacking…"
msgstr "Wird entpackt…"

#: telescope/platform/adb_download.py:176
msgid "Couldn't unpack adb. Try again."
msgstr "adb konnte nicht entpackt werden. Versuche es erneut."

#: telescope/platform/adb_download.py:178
msgid "Google's download doesn't have adb.exe in it anymore."
msgstr "Der Download von Google enthält keine adb.exe mehr."

#: telescope/platform/adb_download.py:209
msgid "Couldn't put adb in place. Is another program using it? Try again."
msgstr "adb konnte nicht abgelegt werden. Wird es von einem anderen Programm verwendet? Versuche es erneut."

#: telescope/platform/adb_download.py:233
msgid "Couldn't copy adb from there."
msgstr "adb konnte von dort nicht kopiert werden."

#: telescope/platform/adb_download.py:235
msgid "That doesn't have adb.exe in it."
msgstr "Darin ist keine adb.exe enthalten."

#: telescope/platform/adb_download.py:245
msgid "Couldn't check Google's certificate, so nothing was downloaded. Security software or a network that inspects HTTPS can cause this."
msgstr "Das Zertifikat von Google konnte nicht geprüft werden, daher wurde nichts heruntergeladen. Sicherheitssoftware oder ein Netzwerk mit HTTPS-Überprüfung kann die Ursache sein."

#: telescope/platform/adb_download.py:249
msgid "Couldn't reach Google. Check the internet connection and try again."
msgstr "Google konnte nicht erreicht werden. Prüfe die Internetverbindung und versuche es erneut."

#: telescope/platform/adb_download.py:251
#, python-brace-format
msgid "Google wouldn't send adb to this computer (it said {code}). Google blocks Android downloads in some countries. If you get platform-tools another way, pick its adb.exe or zip instead."
msgstr "Google wollte adb nicht an diesen Computer senden (Antwort: {code}). In einigen Ländern blockiert Google Android-Downloads. Falls du platform-tools anderweitig bekommst, wähle stattdessen die adb.exe oder die ZIP-Datei aus."

#: telescope/platform/adb_download.py:254
#, python-brace-format
msgid "Google's server said {code}. Try again later."
msgstr "Der Google-Server meldete {code}. Versuche es später erneut."

#: telescope/platform/autostart.py:168
#, python-brace-format
msgid "Couldn't set Telescope to open at sign-in: {error}"
msgstr "Telescope konnte nicht für den Autostart bei der Anmeldung eingerichtet werden: {error}"

#: telescope/platform/autostart.py:206
#, python-brace-format
msgid "Couldn't stop Telescope opening at sign-in: {error}"
msgstr "Autostart von Telescope bei der Anmeldung konnte nicht ausgeschaltet werden: {error}"

#: telescope/platform/hotkeys_portal.py:118
msgid "Not available on this desktop"
msgstr "In dieser Desktop-Umgebung nicht verfügbar"

#: telescope/platform/hotkeys_portal.py:120
msgid "Waiting for you to confirm it"
msgstr "Wartet auf deine Bestätigung"

#: telescope/platform/hotkeys_portal.py:127
#, python-brace-format
msgid "This desktop doesn't offer global shortcuts to apps ({why})."
msgstr "Diese Desktop-Umgebung bietet Apps keine globalen Tastenkombinationen ({why})."

#: telescope/platform/hotkeys_portal.py:128
msgid "This desktop doesn't offer global shortcuts to apps."
msgstr "Diese Desktop-Umgebung bietet Apps keine globalen Tastenkombinationen."

