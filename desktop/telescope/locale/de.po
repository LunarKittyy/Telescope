msgstr "In den Tastatureinstellungen der Desktop-Umgebung ist keine Taste festgelegt"

#: telescope/platform/hotkeys_portal.py:311
#, python-brace-format
msgid "Everywhere: {keys}"
msgstr "Überall: {keys}"

#: telescope/platform/hotkeys_windows.py:107
msgid "Windows can't use this key everywhere"
msgstr "Windows kann diese Taste nicht überall verwenden"

#: telescope/platform/hotkeys_windows.py:112 telescope/plugins/shortcuts.py:731
msgid "Everywhere"
msgstr "Überall"

#: telescope/platform/hotkeys_windows.py:114
msgid "Another app already uses this key"
msgstr "Eine andere App verwendet diese Taste bereits"

#: telescope/platform/hotkeys_windows.py:122
msgid "Everywhere shortcuts are taken from Windows while Telescope runs. A key another app already took doesn't reach Telescope at all, so pick another."
msgstr "Globale Tastenkombinationen werden von Windows reserviert, während Telescope läuft. Eine Taste, die bereits von einer anderen App belegt ist, erreicht Telescope nicht; wähle daher eine andere."

#: telescope/platform/linux.py:106
msgid "Telescope couldn't ask for your password here. Run this in a terminal, then try again."
msgstr "Telescope konnte hier nicht nach deinem Passwort fragen. Führe diesen Befehl im Terminal aus und versuche es erneut."

#: telescope/platform/linux.py:174
msgid "modprobe -r failed"
msgstr "modprobe -r fehlgeschlagen"

#: telescope/platform/linux.py:175
msgid "Module unloaded"
msgstr "Modul entladen"

#: telescope/platform/linux.py:181
msgid "reload failed"
msgstr "Neu laden fehlgeschlagen"

#: telescope/platform/linux.py:189
#, python-brace-format
msgid "v4l2loopback is already loaded with other settings, so {device} isn't there. Close any app using a virtual camera, click Unload and then Load."
msgstr "v4l2loopback ist bereits mit anderen Einstellungen geladen, daher ist {device} nicht vorhanden. Schließe alle Apps, die eine virtuelle Kamera verwenden, und klicke auf „Entladen“ und dann auf „Laden“."

