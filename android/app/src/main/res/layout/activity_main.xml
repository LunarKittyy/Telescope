<?xml version="1.0" encoding="utf-8"?>
<!-- Same rules as the desktop app (desktop/telescope/widgets/common.py): one type scale (styles.xml),
     sentence-case card titles with an accent icon, labels above fields on a phone, one primary button,
     on/off settings as switches, 12dp field and button radius, 16dp cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/colorHeader"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_launcher_foreground"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Telescope"
            android:textAppearance="@style/TextAppearance.Telescope.AppTitle" />

        <ImageButton
            android:id="@+id/btnPreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_preview_open"
            app:tint="@color/colorOnSurfaceDim"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open camera preview"
            android:padding="12dp" />


    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="24dp">

            <!-- Permissions: shown only when something is missing -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/colorError"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Permissions needed"
                            android:textAppearance="@style/TextAppearance.Telescope.CardTitle" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutPermissionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pairing: what this phone is paired with, or how to pair it -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_link"
                            app:tint="@color/colorAccent"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:id="@+id/tvPairingTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Pair with your computer"
                            android:textAppearance="@style/TextAppearance.Telescope.CardTitle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPairingHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="On your computer, open Telescope and click Add phone. Tap Scan pairing code and point the camera at the code it shows. Over USB, the phone pairs without scanning."
                        android:textAppearance="@style/TextAppearance.Telescope.Label" />

                    <LinearLayout
                        android:id="@+id/layoutComputers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanPair"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Scan pairing code"
                        app:icon="@drawable/ic_qr_scan"
                        app:iconGravity="textStart" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Camera -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/colorAccent"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Camera"
                            android:textAppearance="@style/TextAppearance.Telescope.CardTitle" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Lens"
                        android:textAppearance="@style/TextAppearance.Telescope.Label" />

                    <Spinner
                        android:id="@+id/spinnerCamera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/spinner_bg"
                        android:popupBackground="@color/colorSurfaceRaised" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Resolution"
                        android:textAppearance="@style/TextAppearance.Telescope.Label" />

                    <Spinner
                        android:id="@+id/spinnerResolution"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/spinner_bg"
                        android:popupBackground="@color/colorSurfaceRaised" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkOis"
                        style="@style/Widget.Telescope.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Stabilization (OIS)" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkLocalOnly"
                        style="@style/Widget.Telescope.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Local only - USB" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Keeps the camera off the network, so only a USB connection can reach it."
                        android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- The one primary action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="Start Streaming" />

            <!-- Status -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_status"
                            app:tint="@color/colorAccent"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Status"
                            android:textAppearance="@style/TextAppearance.Telescope.CardTitle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○ Not streaming"
                        android:textAppearance="@style/TextAppearance.Telescope.Body"
                        android:textColor="@color/colorOnSurfaceDim" />

                    <!-- Stream addresses, only while streaming. Tap one to copy it. -->
                    <LinearLayout
                        android:id="@+id/layoutLinks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Stream address (tap to copy)"
                            android:textAppearance="@style/TextAppearance.Telescope.Label" />

                        <TextView
                            android:id="@+id/tvLinkWifi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/pill_link"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:textAppearance="@style/TextAppearance.Telescope.Body"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tvLinkUsb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/pill_link"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:textAppearance="@style/TextAppearance.Telescope.Body"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detected cameras (diagnostics) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/colorAccent"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Detected cameras"
                            android:textAppearance="@style/TextAppearance.Telescope.CardTitle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCameraList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.35"
                        android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyDiagnostics"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="Copy diagnostics" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
