<?xml version="1.0" encoding="utf-8"?>
<!-- Same rules as the desktop app (rust/crates/ui-kit/ui): one type scale (styles.xml), cards with
     a hue each and the icon on a square of it (CardHeader), the desktop's line icons, labels above fields on a
     phone, one primary button, on/off settings as switches, 10dp button radius, 14dp cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/tsGround">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:background="?attr/tsChrome"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_logo"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Telescope.AppTitle" />

        <!-- Only while streaming (MainActivity.updateStatusText); left of Preview so Preview keeps the corner -->
        <com.telescope.LookButton
            android:id="@+id/btnBlackScreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:insetLeft="4dp"
            android:insetRight="4dp"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:contentDescription="@string/black_screen_button"
            android:visibility="gone"
            app:icon="@drawable/ic_moon"
            app:iconSize="16dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart" />

        <!-- Says what it opens, since no icon reads as "the camera's view" on its own -->
        <com.telescope.LookButton
            android:id="@+id/btnPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:text="@string/preview_button"
            android:contentDescription="@string/open_preview"
            app:icon="@drawable/ic_eye"
            app:iconSize="16dp"
            app:iconPadding="6dp" />

        <!-- Look and About: the desktop opens its Settings from the same corner of the top bar -->
        <com.telescope.LookButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:insetLeft="4dp"
            android:insetRight="4dp"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:contentDescription="@string/settings"
            app:icon="@drawable/ic_sliders"
            app:iconSize="16dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart" />

    </LinearLayout>

    <!-- A line under the header, drawn only where the look has outlines (OLED), as nothing else tells the bar from the window there -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/tsCardOutline" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingBottom="24dp">

            <!-- Update: shown only when a newer app is available (Updater) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ts_card_pad"
                    android:paddingEnd="@dimen/ts_card_pad"
                    android:paddingTop="@dimen/ts_card_pad_top"
                    android:paddingBottom="@dimen/ts_card_pad_bottom">

                    <com.telescope.CardHeader
                        android:id="@+id/headerUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:headerIcon="@drawable/ic_update"
                        app:headerHue="?attr/tsOk"
                        app:headerTitle="@string/update_available" />

                    <TextView
                        android:id="@+id/tvUpdateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Telescope.Label" />

                    <com.telescope.LookButton
                        android:id="@+id/btnUpdate"
                        app:role="update"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/update" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- First-run setup: the permissions, in order, each with its reason. Gone once all are allowed. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ts_card_pad"
                    android:paddingEnd="@dimen/ts_card_pad"
                    android:paddingTop="@dimen/ts_card_pad_top"
                    android:paddingBottom="@dimen/ts_card_pad_bottom">

                    <com.telescope.CardHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:headerIcon="@drawable/ic_check"
                        app:headerHue="?attr/tsAccent"
                        app:headerTitle="@string/setup_title" />

                    <LinearLayout
                        android:id="@+id/layoutPermissionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pair and Network. While streaming they fold under "More" (MainActivity.updateStatusText moves the block below Status, so Stop stays put) -->
            <LinearLayout
                android:id="@+id/moreBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.telescope.LookButton
                    android:id="@+id/btnMore"
                    app:role="quiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/more"
                    android:visibility="gone"
                    app:icon="@drawable/ic_chevron_down"
                    app:iconSize="16dp"
                    app:iconGravity="end" />

                <LinearLayout
                    android:id="@+id/moreBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- Pairing: what this phone is paired with, or how to pair it -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/ts_card_pad"
                        android:paddingEnd="@dimen/ts_card_pad"
                        android:paddingTop="@dimen/ts_card_pad_top"
                        android:paddingBottom="@dimen/ts_card_pad_bottom">

                        <com.telescope.CardHeader
                            android:id="@+id/headerPairing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            app:headerIcon="@drawable/ic_link"
                            app:headerHue="?attr/tsHueStreaming"
                            app:headerTitle="@string/pair_title" />

                        <TextView
                            android:id="@+id/tvPairingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/pair_hint"
                            android:textAppearance="@style/TextAppearance.Telescope.Label" />

                        <LinearLayout
                            android:id="@+id/layoutComputers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.telescope.LookButton
                            android:id="@+id/btnScanPair"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/scan_pairing_code"
                            app:icon="@drawable/ic_qr_scan"
                            app:iconSize="20dp"
                            app:iconGravity="textStart" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Network -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/ts_card_pad"
                        android:paddingEnd="@dimen/ts_card_pad"
                        android:paddingTop="@dimen/ts_card_pad_top"
                        android:paddingBottom="@dimen/ts_card_pad_bottom">

                        <com.telescope.CardHeader
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            app:headerIcon="@drawable/ic_wifi"
                            app:headerHue="?attr/tsHueCamera"
                            app:headerTitle="@string/network_title" />

                        <com.telescope.LookSwitch
                            android:id="@+id/checkLocalOnly"
                            app:switchHue="?attr/tsHueCamera"
                            android:textAppearance="@style/TextAppearance.Telescope.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/local_only" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="56dp"
                            android:text="@string/local_only_hint"
                            android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"
                            android:background="?attr/tsLine" />

                        <com.telescope.LookSwitch
                            android:id="@+id/checkWaitForComputer"
                            app:switchHue="?attr/tsHueCamera"
                            android:textAppearance="@style/TextAppearance.Telescope.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wait_for_computer" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="56dp"
                            android:text="@string/wait_for_computer_hint"
                            android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                </LinearLayout>
            </LinearLayout>

            <!-- Streams start from the computer; this only stops one, and is gone otherwise -->
            <com.telescope.LookButton
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="10dp"
                app:role="stop"
                android:text="@string/stop_streaming"
                android:visibility="gone" />

            <!-- Status, drawn like the desktop's: the state as a coloured word -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ts_card_pad"
                    android:paddingEnd="@dimen/ts_card_pad"
                    android:paddingTop="@dimen/ts_card_pad_top"
                    android:paddingBottom="@dimen/ts_card_pad_bottom">

                    <com.telescope.CardHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        app:headerIcon="@drawable/ic_phone"
                        app:headerHue="?attr/tsHueOnScreen"
                        app:headerTitle="@string/status_title" />

                    <!-- The desktop's Status row: one coloured word, with the route and the quality as tags under it -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ibm_plex_sans_semibold"
                        android:textSize="16sp"
                        android:textColor="?attr/tsInk2" />

                    <!-- Where the stream goes and at what, while a computer is watching -->
                    <LinearLayout
                        android:id="@+id/layoutStatusTags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
