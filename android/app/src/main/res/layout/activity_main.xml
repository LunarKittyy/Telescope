<?xml version="1.0" encoding="utf-8"?>
<!-- Same rules as the desktop app (desktop/telescope/widgets/common.py): one type scale (styles.xml), cards with
     a hue each and the icon on a square of it (CardHeader), the desktop's line icons, labels above fields on a
     phone, one primary button, on/off settings as switches, 10dp button radius, 14dp cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:background="@color/colorHeader"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_launcher_foreground"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Telescope.AppTitle" />

        <!-- Says what it opens, since no icon reads as "the camera's view" on its own -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreview"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/preview_button"
            android:contentDescription="@string/open_preview"
            app:icon="@drawable/ic_eye"
            app:iconSize="16dp"
            app:iconPadding="6dp" />

    </LinearLayout>

    <!-- A hairline under the header, like the desktop's top bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorBorder" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingBottom="24dp">

            <!-- Update: shown only when a newer app is available (Updater) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.telescope.CardHeader
                        android:id="@+id/headerUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:headerIcon="@drawable/ic_update"
                        app:headerHue="@color/colorStreamingText"
                        app:headerTitle="@string/update_available" />

                    <TextView
                        android:id="@+id/tvUpdateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Telescope.Label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/update" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- First-run setup: the permissions, in order, each with its reason. Gone once all are allowed. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.telescope.CardHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:headerIcon="@drawable/ic_check"
                        app:headerHue="@color/hueLavender"
                        app:headerTitle="@string/setup_title" />

                    <LinearLayout
                        android:id="@+id/layoutPermissionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pairing: what this phone is paired with, or how to pair it -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.telescope.CardHeader
                        android:id="@+id/headerPairing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:headerIcon="@drawable/ic_link"
                        app:headerHue="@color/hueSky"
                        app:headerTitle="@string/pair_title" />

                    <TextView
                        android:id="@+id/tvPairingHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/pair_hint"
                        android:textAppearance="@style/TextAppearance.Telescope.Label" />

                    <LinearLayout
                        android:id="@+id/layoutComputers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanPair"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:text="@string/scan_pairing_code"
                        app:icon="@drawable/ic_qr_scan"
                        app:iconSize="20dp"
                        app:iconGravity="textStart" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Network -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.telescope.CardHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        app:headerIcon="@drawable/ic_wifi"
                        app:headerHue="@color/hueMint"
                        app:headerTitle="@string/network_title" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkLocalOnly"
                        style="@style/Widget.Telescope.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/local_only" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="56dp"
                        android:text="@string/local_only_hint"
                        android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/colorBorder" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkWaitForComputer"
                        style="@style/Widget.Telescope.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wait_for_computer" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="56dp"
                        android:text="@string/wait_for_computer_hint"
                        android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Streams start from the computer; this only stops one, and is gone otherwise -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@color/colorStop"
                app:strokeColor="@color/colorStop"
                android:text="@string/stop_streaming"
                android:visibility="gone" />

            <!-- Status, drawn like the desktop's connection status: a tinted round icon, then the state -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.telescope.CardHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:headerIcon="@drawable/ic_phone"
                        app:headerHue="@color/hueRose"
                        app:headerTitle="@string/status_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_inset"
                        android:padding="10dp">

                        <FrameLayout
                            android:id="@+id/statusChip"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_status_chip"
                            android:importantForAccessibility="no">
                            <ImageView
                                android:id="@+id/ivStatus"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_preview_open" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textAppearance="@style/TextAppearance.Telescope.Body"
                                android:textColor="@color/colorOnSurfaceDim" />
                            <!-- Where the stream goes and at what, while a computer is watching -->
                            <TextView
                                android:id="@+id/tvStatusDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Telescope.Label"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About: diagnostics and updates -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.telescope.CardHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:headerIcon="@drawable/ic_help"
                        app:headerHue="@color/hueLavender"
                        app:headerTitle="@string/about_title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyDiagnostics"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/copy_diagnostics"
                        app:icon="@drawable/ic_copy"
                        app:iconSize="18dp"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportBug"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="6dp"
                        android:text="@string/report_bug"
                        app:icon="@drawable/ic_pop_out"
                        app:iconSize="18dp"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHelp"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="6dp"
                        android:text="@string/troubleshooting"
                        app:icon="@drawable/ic_pop_out"
                        app:iconSize="18dp"
                        app:iconGravity="textStart" />

                    <!-- Updates, under a section heading like the desktop's -->
                    <LinearLayout
                        android:id="@+id/sectionUpdates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_update"
                            app:tint="@color/colorOnSurfaceFaint"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/updates_section"
                            android:textAppearance="@style/TextAppearance.Telescope.Section" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:background="@color/colorBorder" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNightly"
                        style="@style/Widget.Telescope.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nightly_updates" />

                    <TextView
                        android:id="@+id/tvNightlyHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="56dp"
                        android:text="@string/nightly_updates_hint"
                        android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckUpdates"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/check_for_updates"
                        app:icon="@drawable/ic_update"
                        app:iconSize="18dp"
                        app:iconGravity="textStart" />

                    <!-- Shown only in a language whose translation is a first draft (bool translation_is_draft) -->
                    <TextView
                        android:id="@+id/tvTranslationDraft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_horizontal"
                        android:text="@string/translation_draft"
                        android:textAppearance="@style/TextAppearance.Telescope.Hint"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvAppVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                    <!-- Same credit as the desktop's About card -->
                    <TextView
                        android:id="@+id/tvMadeBy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_horizontal"
                        android:textColorLink="@color/colorAccent"
                        android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
