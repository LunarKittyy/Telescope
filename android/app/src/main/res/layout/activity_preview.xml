<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <android.view.TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/btnAspect"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:minWidth="80dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:gravity="center"
        android:drawableStart="@drawable/ic_crop_small"
        android:drawablePadding="8dp"
        android:drawableTint="?attr/tsHueCamera"
        android:fontFamily="@font/ibm_plex_sans_semibold"
        android:textColor="?attr/tsInk"
        android:textSize="14sp"
        android:background="@drawable/bg_overlay_tile"
        android:clickable="true"
        android:focusable="true" />

    <ImageButton
        android:id="@+id/btnClosePreview"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_close"
        app:tint="?attr/tsInk"
        android:background="@drawable/bg_overlay_tile"
        android:scaleType="fitCenter"
        android:contentDescription="@string/close_preview"
        android:padding="12dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="28dp"
        android:scrollbars="none"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/layoutLensPills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

</FrameLayout>
