<?xml version="1.0" encoding="utf-8"?>
<!-- Developer Camera2 probe progress screen with Start, Cancel and Copy report actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/tsGround">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:background="?attr/tsChrome"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <com.telescope.LookButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:insetLeft="4dp"
            android:insetRight="4dp"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_back"
            app:iconSize="16dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/camera_probe_title"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Telescope.AppTitle" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/tsCardOutline" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ts_card_pad"
                    android:paddingEnd="@dimen/ts_card_pad"
                    android:paddingTop="@dimen/ts_card_pad_top"
                    android:paddingBottom="@dimen/ts_card_pad_bottom">

                    <com.telescope.CardHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:headerIcon="@drawable/ic_sliders"
                        app:headerHue="?attr/tsHueExtras"
                        app:headerTitle="@string/camera_probe_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/probe_guidance"
                        android:textAppearance="@style/TextAppearance.Telescope.Body" />

                    <TextView
                        android:id="@+id/tvProbeStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/ibm_plex_sans_semibold"
                        android:text="@string/probe_status_ready"
                        android:textAppearance="@style/TextAppearance.Telescope.Body" />

                    <TextView
                        android:id="@+id/tvProbeDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                    <ProgressBar
                        android:id="@+id/progressProbe"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:indeterminate="true"
                        android:indeterminateTint="?attr/tsAccent"
                        android:progressBackgroundTint="?attr/tsTrough"
                        android:visibility="gone" />

                    <com.telescope.LookButton
                        android:id="@+id/btnStartProbe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/probe_start"
                        app:role="primary"
                        app:buttonHue="?attr/tsHueExtras" />

                    <com.telescope.LookButton
                        android:id="@+id/btnCancelProbe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/cancel"
                        android:visibility="gone"
                        app:role="stop" />

                    <com.telescope.LookButton
                        android:id="@+id/btnCopyReport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:text="@string/probe_copy_report"
                        app:icon="@drawable/ic_copy"
                        app:iconSize="18dp"
                        app:iconGravity="textStart" />

                    <TextView
                        android:id="@+id/tvProbeCacheNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:textAppearance="@style/TextAppearance.Telescope.Hint" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReportPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ts_card_pad"
                    android:paddingEnd="@dimen/ts_card_pad"
                    android:paddingTop="@dimen/ts_card_pad_top"
                    android:paddingBottom="@dimen/ts_card_pad_bottom">

                    <com.telescope.CardHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:headerIcon="@drawable/ic_notes"
                        app:headerHue="?attr/tsHueExtras"
                        app:headerTitle="@string/probe_report_title" />

                    <TextView
                        android:id="@+id/tvReportPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_inset"
                        android:padding="12dp"
                        android:typeface="monospace"
                        android:textSize="11sp"
                        android:textColor="?attr/tsInk2"
                        android:textIsSelectable="true" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
