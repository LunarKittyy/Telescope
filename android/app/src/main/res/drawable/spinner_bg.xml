<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown field: same fill, border and radius as the desktop inputs, plus the chevron the old one lacked. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/colorOutline" />
            <corners android:radius="12dp" />
            <solid android:color="@color/colorSurfaceRaised" />
            <padding android:left="14dp" android:right="40dp"
                     android:top="12dp" android:bottom="12dp" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="14dp"
          android:width="18dp" android:height="18dp"
          android:drawable="@drawable/ic_chevron_down_tinted" />
</layer-list>
