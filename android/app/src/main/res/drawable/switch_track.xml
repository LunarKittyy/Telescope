<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop's Switch (rust/crates/ui-kit/ui/widgets) at phone size: a purple track when on, a grey one when off -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="?attr/tsLineStrong" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="?attr/tsRaise" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="?attr/tsFill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="?attr/tsLineStrong" />
        </shape>
    </item>
</selector>
