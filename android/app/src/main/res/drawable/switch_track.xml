<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop's Switch (desktop/telescope/widgets/common.py) at phone size: a purple track when on, a grey one when off -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="@color/colorOutline" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="@color/colorSurfaceRaised" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="@color/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="@color/colorOutline" />
        </shape>
    </item>
</selector>
