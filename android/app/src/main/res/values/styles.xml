<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type scale, mirroring the desktop: titles, body, caps section headings. -->
    <style name="TextAppearance.Telescope.AppTitle" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Telescope.CardTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Telescope.Label" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/colorOnSurfaceDim</item>
    </style>
    <style name="TextAppearance.Telescope.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>
    <!-- A heading inside a card, followed by a hairline (the desktop's add_section_heading) -->
    <style name="TextAppearance.Telescope.Section" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorOnSurfaceFaint</item>
    </style>
    <style name="TextAppearance.Telescope.Hint" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/colorOnSurfaceFaint</item>
    </style>

    <!-- Card: same radius and hairline border as the desktop cards. -->
    <style name="Widget.Telescope.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Telescope.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/button_fill</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="strokeColor">@color/button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <!-- Flat like the cards. The raised shadow also showed through as a lighter box when
             a button is restyled with a transparent fill (Pair another computer). -->
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <!-- Every button that isn't the one main action: the desktop's raised fill and stronger border -->
    <style name="Widget.Telescope.Button.Outlined" parent="Widget.Telescope.Button">
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/button_secondary_fill</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="iconTint">@color/button_secondary_text</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="rippleColor">@color/colorOutline</item>
    </style>

    <!-- Dialogs like the desktop's: a card's surface and corners, ordinary buttons and the main action filled -->
    <style name="ThemeOverlay.Telescope.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Telescope.Dialog</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Telescope.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Telescope.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Telescope.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Telescope.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Telescope.DialogButton</item>
    </style>
    <style name="ShapeAppearance.Telescope.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="Telescope.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>
    <style name="Telescope.DialogBody" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/colorOnSurfaceDim</item>
    </style>
    <style name="Widget.Telescope.DialogButton" parent="Widget.Telescope.Button.Outlined">
        <item name="android:layout_marginStart">8dp</item>
    </style>
    <style name="Widget.Telescope.DialogButton.Positive" parent="Widget.Telescope.Button">
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="Widget.Telescope.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:textAppearance">@style/TextAppearance.Telescope.Body</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="track">@drawable/switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="switchMinWidth">44dp</item>
        <item name="useMaterialThemeColors">false</item>
    </style>
</resources>
