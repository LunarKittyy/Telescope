<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type scale from the desktop (body 13, small 12, card title 16, dialog title 19) at the phone's 14sp body, in IBM Plex Sans: regular, medium for labels, semibold for titles -->
    <style name="TextAppearance.Telescope.AppTitle" parent="">
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_semibold</item>
        <item name="android:textColor">?attr/tsInk</item>
    </style>
    <style name="TextAppearance.Telescope.CardTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_semibold</item>
        <item name="android:textColor">?attr/tsInk</item>
    </style>
    <style name="TextAppearance.Telescope.Label" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_medium</item>
        <item name="android:textColor">?attr/tsInk</item>
    </style>
    <style name="TextAppearance.Telescope.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_regular</item>
        <item name="android:textColor">?attr/tsInk</item>
    </style>
    <style name="TextAppearance.Telescope.Default" parent="">
        <item name="android:fontFamily">@font/ibm_plex_sans_regular</item>
    </style>
    <!-- A heading inside a card (the desktop's SectionHeading): small, semibold, no rule -->
    <style name="TextAppearance.Telescope.Section" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_semibold</item>
        <item name="android:textColor">?attr/tsInk2</item>
    </style>
    <style name="TextAppearance.Telescope.Hint" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_regular</item>
        <item name="android:textColor">?attr/tsFaint</item>
    </style>

    <!-- Card: the desktop's radius, no edge but OLED's outline -->
    <style name="Widget.Telescope.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/tsCard</item>
        <item name="cardCornerRadius">@dimen/ts_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/tsCardOutline</item>
        <item name="strokeWidth">?attr/tsCardOutlineW</item>
    </style>

    <!-- A button is 44dp tall inside a 48dp touch target (the inset is the touch room); LookButton gives it its role's colours -->
    <style name="Widget.Telescope.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_semibold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">@dimen/ts_radius</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Dialogs like the desktop's: a card's surface and corners, a 20sp semibold title -->
    <style name="ThemeOverlay.Telescope.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">?attr/tsCard</item>
        <item name="colorOnSurface">?attr/tsInk</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Telescope.Dialog</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Telescope.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Telescope.DialogBody</item>
    </style>
    <style name="ShapeAppearance.Telescope.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ts_radius_card</item>
    </style>
    <style name="Telescope.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_semibold</item>
        <item name="android:textColor">?attr/tsInk</item>
    </style>
    <style name="Telescope.DialogBody" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_regular</item>
        <item name="android:textColor">?attr/tsInk2</item>
    </style>
</resources>
