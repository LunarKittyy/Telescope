<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Everything the app draws reads the ts* attributes (look_attrs.xml). The four looks (Theme.Telescope.Dark, .Classic, .Oled and .Light,
         in look_themes.xml) are children of this one and give those attributes their values; Look.kt picks one per activity. -->
    <style name="Theme.Telescope.Base" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">?attr/tsFill</item>
        <item name="colorPrimaryDark">?attr/tsFillPress</item>
        <item name="colorOnPrimary">?attr/tsOnFill</item>
        <!-- Switch thumbs and other "secondary" accents use the accent colour. -->
        <item name="colorSecondary">?attr/tsAccent</item>
        <item name="colorOnSecondary">?attr/tsGround</item>
        <item name="colorControlActivated">?attr/tsAccent</item>
        <item name="colorControlNormal">?attr/tsInk2</item>
        <item name="colorSurface">?attr/tsCard</item>
        <item name="colorOnSurface">?attr/tsInk</item>
        <item name="android:colorBackground">?attr/tsGround</item>
        <item name="colorOnBackground">?attr/tsInk</item>
        <item name="colorError">?attr/tsErr</item>
        <item name="android:windowBackground">?attr/tsGround</item>
        <item name="android:statusBarColor">?attr/tsChrome</item>
        <item name="android:navigationBarColor">?attr/tsChrome</item>
        <item name="android:textColorPrimary">?attr/tsInk</item>
        <item name="android:textColorSecondary">?attr/tsInk2</item>
        <item name="android:textColorHint">?attr/tsFaint</item>
        <item name="materialButtonStyle">@style/Widget.Telescope.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Telescope.Button</item>
        <!-- Plex for every text that names no appearance of its own (a font set on the theme would beat the appearances) -->
        <item name="android:textAppearance">@style/TextAppearance.Telescope.Default</item>
        <item name="materialCardViewStyle">@style/Widget.Telescope.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Telescope.Dialog</item>
    </style>
</resources>
